---
/**
 * Chi annulla su Stripe, o inciampa in un errore, torna indietro con
 * `?cancelled=1` o `?checkoutError=1` nell'URL. Prima non li leggeva nessuno:
 * `checkoutError` finiva solo in GA4 e `cancelled` in nessun posto, quindi si
 * atterrava su una pagina identica a quella di partenza, senza una parola.
 *
 * Le pagine che ricevono questi parametri sono prerenderizzate e servite dalla
 * CDN, percio' il messaggio si monta lato client.
 */
import type { Lang } from '../lib/i18n';

export interface Props {
  lang?: Lang;
}

const { lang = 'it' } = Astro.props;

const COPY = {
  it: {
    cancelled: 'Pagamento annullato, non abbiamo addebitato nulla. La guida resta qui quando vuoi.',
    error: 'Non siamo riusciti ad aprire il pagamento. Riprova tra un istante — se insiste, scrivici a hello@localis.guide.',
    dismiss: 'Chiudi',
  },
  en: {
    cancelled: 'Payment cancelled, nothing was charged. The guide stays here whenever you want it.',
    error: 'We could not open the payment page. Try again in a moment — if it keeps failing, write to hello@localis.guide.',
    dismiss: 'Dismiss',
  },
  de: {
    cancelled: 'Zahlung abgebrochen, es wurde nichts abgebucht. Der Guide bleibt hier, wann immer du willst.',
    error: 'Die Zahlung konnte nicht geöffnet werden. Versuch es gleich noch einmal — wenn es weiter hakt, schreib an hello@localis.guide.',
    dismiss: 'Schließen',
  },
} satisfies Record<Lang, { cancelled: string; error: string; dismiss: string }>;

const copy = COPY[lang];
---
<div
  id="checkout-notice"
  class="checkout-notice"
  role="status"
  aria-live="polite"
  hidden
  data-cancelled={copy.cancelled}
  data-error={copy.error}
>
  <p id="checkout-notice-text" class="checkout-notice-text"></p>
  <button type="button" id="checkout-notice-close" class="checkout-notice-close" aria-label={copy.dismiss}>
    <span aria-hidden="true">×</span>
  </button>
</div>

<style>
  .checkout-notice {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-sm);
    max-width: var(--max-wrap, 1280px);
    margin: var(--spacing-md) auto 0;
    padding: var(--spacing-sm) var(--spacing-md);
    border: 1px solid var(--color-accent);
    border-radius: 8px;
    background: oklch(from var(--color-accent) l c h / 0.08);
  }

  .checkout-notice[hidden] {
    display: none;
  }

  .checkout-notice-text {
    flex: 1;
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: var(--color-ink);
  }

  .checkout-notice-close {
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    padding: 0;
    background: none;
    border: none;
    border-radius: 4px;
    color: var(--color-ink-muted);
    font-size: 1.25rem;
    line-height: 1;
    cursor: pointer;
  }

  .checkout-notice-close:hover {
    color: var(--color-ink);
    background: oklch(from var(--color-accent) l c h / 0.15);
  }
</style>

<script>
  const notice = document.getElementById('checkout-notice');
  const text = document.getElementById('checkout-notice-text');
  const close = document.getElementById('checkout-notice-close');

  if (notice && text && close) {
    const params = new URLSearchParams(window.location.search);
    const message =
      params.get('checkoutError') === '1' ? notice.dataset.error
      : params.get('cancelled') === '1' ? notice.dataset.cancelled
      : null;

    if (message) {
      text.textContent = message;
      notice.hidden = false;

      // Fuori dall'URL: un refresh o un link condiviso non devono far
      // ricomparire un errore che non e' piu' successo.
      params.delete('checkoutError');
      params.delete('cancelled');
      const query = params.toString();
      history.replaceState(
        null,
        '',
        window.location.pathname + (query ? `?${query}` : '') + window.location.hash,
      );
    }

    close.addEventListener('click', () => {
      notice.hidden = true;
    });
  }
</script>
