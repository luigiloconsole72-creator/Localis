---
import type { CollectionEntry } from 'astro:content';
import { formatDuration } from '../lib/format';
import type { Lang } from '../lib/i18n';
import { chapterStartSeconds, chapterTitle, guideDurationSeconds, guideSubtitle, guideTitle } from '../lib/guide-localization';

export interface Props {
  guide: CollectionEntry<'guides'>['data'];
  token: string;
  lang: Lang;
}

const { guide, token, lang } = Astro.props;
const durationSeconds = guideDurationSeconds(guide, lang);
// Estimated file size: 128 kbps mono = 16 KB/s
const estimatedMB = Math.round(durationSeconds * 16000 / 1024 / 1024);

const labels = {
  it: {
    play: 'Riproduci',
    pause: 'Pausa',
    rewind: 'Indietro 15 secondi',
    forward: 'Avanti 15 secondi',
    speed: 'Velocità',
    chapters: 'Capitoli',
    progress: 'Avanzamento audio',
    loading: 'Caricamento...',
    error: 'Impossibile caricare l\'audio.',
    retry: 'Riprova',
    save_offline: `Salva per ascoltare offline · circa ${estimatedMB} MB`,
    downloading: 'Download',
    offline_ready: '✓ Disponibile offline',
    interrupted: 'Download interrotto — riprendi',
  },
  en: {
    play: 'Play',
    pause: 'Pause',
    rewind: 'Back 15 seconds',
    forward: 'Forward 15 seconds',
    speed: 'Speed',
    chapters: 'Chapters',
    progress: 'Audio progress',
    loading: 'Loading...',
    error: 'Could not load audio.',
    retry: 'Retry',
    save_offline: `Save for offline listening · about ${estimatedMB} MB`,
    downloading: 'Downloading',
    offline_ready: '✓ Available offline',
    interrupted: 'Download interrupted — retry',
  },
  de: {
    play: 'Abspielen',
    pause: 'Pause',
    rewind: '15 Sekunden zurück',
    forward: '15 Sekunden vor',
    speed: 'Geschwindigkeit',
    chapters: 'Kapitel',
    loading: 'Laden...',
    error: 'Audio konnte nicht geladen werden.',
    retry: 'Erneut versuchen',
    progress: 'Audio-Fortschritt',
    save_offline: `Für offline speichern · ca. ${estimatedMB} MB`,
    downloading: 'Herunterladen',
    offline_ready: '✓ Offline verfügbar',
    interrupted: 'Download unterbrochen — wiederholen',
  },
}[lang];
---
<div
  class="audio-player border border-border rounded-lg bg-surface-elev overflow-hidden"
  data-guide-slug={guide.slug}
  data-token={token}
  data-lang={lang}
  data-duration={durationSeconds}
  data-guide-title={guideTitle(guide, lang)}
  data-guide-subtitle={guideSubtitle(guide, lang)}
  data-guide-cover={guide.cover}
  data-label-save={labels.save_offline}
  data-label-downloading={labels.downloading}
  data-label-ready={labels.offline_ready}
  data-label-interrupted={labels.interrupted}
>
  <div class="p-md flex items-center gap-md">
    <button
      type="button"
      class="ap-toggle flex-shrink-0 w-14 h-14 rounded-full bg-ink text-surface flex items-center justify-center transition-transform duration-fast hover:scale-105 disabled:opacity-50 disabled:cursor-wait"
      aria-label={labels.play}
    >
      <svg class="ap-icon-play" width="16" height="18" viewBox="0 0 10 12" fill="currentColor" aria-hidden="true">
        <path d="M0 0l10 6-10 6z" />
      </svg>
      <svg class="ap-icon-pause hidden" width="16" height="18" viewBox="0 0 12 14" fill="currentColor" aria-hidden="true">
        <path d="M2 0h3v14H2zM7 0h3v14H7z" />
      </svg>
      <svg class="ap-icon-loading hidden animate-spin" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="12" cy="12" r="10" stroke-opacity="0.3" />
        <path d="M22 12a10 10 0 0 1-10 10" stroke-linecap="round" />
      </svg>
    </button>

    <button type="button" class="ap-rewind text-ink-muted hover:text-ink transition-colors duration-fast" aria-label={labels.rewind}>
      ⏪
    </button>

    <div class="flex-1 min-w-0">
      <div class="ap-progress h-1 bg-ink/10 rounded-full overflow-hidden cursor-pointer" role="progressbar" aria-label={labels.progress} tabindex="0">
        <div class="ap-fill h-full bg-accent rounded-full" style="width: 0%"></div>
      </div>
      <div class="flex justify-between mt-xs text-xs text-ink-subtle font-mono tabular-nums">
        <span class="ap-current">0:00</span>
        <span class="ap-duration">{formatDuration(durationSeconds, 'long')}</span>
      </div>
    </div>

    <button type="button" class="ap-forward text-ink-muted hover:text-ink transition-colors duration-fast" aria-label={labels.forward}>
      ⏩
    </button>

    <button type="button" class="ap-speed text-xs font-semibold text-ink-muted hover:text-ink transition-colors duration-fast min-w-10" data-speed="1" aria-label={labels.speed}>
      1×
    </button>
  </div>

  <details class="border-t border-border">
    <summary class="px-md py-sm cursor-pointer text-sm font-semibold text-ink-muted hover:text-ink select-none">
      {labels.chapters} ({guide.chapters.length})
    </summary>
    <ol class="px-md pb-md flex flex-col gap-2xs">
      {guide.chapters.map((ch, i) => {
        const title = chapterTitle(ch, lang);
        const startSeconds = chapterStartSeconds(ch, lang);
        return (
          <li>
            <button
              type="button"
              class="ap-chapter w-full text-left flex items-baseline gap-sm py-xs hover:bg-surface rounded-sm transition-colors duration-fast"
              data-time={startSeconds}
            >
              <span class="font-mono text-xs text-ink-subtle tabular-nums w-6">{String(i + 1).padStart(2, '0')}</span>
              <span class="flex-1 text-sm text-ink">{title}</span>
              <span class="font-mono text-xs text-ink-subtle tabular-nums">{formatDuration(startSeconds, 'long')}</span>
            </button>
          </li>
        );
      })}
    </ol>
  </details>

  <!-- Offline save section -->
  <div class="ap-offline border-t border-border px-md py-sm">
    <!-- idle: show save button -->
    <button
      type="button"
      class="ap-offline-btn flex items-center gap-xs text-sm text-ink-muted hover:text-ink transition-colors duration-fast"
    >
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
        <polyline points="7 10 12 15 17 10"/>
        <line x1="12" y1="15" x2="12" y2="3"/>
      </svg>
      <span class="ap-offline-label">{labels.save_offline}</span>
    </button>

    <!-- downloading: progress bar + percentage -->
    <div class="ap-offline-downloading hidden">
      <div class="flex items-center justify-between mb-xs">
        <span class="text-xs text-ink-subtle ap-offline-pct-label">{labels.downloading}…</span>
      </div>
      <div class="h-1 bg-ink/10 rounded-full overflow-hidden">
        <div class="ap-offline-fill h-full bg-accent rounded-full transition-[width] duration-200" style="width: 0%"></div>
      </div>
    </div>

    <!-- done -->
    <p class="ap-offline-done hidden text-sm text-ink-subtle">{labels.offline_ready}</p>

    <!-- interrupted -->
    <button
      type="button"
      class="ap-offline-interrupted hidden flex items-center gap-xs text-sm text-error hover:text-error/80 transition-colors duration-fast"
    >
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
      </svg>
      <span>{labels.interrupted}</span>
    </button>
  </div>

  <div class="ap-error px-md py-md border-t border-error/30 bg-error/5 text-sm text-error hidden">
    <p class="ap-error-text">{labels.error}</p>
    <button type="button" class="ap-retry mt-xs underline">{labels.retry}</button>
  </div>

  <audio class="ap-audio" preload="none" crossorigin="anonymous"></audio>
</div>

<script>
  type OfflineState = 'idle' | 'downloading' | 'done' | 'interrupted';

  type Player = {
    el: HTMLElement;
    audio: HTMLAudioElement;
    toggle: HTMLButtonElement;
    iconPlay: SVGElement;
    iconPause: SVGElement;
    iconLoading: SVGElement;
    rewind: HTMLButtonElement;
    forward: HTMLButtonElement;
    speed: HTMLButtonElement;
    progress: HTMLElement;
    fill: HTMLElement;
    cur: HTMLElement;
    dur: HTMLElement;
    chapters: NodeListOf<HTMLButtonElement>;
    error: HTMLElement;
    retry: HTMLButtonElement;
    offlineBtn: HTMLButtonElement;
    offlineLabel: HTMLElement;
    offlineDownloading: HTMLElement;
    offlinePctLabel: HTMLElement;
    offlineFill: HTMLElement;
    offlineDone: HTMLElement;
    offlineInterrupted: HTMLButtonElement;
    slug: string;
    token: string;
    lang: 'it' | 'en' | 'de';
    title: string;
    subtitle: string;
    cover: string;
    audioUrl?: string;
    offlineState: OfflineState;
    startedTracked?: boolean;
    audioMilestones?: Set<number>;
    completeTracked?: boolean;
  };

  const SPEEDS = [1, 1.25, 1.5, 2, 0.85];

  // Global SW message handler — routes messages to the right player
  const players: Player[] = [];

  if ('serviceWorker' in navigator) {
    navigator.serviceWorker.addEventListener('message', (event) => {
      const data = event.data;
      if (!data?.slug || !data?.lang) return;
      const p = players.find((p) => p.slug === data.slug && p.lang === data.lang);
      if (!p) return;

      if (data.type === 'OFFLINE_STATUS') {
        setOfflineState(p, data.available ? 'done' : 'idle');
      } else if (data.type === 'OFFLINE_PROGRESS') {
        setOfflineState(p, 'downloading');
        const pct = data.percent as number;
        // percent is only sent when Content-Length is known — always real bytes
        p.offlinePctLabel.textContent = `${p.el.dataset.labelDownloading} ${pct}%`;
        p.offlineFill.style.width = `${pct}%`;
      } else if (data.type === 'OFFLINE_DONE') {
        setOfflineState(p, 'done');
      } else if (data.type === 'OFFLINE_ERROR') {
        setOfflineState(p, 'interrupted');
      }
    });
  }

  function setOfflineState(p: Player, state: OfflineState): void {
    p.offlineState = state;
    p.offlineBtn.classList.toggle('hidden', state !== 'idle');
    p.offlineDownloading.classList.toggle('hidden', state !== 'downloading');
    p.offlineDone.classList.toggle('hidden', state !== 'done');
    p.offlineInterrupted.classList.toggle('hidden', state !== 'interrupted');
  }

  function fmtTime(s: number): string {
    const m = Math.floor(s / 60);
    const sec = Math.floor(s % 60);
    return `${m}:${sec.toString().padStart(2, '0')}`;
  }

  async function fetchAudioUrl(slug: string, token: string, lang: 'it' | 'en' | 'de'): Promise<string> {
    const res = await fetch(`/api/audio-url?guide=${encodeURIComponent(slug)}&token=${encodeURIComponent(token)}&lang=${lang}`);
    if (!res.ok) {
      const err = await res.json().catch(() => ({ error: `HTTP ${res.status}` }));
      throw new Error(err.error || `HTTP ${res.status}`);
    }
    const data = await res.json();
    return data.url;
  }

  function showError(p: Player, text?: string): void {
    p.error.classList.remove('hidden');
    if (text) p.el.querySelector<HTMLElement>('.ap-error-text')!.textContent = text;
    p.iconLoading.classList.add('hidden');
    p.iconPlay.classList.remove('hidden');
    p.toggle.disabled = false;
  }

  function hideError(p: Player): void {
    p.error.classList.add('hidden');
  }

  function setPlayingState(p: Player, playing: boolean, loading = false): void {
    p.iconPlay.classList.toggle('hidden', playing || loading);
    p.iconPause.classList.toggle('hidden', !playing || loading);
    p.iconLoading.classList.toggle('hidden', !loading);
    p.toggle.disabled = loading;
    if ('mediaSession' in navigator) {
      navigator.mediaSession.playbackState = loading ? 'none' : playing ? 'playing' : 'paused';
    }
  }

  function updateMediaSessionPosition(p: Player): void {
    if (!('mediaSession' in navigator) || typeof navigator.mediaSession.setPositionState !== 'function') return;
    if (!Number.isFinite(p.audio.duration) || p.audio.duration <= 0) return;
    try {
      navigator.mediaSession.setPositionState({
        duration: p.audio.duration,
        position: p.audio.currentTime,
        playbackRate: p.audio.playbackRate || 1,
      });
    } catch {
      // Some browsers expose the API but reject updates.
    }
  }

  function syncMediaSession(p: Player): void {
    if (!('mediaSession' in navigator)) return;

    if (typeof MediaMetadata !== 'undefined') {
      navigator.mediaSession.metadata = new MediaMetadata({
        title: p.title,
        artist: p.subtitle,
        album: 'Localis',
        artwork: [{ src: new URL(p.cover, window.location.origin).href }],
      });
    }

    const bindAction = (action: MediaSessionAction, handler: MediaSessionActionHandler | null): void => {
      try { navigator.mediaSession.setActionHandler(action, handler); } catch { /* ignore */ }
    };

    bindAction('play', () => { void play(p); });
    bindAction('pause', () => pause(p));
    bindAction('seekbackward', (details) => {
      const skip = details.seekOffset ?? 15;
      p.audio.currentTime = Math.max(0, p.audio.currentTime - skip);
      updateMediaSessionPosition(p);
    });
    bindAction('seekforward', (details) => {
      const skip = details.seekOffset ?? 15;
      p.audio.currentTime = Math.min(p.audio.duration || 0, p.audio.currentTime + skip);
      updateMediaSessionPosition(p);
    });

    updateMediaSessionPosition(p);
  }

  async function play(p: Player): Promise<void> {
    if (!p.audioUrl) {
      setPlayingState(p, false, true);
      try {
        p.audioUrl = await fetchAudioUrl(p.slug, p.token, p.lang);
        p.audio.src = p.audioUrl;
      } catch (err: unknown) {
        const msg = err instanceof Error ? err.message : 'unknown';
        showError(p, msg);
        return;
      }
    }
    try {
      await p.audio.play();
      syncMediaSession(p);
      setPlayingState(p, true);
      if (!p.startedTracked && typeof window.localisTrack === 'function') {
        p.startedTracked = true;
        window.localisTrack('guide_audio_started', { guide_slug: p.slug, lang: p.lang });
      }
    } catch {
      showError(p);
    }
  }

  function pause(p: Player): void {
    p.audio.pause();
    setPlayingState(p, false);
  }

  /**
   * Il service worker viene registrato dalla pagina di accesso stessa, quindi
   * alla PRIMA apertura del link la pagina non e' ancora controllata: install →
   * activate → clients.claim() arrivano dopo. E la prima apertura e' il caso
   * normale per un link di accesso. Aspettiamo che il controllo arrivi invece
   * di rinunciare.
   */
  function waitForController(timeoutMs = 10000): Promise<ServiceWorker | null> {
    if (!('serviceWorker' in navigator)) return Promise.resolve(null);
    if (navigator.serviceWorker.controller) {
      return Promise.resolve(navigator.serviceWorker.controller);
    }
    return new Promise((resolve) => {
      let done = false;
      const finish = (value: ServiceWorker | null) => {
        if (done) return;
        done = true;
        clearTimeout(timer);
        navigator.serviceWorker.removeEventListener('controllerchange', onChange);
        resolve(value);
      };
      const onChange = () => finish(navigator.serviceWorker.controller);
      const timer = setTimeout(() => finish(null), timeoutMs);
      navigator.serviceWorker.addEventListener('controllerchange', onChange);
      // ready si risolve quando esiste un SW attivo; il claim puo' arrivare
      // subito prima e non far scattare controllerchange, quindi ricontrolliamo.
      navigator.serviceWorker.ready
        .then(() => {
          if (navigator.serviceWorker.controller) finish(navigator.serviceWorker.controller);
        })
        .catch(() => finish(null));
    });
  }

  async function saveOffline(p: Player): Promise<void> {
    // Prima si dava feedback zero: senza controller la funzione usciva in
    // silenzio e il pulsante sembrava rotto.
    setOfflineState(p, 'downloading');
    p.offlinePctLabel.textContent = `${p.el.dataset.labelDownloading} …`;
    p.offlineFill.style.width = '0%';

    const controller = await waitForController();
    if (!controller) {
      setOfflineState(p, 'interrupted');
      return;
    }

    // Need the signed URL — fetch it if not yet available
    if (!p.audioUrl) {
      setOfflineState(p, 'downloading');
      p.offlinePctLabel.textContent = `${p.el.dataset.labelDownloading} …`;
      try {
        p.audioUrl = await fetchAudioUrl(p.slug, p.token, p.lang);
        p.audio.src = p.audioUrl;
      } catch {
        setOfflineState(p, 'interrupted');
        return;
      }
    }

    setOfflineState(p, 'downloading');
    p.offlinePctLabel.textContent = `${p.el.dataset.labelDownloading} 0%`;
    p.offlineFill.style.width = '0%';

    controller.postMessage({
      type: 'SAVE_OFFLINE',
      url: p.audioUrl,
      slug: p.slug,
      lang: p.lang,
      // These assets may have loaded before the service worker took control.
      assets: Array.from(document.querySelectorAll<HTMLScriptElement | HTMLLinkElement>(
        'script[src], link[rel="stylesheet"][href]',
      )).map((el) => el instanceof HTMLScriptElement ? el.src : el.href),
    });
  }

  function initPlayer(el: HTMLElement): void {
    const p: Player = {
      el,
      audio: el.querySelector<HTMLAudioElement>('.ap-audio')!,
      toggle: el.querySelector<HTMLButtonElement>('.ap-toggle')!,
      iconPlay: el.querySelector<SVGElement>('.ap-icon-play')!,
      iconPause: el.querySelector<SVGElement>('.ap-icon-pause')!,
      iconLoading: el.querySelector<SVGElement>('.ap-icon-loading')!,
      rewind: el.querySelector<HTMLButtonElement>('.ap-rewind')!,
      forward: el.querySelector<HTMLButtonElement>('.ap-forward')!,
      speed: el.querySelector<HTMLButtonElement>('.ap-speed')!,
      progress: el.querySelector<HTMLElement>('.ap-progress')!,
      fill: el.querySelector<HTMLElement>('.ap-fill')!,
      cur: el.querySelector<HTMLElement>('.ap-current')!,
      dur: el.querySelector<HTMLElement>('.ap-duration')!,
      chapters: el.querySelectorAll<HTMLButtonElement>('.ap-chapter'),
      error: el.querySelector<HTMLElement>('.ap-error')!,
      retry: el.querySelector<HTMLButtonElement>('.ap-retry')!,
      offlineBtn: el.querySelector<HTMLButtonElement>('.ap-offline-btn')!,
      offlineLabel: el.querySelector<HTMLElement>('.ap-offline-label')!,
      offlineDownloading: el.querySelector<HTMLElement>('.ap-offline-downloading')!,
      offlinePctLabel: el.querySelector<HTMLElement>('.ap-offline-pct-label')!,
      offlineFill: el.querySelector<HTMLElement>('.ap-offline-fill')!,
      offlineDone: el.querySelector<HTMLElement>('.ap-offline-done')!,
      offlineInterrupted: el.querySelector<HTMLButtonElement>('.ap-offline-interrupted')!,
      slug: el.dataset.guideSlug!,
      token: el.dataset.token!,
      lang: (el.dataset.lang === 'en' ? 'en' : el.dataset.lang === 'de' ? 'de' : 'it') as 'it' | 'en' | 'de',
      title: el.dataset.guideTitle || el.dataset.guideSlug || 'Localis',
      subtitle: el.dataset.guideSubtitle || 'Localis',
      cover: el.dataset.guideCover || '/og-default.jpg',
      offlineState: 'idle',
    };

    players.push(p);

    // Check offline status on load
    if (navigator.serviceWorker?.controller) {
      navigator.serviceWorker.controller.postMessage({
        type: 'GET_OFFLINE_STATUS',
        slug: p.slug,
        lang: p.lang,
      });
    }

    p.audio.addEventListener('loadedmetadata', () => {
      p.dur.textContent = fmtTime(p.audio.duration);
      updateMediaSessionPosition(p);
    });

    p.audio.addEventListener('timeupdate', () => {
      if (!p.audio.duration) return;
      const pct = (p.audio.currentTime / p.audio.duration) * 100;
      p.fill.style.width = `${pct}%`;
      p.cur.textContent = fmtTime(p.audio.currentTime);
      updateMediaSessionPosition(p);
      // Milestone di ascolto: dove la gente molla il racconto (il cuore del prodotto).
      const milestones = p.audioMilestones || (p.audioMilestones = new Set());
      for (const m of [25, 50, 75]) {
        if (pct >= m && !milestones.has(m)) {
          milestones.add(m);
          if (typeof window.localisTrack === 'function') {
            window.localisTrack(`guide_audio_${m}_percent`, { guide_slug: p.slug, lang: p.lang });
          }
        }
      }
    });

    p.audio.addEventListener('ended', () => {
      updateMediaSessionPosition(p);
      setPlayingState(p, false);
      if (!p.completeTracked) {
        p.completeTracked = true;
        if (typeof window.localisTrack === 'function') {
          window.localisTrack('guide_audio_complete', { guide_slug: p.slug, lang: p.lang });
        }
        if (typeof window.plausible === 'function') {
          window.plausible('Audio Played Full', { props: { guide: p.slug } });
        }
      }
    });

    p.audio.addEventListener('error', () => showError(p));

    p.toggle.addEventListener('click', () => {
      hideError(p);
      if (p.audio.paused) void play(p);
      else pause(p);
    });

    p.retry.addEventListener('click', () => {
      hideError(p);
      delete p.audioUrl;
      p.audio.removeAttribute('src');
      void play(p);
    });

    p.rewind.addEventListener('click', () => {
      p.audio.currentTime = Math.max(0, p.audio.currentTime - 15);
      updateMediaSessionPosition(p);
    });

    p.forward.addEventListener('click', () => {
      p.audio.currentTime = Math.min(p.audio.duration || 0, p.audio.currentTime + 15);
      updateMediaSessionPosition(p);
    });

    p.speed.addEventListener('click', () => {
      const cur = parseFloat(p.speed.dataset.speed || '1');
      const idx = SPEEDS.indexOf(cur);
      const next = SPEEDS[(idx + 1) % SPEEDS.length];
      p.audio.playbackRate = next;
      p.speed.dataset.speed = String(next);
      p.speed.textContent = `${next}×`;
    });

    p.progress.addEventListener('click', (e) => {
      if (!p.audio.duration) return;
      const r = p.progress.getBoundingClientRect();
      p.audio.currentTime = ((e.clientX - r.left) / r.width) * p.audio.duration;
      updateMediaSessionPosition(p);
    });

    p.progress.addEventListener('keydown', (e) => {
      if (!p.audio.duration) return;
      if (e.key === 'ArrowRight') {
        p.audio.currentTime = Math.min(p.audio.duration, p.audio.currentTime + 15);
        updateMediaSessionPosition(p);
        e.preventDefault();
      } else if (e.key === 'ArrowLeft') {
        p.audio.currentTime = Math.max(0, p.audio.currentTime - 15);
        updateMediaSessionPosition(p);
        e.preventDefault();
      }
    });

    p.chapters.forEach((ch) => {
      ch.addEventListener('click', () => {
        const time = parseFloat(ch.dataset.time || '0');
        if (!p.audio.src) {
          void play(p).then(() => {
            const onCanPlay = () => {
              p.audio.currentTime = time;
              p.audio.removeEventListener('canplay', onCanPlay);
            };
            p.audio.addEventListener('canplay', onCanPlay);
          });
        } else {
          p.audio.currentTime = time;
          updateMediaSessionPosition(p);
        }
      });
    });

    p.offlineBtn.addEventListener('click', () => void saveOffline(p));
    p.offlineInterrupted.addEventListener('click', () => void saveOffline(p));
  }

  document.querySelectorAll<HTMLElement>('.audio-player').forEach(initPlayer);
</script>
