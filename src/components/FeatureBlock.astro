---
export interface Props {
  eyebrow: string;
  heading: string;
  italicEnding?: string;
  body: string;
  bullets: string[];
  imageSrc: string;
  imageAlt: string;
  plateNumber?: string;
  caption?: string;
  ctaLabel: string;
  ctaHref: string;
  imageSide?: 'left' | 'right';
  /** Optional CSS aspect-ratio for the image on mobile. Default '4 / 5'. */
  mobileAspect?: string;
  /** Subtle tilt angle in degrees applied to the image plate. Default 0. */
  tiltDeg?: number;
  /** Optional second phone for the dual-stack layout (Komoot-style). */
  dualPhone?: {
    src: string;
    alt: string;
  };
  /** When true, apply heavier outline + larger border-radius to the image plate. */
  framedImage?: boolean;
}

const {
  eyebrow,
  heading,
  italicEnding,
  body,
  bullets,
  imageSrc,
  imageAlt,
  plateNumber,
  caption,
  ctaLabel,
  ctaHref,
  imageSide = 'right',
  mobileAspect = '4 / 5',
  tiltDeg = 0,
  dualPhone,
  framedImage = false,
} = Astro.props;

const sideClass = imageSide === 'right' ? 'feature-block-right' : 'feature-block-left';
---
<section
  class={`feature-block ${sideClass}`}
  style={`--mobile-aspect: ${mobileAspect}; --tilt-deg: ${tiltDeg}deg;`}
>
  <!-- Image column -->
  <figure class={`feature-image ${dualPhone ? 'is-dual' : ''}`}>
    {dualPhone ? (
      <div class="phone-stack">
        <img
          src={imageSrc}
          alt={imageAlt}
          class="phone phone-back"
          loading="lazy"
          decoding="async"
        />
        <img
          src={dualPhone.src}
          alt={dualPhone.alt}
          class="phone phone-front"
          loading="lazy"
          decoding="async"
        />
        {plateNumber && (
          <span class="feature-plate phone-plate" aria-hidden="true">
            {plateNumber}
          </span>
        )}
      </div>
    ) : (
      <div class={`feature-image-frame ${framedImage ? 'is-framed' : ''}`}>
        <img
          src={imageSrc}
          alt={imageAlt}
          class="feature-img"
          loading="lazy"
          decoding="async"
        />
        {plateNumber && (
          <span class="feature-plate" aria-hidden="true">
            {plateNumber}
          </span>
        )}
      </div>
    )}
    {caption && (
      <figcaption class="feature-caption">
        <span class="block w-11 h-px bg-border flex-shrink-0 mt-[10px]"></span>
        <span class="font-display italic text-[13px] leading-snug text-ink-muted max-w-[44ch]">
          {caption}
        </span>
      </figcaption>
    )}
  </figure>

  <!-- Text column — stays inside container -->
  <div class="feature-text">
    <div class="flex items-center gap-sm mb-md">
      <span class="block w-7 h-px bg-accent"></span>
      <span class="font-display italic text-[11px] font-semibold tracking-[0.26em] uppercase text-accent">
        {eyebrow}
      </span>
    </div>

    <h2 class="font-display text-ink leading-[1.05] tracking-[-0.014em] mb-md text-[clamp(1.9rem,4.4vw,3rem)]">
      <span class="font-light">{heading}</span>
      {italicEnding && (
        <span class="block font-body font-normal text-ink-muted mt-sm text-[clamp(1.15rem,2.4vw,1.55rem)] leading-relaxed tracking-normal">
          {italicEnding}
        </span>
      )}
    </h2>

    <p class="font-body text-base sm:text-lg leading-relaxed text-ink-muted max-w-[52ch] mb-lg">
      {body}
    </p>

    <ul class="bullets list-none p-0 m-0 mb-lg flex flex-col gap-sm max-w-[52ch]">
      {bullets.map((b) => (
        <li class="flex items-baseline gap-sm font-body text-base text-ink-muted leading-snug">
          <span class="font-display italic font-light text-accent text-base flex-shrink-0 select-none">✻</span>
          <span>{b}</span>
        </li>
      ))}
    </ul>

    <a
      href={ctaHref}
      class="inline-flex items-center justify-center gap-xs px-lg py-md rounded-md font-semibold text-sm border border-ink text-ink hover:bg-ink hover:text-surface transition-colors duration-fast no-underline min-h-[48px] self-start"
    >
      {ctaLabel}
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="5" y1="12" x2="19" y2="12"></line>
        <polyline points="12 5 19 12 12 19"></polyline>
      </svg>
    </a>
  </div>
</section>

<style>
  /* === Container math ===
   * 1280px == --container max width used across Localis (max-w-wrap).
   * Wider editorial spread for widescreen breathing room.
   * Side gutter on desktop = max(--spacing-lg, half of (vw - 1280) + lg)
   */
  .feature-block {
    --max-w: 1280px;
    --side-gutter: max(var(--spacing-lg), calc((100vw - var(--max-w)) / 2 + var(--spacing-lg)));

    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xl);
    padding-block: var(--spacing-2xl);
    padding-inline: var(--side-gutter);
    border-top: 1px solid var(--color-border);
  }

  /* === Mobile: image full-bleed top, text below in container ===  */
  .feature-image {
    margin: 0;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }
  .feature-image-frame {
    position: relative;
    width: 100%;
    aspect-ratio: var(--mobile-aspect);
    background: var(--color-surface-elev);
    overflow: hidden;
    border-radius: var(--radius-md);
    box-shadow: 0 1px 2px oklch(15% 0.012 240 / 0.08),
                0 12px 32px -12px oklch(15% 0.012 240 / 0.16);
  }

  /* Framed variant — accentuated rounded corners + visible border for storytelling shots */
  .feature-image-frame.is-framed {
    border-radius: clamp(1.5rem, 3vw, 2.25rem);
    border: 1px solid var(--color-border);
    padding: clamp(0.5rem, 1vw, 0.75rem);
    background: var(--color-surface);
    box-shadow: 0 2px 4px oklch(15% 0.012 240 / 0.06),
                0 18px 40px -16px oklch(15% 0.012 240 / 0.18);
  }
  .feature-image-frame.is-framed > .feature-img {
    border-radius: clamp(1rem, 2.4vw, 1.6rem);
  }

  /* === Dual-phone stack (Komoot-inspired). Two PNG cutouts of a single
   * phone, photographed in mirrored 3D perspective, layered diagonally
   * inside a square container. No frame, no rounded corners — the phones
   * float on the page and carry their own bezels. */
  .feature-image.is-dual {
    width: 100%;
  }
  .phone-stack {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
  }
  .phone {
    position: absolute;
    height: 88%;
    width: auto;
    filter: drop-shadow(0 12px 28px oklch(15% 0.012 240 / 0.22));
  }
  .phone-back {
    bottom: 0;
    left: 0;
    z-index: 1;
  }
  .phone-front {
    top: 0;
    right: 0;
    z-index: 2;
  }
  /* Plate sits in the bottom-right corner of the dual container */
  .phone-plate {
    bottom: var(--spacing-sm);
    right: var(--spacing-sm);
  }
  .feature-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: saturate(0.94) contrast(1.04);
  }

  /* Plate number — magazine convention, bottom corner with subtle scrim */
  .feature-plate {
    position: absolute;
    bottom: var(--spacing-md);
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--color-surface);
    background: oklch(15% 0.012 240 / 0.78);
    padding: 6px 12px;
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  .feature-caption {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-sm);
    color: var(--color-ink-subtle);
  }

  .feature-text {
    display: flex;
    flex-direction: column;
  }

  /* === Desktop (lg+): symmetric spread.
   * Equal columns (1fr / 1fr): text and photo carry the same visual weight.
   * No bleed — both stay inside the container.
   */
  @media (min-width: 1024px) {
    .feature-block {
      display: grid;
      /* Asymmetric editorial spread: text takes ≈58%, image ≈42%.
       * Magazine convention — running text is the protagonist, the photo is the plate.
       * Wider column-gap on widescreen lets the two columns breathe. */
      column-gap: clamp(var(--spacing-3xl), 6vw, 6rem);
      align-items: center;
      padding-block: clamp(var(--spacing-4xl), 9vw, 9rem);
    }

    .feature-block-right {
      grid-template-columns: 7fr 5fr;
    }
    .feature-block-left {
      grid-template-columns: 5fr 7fr;
    }

    .feature-block-right .feature-image {
      grid-column: 2;
      grid-row: 1;
      width: 100%;
    }
    .feature-block-right .feature-text {
      grid-column: 1;
      grid-row: 1;
    }

    .feature-block-left .feature-image {
      grid-column: 1;
      grid-row: 1;
      width: 100%;
    }
    .feature-block-left .feature-text {
      grid-column: 2;
      grid-row: 1;
    }

    .feature-image-frame {
      aspect-ratio: 4 / 5;
    }

    .feature-plate {
      bottom: var(--spacing-md);
      right: var(--spacing-md);
    }
  }

  /* On smaller screens, plate sits inside the bottom-outer corner of the image */
  @media (max-width: 1023.98px) {
    .feature-plate {
      right: var(--spacing-md);
    }
  }

  /* Reveal on first paint */
  .feature-image,
  .feature-text {
    opacity: 0;
    transform: translateY(14px);
    animation: featureIn 0.85s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }
  .feature-image {
    animation-delay: 0.05s;
  }
  .feature-text {
    animation-delay: 0.2s;
  }

  @keyframes featureIn {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .feature-image,
    .feature-text {
      animation: none;
      opacity: 1;
      transform: none;
    }
    .feature-img {
      transition: none;
    }
    .feature-block:hover .feature-img {
      transform: none;
    }
  }
</style>
