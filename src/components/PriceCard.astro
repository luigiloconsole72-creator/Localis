---
import { formatPrice } from '../lib/format';
import { PRODUCT_PRICE_CENTS } from '../lib/stripe-prices';
import { type Lang } from '../lib/i18n';

export interface Props {
  product: 'single' | 'tris' | 'sestina' | 'bari-completa' | 'valle-completa' | 'gargano-completa' | 'crociera';
  guideSlug?: string;
  lang: Lang;
  features: string[];
  primary?: boolean;
  titleOverride?: string;
  descriptionOverride?: string;
  ctaOverride?: string;
}

const {
  product,
  guideSlug,
  lang,
  features,
  primary = false,
  titleOverride,
  descriptionOverride,
  ctaOverride,
} = Astro.props;

const isCompleteArea =
  product === 'bari-completa' ||
  product === 'valle-completa' ||
  product === 'gargano-completa';

// Il listino sta in un posto solo: quello che il server usa per addebitare.
// Duplicarlo qui voleva dire poter mostrare un prezzo e incassarne un altro.
const priceCents = PRODUCT_PRICE_CENTS[product];

const priceLabel = formatPrice(priceCents, lang);

const title = titleOverride ?? (
  product === 'tris'
    ? (lang === 'it' ? 'Pack 3 Guide' : lang === 'de' ? 'Pack 3' : 'Pack 3 Guides')
    : product === 'sestina'
      ? (lang === 'it' ? 'Pack 6 Guide' : lang === 'de' ? 'Pack 6' : 'Pack 6 Guides')
    : isCompleteArea
      ? (lang === 'it' ? 'Pack 6 Guide (Intera Zona)' : lang === 'de' ? 'Pack 6 (Komplette Zone)' : 'Pack 6 Guides (Complete Area)')
      : product === 'crociera'
        ? (lang === 'it' ? 'Pacchetto Crociera' : lang === 'de' ? 'Kreuzfahrt-Paket' : 'Cruise Package')
        : (lang === 'it' ? 'Guida singola' : lang === 'de' ? 'Einzelner Guide' : 'Single guide')
);

const description = descriptionOverride ?? (
  product === 'tris'
    ? (lang === 'it'
        ? '3 guide a tua scelta tra tutte le zone.'
        : lang === 'de'
          ? '3 Guides deiner Wahl aus allen Zonen.'
          : '3 guides of your choice across all zones.')
    : product === 'sestina'
      ? (lang === 'it'
          ? '6 guide a tua scelta tra tutte le zone.'
          : lang === 'de'
            ? '6 Guides deiner Wahl aus allen Zonen.'
            : '6 guides of your choice across all zones.')
    : product === 'bari-completa'
      ? (lang === 'it'
          ? 'Tutte le 6 guide di Bari. Sei racconti, sei itinerari.'
          : lang === 'de'
            ? 'Alle 6 Audioerzählungen aus Bari. Sechs Erzählungen, sechs Perspektiven.'
            : 'All 6 Bari guides. Six stories, six routes.')
      : product === 'valle-completa'
        ? (lang === 'it'
            ? "Tutte le 6 guide della Valle d'Itria. Sei racconti, sei luoghi."
            : lang === 'de'
              ? "Alle 6 Audioerzählungen aus dem Valle d'Itria. Sechs Erzählungen, sechs Orte."
              : "All 6 Valle d'Itria guides. Six stories, six places.")
        : product === 'gargano-completa'
          ? (lang === 'it'
              ? 'Tutte le 6 guide del Gargano. Sei racconti, sei paesaggi.'
              : lang === 'de'
                ? 'Alle 6 Audioerzählungen aus dem Gargano. Sechs Erzählungen, sechs Landschaften.'
                : 'All 6 Gargano guides. Six stories, six landscapes.')
      : product === 'crociera'
        ? (lang === 'it'
            ? 'Bari Vecchia + Il Meglio di Bari. Per chi ha 3 ore.'
            : lang === 'de'
              ? 'Bari Vecchia + Best of Bari. Für einen kurzen Landgang.'
              : 'Bari Vecchia + Best of Bari. For a 3-hour port stop.')
        : (lang === 'it'
            ? 'Una guida a scelta, tua per sempre.'
            : lang === 'de'
              ? 'Ein Guide deiner Wahl, dauerhaft nutzbar.'
              : 'One guide of your choice, yours forever.')
);

const unitLabel =
  isCompleteArea
    ? (lang === 'it' ? '/ 6 guide' : lang === 'de' ? '/ 6 Guides' : '/ 6 guides')
    : product === 'sestina'
      ? (lang === 'it' ? '/ 6 guide' : lang === 'de' ? '/ 6 Guides' : '/ 6 guides')
    : product === 'tris'
      ? (lang === 'it' ? '/ 3 guide' : lang === 'de' ? '/ 3 Guides' : '/ 3 guides')
      : product === 'crociera'
        ? (lang === 'it' ? '/ 2 guide' : lang === 'de' ? '/ 2 Guides' : '/ 2 guides')
        : (lang === 'it' ? '/ guida' : lang === 'de' ? '/ Guide' : '/ guide');

const defaultCtaLabel = ctaOverride ?? (
  product === 'tris'
    ? (lang === 'it' ? 'Scegli Pack 3' : lang === 'de' ? 'Pack 3 wählen' : 'Choose Pack 3')
    : isCompleteArea
      ? (lang === 'it' ? 'Acquista Pack 6 Guide' : lang === 'de' ? 'Pack 6 kaufen' : 'Get Pack 6 Guides')
      : product === 'crociera'
        ? (lang === 'it' ? 'Acquista Pacchetto Crociera' : lang === 'de' ? 'Kreuzfahrt-Paket kaufen' : 'Get Cruise Package')
        : (lang === 'it' ? 'Acquista guida singola' : lang === 'de' ? 'Guide kaufen' : 'Buy single guide')
);

const ctaLabel = ctaOverride ?? (
  product === 'sestina'
    ? (lang === 'it' ? 'Scegli Pack 6' : lang === 'de' ? 'Pack 6 wählen' : 'Choose Pack 6')
    : defaultCtaLabel
);

const builderHref = lang === 'en' ? '/en/guide#builder' : lang === 'de' ? '/de/guide#builder' : '/guide#builder';
const isBuilderProduct = product === 'tris' || product === 'sestina';

const trustLine =
  lang === 'it'
    ? 'Download immediato, ascolto offline · Soddisfatto o rimborsato'
    : lang === 'de'
      ? 'Sofort-Download, offline hörbar · Geld-zurück-Garantie'
      : 'Instant download, listen offline · Money-back guarantee';
---
<article class={`flex flex-col gap-md p-lg border rounded-lg ${primary ? 'border-accent bg-surface-elev' : 'border-border bg-surface'}`}>
  <header>
    {primary && (
      <p class="text-xs font-semibold tracking-[0.22em] uppercase text-accent mb-xs">
        {lang === 'it' ? 'COLLEZIONE COMPLETA' : lang === 'de' ? 'KOMPLETTE SAMMLUNG' : 'COMPLETE COLLECTION'}
      </p>
    )}
    <h3 class="font-display text-2xl text-ink leading-tight">{title}</h3>
    <p class="text-sm text-ink-muted mt-xs">{description}</p>
  </header>

  <div class="flex items-baseline gap-xs">
    <span class="font-display text-4xl text-ink">{priceLabel}</span>
    <span class="text-sm text-ink-muted">{unitLabel}</span>
  </div>

  <ul class="flex flex-col gap-xs">
    {features.map((f) => (
      <li class="text-sm text-ink-muted flex items-start gap-sm">
        <span class="text-accent flex-shrink-0 mt-1">✦</span>
        <span>{f}</span>
      </li>
    ))}
  </ul>

  {isBuilderProduct ? (
    <a
      href={builderHref}
      class={`mt-auto w-full px-md py-sm rounded-md font-semibold text-sm text-center transition-colors duration-fast no-underline inline-block ${primary ? 'bg-ink text-surface hover:bg-ink/90' : 'border border-ink text-ink hover:bg-ink hover:text-surface'}`}
    >
      {ctaLabel} · {priceLabel}
    </a>
  ) : (
    <button
      type="button"
      class={`checkout-btn mt-auto w-full px-md py-sm rounded-md font-semibold text-sm text-center transition-colors duration-fast ${primary ? 'bg-ink text-surface hover:bg-ink/90' : 'border border-ink text-ink hover:bg-ink hover:text-surface'}`}
      data-product={product}
      data-guide-slug={guideSlug ?? ''}
      data-lang={lang}
    >
      {ctaLabel} · {priceLabel}
    </button>
  )}

  <p class="text-xs text-ink-muted text-center m-0">✓ {trustLine}</p>
</article>

<script>
  import { submitCheckoutRedirect } from '../lib/checkout-client';

  document.querySelectorAll<HTMLButtonElement>('.checkout-btn').forEach((btn) => {
    btn.addEventListener('click', async (e) => {
      e.preventDefault();
      const product = btn.dataset.product;
      const guideSlug = btn.dataset.guideSlug || undefined;
      const lang = btn.dataset.lang || 'it';

      if (!product) return;
      if (product === 'single' && !guideSlug) {
        console.error('[checkout] single product requires guideSlug');
        return;
      }

      btn.disabled = true;
      const originalText = btn.textContent;
      btn.textContent = lang === 'it' ? 'Apertura pagamento...' : lang === 'de' ? 'Checkout wird geöffnet...' : 'Opening checkout...';

      const BARI_SLUGS = ['bari-vecchia', 'san-nicola', 'tre-teatri', 'bari-tavola', 'porto-bari', 'bari-sotterranea'];
      const VALLE_SLUGS = ['alberobello', 'locorotondo', 'martina-franca', 'cisternino', 'ostuni', 'fasano'];
      const GARGANO_SLUGS = ['gargano-vieste', 'gargano-tremiti', 'gargano-nord', 'gargano-paesi', 'gargano-sacro', 'gargano-saline'];
      const CROCIERA_SLUGS = ['bari-vecchia', 'bari-tavola'];
      const PRODUCT_PRICE_CENTS: Record<string, number> = {
        single: 499,
        tris: 1199,
        'bari-completa': 1999,
        'valle-completa': 1999,
        'gargano-completa': 1999,
        crociera: 799,
      };

      const bodyPayload: Record<string, unknown> = { product, lang };
      if (product === 'single') {
        bodyPayload.guideSlug = guideSlug || undefined;
        bodyPayload.selectedSlugs = guideSlug ? [guideSlug] : [];
      } else if (product === 'bari-completa') {
        bodyPayload.selectedSlugs = BARI_SLUGS;
      } else if (product === 'valle-completa') {
        bodyPayload.selectedSlugs = VALLE_SLUGS;
      } else if (product === 'gargano-completa') {
        bodyPayload.selectedSlugs = GARGANO_SLUGS;
      } else if (product === 'crociera') {
        bodyPayload.selectedSlugs = CROCIERA_SLUGS;
      }

      try {
        if (typeof window.localisTrack === 'function') {
          const selectedSlugs = Array.isArray(bodyPayload.selectedSlugs) ? bodyPayload.selectedSlugs as string[] : [];
          const value = (PRODUCT_PRICE_CENTS[product] || 0) / 100;
          const params = {
            product,
            guide: guideSlug ?? product,
            guide_slugs: selectedSlugs.join(','),
            guide_count: selectedSlugs.length || (guideSlug ? 1 : 0),
            lang,
            value,
            currency: 'EUR',
            cta_source: 'price_card',
          };
          window.localisTrack('begin_checkout', params);
        } else if (typeof window.plausible === 'function') {
          window.plausible('Checkout Started', { props: { product, guideSlug: guideSlug ?? product, lang } });
        }
        submitCheckoutRedirect(bodyPayload as import('../lib/checkout-client').CheckoutRedirectPayload);
      } catch (err) {
        console.error('[checkout]', err);
        btn.disabled = false;
        btn.textContent = originalText;
        alert(
          lang === 'it'
            ? 'Impossibile aprire il pagamento. Riprova tra un istante.'
            : lang === 'de'
              ? 'Checkout konnte nicht geöffnet werden. Bitte versuche es gleich erneut.'
              : 'Could not open checkout. Please try again in a moment.',
        );
      }
    });
  });
</script>
