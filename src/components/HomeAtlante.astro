      },
    ],
    passiOcchiello: "Three minutes in, you're there", passiH: 'Three steps.', passiItalic: 'A land that speaks, whenever you want.',
    passi: [
      { title: 'Choose a destination', body: "Bari, Valle d'Itria, Gargano — every zone has its own guide." },
      { title: 'Open the link', body: 'No app. Buy, get a link, press play.' },
      { title: 'Listen', body: "The stories begin when you're ready to understand. In your room, on a train, on a bench — the moment is yours." },
    ],
    passiCta: 'Start now', passiHref: '/en/guide/bari-vecchia',
  },
  de: {
    occhiello: 'Audioerzählungen über Orte',
    h1a: 'Apulien, erzählt',
    h1b: 'von Menschen, die hier leben.',
    lede: 'Dokumentierte Audioerzählungen, um Bari und Apulien während des Besuchs wirklich zu verstehen. Keine App.',
    cta: 'Erzählungen entdecken', ctaHref: '/de/guide',
    trailer: '/audio/trailers/home-trailer-de.mp3',
    heroAlt: 'Eine junge Frau mit Kopfhörern auf einem Weg zwischen Trockenmauern und Olivenbäumen, zu einer weißen Masseria im Abendlicht',
    numeri: [
      { value: '~30 Min.', label: 'pro Erzählung' },
      { value: 'Keine App', label: 'nichts zu installieren' },
      { value: '4,99 €', label: 'eine Erzählung' },
    ],
    claim: 'Sie sagen dir nicht, wohin du gehen sollst. Sie helfen dir zu verstehen, wo du bist.',
    intro: 'Localis ist eine Audio-Erzählung über den Ort: Geschichte, Kontext und ein erklärter Blickwinkel, damit du verstehst, wie dieser Ort zu dem wurde, was er heute ist. Keine App: Du bekommst einen Link, drückst Play und hörst, wann du willst — vor Ort, von zu Hause vor der Reise oder danach.',
    manifesto: ['Orte verbraucht man nicht.', 'Man versteht sie.'],
    cambiaOcchiello: 'Was sich wirklich ändert',
    cambiaH: ['Wir fügen keine Informationen hinzu.', 'Wir verändern, was du siehst.'],
    cambia: [
      ['Eine Frau, die Orecchiette macht.', 'Jemand, der eine über Generationen weitergegebene Geste fortführt.'],
      ['Eine weiß gekalkte Mauer.', 'Jahrhundertelanger Schutz vor Sonne und Seuchen.'],
      ['Ein Heiliger, in Prozession getragen.', 'Eine Stadt, die sich bis heute in ihm wiedererkennt.'],
    ],
    zoneOcchiello: 'Die Reiseziele',
    zoneH: 'Wähle deine Region.',
    zoneSub: "Bari, Valle d'Itria, Gargano und Matera: Audiogeschichten zum Hören vor Ort, vor der Abreise oder nach der Rückkehr.",
    zone: [
      { href: '/de/bari', name: 'Bari', tagline: 'Sechs Erzählungen, um die Stadt zu verstehen.', guides: '6 Erzählungen', cover: '/images/covers/bari-landing-v2.jpg', alt: 'Gasse in der Altstadt von Bari mit antiken römischen Säulen' },
      { href: '/de/valle-d-itria', name: "Valle d'Itria", tagline: 'Trulli, Wein und weiße Dörfer.', guides: '6 Erzählungen', cover: '/images/covers/valle-d-itria-landing.jpg', alt: "Valle d'Itria mit Trulli und Weinbergen unter der Sonne Apuliens" },
      { href: '/de/gargano', name: 'Gargano', tagline: 'Das Vorgebirge mit Blick auf die Welt.', guides: '6 Erzählungen', cover: '/images/covers/gargano-landing.jpg', alt: 'Gargano-Vorgebirge über der Adria' },
      { href: '/de/matera', name: 'Matera', tagline: 'Die Sassi, die Gravina und Rosas Erzählung.', guides: '1 Erzählung', cover: '/images/covers/matera-golden-hour-jun26.webp', alt: 'Matera, die Sassi von oben' },
    ],
    prezziId: 'preise',
    prezziH: 'Eine Erzählung, ein Pack oder ganz Apulien.',
    prezzi: [['Einzelner Guide', '4,99 €'], ['Pack 3', '11,99 €'], ['Pack 6', '19,99 €']],
    prezziNota: 'je ~30 Min. · Pack 6 funktioniert auch mit Guides aus verschiedenen Gebieten.',
    prezziCta: 'Paket zusammenstellen', prezziHref: '/de/guide#builder',
    rimborso: 'Einfache Rückerstattung — schreib an hello@localis.guide, Geld zurück ohne Fragen.',
    feature: [
      {
        occhiello: 'Nur wenige Stunden?', h: 'Nur wenige Stunden in Bari?',
        italic: 'Hör zwei ausgewählte Erzählungen und versteh die Stadt — ohne Zeit zu verlieren.',
        body: 'Du kaufst mit E-Mail und Karte. Danach bekommst du einen dauerhaften Link: öffnen, Play drücken, hören. Auf der Straße beim Gehen, auf dem Sofa vor der Reise oder im Zug zurück. Das sind Erzählungen, keine Museums-Audios, die nur beschreiben, was vor dir steht — sie bringen dich nach Bari hinein, auch wenn du noch nicht dort bist.',
        bullets: ['Freies Hören · vor Ort, vorher, danach, überall', 'Magic Link per E-Mail · kein Passwort, kein Konto', 'Dauerhafter Link · die Guide gehört dir, immer wieder hörbar'],
        img: '/images/covers/nave-crociera.jpg',
        alt: 'Kreuzfahrtgäste gehen in Bari vor der MSC Splendida von Bord; im Hintergrund Hafenpromenade und helles Sonnenlicht',
        caption: 'Bari, Kreuzfahrthafen. Auch mit wenigen Stunden an Land kann die Erzählung beginnen, bevor man die Stadt wirklich durchquert.',
        cta: 'Route für Kreuzfahrtgäste entdecken', href: '/de/kreuzfahrt',
      },
      {
        occhiello: 'Woher die Geschichten kommen', h: 'In Apulien geschrieben.', italic: 'Mit überprüfbaren Quellen.',
        body: 'Jede Guide entsteht aus redaktioneller Recherche: historische Quellen, institutionelle Quellen und, wenn vorhanden, lokale Erinnerung, die vor Ort gesammelt wurde. Auf der Seite Quellen veröffentlichen wir die Referenzen, aus denen die Erzählungen gebaut sind.',
        bullets: ['Von Menschen geschrieben, die hier leben · Recherche und lokale Erinnerung', "Veröffentlichte Guides · Bari, Valle d'Itria, Gargano", 'Italienisch, Englisch und Deutsch · Texte sprachgenau ausgearbeitet', 'Nachprüfbar · jede belegte Aussage auf /de/fonti, Kapitel für Kapitel'],
        img: '/images/covers/fonti-ricerca.jpg',
        alt: 'Recherche-Schreibtisch: Bücher zur Geschichte Baris, offenes Notizbuch, historische Postkarten, Karte und Zeitungsausschnitt über die Reliquien des heiligen Nikolaus',
        caption: 'Der Schreibtisch vor der Stimme. Bücher, Notizen, Postkarten, Ausschnitte — jedes Kapitel beginnt hier.',
        cta: 'Unsere Methode', href: '/de/methode',
      },
    ],
    passiOcchiello: 'In wenigen Minuten bereit', passiH: 'Drei Schritte.', passiItalic: 'Ein Land, das spricht. Dann, wenn du hören willst.',
    passi: [
      { title: 'Ort wählen', body: "Bari, Valle d'Itria, Gargano: Jede Gegend hat ihre eigene Audioerzählung." },
      { title: 'Link öffnen', body: 'Keine App. Du kaufst, bekommst einen Link und drückst auf Play.' },
      { title: 'Anhören', body: 'Die Geschichten beginnen, wenn du bereit bist zu verstehen. Im Zimmer, im Zug, auf einer Bank — der Moment gehört dir.' },
    ],
    passiCta: 'Jetzt starten', passiHref: '/de/guide/bari-vecchia',
  },
} as const;

const t = T[lang];
// Le masserie sono solo in italiano: la banda compare solo nella home italiana.
const masserie = lang === 'it' ? await getCollection('masserie', (m) => m.data.status === 'published') : [];
const due = (n: number) => String(n).padStart(2, '0');
---
<!-- Apertura -->
<section class="h-apertura">
  <img src="/images/hero/landing-puglia.jpg" alt={t.heroAlt} class="h-apertura-foto" width="1980" height="1485" fetchpriority="high" />
  <div class="h-velo" aria-hidden="true"></div>
  <div class="h-apertura-testo">
    <div class="h-pills"><LangPills lang={lang} currentPath={currentPath} /></div>
    <p class="h-occhiello">{t.occhiello}</p>
    <h1><span>{t.h1a}</span> <em>{t.h1b}</em></h1>
    <p class="h-lede">{t.lede}</p>
    <div class="h-audio"><HeroAudioSample lang={lang} src={t.trailer} /></div>
    <div class="h-azioni">
      <a href={t.ctaHref} class="h-pill">{t.cta}</a>
      {lang === 'it' && <a href="/masserie/" class="h-link-chiaro">Le masserie di Puglia, raccontate →</a>}
    </div>
    <ul class="h-numeri">
      {t.numeri.map((n) => <li><strong>{n.value}</strong> {n.label}</li>)}
    </ul>
  </div>
</section>

<!-- Manifesto -->
<section class="h-manifesto">
  <div class="h-manifesto-dentro">
    <blockquote>{t.manifesto[0]}<br /><em>{t.manifesto[1]}</em></blockquote>
    <div class="h-manifesto-testo">
      <p class="h-claim">{t.claim}</p>
      <p>{t.intro}</p>
    </div>
  </div>
</section>

<!-- Cosa cambia davvero -->
<section class="h-sezione h-stretto">
  <p class="h-occhiello h-scuro">{t.cambiaOcchiello}</p>
  <h2 class="h-titolo">{t.cambiaH[0]}<br /><em>{t.cambiaH[1]}</em></h2>
  <ol class="h-tavola">
    {t.cambia.map(([prima, dopo], i) => (
      <li>
        <span class="h-tavola-num">{['I', 'II', 'III'][i]}</span>
        <span class="h-tavola-prima">{prima}</span>
        <span class="h-tavola-freccia" aria-hidden="true">→</span>
        <span class="h-tavola-dopo">{dopo}</span>
      </li>
    ))}
  </ol>
</section>

<!-- Le zone -->
<section class="h-sezione h-largo" id="zone">
  <div class="h-testa">
    <div>
      <p class="h-occhiello h-scuro">{t.zoneOcchiello}</p>
      <h2 class="h-titolo">{t.zoneH}</h2>
    </div>
    <p class="h-testa-sub">{t.zoneSub}</p>
  </div>
  <div class="h-zone">
    {t.zone.map((z, i) => (
      <a href={z.href} class:list={['h-zona', { 'h-zona-grande': i === 0 }]} style={`--ritardo:${i * 90}ms`}>
        <img src={z.cover} alt={z.alt} loading="lazy" decoding="async" />
        <span class="h-zona-num">{due(i + 1)}</span>
        <span class="h-zona-testo">
          <span class="h-zona-nome">{z.name}</span>
          <span class="h-zona-tag">{z.tagline}</span>
          <span class="h-zona-guide">{z.guides} →</span>
        </span>
      </a>
    ))}
  </div>
</section>

{masserie.length > 0 && (
  <!-- Le masserie (solo IT) -->
  <section class="h-sezione h-largo">
    <a href="/masserie/" class="h-masserie">
      <span class="h-masserie-testo">
        <span class="h-occhiello">Nuovo · gratis</span>
        <span class="h-masserie-h">Le masserie di Puglia, <em>raccontate.</em></span>
        <span class="h-masserie-sub">{masserie.length} masserie della Valle d'Itria, una per una: perché sono fatte così, chi ci ha vissuto, cosa notare quando ci sei. Da tre a quindici minuti, con le fonti.</span>
        <span class="h-pill h-pill-chiara">Apri l'atlante →</span>
      </span>
      <span class="h-masserie-nomi" aria-hidden="true">
        {masserie.slice(0, 6).map((m) => <span>{m.data.name.replace(/^Masseria (Fortificata )?/, '')}</span>)}
      </span>
    </a>
  </section>
)}

<!-- Prezzi -->
<section class="h-sezione h-stretto" id={t.prezziId}>
  <div class="h-prezzi">
    <h2 class="h-titolo h-centro">{t.prezziH}</h2>
    <ul class="h-cartellini">
      {t.prezzi.map(([nome, prezzo]) => <li><span>{nome}</span><strong>{prezzo}</strong></li>)}
    </ul>
    <p class="h-nota">{t.prezziNota}</p>
    <a href={t.prezziHref} class="h-pill">{t.prezziCta} →</a>
    <p class="h-nota h-piccola">{t.rimborso}</p>
  </div>
</section>

<!-- Crocieristi e fonti -->
{t.feature.map((f, i) => (
  <section class:list={['h-sezione', 'h-largo', 'h-feature', { 'h-feature-rovescio': i % 2 === 1 }]}>
    <figure class="h-feature-foto">
      <img src={f.img} alt={f.alt} loading="lazy" decoding="async" />
      <figcaption>{f.caption}</figcaption>
    </figure>
    <div class="h-feature-testo">
      <p class="h-occhiello h-scuro">{f.occhiello}</p>
      <h2 class="h-titolo">{f.h} <em>{f.italic}</em></h2>
      <p class="h-feature-body">{f.body}</p>
      <ul class="h-elenco">{f.bullets.map((b) => <li>{b}</li>)}</ul>
      <a href={f.href} class="h-link">{f.cta} →</a>
    </div>
  </section>
))}

<!-- Tre passi -->
<section class="h-sezione h-largo" id="come-funziona">
  <p class="h-occhiello h-scuro h-centro">{t.passiOcchiello}</p>
  <h2 class="h-titolo h-centro">{t.passiH} <em>{t.passiItalic}</em></h2>
  <ol class="h-passi">
    {t.passi.map((p, i) => (
      <li>
        <span class="h-passi-num">{due(i + 1)}</span>
        <span class="h-passi-titolo">{p.title}</span>
        <span class="h-passi-body">{p.body}</span>
      </li>
    ))}
  </ol>
  <p class="h-centro"><a href={t.passiHref} class="h-pill">▶ {t.passiCta}</a></p>
</section>

