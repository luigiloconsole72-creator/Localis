    prezzi: [['Guida singola', '€4,99'], ['Pack 3', '€11,99'], ['Pack 6', '€19,99']],
    prezziNota: '~30 min ciascuna · Pack 6 Guide funziona anche mescolando guide di zone diverse.',
    prezziCta: 'Costruisci il tuo pacchetto', prezziHref: '/guide#builder',
    rimborso: 'Rimborso semplice — scrivi a hello@localis.guide, soldi indietro senza domande.',
    feature: [
      {
        occhiello: 'Hai poche ore?', h: 'Poche ore a Bari?',
        italic: 'Ascolta due racconti selezionati per capire la città senza perdere tempo.',
        body: 'Acquisti con email e carta. Ti arriva un link permanente: lo apri quando vuoi, premi play, ascolti. In strada mentre cammini, sul divano prima di partire, in treno al ritorno. Sono racconti, non audio museali che descrivono ciò che hai davanti — ti portano dentro Bari, anche se non ci sei ancora.',
        bullets: ['Ascolto libero · sul posto, prima, dopo, ovunque', 'Magic link via email · zero password, zero account', 'Link permanente · la guida è tua, riascolti per sempre'],
        img: '/images/covers/nave-crociera.jpg',
        alt: 'Gruppo di crocieristi sbarca a Bari davanti alla nave MSC Splendida; lungomare del porto sullo sfondo, sole pieno',
        caption: 'Bari, porto crociere. Anche con poche ore a terra, è un modo per capire il luogo prima ancora di attraversarlo.',
        cta: 'Scopri il percorso per crocieristi', href: '/crocieristi',
      },
      {
        occhiello: 'Da dove vengono le storie', h: 'Scritte in Puglia.', italic: 'Con fonti verificabili.',
        body: 'Ogni guida nasce da ricerca editoriale: fonti storiche, fonti istituzionali e, quando presente, memoria locale raccolta sul territorio. Nella pagina Fonti pubblichiamo i riferimenti utilizzati per costruire i racconti.',
        bullets: ['Scritte da chi la Puglia la vive · ricerca e memoria locale', 'Guide pubblicate · Bari, Valle d’Itria, Gargano', 'Italiano, inglese e tedesco · testi curati lingua per lingua', 'Tutto verificabile · ogni claim su /fonti, capitolo per capitolo'],
        img: '/images/covers/fonti-ricerca.jpg',
        alt: 'Scrivania di ricerca: libri di storia barese, taccuino aperto con appunti su Bari Vecchia, cartoline d’epoca della città, mappa storica e quotidiano ‘L’Eco di Bari’ sulle reliquie di San Nicola',
        caption: 'La scrivania prima della voce. Libri, appunti, cartoline, ritagli — ogni capitolo nasce da qui.',
        cta: 'Il nostro metodo', href: '/metodo',
      },
    ],
    passiOcchiello: 'In tre minuti, sei dentro', passiH: 'Tre passi.', passiItalic: 'Una terra che parla, quando vuoi tu.',
    passi: [
      { title: 'Scegli la destinazione', body: "Bari, Valle d'Itria, Gargano — ogni zona ha la sua guida." },
      { title: 'Apri il link', body: 'Niente app. Compri, ti arriva un link, premi play.' },
      { title: 'Ascolta', body: 'Le storie partono quando sei pronto a capire. In camera, in treno, su una panchina — il momento è tuo.' },
    ],
    passiCta: 'Inizia ora', passiHref: '/guide/bari-vecchia',
  },
  en: {
    occhiello: 'Audio stories of places',
    h1a: 'Puglia, in the words',
    h1b: 'of the people who live here.',
    lede: 'Documented audio stories to understand Bari and Puglia as you visit. No app needed.',
    cta: 'Explore the stories', ctaHref: '/en/guide',
    trailer: '/audio/trailers/home-trailer-en.mp3',
    heroAlt: 'A young woman with headphones on a path between dry-stone walls and olive trees, towards a white masseria at sunset',
    numeri: [
      { value: '~30 min', label: 'per guide' },
      { value: 'No app', label: 'nothing to install' },
      { value: '€4.99', label: 'one guide' },
    ],
    claim: "They don't tell you where to go. They help you understand where you are.",
    intro: 'Localis is an audio story of the place: the history, the context, a point of view — so you understand how it became what it is. No app: you get a link, press play, listen whenever you want — on location, from home before you leave, or after.',
    manifesto: ["Places aren't consumed.", "They're understood."],
    cambiaOcchiello: 'What actually changes',
    cambiaH: ["We don't add information.", 'We change what you see.'],
    cambia: [
      ['A woman making orecchiette.', 'Someone continuing a gesture handed down for generations.'],
      ['A wall whitewashed with lime.', 'Centuries of defense against the sun and disease.'],
      ['A saint carried in procession.', 'A city that still recognizes itself in him.'],
    ],
    zoneOcchiello: 'The destinations',
    zoneH: 'Choose your area.',
    zoneSub: "Bari, Valle d'Itria, Gargano and Matera: audio stories to listen on the spot, before you leave or after you return.",
    zone: [
      { href: '/en/bari', name: 'Bari', tagline: 'Six stories to understand the city.', guides: '6 guides live', cover: '/images/covers/bari-landing-v2.jpg', alt: "Lane of Bari's Old Town with ancient Roman columns" },
      { href: '/en/valle-d-itria', name: "Valle d'Itria", tagline: 'Trullos, wines and white villages.', guides: '6 guides live', cover: '/images/covers/valle-d-itria-landing.jpg', alt: "Valle d'Itria, trulli and vineyards under the Puglia sun" },
      { href: '/en/gargano', name: 'Gargano', tagline: 'The promontory that faces the world.', guides: '6 guides live', cover: '/images/covers/gargano-landing.jpg', alt: 'Gargano promontory over the Adriatic sea' },
      { href: '/en/matera', name: 'Matera', tagline: "The Sassi, the Gravina and Rosa's story.", guides: '1 guide live', cover: '/images/covers/matera-golden-hour-jun26.webp', alt: 'Matera, the Sassi from above' },
    ],
    prezziId: 'prezzi',
    prezziH: 'One guide, a pack, or all of Puglia.',
    prezzi: [['Single guide', '€4.99'], ['Pack 3', '€11.99'], ['Pack 6', '€19.99']],
    prezziNota: '~30 min each · Pack 6 Guides also works when you mix guides from different areas.',
    prezziCta: 'Build your package', prezziHref: '/en/guide#builder',
    rimborso: 'Simple refund — write to hello@localis.guide, money back, no questions.',
    feature: [
      {
        occhiello: 'Only a few hours?', h: 'Only a few hours in Bari?',
        italic: 'Listen to two selected stories to understand the city without wasting time.',
        body: "You pay with email and card. You receive a permanent link: open it whenever you want, press play, listen. On the street while you walk, on the couch before you leave, on the train coming back. These are stories, not museum audio describing what's in front of you — they take you inside Bari, even if you're not there yet.",
        bullets: ['Free listening · on-site, before, after, anywhere', 'Magic link via email · zero passwords, zero accounts', 'Permanent link · the guide is yours, replay forever'],
        img: '/images/covers/nave-crociera.jpg',
        alt: 'Group of cruise passengers disembarking in Bari in front of the MSC Splendida; port lungomare in the background, full sunlight',
        caption: 'Bari, cruise port. For them the story starts the moment they step off the ship.',
        cta: 'Discover the cruise route', href: '/en/cruise',
      },
      {
        occhiello: 'Where the stories come from', h: 'Written in Puglia.', italic: 'With verifiable sources.',
        body: 'Every guide begins with editorial research: historical sources, institutional sources and, when present, local memory gathered on the ground. On the Sources page we publish the references used to build each story.',
        bullets: ['Written by people who live here · research and local memory', "Published guides · Bari, Valle d'Itria, Gargano", 'Italian, English and German · each text crafted in its own language', 'Fully verifiable · every claim on /en/fonti, chapter by chapter'],
        img: '/images/covers/fonti-ricerca.jpg',
        alt: "Research desk: Bari history books, open notebook with Old Bari notes, vintage postcards of the city, a historical map and the newspaper 'L'Eco di Bari' on San Nicola's relics",
        caption: 'The desk before the voice. Books, notes, postcards, clippings — every chapter starts here.',
