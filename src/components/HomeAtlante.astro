      { href: '/bari', name: 'Bari', tagline: 'Sei racconti per capire la città.', guides: '6 guide', cover: '/images/covers/bari-landing-v2.jpg', alt: 'Vicolo del Borgo Antico di Bari con colonne romane e palazzi storici' },
      { href: '/valle-d-itria', name: "Valle d'Itria", tagline: 'Trulli, vini e borghi bianchi.', guides: '6 guide', cover: '/images/covers/valle-d-itria-landing.jpg', alt: "Valle d'Itria, trulli e vigneti sotto il sole di Puglia" },
      { href: '/gargano', name: 'Gargano', tagline: 'Il promontorio che guarda il mondo.', guides: '6 guide', cover: '/images/covers/gargano-landing.jpg', alt: 'Gargano, promontorio sul mare Adriatico' },
      { href: '/matera', name: 'Matera', tagline: 'I Sassi, la Gravina e il racconto di Rosa.', guides: '1 guida', cover: '/images/covers/matera-golden-hour-jun26.webp', alt: "Matera, i Sassi visti dall'alto" },
    ],
    prezziId: 'prezzi',
