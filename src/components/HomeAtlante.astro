---
// La home di Localis nello stile dell'atlante delle masserie (18/10/2026).
// I testi sono quelli che c'erano, parola per parola, presi dalle tre home e da
// Hero / StatsBlock / DestinationsBlock / StepsBlock — che restano com'erano perché
// li usano anche le pagine di Bari, Gargano e Matera. Una modifica di testo della
// home si fa QUI, in tutte e tre le lingue.
import { getCollection } from 'astro:content';
import { type Lang } from '../lib/i18n';
import LangPills from './LangPills.astro';
import HeroAudioSample from './HeroAudioSample.astro';

export interface Props {
  lang: Lang;
  currentPath: string;
}
const { lang, currentPath } = Astro.props;

const T = {
  it: {
    occhiello: 'Racconti audio dei luoghi',
    h1a: 'La Puglia, raccontata',
    h1b: 'da chi ci vive.',
    lede: 'Racconti audio documentati per capire Bari e la Puglia mentre le visiti. Nessuna app.',
    cta: 'Scopri le guide', ctaHref: '/guide',
    trailer: '/audio/trailers/home-trailer-it.mp3',
    heroAlt: 'Una ragazza con le cuffie su un sentiero tra muretti a secco e ulivi, verso una masseria bianca al tramonto',
    numeri: [
      { value: '~30 min', label: 'per guida' },
      { value: 'Senza app', label: 'niente da installare' },
      { value: '€4,99', label: 'una guida' },
    ],
