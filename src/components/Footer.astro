---
import { t } from '../lib/i18n-strings';
import { localizedHref, type Lang } from '../lib/i18n';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const year = new Date().getFullYear();
---
<footer class="border-t border-border mt-3xl bg-surface-deep/45">
  <div class="max-w-wrap mx-auto px-md py-2xl md:py-3xl grid grid-cols-1 lg:grid-cols-[1fr_auto] gap-xl items-start">
    <div class="max-w-prose">
      <p class="font-display text-2xl text-ink mb-2xs">
        Loc<em class="text-accent not-italic">alis</em>
      </p>
      <p class="font-display italic text-lg text-accent mb-2xs leading-snug">
        {lang === 'it'
          ? 'Le guide spiegano. Noi raccontiamo.'
          : lang === 'de'
            ? 'Reiseführer erklären. Wir erzählen.'
            : 'Guides explain. We tell the story.'}
      </p>
      <p class="font-display italic text-base text-ink-muted mb-sm leading-snug">
        {lang === 'it'
          ? "Racconti audio documentati · Scritti in Puglia · Fonti consultabili"
          : lang === 'de'
            ? 'Dokumentierte Audio-Erzählungen · Geschrieben in Apulien · Einsehbare Quellen'
            : 'Documented audio stories · Written in Puglia · Consultable sources'}
      </p>
      <p class="text-sm text-ink-subtle">
        {t('footer.copyright', lang)} · {year}
      </p>
      <p class="text-sm text-ink-subtle mt-2xs">
        {lang === 'it'
          ? 'Della stessa famiglia di '
          : lang === 'de'
            ? 'Aus derselben Familie wie '
            : 'From the same family as '}
        <a href="https://cortese.app" rel="noopener" class="text-ink-muted hover:text-ink underline underline-offset-2">Cortése</a>
        {lang === 'it'
          ? ', il concierge digitale per masserie e dimore.'
          : lang === 'de'
            ? ', dem digitalen Concierge für Masserie und historische Häuser.'
            : ', the digital concierge for masserie and historic houses.'}
      </p>
    </div>

    <nav class="flex flex-wrap items-center gap-x-lg gap-y-sm lg:justify-end">
      <a
        href={localizedHref('/fonti', lang)}
        class="text-sm text-ink-muted hover:text-ink no-underline transition-colors duration-fast"
      >
        {lang === 'it' ? 'Fonti' : lang === 'de' ? 'Quellen' : 'Sources'}
      </a>
      <a
        href={localizedHref('/faq', lang)}
        class="text-sm text-ink-muted hover:text-ink no-underline transition-colors duration-fast"
      >
        FAQ
      </a>
      <a
        href={lang === 'en' ? '/en/method' : lang === 'de' ? '/de/methode' : '/metodo'}
        class="text-sm text-ink-muted hover:text-ink no-underline transition-colors duration-fast"
      >
        {lang === 'it' ? 'Metodo' : lang === 'de' ? 'Methode' : 'Method'}
      </a>
      <a
        href={lang === 'en' ? '/en/cruise' : lang === 'de' ? '/de/kreuzfahrt' : '/crocieristi'}
        class="text-sm text-ink-muted hover:text-ink no-underline transition-colors duration-fast"
      >
        {lang === 'it' ? 'Crocieristi' : lang === 'de' ? 'Kreuzfahrtgäste' : 'Cruise guests'}
      </a>
      {lang === 'it' && (
        <a
          href="/masserie/"
          class="text-sm text-ink-muted hover:text-ink no-underline transition-colors duration-fast"
        >
          Masserie
        </a>
      )}
      <a
        href={localizedHref('/termini', lang)}
        class="text-sm text-ink-muted hover:text-ink no-underline transition-colors duration-fast"
      >
        {t('footer.terms', lang)}
      </a>
      <a
        href={localizedHref('/privacy', lang)}
        class="text-sm text-ink-muted hover:text-ink no-underline transition-colors duration-fast"
      >
        {t('footer.privacy', lang)}
      </a>
      <a
        href={localizedHref('/cookie-policy', lang)}
        class="text-sm text-ink-muted hover:text-ink no-underline transition-colors duration-fast"
      >
        Cookie
      </a>
      <button
        id="cookie-reopen"
        class="text-sm text-ink-muted hover:text-ink transition-colors duration-fast bg-transparent border-0 p-0 cursor-pointer"
      >
        {lang === 'it' ? 'Gestisci cookie' : lang === 'de' ? 'Cookies verwalten' : 'Manage cookies'}
      </button>
      <a
        href="mailto:hello@localis.guide"
        class="text-sm text-ink-muted hover:text-ink no-underline transition-colors duration-fast"
      >
        hello@localis.guide
      </a>
    </nav>
  </div>
</footer>
