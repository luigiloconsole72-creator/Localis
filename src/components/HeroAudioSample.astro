---
import { type Lang } from '../lib/i18n';

export interface Props {
  lang: Lang;
  src?: string;
  guideSlug?: string;
  context?: string;
  /** Scritta accanto al play; di default quella dell'assaggio da 1 minuto. */
  label?: string;
}

const { lang, src = '/audio/trailers/home-trailer-it.mp3', guideSlug, context = 'hero' } = Astro.props;
const audioAssetId = src.split('/').pop()?.replace(/\.mp3$/i, '') || 'unknown';

const label = Astro.props.label ?? (lang === 'de'
  ? 'Hörprobe · 1 Min · gratis'
  : lang === 'it'
    ? 'Ascolta un assaggio · 1 min · gratis'
    : 'Listen to a sample · 1 min · free');

const playLabel = lang === 'de' ? 'Abspielen' : lang === 'it' ? 'Play' : 'Play';
const pauseLabel = lang === 'de' ? 'Pausieren' : lang === 'it' ? 'Pausa' : 'Pause';
---

<div class="hero-sample" data-src={src} data-guide-slug={guideSlug ?? ''} data-audio-asset-id={audioAssetId} data-lang={lang} data-audio-context={context}>
  <button
    class="hero-sample-btn"
    aria-label={playLabel}
    data-play-label={playLabel}
    data-pause-label={pauseLabel}
  >
    <svg class="icon-play" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <polygon points="6 4 20 12 6 20 6 4" />
    </svg>
    <svg class="icon-pause" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="display:none">
      <rect x="6" y="4" width="4" height="16" /><rect x="14" y="4" width="4" height="16" />
    </svg>
  </button>

  <div class="hero-sample-info">
    <span class="hero-sample-label">{label}</span>
    <div class="hero-sample-bar" aria-hidden="true">
      <div class="hero-sample-progress"></div>
    </div>
  </div>
</div>

<script>
  import { createAudioAnalyticsTracker } from '../lib/audio-analytics';

  // Un solo racconto per volta: chi parte mette in pausa l'altro (directory delle
  // masserie, «La valle intorno» sotto una storia). Le icone seguono gli eventi
  // dell'audio, non il clic, così restano giuste anche quando la pausa arriva da fuori.
  let current: HTMLAudioElement | null = null;

  document.querySelectorAll<HTMLElement>('.hero-sample').forEach((el) => {
    const src = el.dataset.src!;
    const btn = el.querySelector<HTMLButtonElement>('.hero-sample-btn')!;
    const bar = el.querySelector<HTMLElement>('.hero-sample-progress')!;
    const iconPlay = btn.querySelector<SVGElement>('.icon-play')!;
    const iconPause = btn.querySelector<SVGElement>('.icon-pause')!;

    let audio: HTMLAudioElement | null = null;

    const guideSlug = el.dataset.guideSlug || undefined;
    const guideLang = el.dataset.lang || 'it';
    const audioAssetId = el.dataset.audioAssetId || src.split('/').pop()?.replace(/\.mp3$/i, '') || 'unknown';
    let tracker: ReturnType<typeof createAudioAnalyticsTracker> | null = null;

    btn.addEventListener('click', () => {
      if (!audio) {
        audio = new Audio(src);
        tracker = createAudioAnalyticsTracker({
          audio,
          guideSlug,
          audioAssetId,
          language: guideLang,
          audioContext: el.dataset.audioContext || 'hero',
        });
        audio.addEventListener('timeupdate', () => {
          if (!audio!.duration) return;
          bar.style.width = `${(audio!.currentTime / audio!.duration) * 100}%`;
          tracker?.onTimeUpdate();
        });
        audio.addEventListener('ended', () => {
          bar.style.width = '0%';
          tracker?.onEnded();
        });
        audio.addEventListener('play', () => {
          iconPlay.style.display = 'none';
          iconPause.style.display = '';
          btn.setAttribute('aria-label', btn.dataset.pauseLabel!);
        });
        audio.addEventListener('pause', () => {
          iconPlay.style.display = '';
          iconPause.style.display = 'none';
          btn.setAttribute('aria-label', btn.dataset.playLabel!);
        });
      }

      if (audio.paused) {
        if (current && current !== audio && !current.paused) current.pause();
        current = audio;
        audio.play().then(() => {
          tracker?.onPlay();
        }).catch((e) => {
          console.error('[HeroAudio] play() failed:', e, 'src:', src);
        });
      } else {
        audio.pause();
        tracker?.onPause();
      }
    });
  });
</script>

<style>
  .hero-sample {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
    margin-top: var(--spacing-lg);
    width: min(100%, 29rem);
    padding: 0.8rem 0.95rem;
    border-radius: 999px;
    background: oklch(from var(--color-surface) l c h / 0.94);
    border: 1px solid oklch(from var(--color-border) l c h / 0.9);
    box-shadow: 0 10px 30px -16px oklch(15% 0.012 240 / 0.42);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .hero-sample-btn {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: none;
    background: var(--color-accent);
    color: var(--color-surface);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 8px 18px -12px oklch(from var(--color-accent) l c h / 0.9);
    transition: transform var(--duration-fast), background-color var(--duration-fast), box-shadow var(--duration-fast);
  }

  .hero-sample-btn:hover {
    background: color-mix(in oklab, var(--color-accent) 88%, black 12%);
    transform: translateY(-1px);
    box-shadow: 0 12px 24px -14px oklch(from var(--color-accent) l c h / 0.95);
  }

  .hero-sample-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .hero-sample-label {
    font-family: var(--font-body);
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--color-ink);
    line-height: 1.2;
  }

  .hero-sample-bar {
    width: 100%;
    height: 4px;
    background: oklch(from var(--color-border) l c h / 0.65);
    border-radius: 999px;
    overflow: hidden;
  }

  .hero-sample-progress {
    height: 100%;
    width: 0%;
    background: var(--color-accent);
    transition: width 0.25s linear;
    border-radius: 999px;
  }

  @media (max-width: 640px) {
    .hero-sample {
      width: 100%;
      padding: 0.8rem 0.9rem;
    }

    .hero-sample-label {
      font-size: 0.82rem;
    }
  }
</style>
