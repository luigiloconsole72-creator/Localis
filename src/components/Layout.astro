---
import '../styles/global.css';
import SkipLink from './SkipLink.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import StickyPlayer from './StickyPlayer.astro';
import StructuredData from './StructuredData.astro';
import Analytics from './Analytics.astro';
import CheckoutNotice from './CheckoutNotice.astro';
import CookieBanner from './CookieBanner.astro';
import { type Lang, allLangUrls } from '../lib/i18n';
import { organizationLD } from '../lib/seo';

export interface Props {
  title: string;
  description?: string;
  lang?: Lang;
  ogImage?: string;
  /** Override hreflang quando i slug differiscono tra lingue (es. articoli blog) */
  langUrlsOverride?: Partial<Record<Lang, string>>;
  /** Override og:type (default: 'website') */
  ogType?: string;
  robots?: string;
  /** Player in cornice (token Cortése): niente header/footer del sito —
      i link di navigazione dentro un iframe portano a pagine che rifiutano
      il framing ("connessione negata"). La cornice la fornisce l'app ospite. */
  embedded?: boolean;
}

const { title, description = '', lang = 'it', ogImage, langUrlsOverride, ogType = 'website', robots, embedded = false } = Astro.props;
const currentPath = Astro.url.pathname;
const computedLangUrls = langUrlsOverride ?? allLangUrls(currentPath);
const itUrl = computedLangUrls.it;
const alternateUrls = (['it', 'en', 'de'] as Lang[])
  .map((code) => ({ code, href: computedLangUrls[code] }))
  .filter((alternate): alternate is { code: Lang; href: string } => Boolean(alternate.href));
const SITE = 'https://localis.guide';
const canonical = `${SITE}${currentPath}`;
const ogLocale = lang === 'en' ? 'en_US' : lang === 'de' ? 'de_DE' : 'it_IT';
const alternateOgLocales = ['it_IT', 'en_US', 'de_DE'].filter((locale) => locale !== ogLocale);
const partnerSlugFromPath = currentPath.match(/^\/(?:(?:en|de)\/)?p\/([a-z0-9][a-z0-9-]{2,40})\/?$/i)?.[1] ?? '';
---
<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#FAF7F2" />
  <link rel="canonical" href={canonical} />
  {alternateUrls.map(({ code, href }) => <link rel="alternate" hreflang={code} href={`${SITE}${href}`} />)}
  {itUrl && <link rel="alternate" hreflang="x-default" href={`${SITE}${itUrl}`} />}
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  {robots && <meta name="robots" content={robots} />}

  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={title} />
  {description && <meta property="og:description" content={description} />}
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content={ogLocale} />
  {alternateOgLocales.map((locale) => <meta property="og:locale:alternate" content={locale} />)}
  <meta property="og:site_name" content="Localis" />
  <meta property="og:image" content={ogImage ? `${SITE}${ogImage}` : `${SITE}/og-default.jpg`} />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  {description && <meta name="twitter:description" content={description} />}
  <meta name="twitter:image" content={ogImage ? `${SITE}${ogImage}` : `${SITE}/og-default.jpg`} />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <link rel="preconnect" href="https://fonts.bunny.net" />
  <link
    href="https://fonts.bunny.net/css?family=spectral:300,300i,400,400i,500,500i,600,600i|schibsted-grotesk:400,500,600,700&display=swap"
    rel="stylesheet"
  />
  <script is:inline define:vars={{ currentPath, lang, partnerSlugFromPath }}>
    (function() {
      try {
        const maxAge = 30 * 24 * 60 * 60;
        const params = new URLSearchParams(window.location.search);
        const queryPartner = params.get('p');
        const partner = /^[a-z0-9][a-z0-9-]{2,40}$/i.test(queryPartner || '')
          ? queryPartner
          : partnerSlugFromPath;

        if (partner) {
          document.cookie = `lg_partner=${partner}; path=/; max-age=${maxAge}; SameSite=Lax`;
          localStorage.setItem('lg_partner', partner);
          localStorage.setItem('lg_partner_ts', String(Date.now()));
          window.localisPartnerId = partner;
          window.localisPartnerLanding = {
            partner_id: partner,
            path: currentPath,
            lang,
            source: partnerSlugFromPath ? 'partner_landing' : 'partner_query',
            qr_path: currentPath,
            qr_url: partnerSlugFromPath ? `${window.location.origin}${currentPath}` : window.location.href,
          };
          return;
        }

        const cookieVal = document.cookie.split('; ').find((c) => c.startsWith('lg_partner='));
        if (cookieVal) {
          window.localisPartnerId = decodeURIComponent(cookieVal.split('=')[1] || '');
          return;
        }

        const ls = localStorage.getItem('lg_partner');
        const lsTs = parseInt(localStorage.getItem('lg_partner_ts') || '0', 10);
        const expired = Date.now() - lsTs > 30 * 24 * 60 * 60 * 1000;
        if (ls && !expired) {
          document.cookie = `lg_partner=${ls}; path=/; max-age=${maxAge}; SameSite=Lax`;
          window.localisPartnerId = ls;
        }
      } catch (e) {}
    })();
  </script>
  <script is:inline>
    // Pagine viste consenso-indipendente: nessun cookie, nessun identificatore,
    // solo un contatore aggregato. Lo manda il browser perche' le pagine
    // prerenderizzate le serve la CDN e non passano mai dal server. Vedi
    // src/pages/api/hit.ts.
    try {
      if (navigator.sendBeacon && !window.location.search.includes('localis_internal=1')) {
        navigator.sendBeacon('/api/hit?p=' + encodeURIComponent(window.location.pathname));
      }
    } catch (e) {}
  </script>
  <Analytics />
  <StructuredData data={organizationLD()} />
</head>
<body class="bg-surface text-ink font-body antialiased min-h-screen flex flex-col">
  <SkipLink lang={lang} />
  {!embedded && <Header lang={lang} currentPath={currentPath} langUrlsOverride={langUrlsOverride} />}

  <main id="main" class="flex-1">
    {!embedded && <CheckoutNotice lang={lang} />}
    <slot />
  </main>

  {!embedded && <Footer lang={lang} />}

  <StickyPlayer lang={lang} />
  <CookieBanner lang={lang} />
</body>
</html>
