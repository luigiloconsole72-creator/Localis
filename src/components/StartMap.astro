---
import { type Lang } from '../lib/i18n';

export interface Props {
  lat: number;
  lng: number;
  lang: Lang;
  startsAt?: string;
  delta?: number;
}

const { lat, lng, lang, startsAt, delta = 0.0035 } = Astro.props;
const bbox = `${(lng - delta).toFixed(5)},${(lat - delta).toFixed(5)},${(lng + delta).toFixed(5)},${(lat + delta).toFixed(5)}`;
const embedSrc = `https://www.openstreetmap.org/export/embed.html?bbox=${bbox}&layer=mapnik&marker=${lat.toFixed(5)},${lng.toFixed(5)}`;
const mapsHref = `https://www.google.com/maps/search/?api=1&query=${lat.toFixed(5)},${lng.toFixed(5)}`;
const appleHref = `https://maps.apple.com/?ll=${lat.toFixed(5)},${lng.toFixed(5)}&q=${lat.toFixed(5)},${lng.toFixed(5)}`;

const heading = lang === 'it' ? 'Dove parte il racconto' : lang === 'de' ? 'Wo die Erzählung beginnt' : 'Where the story starts';
const note = lang === 'it'
  ? "Punto di partenza consigliato. Apri in Maps per farti guidare fin qui — poi premi play."
  : lang === 'de'
    ? 'Empfohlener Startpunkt. Öffne die Karte für die Wegbeschreibung und starte danach die Wiedergabe.'
    : 'Suggested starting point. Open in Maps to get directions — then press play.';
const openGoogle = lang === 'it' ? 'Apri in Google Maps' : lang === 'de' ? 'In Google Maps öffnen' : 'Open in Google Maps';
const openApple = lang === 'it' ? 'Apri in Apple Maps' : lang === 'de' ? 'In Apple Karten öffnen' : 'Open in Apple Maps';
const iframeTitle = lang === 'it' ? 'Mappa punto di partenza' : lang === 'de' ? 'Karte Startpunkt' : 'Starting point map';
---
<section class="start-map">
  <h2 class="font-display text-3xl text-ink mb-sm">{heading}</h2>
  {startsAt && (
    <p class="start-map-place font-display italic text-xl text-accent mb-xs">{startsAt}</p>
  )}
  <p class="start-map-note text-sm text-ink-muted mb-md">{note}</p>

  <div class="start-map-frame">
    <iframe
      src={embedSrc}
      title={iframeTitle}
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
    ></iframe>
  </div>

  <div class="start-map-actions">
    <a href={mapsHref} target="_blank" rel="noopener noreferrer" class="start-map-btn start-map-btn-primary">
      {openGoogle}
    </a>
    <a href={appleHref} target="_blank" rel="noopener noreferrer" class="start-map-btn">
      {openApple}
    </a>
  </div>
</section>

<style>
  .start-map-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--color-surface-elev);
  }
  .start-map-frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }
  .start-map-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-sm);
    margin-top: var(--spacing-md);
  }
  .start-map-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 10px 16px;
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    text-decoration: none;
    border: 1px solid var(--color-ink);
    border-radius: 9999px;
    color: var(--color-ink);
    background: var(--color-surface);
    transition: background 180ms, color 180ms, transform 180ms;
  }
  .start-map-btn:hover {
    transform: translateY(-1px);
  }
  .start-map-btn-primary {
    border-color: var(--color-olive);
    background: var(--color-olive);
    color: var(--color-surface);
  }
  .start-map-btn-primary:hover {
    background: var(--color-accent);
    border-color: var(--color-accent);
  }
</style>
