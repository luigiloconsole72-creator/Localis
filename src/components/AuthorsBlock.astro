---
import { type Lang } from '../lib/i18n';

export interface Author {
  /** Titolo della guida che racconta (es. "Bari Vecchia", "Il Meglio di Bari") */
  guideTitle: string;
  /** Nome reale del narratore. Se vuoto: render placeholder. */
  name?: string;
  /** Bio breve (2-3 righe). Se vuoto: render placeholder. */
  bioIt?: string;
  bioEn?: string;
  bioDe?: string;
  /** Iniziali per il fallback (es. "F.M."). Auto-derivate se manca. */
  initials?: string;
  /** Path foto B/W 3:4. Se vuoto: render silhouette tipografica. */
  photo?: string;
  /** True quando la voce è un personaggio editoriale composito. */
  composite?: boolean;
  /** Se true, mostra badge "Profilo in arrivo" sopra la card */
  draft?: boolean;
}

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const eyebrow = lang === 'it' ? 'Chi racconta' : lang === 'de' ? 'Wer erzählt' : 'Who tells the story';
const heading1 = lang === 'it' ? 'Le persone dietro i racconti.' : lang === 'de' ? 'Die Menschen hinter den Erzählungen.' : 'The people behind the stories.';
const heading2 = lang === 'it' ? 'Sei guide, una sola Bari.' : lang === 'de' ? 'Sechs Erzählungen, ein Bari.' : 'Six stories, one Bari.';
const intro = lang === 'it'
  ? 'Le guide di Bari nascono da ricerca, fonti consultabili e memoria locale quando disponibile. Ogni racconto ha una prospettiva dichiarata, ma la narrazione audio è generata con ElevenLabs.'
  : lang === 'de'
    ? 'Die Bari-Guides entstehen aus Recherche, einsehbaren Quellen und lokaler Erinnerung, wenn verfügbar. Jede Erzählung hat eine erklärte Perspektive, aber die Audionarration wird mit ElevenLabs generiert.'
    : 'The Bari guides are built from research, consultable sources and local memory when available. Every story has a declared perspective, but the audio narration is generated with ElevenLabs.';
const draftBadge = lang === 'it' ? 'Profilo in arrivo' : lang === 'de' ? 'Profil folgt' : 'Profile coming';
const photoSoonLabel = lang === 'it' ? 'Ritratto in arrivo' : lang === 'de' ? 'Portraet folgt' : 'Portrait coming';

// Placeholders editoriali — nessun nome inventato di persona reale.
// Quando il narratore reale è confermato, sostituire `name`, `bioIt`, `bioEn`,
// `photo` (path /images/authors/<slug>.jpg) e rimuovere `draft: true`.
const authors: Author[] = [
  {
    guideTitle: 'Bari Vecchia',    name: 'Domenico Loconsole',
    initials: 'D.L.',
    photo: '/images/authors/domenico-loconsole.png',
    bioIt: 'Barese, cresciuto nel quartiere Libertà, a pochi passi dal borgo antico. Fondatore di Localis, racconta Bari Vecchia attraverso la sua storia, le sue pietre e il legame profondo che questo luogo conserva con l\'identità della città.',
    bioEn: 'From Bari, raised in the Libertà neighbourhood, a few steps from the old town. Founder of Localis, he tells the story of Bari Vecchia through its history, its stones, and the deep bond this place holds with the identity of the city.',
    bioDe: 'In Bari geboren und im Viertel Libertà aufgewachsen, nur wenige Schritte von der Altstadt entfernt. Als Gründer von Localis erzählt Domenico Bari Vecchia durch ihre Geschichte, ihre Steine und die tiefe Verbindung, die dieser Ort bis heute mit der Identität der Stadt bewahrt.',
  },
  {
    guideTitle: 'Tre Teatri',    name: 'Filippo Bellomo',
    initials: 'F.B.',
    photo: '/images/authors/filippo-headshot.jpg',
    bioIt: 'Architetto, innamorato del liberty barese. Studia da anni i tre teatri che hanno trasformato Bari in città europea — il Petruzzelli, il Margherita, il Piccinni. Li racconta come se ci avesse vissuto dentro.',
    bioEn: 'Architect, in love with Bari Liberty style. He has spent years studying the three theatres that turned Bari into a European city — the Petruzzelli, the Margherita, the Piccinni. He talks about them as if he had lived inside them.',
    bioDe: 'Architekt, verliebt in den Liberty-Stil von Bari. Er studiert seit Jahren die drei Theater, die Bari zur europäischen Stadt gemacht haben — Petruzzelli, Margherita, Piccinni.',
  },
  {
    guideTitle: 'San Nicola',    name: 'Nonno Nicola',
    initials: 'N.N.',
    photo: '/images/authors/nonno-nicola.jpg',
    bioIt: 'Nonno Nicola è cresciuto nel quartiere Libertà, ma la sua memoria familiare nasce nel cuore più antico di Bari: i suoi genitori sono nati e cresciuti a Bari Vecchia, suo padre aveva una storica salumeria in via Ricciotto Canudo, conosciuta come \'da Minguccio\', e il nonno gestiva una saponeria artigianale. In questo racconto porta una Bari fatta di botteghe, vicoli, lavoro e vita quotidiana. Persona reale coinvolta nel progetto Localis. Narrazione audio generata con ElevenLabs.',
    bioEn: 'Nonno Nicola grew up in the Libertà neighbourhood, but his family memory is rooted in the oldest heart of Bari: his parents were born and raised in Bari Vecchia, his father ran a historic deli on Via Ricciotto Canudo, known as \'da Minguccio\', and his grandfather ran an artisanal soap shop. In this story he brings a Bari of workshops, alleyways, work and everyday life. Real person involved in the Localis project. Audio narration generated with ElevenLabs.',
    bioDe: 'Nonno Nicola ist im Viertel Libertà aufgewachsen, aber seine Familienerinnerung wurzelt im ältesten Herzen von Bari: Seine Eltern sind in Bari Vecchia geboren und aufgewachsen, sein Vater führte eine historische Delikatesshandlung in der Via Ricciotto Canudo, bekannt als \'da Minguccio\', und sein Großvater betrieb eine handwerkliche Seifenmanufaktur. In dieser Geschichte bringt er ein Bari aus Läden, Gassen, Arbeit und Alltagsleben. Reale Person, die am Localis-Projekt beteiligt ist. Audioerzählung generiert mit ElevenLabs.',
  },
  {
    guideTitle: 'Il Meglio di Bari',    name: 'Rachele Grande',
    initials: 'R.G.',
    photo: '/images/authors/rachele-grande.jpg',
    bioIt: 'Rachele è la prospettiva narrante del racconto sul cibo di Bari. Dal mare di N\'dèrr\'a la lanze al ricordo dei ricci alla Forcatella, accompagna l\'ascoltatore dentro un rapporto fatto di gesti, memoria e vita quotidiana.',
    bioEn: 'Rachele is the narrative voice of the story about Bari\'s food. From the sea at N\'dèrr\'a la lanze to the memory of sea urchins at Forcatella, she guides the listener through a relationship built on gestures, memory and everyday life.',
    bioDe: 'Rachele ist die erzählerische Perspektive der Geschichte über Baris Essen. Vom Meer bei N\'dèrr\'a la lanze bis zur Erinnerung an Seeigel bei Forcatella begleitet sie den Zuhörer in eine von Gesten, Erinnerung und Alltag geprägte Beziehung.',
  },
  {
    guideTitle: 'Porto di Bari',    name: 'Luigi Loconsole',
    initials: 'L.L.',
    photo: '/images/authors/luigi-loconsole.jpg',
    bioIt: 'Cinquantaquattro anni. Troppi passati in mare per contarli. Conosce il Porto dentro, fuori, sopra e sotto — e le feste che il lungomare ricorda meno di lui.',
    bioEn: 'Fifty-four. Too many years on the water to count. He knows the Port inside, outside, above and below — and the festivals the lungomare remembers worse than he does.',
    bioDe: 'Vierundfünfzig Jahre. Zu viele davon auf dem Wasser, um sie zu zählen. Er kennt den Hafen von innen, außen, oben und unten — und die Feste, die der Lungomare weniger gut erinnert als er.',
  },
  {
    guideTitle: 'Bari Sotterranea',    name: 'Rosa "la Perpetua"',
    initials: 'R.P.',
    photo: '/images/authors/rosa-perpetua.jpg',
    composite: true,
    bioIt: 'Attraverso Rosa, Localis accompagna l\'ascoltatore nel sottosuolo di Bari, tra cripte, pietra e stratificazioni della città antica.',
    bioEn: 'Through Rosa, Localis leads the listener beneath Bari, among crypts, stone and the layered remains of the ancient city.',
    bioDe: 'Durch Rosa führt Localis die Zuhörenden in den Untergrund von Bari: zu Krypten, Stein und den historischen Schichten der alten Stadt.',
  },
];

function deriveInitials(a: Author): string {
  if (a.initials) return a.initials;
  if (a.name) {
    return a.name
      .split(/\s+/)
      .filter(Boolean)
      .slice(0, 2)
      .map((s) => s[0]?.toUpperCase() ?? '')
      .join('.') + '.';
  }
  return a.guideTitle.split(/\s+/).slice(0, 2).map((s) => s[0]?.toUpperCase() ?? '').join('');
}

function bioFor(a: Author): string {
  const draftIt = `Voce confermata per "${a.guideTitle}". Foto e bio breve a giorni.`;
  const draftEn = `Voice confirmed for "${a.guideTitle}". Photo and short bio coming soon.`;
  const draftDe = `Stimme für "${a.guideTitle}" bestätigt. Foto und Kurzbiografie folgen bald.`;
  if (lang === 'it') {
    return a.bioIt ?? draftIt;
  }
  if (lang === 'de') {
    return a.bioDe ?? draftDe;
  }
  return a.bioEn ?? draftEn;
}

function photoNoteFor(a: Author): string {
  if (a.composite) {
    return lang === 'it'
      ? 'Ritratto narrativo. Costruito su ricerca e fonti Localis.'
      : lang === 'de'
        ? 'Narratives Porträt. Auf Grundlage der Recherchen und Quellen von Localis gestaltet.'
        : 'Narrative portrait. Created from Localis research and sources.';
  }
  return lang === 'it'
    ? 'Persona reale coinvolta nel progetto Localis.'
    : lang === 'de'
      ? 'Reale Person, am Projekt Localis beteiligt.'
      : 'Real person involved in the Localis project.';
}

function photoTitleFor(a: Author): string {
  if (a.composite) {
    return lang === 'it'
      ? `${a.name}: ritratto narrativo costruito su ricerca e fonti Localis.`
      : lang === 'de'
        ? `${a.name}: narratives Porträt auf Grundlage der Recherchen und Quellen von Localis.`
        : `${a.name}: narrative portrait created from Localis research and sources.`;
  }
  return lang === 'it'
    ? `${a.name}: persona reale e autore della guida ${a.guideTitle}.`
    : lang === 'de'
      ? `${a.name}: reale Person und Autor des Guides ${a.guideTitle}.`
      : `${a.name}: real person and author of the ${a.guideTitle} guide.`;
}
---
<section class="authors bg-surface">
  <div class="max-w-wrap mx-auto px-md sm:px-lg py-3xl lg:py-4xl">

    <!-- Section header -->
    <div class="authors-header max-w-[60ch] mb-2xl lg:mb-3xl">
      <div class="flex items-center gap-sm mb-md">
        <span class="block w-7 h-px bg-accent"></span>
        <span class="text-[11px] font-semibold tracking-[0.24em] uppercase text-accent">
          {eyebrow}
        </span>
      </div>
      <h2 class="font-display text-ink leading-[1.05] tracking-[-0.014em] mb-md text-[clamp(1.9rem,4.4vw,3rem)]">
        <span class="font-light">{heading1}</span>
        <span class="block font-body font-normal text-ink-muted mt-sm text-[clamp(1.15rem,2.4vw,1.55rem)] leading-relaxed tracking-normal">
          {heading2}
        </span>
      </h2>
      <p class="font-body text-base sm:text-lg leading-relaxed text-ink-muted">
        {intro}
      </p>
    </div>

    <!-- Plates grid: 1 col mobile, 2 cols sm, 3 cols lg -->
    <ol class="authors-grid grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-xl gap-y-2xl list-none p-0 m-0">
      {authors.map((a, i) => {
        const initials = deriveInitials(a);
        const bio = bioFor(a);
        const photoNote = photoNoteFor(a);
        const photoTitle = photoTitleFor(a);
        const isPlaceholderName = !a.name;

        return (
          <li class="author-cell" style={`--idx:${i}`}>
            <article class="author-plate">
              <!-- Photo / silhouette -->
              <figure class="author-photo m-0">
                {a.photo ? (
                  <img
                    src={a.photo}
                    alt={a.name ? `Ritratto di ${a.name}, narratore di "${a.guideTitle}"` : `Ritratto in arrivo per "${a.guideTitle}"`}
                    title={photoTitle}
                    class="author-img"
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <div class="author-silhouette" role="img" aria-label={`${photoSoonLabel} — ${a.guideTitle}`}>
                    <span class="silhouette-initials">{initials}</span>
                    <span class="silhouette-label">{photoSoonLabel}</span>
                  </div>
                )}
                {a.draft && (
                  <span class="author-draft" aria-hidden="true">{draftBadge}</span>
                )}
              </figure>
              {a.photo && (
                <p class="author-photo-note font-body text-[10px] font-semibold uppercase tracking-[0.18em] text-ink-subtle m-0">
                  {photoNote}
                </p>
              )}

              <!-- Meta -->
              <div class="author-meta">
                <h3 class="author-name font-display text-ink leading-[1.1] m-0">
                  {isPlaceholderName ? (
                    <span class="text-ink-subtle italic font-light">
                      {lang === 'it' ? 'Autore di' : lang === 'de' ? 'Autor von' : 'Author of'} <span class="not-italic font-normal text-ink">{a.guideTitle}</span>
                    </span>
                  ) : (
                    <>
                      <span class="font-light">{a.name}</span>
                      <span class="block font-body font-normal text-ink-muted text-[0.62em] mt-2xs tracking-normal">
                        {a.guideTitle}
                      </span>
                    </>
                  )}
                </h3>
                <p class="author-bio font-body text-sm text-ink-muted leading-snug max-w-[36ch] mb-0">
                  {bio}
                </p>
              </div>
            </article>
          </li>
        );
      })}
    </ol>
  </div>
</section>

<style>
  .author-cell {
    opacity: 0;
    transform: translateY(14px);
    animation: authorIn 0.8s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: calc(var(--idx, 0) * 90ms + 100ms);
  }

  .author-plate {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
    border-top: 1px solid var(--color-ink);
    padding-top: var(--spacing-md);
  }

  /* Photo plate */
  .author-photo {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 4;
    background: var(--color-surface-elev);
    overflow: hidden;
    border-radius: var(--radius-md);
    box-shadow: 0 1px 2px oklch(15% 0.012 240 / 0.08),
                0 12px 32px -12px oklch(15% 0.012 240 / 0.16);
  }

  .author-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: grayscale(100%) contrast(1.06) brightness(0.96);
  }

  .author-photo-note {
    margin-top: calc(var(--spacing-md) * -0.55);
    line-height: 1.35;
  }

  /* Silhouette placeholder — initials in Spectral italic on parchment */
  .author-silhouette {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-sm);
    background:
      radial-gradient(ellipse at 50% 32%, oklch(75% 0.012 75) 0%, oklch(75% 0.012 75) 22%, transparent 40%),
      var(--color-surface-elev);
  }

  .silhouette-initials {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(3.5rem, 7vw, 5.5rem);
    line-height: 1;
    color: var(--color-ink);
    letter-spacing: -0.04em;
    user-select: none;
  }

  .silhouette-label {
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--color-ink-subtle);
  }

  /* Draft badge */
  .author-draft {
    position: absolute;
    top: var(--spacing-sm);
    left: var(--spacing-sm);
    font-family: var(--font-body);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-surface);
    background: var(--color-accent);
    padding: 4px 10px;
    line-height: 1.4;
  }

  /* Meta */
  .author-meta {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }

  .author-name {
    font-size: clamp(1.4rem, 2.4vw, 1.75rem);
    font-weight: 300;
  }

  .author-bio {
    color: var(--color-ink-muted);
  }

  @keyframes authorIn {
    to { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .author-cell {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>
