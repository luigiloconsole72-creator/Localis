---
import PriceCard from './PriceCard.astro';
import type { Lang } from '../lib/i18n';

type ZoneBundleProduct = 'bari-completa' | 'valle-completa' | 'gargano-completa';

export interface Props {
  guideSlug: string;
  lang: Lang;
  singleFeatures: string[];
  trisFeatures: string[];
  zoneBundleProduct?: ZoneBundleProduct | null;
  zoneBundleFeatures?: string[];
  class?: string;
}

const HEADING = { it: 'Prezzi e pacchetti', en: 'Pricing and packs', de: 'Preise und Pakete' } as const;

const {
  guideSlug,
  lang,
  singleFeatures,
  trisFeatures,
  zoneBundleProduct = null,
  zoneBundleFeatures = [],
  class: className = 'flex flex-col gap-md',
} = Astro.props;
---

<aside class={className}>
  <h2 class="sr-only">{HEADING[lang]}</h2>
  <PriceCard product="single" guideSlug={guideSlug} lang={lang} features={singleFeatures} />
  <PriceCard product="tris" lang={lang} features={trisFeatures} />
  {zoneBundleProduct && (
    <PriceCard product={zoneBundleProduct} lang={lang} primary features={zoneBundleFeatures} />
  )}
</aside>
