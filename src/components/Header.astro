---
import { t } from '../lib/i18n-strings';
import { localizedHref, type Lang } from '../lib/i18n';
import LangSwitcher from './LangSwitcher.astro';

export interface Props {
  lang: Lang;
  currentPath: string;
  langUrlsOverride?: Partial<Record<Lang, string>>;
}

const { lang, currentPath, langUrlsOverride } = Astro.props;

const navLinks = [
  { href: localizedHref('/guide', lang), label: lang === 'it' ? 'Guide' : 'Guides' },
  ...(lang === 'it' ? [{ href: '/masserie/', label: 'Masserie' }] : []),
  { href: localizedHref('/blog', lang),  label: 'Blog' },
  { href: localizedHref('/fonti', lang), label: lang === 'it' ? 'Fonti' : lang === 'de' ? 'Quellen' : 'Sources' },
  { href: localizedHref('/about', lang), label: lang === 'it' ? 'Chi siamo' : lang === 'de' ? 'Über uns' : 'About' },
  ...(lang === 'it' ? [{ href: '/crocieristi', label: 'Crocieristi' }] : []),
  ...(lang === 'en' ? [{ href: '/en/cruise', label: 'Cruise guests' }] : []),
  ...(lang === 'de' ? [{ href: '/de/kreuzfahrt', label: 'Kreuzfahrtgäste' }] : []),
  {
    href: lang === 'it' ? '/diventa-partner' : lang === 'en' ? '/en/become-a-partner' : '/de/partner-werden',
    label: t('nav.partner', lang),
  },
];
---
<header class="sticky top-0 z-40 bg-surface/95 backdrop-blur border-b border-border">
  <div class="max-w-wrap mx-auto px-md flex items-center justify-between h-14">
    <a
      href={localizedHref('/', lang)}
      class="font-display text-xl font-medium tracking-tight text-ink no-underline"
      aria-label={t('site.name', lang)}
    >
      Loc<em class="text-accent not-italic">alis</em>
    </a>

    <!-- Desktop nav -->
    <nav class="hidden sm:flex items-center gap-lg">
      {navLinks.map(l => (
        <a
          href={l.href}
          class="font-body text-sm font-medium text-ink-muted hover:text-ink no-underline transition-colors duration-fast"
        >
          {l.label}
        </a>
      ))}
      <LangSwitcher lang={lang} currentPath={currentPath} langUrlsOverride={langUrlsOverride} />
    </nav>

    <!-- Mobile: lang switcher + hamburger -->
    <div class="flex sm:hidden items-center gap-sm">
      <LangSwitcher lang={lang} currentPath={currentPath} langUrlsOverride={langUrlsOverride} />
      <button
        id="mobile-menu-btn"
        aria-label={lang === 'it' ? 'Apri menu' : lang === 'de' ? 'Menü öffnen' : 'Open menu'}
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="w-10 h-10 flex items-center justify-center text-ink rounded-md hover:bg-surface-elev transition-colors duration-fast"
      >
        <svg id="icon-menu" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
        <svg id="icon-close" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" class="hidden">
          <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu drawer -->
  <nav
    id="mobile-menu"
    class="hidden sm:hidden border-t border-border bg-surface/98 backdrop-blur"
    aria-label={lang === 'it' ? 'Menu principale' : lang === 'de' ? 'Hauptmenü' : 'Main menu'}
  >
    <ul class="list-none m-0 p-0 flex flex-col">
      {navLinks.map(l => (
        <li>
          <a
            href={l.href}
            class="block px-md py-sm font-body text-base font-medium text-ink-muted hover:text-ink hover:bg-surface-elev no-underline transition-colors duration-fast border-b border-border/50 last:border-0"
          >
            {l.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn')!;
  const menu = document.getElementById('mobile-menu')!;
  const iconMenu = document.getElementById('icon-menu')!;
  const iconClose = document.getElementById('icon-close')!;
  const focusableSelector = 'a[href], button:not([disabled])';

  function getFocusableMenuItems(): HTMLElement[] {
    return Array.from(menu.querySelectorAll<HTMLElement>(focusableSelector)).filter((el) => {
      return !el.hasAttribute('hidden');
    });
  }

  function setMenuOpen(isOpen: boolean) {
    menu.classList.toggle('hidden', !isOpen);
    btn.setAttribute('aria-expanded', String(isOpen));
    btn.setAttribute(
      'aria-label',
      isOpen
        ? ({ it: 'Chiudi menu', de: 'Menü schließen', en: 'Close menu' }[document.documentElement.lang] ?? 'Close menu')
        : ({ it: 'Apri menu', de: 'Menü öffnen', en: 'Open menu' }[document.documentElement.lang] ?? 'Open menu'),
    );
    iconMenu.classList.toggle('hidden', isOpen);
    iconClose.classList.toggle('hidden', !isOpen);
    document.body.classList.toggle('mobile-menu-open', isOpen);

    if (isOpen) {
      const [firstItem] = getFocusableMenuItems();
      firstItem?.focus();
    } else {
      btn.focus();
    }
  }

  btn.addEventListener('click', () => {
    const isOpen = menu.classList.contains('hidden');
    setMenuOpen(isOpen);
  });

  // Chiudi al click su un link
  menu.querySelectorAll('a').forEach(a => {
    a.addEventListener('click', () => {
      setMenuOpen(false);
    });
  });

  document.addEventListener('keydown', (event) => {
    const isOpen = !menu.classList.contains('hidden');
    if (!isOpen) return;

    if (event.key === 'Escape') {
      setMenuOpen(false);
      return;
    }

    if (event.key !== 'Tab') return;

    const items = getFocusableMenuItems();
    if (items.length === 0) return;

    const first = items[0];
    const last = items[items.length - 1];
    const active = document.activeElement;

    if (event.shiftKey && active === first) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && active === last) {
      event.preventDefault();
      first.focus();
    }
  });

  document.addEventListener('click', (event) => {
    const isOpen = !menu.classList.contains('hidden');
    if (!isOpen) return;

    const target = event.target;
    if (!(target instanceof Node)) return;
    if (menu.contains(target) || btn.contains(target)) return;
    setMenuOpen(false);
  });

  window.addEventListener('resize', () => {
    if (window.innerWidth >= 640 && !menu.classList.contains('hidden')) {
      setMenuOpen(false);
    }
  });
</script>

<style is:global>
  body.mobile-menu-open {
    overflow: hidden;
  }
</style>
