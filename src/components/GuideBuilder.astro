---
import { getCollection } from 'astro:content';
import { formatDuration } from '../lib/format';
import { guideDurationSeconds, guideSubtitle, guideTitle } from '../lib/guide-localization';
import { type Lang } from '../lib/i18n';
import {
  BARI_GUIDES,
  GARGANO_GUIDES,
  MATERA_GUIDES,
  VALLE_GUIDES,
} from '../lib/stripe-prices';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const allEntries = await getCollection('guides');

type GuideCard = {
  slug: string;
  title: string;
  subtitle: string;
  cover: string;
  durationLabel: string;
};

const guideMap = new Map<string, GuideCard>();
for (const entry of allEntries) {
  const d = entry.data;
  const slug = (d.slug ?? entry.id) as string;
  guideMap.set(slug, {
    slug,
    title: guideTitle(d, lang),
    subtitle: guideSubtitle(d, lang),
    cover: d.cover as string,
    durationLabel: formatDuration(guideDurationSeconds(d, lang)),
  });
}

const ZONE_ORDER = [
  { key: 'bari', label: 'Bari', slugs: BARI_GUIDES },
  { key: 'valle', label: "Valle d'Itria", slugs: VALLE_GUIDES },
  { key: 'gargano', label: 'Gargano', slugs: GARGANO_GUIDES },
  { key: 'matera', label: 'Matera', slugs: MATERA_GUIDES },
] as const;
---

<section class="guide-builder" id="builder" aria-label={lang === 'it' ? 'Scegli le tue guide' : lang === 'de' ? 'Guides auswählen' : 'Choose your guides'}>
  <div class="max-w-wrap mx-auto px-md py-3xl lg:py-4xl">
    <div class="text-center mb-2xl">
      <h2 class="font-display font-light text-[clamp(1.8rem,4vw,3rem)] text-ink leading-tight">
        {lang === 'it'
          ? 'Crea il tuo pacchetto.'
          : lang === 'de'
            ? 'Stell dein Paket zusammen.'
            : 'Build your package.'}
      </h2>
      <p class="font-body text-ink-muted text-base mt-sm max-w-[42ch] mx-auto">
        {lang === 'it'
          ? 'Scegli almeno 3 guide. Il prezzo si aggiorna automaticamente.'
          : lang === 'de'
            ? 'Wähle mindestens 3 Guides. Der Preis wird automatisch aktualisiert.'
            : 'Choose at least 3 guides. The price updates automatically.'}
      </p>
      <p class="builder-header-meta font-body text-sm text-ink-subtle mt-sm max-w-[48ch] mx-auto">
        {lang === 'it'
          ? 'Durata media di ogni guida: 30 minuti | Disponibile in: 🇮🇹 🇬🇧 🇩🇪'
          : lang === 'de'
            ? 'Durchschnitt pro Guide: 30 Minuten | Verfügbar in: 🇮🇹 🇬🇧 🇩🇪'
            : 'Average guide length: 30 minutes | Available in: 🇮🇹 🇬🇧 🇩🇪'}
      </p>
    </div>

    {ZONE_ORDER.map((zone) => (
      <div class="mb-2xl">
        <h3 class="font-display font-light text-xl text-ink mb-lg border-b border-border pb-sm">
          {zone.label}
        </h3>
        <div class="builder-grid">
          {zone.slugs.map((slug) => {
            const g = guideMap.get(slug);
            if (!g) return null;
            return (
              <button
                type="button"
                class="builder-card"
                data-slug={slug}
                data-zone={zone.key}
                aria-pressed="false"
                aria-label={g.title}
              >
                <figure class="builder-card-fig m-0">
                  <img src={g.cover} alt={g.title} class="builder-card-img" loading="lazy" decoding="async" />
                  <span class="builder-card-check" aria-hidden="true">✓</span>
                </figure>
                <div class="builder-card-meta">
                  <p class="builder-card-title font-display text-sm font-light text-ink leading-tight m-0">{g.title}</p>
                  <p class="builder-card-sub font-body text-xs text-ink-muted m-0 mt-[2px]">{g.subtitle}</p>
                  <p class="builder-card-duration font-body m-0">
                    <span aria-hidden="true">⏱️</span>
                    <span>{g.durationLabel}</span>
                  </p>
                </div>
              </button>
            );
          })}
        </div>
      </div>
    ))}

    <div class="builder-cta-bar" id="builder-cta-bar" aria-live="polite">
      <div class="builder-cta-inner">
        <div class="builder-cta-status">
          <span id="builder-count" class="builder-count-badge">0</span>
          <span id="builder-status-text" class="text-sm text-ink-muted">
            {lang === 'it' ? 'Nessuna guida selezionata' : lang === 'de' ? 'Noch keine Guides ausgewählt' : 'No guides selected'}
          </span>
        </div>
        <button
          type="button"
          id="builder-checkout-btn"
          class="builder-checkout-btn"
          disabled
          data-lang={lang}
        >
          {lang === 'it' ? 'Seleziona almeno 3 guide' : lang === 'de' ? 'Wähle mindestens 3 Guides' : 'Select at least 3 guides'}
        </button>
      </div>
      <p id="builder-upsell" class="builder-upsell"></p>
      <p class="builder-bonus">
        <button type="button" id="builder-switch-btn" class="builder-switch-btn" hidden></button>
      </p>
      <p class="builder-trust">
        ✓ {lang === 'it'
          ? 'Download immediato, ascolto offline · Soddisfatto o rimborsato'
          : lang === 'de'
            ? 'Sofort-Download, offline hörbar · Geld-zurück-Garantie'
            : 'Instant download, listen offline · Money-back guarantee'}
      </p>
    </div>
  </div>
</section>

<style>
  .builder-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 160px));
    gap: var(--spacing-md);
    justify-content: center;
    align-items: stretch;
  }
  @media (max-width: 900px) {
    .builder-grid { grid-template-columns: repeat(3, minmax(0, 160px)); }
  }
  @media (max-width: 500px) {
    .builder-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  .builder-card {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    background: none;
    border: 2px solid var(--color-border);
    border-radius: 8px;
    padding: 0;
    overflow: hidden;
    cursor: pointer;
    transition: border-color 0.15s, box-shadow 0.15s;
    text-align: left;
  }

  .builder-card:hover {
    border-color: var(--color-ink-muted);
  }

  .builder-card[aria-pressed="true"] {
    border-color: var(--color-ink);
    box-shadow: 0 0 0 1px var(--color-ink);
  }

  .builder-card-fig {
    position: relative;
    display: block;
    width: 100%;
    height: clamp(9rem, 12vw, 10.5rem);
    flex-shrink: 0;
  }

  .builder-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .builder-card-check {
    position: absolute;
    top: 6px;
    right: 6px;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--color-ink);
    color: var(--color-surface);
    font-size: 13px;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.15s;
  }

  .builder-card[aria-pressed="true"] .builder-card-check {
    opacity: 1;
  }

  .builder-card-meta {
    padding: var(--spacing-sm);
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .builder-card-title {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .builder-card-sub {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .builder-card-duration {
    margin-top: auto;
    padding-top: 0.2rem;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-ink);
    letter-spacing: 0.01em;
  }

  .builder-header-meta {
    line-height: 1.5;
  }

  .builder-cta-bar {
    position: sticky;
    bottom: 0;
    background:
      linear-gradient(135deg, oklch(20% 0.02 250 / 0.96), oklch(15% 0.018 250 / 0.98));
    color: var(--color-surface);
    border-top: 1px solid oklch(100% 0 0 / 0.08);
    box-shadow: 0 -18px 40px -24px oklch(10% 0.02 250 / 0.75);
    padding: var(--spacing-md) 0;
    padding-bottom: calc(var(--spacing-md) + env(safe-area-inset-bottom, 0px));
    margin-top: var(--spacing-2xl);
    z-index: 40;
    backdrop-filter: blur(10px);
  }

  .builder-cta-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 var(--spacing-md);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-md);
    flex-wrap: wrap;
  }

  .builder-cta-status {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
  }

  #builder-status-text {
    color: oklch(97% 0.005 250);
    font-weight: 600;
    line-height: 1.45;
  }

  .builder-count-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--color-accent);
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 500;
    box-shadow: 0 10px 22px -14px oklch(from var(--color-accent) l c h / 0.95);
  }

  .builder-checkout-btn {
    padding: var(--spacing-sm) var(--spacing-lg);
    background: var(--color-accent);
    color: var(--color-ink);
    border: none;
    border-radius: 6px;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.9rem;
    cursor: pointer;
    transition: background 0.15s, opacity 0.15s, transform 0.15s, box-shadow 0.15s;
    min-height: 48px;
    box-shadow: 0 14px 28px -18px oklch(from var(--color-accent) l c h / 0.9);
  }

  .builder-checkout-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    box-shadow: none;
  }

  .builder-checkout-btn:not(:disabled):hover {
    background: color-mix(in oklab, var(--color-accent) 88%, white 12%);
    transform: translateY(-1px);
    box-shadow: 0 18px 30px -18px oklch(from var(--color-accent) l c h / 1);
  }

  .builder-upsell {
    max-width: 1280px;
    margin: var(--spacing-xs) auto 0;
    padding: 0 var(--spacing-md);
    font-size: 0.8rem;
    color: oklch(90% 0.01 250 / 0.88);
    font-weight: 500;
    min-height: 1.2em;
  }

  /* La selezione costa gia' quanto un pacchetto che contiene piu' guide:
     va detto a voce alta, non nascosto nel grigio dell'upsell. */
  .builder-bonus {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--spacing-sm);
    max-width: 1280px;
    margin: var(--spacing-xs) auto 0;
    padding: 0 var(--spacing-md);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-accent);
  }

  .builder-switch-btn {
    padding: 4px var(--spacing-sm);
    background: none;
    border: 1px solid currentColor;
    border-radius: 4px;
    color: inherit;
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 600;
    cursor: pointer;
    min-height: 32px;
  }

  .builder-switch-btn:hover {
    background: oklch(from var(--color-accent) l c h / 0.15);
  }

  .builder-trust {
    max-width: 1280px;
    margin: var(--spacing-xs) auto 0;
    padding: 0 var(--spacing-md);
    font-size: 0.75rem;
    color: oklch(90% 0.01 250 / 0.7);
  }

  @media (max-width: 640px) {
    .builder-cta-inner {
      align-items: stretch;
    }

    .builder-cta-status,
    .builder-checkout-btn {
      width: 100%;
    }

    .builder-checkout-btn {
      justify-content: center;
    }
  }
</style>

<script>
  import { submitCheckoutRedirect } from '../lib/checkout-client';
  import { formatPrice } from '../lib/format';
  import { customPriceCents, FREE_CHOICE_TIERS } from '../lib/pricing';

  const SINGLE_CENTS = 499;
  const PACK_3_CENTS = 1199;
  const PACK_6_CENTS = 1999;
  const PUGLIA_COMPLETA_CENTS = 3999;
  const TIERS = [
    { product: 'tris', count: 3 },
    { product: 'sestina', count: 6 },
    { product: 'puglia-completa', count: 18 },
  ] as const;

  // Stesso formattatore delle card: prima il builder scriveva "€19,99" e la
  // PriceCard "€19.99" nella stessa pagina.
  const fmt = (c: number, l: string) =>
    formatPrice(c, l === 'en' || l === 'de' ? l : 'it');

  const cards = Array.from(document.querySelectorAll<HTMLButtonElement>('.builder-card'));
  const btn = document.getElementById('builder-checkout-btn') as HTMLButtonElement;
  const countBadge = document.getElementById('builder-count') as HTMLElement;
  const statusText = document.getElementById('builder-status-text') as HTMLElement;
  const upsell = document.getElementById('builder-upsell') as HTMLElement;
  const switchBtn = document.getElementById('builder-switch-btn') as HTMLButtonElement;
  const lang = btn?.dataset.lang ?? 'it';
  const it = lang === 'it';
  const de = lang === 'de';

  if (!btn) throw new Error('[GuideBuilder] checkout btn not found');

  const selected = new Set<string>();
  const cardZoneBySlug = new Map(
    cards.map((card) => [card.dataset.slug ?? '', card.dataset.zone ?? '']),
  );

  const selectedMessage = (n: number) => it
    ? `Hai selezionato ${n} ${n === 1 ? 'guida' : 'guide'}`
    : de
      ? `Du hast ${n} ${n === 1 ? 'Guide' : 'Guides'} ausgewählt`
      : `You selected ${n} guide${n === 1 ? '' : 's'}`;

  const singleGuideLabel = () => it
    ? '1 guida'
    : de
      ? '1 Guide'
      : '1 guide';

  const priceComparisonMessage = (fullPriceCents: number, discountedPriceCents: number) => it
    ? `invece di ${fmt(fullPriceCents, lang)} paghi ${fmt(discountedPriceCents, lang)}`
    : de
      ? `statt ${fmt(fullPriceCents, lang)} zahlst du ${fmt(discountedPriceCents, lang)}`
      : `instead of ${fmt(fullPriceCents, lang)} you pay ${fmt(discountedPriceCents, lang)}`;

  const checkoutValueCents = (product: string, count: number) => {
    if (product === 'single') return SINGLE_CENTS;
    if (product === 'tris') return PACK_3_CENTS;
    if (product === 'sestina') return PACK_6_CENTS;
    if (product === 'puglia-completa') return PUGLIA_COMPLETA_CENTS;
    return customPriceCents(count);
  };

  // "Puglia Completa" ha un contenuto fisso: le 18 guide pugliesi. Una
  // selezione di 18 che comprende Matera (Basilicata) NON e' quel prodotto:
  // il server la sostituiva in silenzio e il compratore riceveva altro.
  const hasMatera = () => [...selected].some((slug) => cardZoneBySlug.get(slug) === 'matera');
  const packForCount = (n: number) => {
    const tier = TIERS.find((candidate) => candidate.count === n);
    if (!tier) return null;
    if (tier.product === 'puglia-completa' && hasMatera()) return null;
    return tier.product;
  };

  const getZoneState = () => {
    const zones = new Set(
      [...selected]
        .map((slug) => cardZoneBySlug.get(slug))
        .filter((zone): zone is string => Boolean(zone)),
    );

    return {
      zone: zones.size === 1 ? [...zones][0] : null,
      isSameZoneComplete: selected.size === 6 && zones.size === 1,
    };
  };

  cards.forEach((card) => {
    card.addEventListener('click', () => {
      const slug = card.dataset.slug!;
      if (selected.has(slug)) {
        selected.delete(slug);
        card.setAttribute('aria-pressed', 'false');
      } else {
        selected.add(slug);
        card.setAttribute('aria-pressed', 'true');
      }
      updateUI();
    });
  });

  /**
   * Col cap sui prezzi, da 9 guide in su si paga gia' il prezzo di tutte e 18.
   * La riga di upsell lo dice ("Aggiungi N guide · Totale €39,99"); qui si
   * aggiunge l'unica cosa che le manca, cioe' farlo in un click. Solo per le
   * 18 pugliesi: e' l'unico pacchetto col contenuto gia' determinato.
   */
  function renderSwitch(n: number, customTotal: number) {
    const isPack = n === 1 || packForCount(n) !== null;
    const better = isPack
      ? undefined
      : FREE_CHOICE_TIERS.find((tier) => tier.count > n && tier.priceCents <= customTotal);

    if (better?.product !== 'puglia-completa') {
      switchBtn.hidden = true;
      return;
    }

    switchBtn.textContent = it
      ? `Prendi tutte le 18 · ${fmt(better.priceCents, lang)}`
      : de
        ? `Alle 18 nehmen · ${fmt(better.priceCents, lang)}`
        : `Take all 18 · ${fmt(better.priceCents, lang)}`;
    switchBtn.hidden = false;
  }

  // Passa alle 18 guide pugliesi: le zone sono gia' sulle card, cosi' la lista
  // non va riscritta qui (e Matera, che e' in Basilicata, resta fuori).
  switchBtn.addEventListener('click', () => {
    selected.clear();
    cards.forEach((card) => {
      const isPuglia = card.dataset.zone !== 'matera';
      card.setAttribute('aria-pressed', isPuglia ? 'true' : 'false');
      if (isPuglia && card.dataset.slug) selected.add(card.dataset.slug);
    });
    updateUI();
  });

  function updateUI() {
    const n = selected.size;
    const zoneState = getZoneState();
    const nextTier = TIERS.find((tier) => tier.count > n) ?? null;
    const customTotal = customPriceCents(n);

    countBadge.textContent = String(n);
    renderSwitch(n, customTotal);

    if (n === 0) {
      statusText.textContent = it ? 'Nessuna guida selezionata' : de ? 'Noch keine Guides ausgewählt' : 'No guides selected';
      btn.disabled = true;
      btn.textContent = it ? 'Seleziona almeno 3 guide' : de ? 'Wähle mindestens 3 Guides' : 'Select at least 3 guides';
      upsell.textContent = '';
      return;
    }

    if (n === 1) {
      statusText.textContent = `${selectedMessage(n)} · ${fmt(SINGLE_CENTS, lang)}`;
      btn.disabled = false;
      btn.textContent = it
        ? `Acquista ${singleGuideLabel()} · ${fmt(SINGLE_CENTS, lang)}`
        : de
          ? `${singleGuideLabel()} kaufen · ${fmt(SINGLE_CENTS, lang)}`
          : `Buy ${singleGuideLabel()} · ${fmt(SINGLE_CENTS, lang)}`;
      upsell.textContent = it
        ? `Aggiungi 2 guide per attivare Pack 3 · Totale ${fmt(PACK_3_CENTS, lang)}`
        : de
          ? `Füge 2 weitere Guides hinzu, um Pack 3 zu aktivieren · Gesamt ${fmt(PACK_3_CENTS, lang)}`
          : `Add 2 guides to unlock Pack 3 · Total ${fmt(PACK_3_CENTS, lang)}`;
      return;
    }

    if (n === 2) {
      statusText.textContent = `${selectedMessage(n)} · ${fmt(customTotal, lang)}`;
      btn.disabled = false;
      btn.textContent = it
        ? `Acquista ${n} guide · ${fmt(customTotal, lang)}`
        : de
          ? `${n} Guides kaufen · ${fmt(customTotal, lang)}`
          : `Buy ${n} guides · ${fmt(customTotal, lang)}`;
      upsell.textContent = it
        ? `Aggiungi 1 guida per attivare Pack 3 · Totale ${fmt(PACK_3_CENTS, lang)}`
        : de
          ? `Füge 1 weiteren Guide hinzu, um Pack 3 zu aktivieren · Gesamt ${fmt(PACK_3_CENTS, lang)}`
          : `Add 1 more guide to unlock Pack 3 · Total ${fmt(PACK_3_CENTS, lang)}`;
      return;
    }

    if (n === 3) {
      const fullPriceCents = n * SINGLE_CENTS;
      statusText.textContent = it
        ? `${selectedMessage(n)} · Sconto Tris applicato · ${priceComparisonMessage(fullPriceCents, PACK_3_CENTS)}`
        : de
          ? `${selectedMessage(n)} · Pack 3 Rabatt aktiviert · ${priceComparisonMessage(fullPriceCents, PACK_3_CENTS)}`
          : `${selectedMessage(n)} · Pack 3 discount applied · ${priceComparisonMessage(fullPriceCents, PACK_3_CENTS)}`;
      btn.disabled = false;
      btn.textContent = it
        ? `Acquista Pack 3 Guide · ${fmt(PACK_3_CENTS, lang)}`
        : de
          ? `Pack 3 kaufen · ${fmt(PACK_3_CENTS, lang)}`
          : `Buy Pack 3 Guides · ${fmt(PACK_3_CENTS, lang)}`;
      upsell.textContent = it
        ? `Aggiungi 3 guide per attivare Pack 6 · Totale ${fmt(PACK_6_CENTS, lang)}`
        : de
          ? `Füge 3 weitere Guides hinzu, um Pack 6 zu aktivieren · Gesamt ${fmt(PACK_6_CENTS, lang)}`
          : `Add 3 more guides to unlock Pack 6 · Total ${fmt(PACK_6_CENTS, lang)}`;
      return;
    }

    if (n === 4 || n === 5) {
      statusText.textContent = `${selectedMessage(n)} · ${fmt(customTotal, lang)}`;
      btn.disabled = false;
      btn.textContent = it
        ? `Acquista ${n} guide · ${fmt(customTotal, lang)}`
        : de
          ? `${n} Guides kaufen · ${fmt(customTotal, lang)}`
          : `Buy ${n} guides · ${fmt(customTotal, lang)}`;
      upsell.textContent = it
        ? `Aggiungi ${6 - n} ${6 - n === 1 ? 'guida' : 'guide'} per attivare Pack 6 · Totale ${fmt(PACK_6_CENTS, lang)}`
        : de
          ? `Füge ${6 - n} weitere${6 - n === 1 ? 'n Guide' : ' Guides'} hinzu, um Pack 6 zu aktivieren · Gesamt ${fmt(PACK_6_CENTS, lang)}`
          : `Add ${6 - n} more guide${6 - n === 1 ? '' : 's'} to unlock Pack 6 · Total ${fmt(PACK_6_CENTS, lang)}`;
      return;
    }

    if (n === 6) {
      const pack6Label = zoneState.isSameZoneComplete
        ? (it ? 'Pack 6 Guide (Intera Zona)' : de ? 'Pack 6 (Komplette Zone)' : 'Pack 6 Guides (Complete Area)')
        : (it ? 'Pack 6 Guide' : de ? 'Pack 6' : 'Pack 6 Guides');

      statusText.textContent = zoneState.isSameZoneComplete
        ? (it
          ? `${selectedMessage(n)} · Intera Zona`
          : de
            ? `${selectedMessage(n)} · Komplette Zone`
            : `${selectedMessage(n)} · Complete Area`)
        : (it
          ? `${selectedMessage(n)} · Pack 6 applicato`
          : de
            ? `${selectedMessage(n)} · Pack 6 aktiviert`
            : `${selectedMessage(n)} · Pack 6 applied`);

      btn.disabled = false;
      btn.textContent = it
        ? `Acquista ${pack6Label} · ${fmt(PACK_6_CENTS, lang)}`
        : de
          ? `${pack6Label} kaufen · ${fmt(PACK_6_CENTS, lang)}`
          : `Buy ${pack6Label} · ${fmt(PACK_6_CENTS, lang)}`;

      upsell.textContent = zoneState.isSameZoneComplete
        ? (it
          ? 'Hai selezionato l’intera zona.'
          : de
            ? 'Du hast die komplette Zone ausgewählt.'
            : 'You selected the complete area.')
        : (it
          ? 'Pack 6 applicato su una selezione mista.'
          : de
            ? 'Pack 6 wurde auf eine gemischte Auswahl angewendet.'
            : 'Pack 6 applied to a mixed-area selection.');
      return;
    }

    if (packForCount(n) === 'puglia-completa') {
      statusText.textContent = it
        ? `${selectedMessage(n)} · Puglia Completa`
        : de
          ? `${selectedMessage(n)} · Ganz Apulien`
          : `${selectedMessage(n)} · All of Puglia`;
      btn.disabled = false;
      btn.textContent = it
        ? `Acquista Puglia Completa · ${fmt(PUGLIA_COMPLETA_CENTS, lang)}`
        : de
          ? `Ganz Apulien kaufen · ${fmt(PUGLIA_COMPLETA_CENTS, lang)}`
          : `Buy All of Puglia · ${fmt(PUGLIA_COMPLETA_CENTS, lang)}`;
      upsell.textContent = it
        ? 'Hai selezionato tutte le 18 guide della Puglia.'
        : de
          ? 'Du hast alle 18 Guides aus Apulien ausgewählt.'
          : 'You selected all 18 Puglia guides.';
      return;
    }

    statusText.textContent = `${selectedMessage(n)} · ${fmt(customTotal, lang)}`;
    btn.disabled = false;

    if (!nextTier) {
      btn.textContent = it
        ? `Acquista ${n} guide · ${fmt(customTotal, lang)}`
        : de
          ? `${n} Guides kaufen · ${fmt(customTotal, lang)}`
          : `Buy ${n} guides · ${fmt(customTotal, lang)}`;
      upsell.textContent = '';
      return;
    }

    const toNext = nextTier.count - n;
    btn.textContent = it
      ? `Acquista ${n} guide · ${fmt(customTotal, lang)}`
      : de
        ? `${n} Guides kaufen · ${fmt(customTotal, lang)}`
        : `Buy ${n} guides · ${fmt(customTotal, lang)}`;

    if (nextTier.count === 3) {
      upsell.textContent = it
        ? `Aggiungi ${toNext} ${toNext === 1 ? 'guida' : 'guide'} per attivare Pack 3 · Totale ${fmt(PACK_3_CENTS, lang)}`
        : de
          ? `Füge ${toNext} weitere${toNext === 1 ? 'n Guide' : ' Guides'} hinzu, um Pack 3 zu aktivieren · Gesamt ${fmt(PACK_3_CENTS, lang)}`
          : `Add ${toNext} more guide${toNext === 1 ? '' : 's'} to unlock Pack 3 · Total ${fmt(PACK_3_CENTS, lang)}`;
      return;
    }

    if (nextTier.count === 6) {
      upsell.textContent = it
        ? `Aggiungi ${toNext} ${toNext === 1 ? 'guida' : 'guide'} per attivare Pack 6 · Totale ${fmt(PACK_6_CENTS, lang)}`
        : de
          ? `Füge ${toNext} weitere${toNext === 1 ? 'n Guide' : ' Guides'} hinzu, um Pack 6 zu aktivieren · Gesamt ${fmt(PACK_6_CENTS, lang)}`
          : `Add ${toNext} more guide${toNext === 1 ? '' : 's'} to unlock Pack 6 · Total ${fmt(PACK_6_CENTS, lang)}`;
      return;
    }

    upsell.textContent = it
      ? `Aggiungi ${toNext} guide per arrivare a Puglia Completa · Totale ${fmt(PUGLIA_COMPLETA_CENTS, lang)}`
      : de
        ? `Füge ${toNext} Guides hinzu für Ganz Apulien · Gesamt ${fmt(PUGLIA_COMPLETA_CENTS, lang)}`
        : `Add ${toNext} guides to reach All of Puglia · Total ${fmt(PUGLIA_COMPLETA_CENTS, lang)}`;
  }

  btn.addEventListener('click', async () => {
    const n = selected.size;
    if (n === 0 || btn.disabled) return;

    const slugsArray = [...selected];
      const product = n === 1 ? 'single' : packForCount(n) ?? 'custom';

    btn.disabled = true;
    const originalText = btn.textContent;
    btn.textContent = it ? 'Apertura pagamento...' : de ? 'Zahlung wird geöffnet...' : 'Opening checkout...';

    try {
      if (typeof (window as unknown as { localisTrack?: Function }).localisTrack === 'function') {
        const params = {
          product,
          guide_count: n,
          guide_slugs: slugsArray.join(','),
          lang,
          value: checkoutValueCents(product, n) / 100,
          currency: 'EUR',
          cta_source: 'guide_builder',
        };
        (window as unknown as { localisTrack: Function }).localisTrack('begin_checkout', params);
      }
      submitCheckoutRedirect({
        product,
        lang,
        guideSlug: product === 'single' ? slugsArray[0] : undefined,
        selectedSlugs: slugsArray,
      });
    } catch (err) {
      console.error('[builder]', err);
      btn.disabled = false;
      btn.textContent = originalText;
      alert(it ? 'Impossibile aprire il pagamento. Riprova.' : de ? 'Zahlung konnte nicht geöffnet werden. Bitte erneut versuchen.' : 'Could not open checkout. Please try again.');
    }
  });
</script>
