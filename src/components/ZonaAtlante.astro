---
// Apertura e sommario delle pagine zona (Bari, Valle d'Itria, Gargano).
// L'apertura è quella dell'atlante (home, guide, masserie). Subito sotto, il
// sommario: l'elenco dei racconti È il listino. Si toccano quelli che si
// vogliono, il banco fa il conto e apre il pagamento. Niente schede prezzo
// da decifrare: 1 = singola, 3 = tris, tutti = pacchetto della zona.
import { getCollection } from 'astro:content';
import AtlanteTesta from './AtlanteTesta.astro';
import HeroAudioSample from './HeroAudioSample.astro';
import { formatMinutes, formatPrice } from '../lib/format';
import { guideDurationSeconds, guideTitle } from '../lib/guide-localization';
import { localizedHref, type Lang } from '../lib/i18n';
import { BARI_GUIDES, GARGANO_GUIDES, PRODUCT_PRICE_CENTS, VALLE_GUIDES } from '../lib/stripe-prices';

export interface Props {
  lang: Lang;
  zona: 'bari' | 'valle' | 'gargano';
  /** id della sezione sommario: resta quello storico della pagina (#prezzi, #preise). */
  ancora: string;
  occhiello: string;
  titolo: string;
  corsivo?: string;
  lede: string;
  img: string;
  alt: string;
  assaggio: string;
  assaggioSlug: string;
}
const { lang, zona, ancora, occhiello, titolo, corsivo, lede, img, alt, assaggio, assaggioSlug } = Astro.props;

const ZONE = {
  bari: { nome: 'Bari', slugs: BARI_GUIDES, pack: 'bari-completa' },
  valle: { nome: "Valle d'Itria", slugs: VALLE_GUIDES, pack: 'valle-completa' },
  gargano: { nome: 'Gargano', slugs: GARGANO_GUIDES, pack: 'gargano-completa' },
} as const;
const z = ZONE[zona];

const voci = await getCollection('guides');
const racconti = z.slugs.flatMap((slug) => {
  const d = voci.find((v) => (v.data.slug ?? v.id) === slug)?.data;
  if (!d) return [];
  // Minuti per difetto, come sulle pagine guida: così la somma del banco torna con le righe.
  return [{ slug, titolo: guideTitle(d, lang), min: Math.floor(guideDurationSeconds(d, lang) / 60) }];
});
const n = racconti.length;
const minTotali = racconti.reduce((somma, r) => somma + r.min, 0);
const prezzoUno = formatPrice(PRODUCT_PRICE_CENTS.single, lang);
const prezzoTutti = formatPrice(PRODUCT_PRICE_CENTS[z.pack], lang);

// Testi. Quelli con {segnaposto} servono anche allo script: viaggiano in data-t.
const T = {
  it: {
    scegliPill: 'Scegli i racconti', rassicura: 'Senza app · tuoi per sempre · soddisfatto o rimborsato',
    occhiello: 'Sommario', titolo: `${n === 6 ? 'Sei' : n} racconti. Scegli i tuoi.`,
    sub: `Tocca quelli che vuoi ascoltare. Uno costa ${prezzoUno}, tutti e ${n} ${prezzoTutti}.`,
    aggiungi: 'Aggiungi', scopri: 'Scopri', barra: 'Scelta e acquisto',
    altrove: 'Anche altre zone? Componi il tuo pacchetto',
    js: {
      uno: '{n} racconto', piu: '{n} racconti', tutti: 'Tutti e {n}', da: 'da {p}',
      oppure: 'Oppure tocca solo quelli che vuoi.',
      altri: 'Altri {k} per {d} in più.', altro: 'Un altro per {d} in più.',
      compreso: "L'ultimo è già compreso nel prezzo.", zona: 'Tutta la zona: risparmi {d}.',
      prendi: 'Prendi tutti e {n} · {p}', compra: 'Acquista · {p}', apre: 'Apertura pagamento…',
      scegli: 'Scegli', compraCorto: 'Acquista',
    },
  },
  en: {
    scegliPill: 'Pick your stories', rassicura: 'No app · yours forever · money-back guarantee',
    occhiello: 'Contents', titolo: `${n === 6 ? 'Six' : n} stories. Pick yours.`,
    sub: `Tap the ones you want to hear. One is ${prezzoUno}, all ${n} are ${prezzoTutti}.`,
    aggiungi: 'Add', scopri: 'Details', barra: 'Choose and buy',
    altrove: 'Other areas too? Build your own bundle',
    js: {
      uno: '{n} story', piu: '{n} stories', tutti: 'All {n}', da: 'from {p}',
      oppure: 'Or tap only the ones you want.',
      altri: '{k} more for {d} extra.', altro: 'One more for {d} extra.',
      compreso: 'The last one is already included.', zona: 'The whole area: you save {d}.',
      prendi: 'Get all {n} · {p}', compra: 'Buy · {p}', apre: 'Opening checkout…',
      scegli: 'Choose', compraCorto: 'Buy',
    },
  },
  de: {
    scegliPill: 'Erzählungen wählen', rassicura: 'Keine App · gehört dir für immer · Geld-zurück-Garantie',
    occhiello: 'Inhalt', titolo: `${n === 6 ? 'Sechs' : n} Erzählungen. Such dir deine aus.`,
    sub: `Tippe die an, die du hören willst. Eine kostet ${prezzoUno}, alle ${n} zusammen ${prezzoTutti}.`,
    aggiungi: 'Hinzufügen', scopri: 'Mehr', barra: 'Auswählen und kaufen',
    altrove: 'Auch andere Gegenden? Stell dein Paket zusammen',
    js: {
      uno: '{n} Erzählung', piu: '{n} Erzählungen', tutti: 'Alle {n}', da: 'ab {p}',
      oppure: 'Oder tippe nur die an, die du willst.',
      altri: 'Noch {k} dazu für {d} mehr.', altro: 'Noch eine dazu für {d} mehr.',
      compreso: 'Die letzte ist im Preis schon drin.', zona: 'Die ganze Gegend: du sparst {d}.',
      prendi: 'Alle {n} nehmen · {p}', compra: 'Kaufen · {p}', apre: 'Zahlung wird geöffnet…',
      scegli: 'Wählen', compraCorto: 'Kaufen',
    },
  },
} as const;
const t = T[lang];
const riempi = (testo: string, valori: Record<string, string | number>) =>
  testo.replace(/\{(\w+)\}/g, (_, chiave) => String(valori[chiave]));
const tuttiTesto = riempi(t.js.tutti, { n });
const daTesto = riempi(t.js.da, { p: prezzoUno });
---
<div class="za">
  <AtlanteTesta occhiello={occhiello} titolo={titolo} corsivo={corsivo} lede={lede} img={img} alt={alt}>
    <HeroAudioSample lang={lang} src={assaggio} guideSlug={assaggioSlug} />
    <div class="za-azioni">
      <a href={`#${ancora}`} class="za-pill" data-za-cta="zone_hero">{t.scegliPill} · {daTesto}</a>
      <span class="za-rassicura">{t.rassicura}</span>
    </div>
  </AtlanteTesta>
</div>

<section id={ancora} class="zs" data-lang={lang} data-pack={z.pack} data-t={JSON.stringify(t.js)}>
  <div class="zs-in">
    <header class="zs-testa">
      <p class="zs-occhiello">{t.occhiello} · {z.nome}</p>
      <h2>{t.titolo}</h2>
      <p class="zs-sub">{t.sub}</p>
    </header>

    <ol class="zs-lista">
      {racconti.map((r, i) => (
        <li class="zs-riga">
          <button type="button" class="zs-scegli" data-slug={r.slug} data-min={r.min} aria-pressed="false" aria-label={`${t.aggiungi}: ${r.titolo}`}>
            <span class="zs-spunta" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="5 12.5 10 17.5 19 7" /></svg>
            </span>
            <span class="zs-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span class="zs-testo">
              <span class="zs-titolo">{r.titolo}</span>
              <span class="zs-meta">{formatMinutes(r.min)} · {prezzoUno}</span>
            </span>
          </button>
          <a href={localizedHref(`/guide/${r.slug}`, lang)} class="zs-apri" aria-label={`${t.scopri}: ${r.titolo}`}><span class="zs-apri-testo">{t.scopri}</span> <span aria-hidden="true">→</span></a>
        </li>
      ))}
    </ol>
    <p class="zs-altrove"><a href={localizedHref('/guide#builder', lang)}>{t.altrove} <span aria-hidden="true">→</span></a></p>

    <div class="zs-banco">
      <div class="zs-conto" aria-live="polite">
        <p class="zs-stato">{tuttiTesto} · {formatMinutes(minTotali)}</p>
        <p class="zs-spinta">{t.js.oppure}</p>
      </div>
      <div class="zs-bottoni">
        <button type="button" class="zs-compra">{riempi(t.js.prendi, { n, p: prezzoTutti })}</button>
        <button type="button" class="zs-tutti" hidden>{tuttiTesto} · {prezzoTutti}</button>
      </div>
      <p class="zs-rassicura">{t.rassicura}</p>
    </div>
  </div>
</section>

<aside class="zs-barra" aria-label={t.barra} inert>
  <span class="zs-barra-testo">
    <span class="zs-barra-titolo">{z.nome}</span>
    <span class="zs-barra-sub">{riempi(t.js.piu, { n })} · {daTesto}</span>
  </span>
  <a href={`#${ancora}`} class="zs-barra-cta" data-za-cta="zone_bar">{t.js.scegli}</a>
</aside>

<script>
  import { submitCheckoutRedirect, type CheckoutProduct } from '../lib/checkout-client';
  import { formatMinutes, formatPrice } from '../lib/format';
  import { customPriceCents, PRODUCT_PRICE_CENTS } from '../lib/pricing';

  const sez = document.querySelector<HTMLElement>('.zs');
  const barra = document.querySelector<HTMLElement>('.zs-barra');
  if (sez && barra) {
    const lang = sez.dataset.lang as 'it' | 'en' | 'de';
    const pack = sez.dataset.pack as CheckoutProduct;
    const t = JSON.parse(sez.dataset.t!) as Record<string, string>;
    const righe = [...sez.querySelectorAll<HTMLButtonElement>('.zs-scegli')];
    const tutti = righe.length;
    const stato = sez.querySelector<HTMLElement>('.zs-stato')!;
    const spinta = sez.querySelector<HTMLElement>('.zs-spinta')!;
    const compra = sez.querySelector<HTMLButtonElement>('.zs-compra')!;
    const prendiTutti = sez.querySelector<HTMLButtonElement>('.zs-tutti')!;
    const barraTitolo = barra.querySelector<HTMLElement>('.zs-barra-titolo')!;
    const barraSub = barra.querySelector<HTMLElement>('.zs-barra-sub')!;
    const nomeZona = barraTitolo.textContent!;
    const barraCta = barra.querySelector<HTMLAnchorElement>('.zs-barra-cta')!;

    const riempi = (testo: string, valori: Record<string, string | number>) =>
      testo.replace(/\{(\w+)\}/g, (_, chiave) => String(valori[chiave]));
    const euro = (cents: number) => formatPrice(cents, lang);
    const racconti = (k: number) => riempi(k === 1 ? t.uno : t.piu, { n: k });

    // Stessa aritmetica del server (/api/checkout): tutti = pacchetto della zona,
    // 3 = tris, il resto è selezione libera col suo tetto.
    const prezzoPack = PRODUCT_PRICE_CENTS[pack];
    const prezzo = (k: number) => (k === tutti ? prezzoPack : customPriceCents(k));
    const prodotto = (k: number): CheckoutProduct => (k === tutti ? pack : k === 1 ? 'single' : k === 3 ? 'tris' : 'custom');

    const scelti = () => righe.filter((r) => r.getAttribute('aria-pressed') === 'true');

    // La barra sale quando i bottoni veri (apertura, banco) non sono a schermo:
    // sempre fuori dal sommario, e dentro il sommario appena c'è una scelta.
    const pill = document.querySelector('.za-pill');
    const aSchermo = new Set<Element>();
    function mostraBarra() {
      const su = !(pill && aSchermo.has(pill)) && !aSchermo.has(compra) && (scelti().length > 0 || !aSchermo.has(sez!));
      barra!.classList.toggle('is-su', su);
      barra!.inert = !su;
    }

    function aggiorna() {
      const sel = scelti();
      const k = sel.length;
      const minuti = (k ? sel : righe).reduce((somma, r) => somma + Number(r.dataset.min), 0);
      const pieno = k === 0 || k === tutti;

      stato.textContent = `${pieno ? riempi(t.tutti, { n: tutti }) : racconti(k)} · ${formatMinutes(minuti)}`;
      compra.disabled = false;
      compra.textContent = pieno ? riempi(t.prendi, { n: tutti, p: euro(prezzoPack) }) : riempi(t.compra, { p: euro(prezzo(k)) });
      prendiTutti.hidden = pieno;

      if (k === 0) {
        spinta.textContent = t.oppure;
      } else if (k === tutti) {
        spinta.textContent = riempi(t.zona, { d: euro(tutti * PRODUCT_PRICE_CENTS.single - prezzoPack) });
      } else {
        // Il prossimo scalino: il tris fino a due, poi tutta la zona.
        const scalino = k < 3 && tutti > 3 ? 3 : tutti;
        const mancano = scalino - k;
        const inPiu = prezzo(scalino) - prezzo(k);
        spinta.textContent = inPiu === 0 ? t.compreso : riempi(mancano === 1 ? t.altro : t.altri, { k: mancano, d: euro(inPiu) });
      }

      // Con una scelta fatta la barra è il banco: conto in alto, scalino sotto.
      barra!.classList.toggle('is-scelta', k > 0);
      barraTitolo.textContent = k ? `${racconti(k)} · ${euro(prezzo(k))}` : nomeZona;
      barraSub.textContent = k ? spinta.textContent : `${racconti(tutti)} · ${riempi(t.da, { p: euro(PRODUCT_PRICE_CENTS.single) })}`;
      barraCta.textContent = k ? t.compraCorto : t.scegli;
      mostraBarra();
    }

    function paga() {
      const sel = scelti();
      const slugs = (sel.length ? sel : righe).map((r) => r.dataset.slug!);
      const k = slugs.length;
      const product = prodotto(k);
      compra.disabled = true;
      compra.textContent = t.apre;
      window.localisTrack?.('begin_checkout', {
        product,
        guide_count: k,
        guide_slugs: slugs.join(','),
        lang,
        value: prezzo(k) / 100,
        currency: 'EUR',
        cta_source: 'zone_sommario',
      });
      submitCheckoutRedirect({ product, lang, guideSlug: product === 'single' ? slugs[0] : undefined, selectedSlugs: slugs });
    }

    righe.forEach((riga) => {
      riga.addEventListener('click', () => {
        riga.setAttribute('aria-pressed', riga.getAttribute('aria-pressed') === 'true' ? 'false' : 'true');
        aggiorna();
      });
    });
    prendiTutti.addEventListener('click', () => {
      righe.forEach((r) => r.setAttribute('aria-pressed', 'true'));
      aggiorna();
    });
    compra.addEventListener('click', paga);
    // Con una scelta fatta la barra paga subito; senza, riporta al sommario (il link fa il suo).
    barraCta.addEventListener('click', (e) => {
      if (!scelti().length) return;
      e.preventDefault();
      paga();
    });
    // Tornando indietro dal pagamento il bottone non deve restare su "Apertura…".
    window.addEventListener('pageshow', aggiorna);

    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => (e.isIntersecting ? aSchermo.add(e.target) : aSchermo.delete(e.target)));
      mostraBarra();
    });
    [pill, compra, sez].forEach((el) => el && io.observe(el));

    // Il banner dei cookie sta in basso anche lui: la barra gli si appoggia sopra.
    const banner = document.getElementById('cookie-banner');
    if (banner) {
      new ResizeObserver(() => {
        barra.style.setProperty('--zs-sotto', `${banner.offsetHeight}px`);
      }).observe(banner);
    }

    document.querySelectorAll<HTMLElement>('[data-za-cta]').forEach((a) => {
      a.addEventListener('click', () => {
        window.localisTrack?.('cta_click', { cta_source: a.dataset.zaCta!, lang });
      });
    });
  }
</script>

<style>
  /* ---------- apertura ---------- */
  .za :global(.at-foto) { min-height: clamp(24rem, 62vh, 36rem); }
  .za :global(.at-testo h1) { font-size: var(--text-4xl); line-height: 1.05; }
  .za :global(.at-lede) { font-size: 1.08rem; }
  .za :global(.hero-sample) { margin-top: 1.3rem; }
  .za-azioni { display: flex; flex-wrap: wrap; align-items: center; gap: 0.7rem 1.2rem; margin-top: 1.1rem; }
  .za-pill {
    display: inline-flex; align-items: center; min-height: 48px; padding: 0.85rem 1.45rem; border-radius: 999px;
    background: var(--color-olive); color: #fbfaf6; font-weight: 600; text-decoration: none;
    transition: background 0.25s, transform 0.25s;
  }
  .za-pill:hover { background: var(--color-olive-d); transform: translateY(-1px); }
  .za-rassicura { font-size: 0.8rem; color: rgba(251,250,246,0.82); }

  /* ---------- sommario ---------- */
  .zs { scroll-margin-top: 4.5rem; }
  .zs-in { max-width: 80rem; margin: 0 auto; padding: 2.75rem 1rem 3rem; display: grid; gap: 1.5rem; }
  .zs-occhiello { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: var(--color-accent); margin-bottom: 0.6rem; }
  .zs-testa h2 { font-family: var(--font-display); font-weight: 400; font-size: clamp(1.9rem, 4.4vw, 2.8rem); line-height: 1.08; letter-spacing: -0.015em; color: var(--color-ink); }
  .zs-sub { margin-top: 0.6rem; color: var(--color-ink-muted); max-width: 34rem; }

  .zs-lista { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--color-ink); }
  .zs-riga { display: flex; align-items: stretch; border-bottom: 1px solid var(--color-border-2); transition: background 0.2s; }
  .zs-riga:has([aria-pressed='true']) { background: var(--color-surface-elev); }
  .zs-scegli {
    flex: 1; min-width: 0; display: flex; align-items: center; gap: 0.65rem; min-height: 60px;
    padding: 0.6rem 0.25rem 0.6rem 0.35rem; background: none; border: none; text-align: left; cursor: pointer; color: inherit;
  }
  .zs-spunta {
    flex-shrink: 0; width: 26px; height: 26px; border-radius: 50%; border: 1.5px solid var(--color-ink-subtle);
    display: flex; align-items: center; justify-content: center; color: transparent;
    transition: background 0.2s, border-color 0.2s, color 0.2s, transform 0.2s;
  }
  [aria-pressed='true'] .zs-spunta { background: var(--color-olive); border-color: var(--color-olive); color: #fbfaf6; transform: scale(1.08); }
  .zs-num { flex-shrink: 0; font-family: var(--font-display); font-style: italic; font-size: 1rem; color: var(--color-accent); }
  .zs-testo { min-width: 0; display: flex; flex-direction: column; gap: 0.15rem; }
  .zs-titolo { font-family: var(--font-display); font-size: 1.04rem; line-height: 1.22; color: var(--color-ink); text-wrap: balance; }
  .zs-meta { font-size: 0.74rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-ink-subtle); }
  .zs-apri {
    flex-shrink: 0; display: inline-flex; align-items: center; justify-content: center; gap: 0.25rem; min-width: 44px; padding: 0 0.4rem;
    font-size: 0.8rem; font-weight: 600; color: var(--color-link); text-decoration: none; white-space: nowrap;
  }
  .zs-apri:hover { color: var(--color-link-pressed); }
  /* Su telefono resta la freccia: la scritta ruberebbe una riga al titolo. */
  @media (max-width: 479px) { .zs-apri-testo { display: none; } .zs-apri { font-size: 1.05rem; } }
  .zs-altrove { margin-top: -0.6rem; font-size: 0.86rem; }
  .zs-altrove a { color: var(--color-link); }
  .zs-scegli:focus-visible, .zs-apri:focus-visible, .zs-compra:focus-visible, .zs-tutti:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }

  /* Il banco chiude l'elenco. Niente sticky: html e body hanno overflow-x: hidden, che lo
     spegne in tutto il sito. Su telefono, a scelta fatta, il conto lo porta la barra fissa. */
  .zs-banco {
    display: grid; gap: 0.75rem; padding: 1rem 1.1rem 1.05rem; border-radius: 18px;
    background: #1c1813; color: #fbfaf6; box-shadow: 0 18px 40px -22px rgba(28,24,19,0.7);
  }
  .zs-stato { font-family: var(--font-display); font-size: 1.25rem; line-height: 1.2; }
  .zs-spinta { margin-top: 0.2rem; font-size: 0.86rem; color: #e8d3a3; min-height: 1.3em; }
  .zs-bottoni { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .zs-compra {
    flex: 1 1 12rem; min-height: 50px; padding: 0.8rem 1.3rem; border: none; border-radius: 999px; cursor: pointer;
    background: #fbfaf6; color: var(--color-olive-d); font-weight: 700; font-size: 1rem;
    transition: transform 0.2s, background 0.2s;
  }
  .zs-compra:hover:not(:disabled) { background: #fff; transform: translateY(-1px); }
  .zs-compra:disabled { opacity: 0.7; cursor: progress; }
  .zs-tutti {
    flex: 0 1 auto; min-height: 50px; padding: 0.8rem 1.1rem; border-radius: 999px; cursor: pointer;
    background: none; border: 1px solid rgba(232,211,163,0.6); color: #e8d3a3; font-weight: 600; font-size: 0.92rem;
  }
  .zs-tutti:hover { border-color: #e8d3a3; }
  .zs-rassicura { font-size: 0.74rem; color: rgba(251,250,246,0.68); }

  @media (min-width: 960px) {
    .zs-in { grid-template-columns: minmax(0, 1.55fr) minmax(19rem, 1fr); grid-template-areas: 'testa banco' 'lista banco' 'altrove banco'; column-gap: 3.5rem; padding: 4rem 1rem 4.5rem; }
    .zs-altrove { grid-area: altrove; }
    .zs-testa { grid-area: testa; }
    .zs-lista { grid-area: lista; }
    .zs-banco { grid-area: banco; align-self: start; padding: 1.5rem; gap: 1rem; }
    .zs-stato { font-size: 1.5rem; }
    .zs-titolo { font-size: 1.25rem; }
  }

  /* ---------- barra (telefono e tablet), quando il sommario non è a schermo ---------- */
  .zs-barra {
    position: fixed; left: 0; right: 0; bottom: var(--zs-sotto, 0px); z-index: 40;
    display: flex; align-items: center; gap: 0.75rem;
    padding: 0.65rem 1rem calc(0.65rem + env(safe-area-inset-bottom, 0px));
