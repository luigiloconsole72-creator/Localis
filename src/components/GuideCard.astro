---
import { localizedHref, type Lang } from '../lib/i18n';
import { formatDuration, formatPrice } from '../lib/format';
import type { CollectionEntry } from 'astro:content';
import { guideDurationSeconds, guideSubtitle, guideTitle } from '../lib/guide-localization';

export interface Props {
  guide: CollectionEntry<'guides'>;
  lang: Lang;
  index: number;
}

const { guide, lang, index } = Astro.props;
const data = guide.data;
const title = guideTitle(data, lang);
const subtitle = guideSubtitle(data, lang);
const isSoon = data.status === 'soon';
const href = isSoon ? '#' : localizedHref(`/guide/${data.slug}`, lang);

const chapterCount = data.chapters.length;
const durationLabel = formatDuration(guideDurationSeconds(data, lang));
const priceLabel = formatPrice(data.price_cents, lang);
const indexLabel = String(index + 1).padStart(2, '0');
---
<a
  href={href}
  class={`guide-card-link group relative flex flex-col bg-surface-elev border border-border rounded-lg overflow-hidden transition-colors duration-med hover:border-accent/40 ${isSoon ? 'opacity-60 pointer-events-none' : ''}`}
  aria-label={title}
  aria-disabled={isSoon}
>
  <div class="relative overflow-hidden bg-ink/5 h-[clamp(16rem,24vw,21rem)]">
    <img
      src={data.cover}
      alt=""
      loading="lazy"
      decoding="async"
      class="w-full h-full object-cover"
    />
    {isSoon && (
      <div class="absolute top-sm right-sm bg-ink/80 text-surface text-xs uppercase tracking-widest font-semibold px-sm py-2xs rounded-full backdrop-blur-sm">
        {lang === 'it' ? 'Presto' : lang === 'de' ? 'Bald' : 'Soon'}
      </div>
    )}
  </div>

  <div class="flex-1 flex flex-col gap-sm p-md">
    <div class="flex items-center gap-sm text-xs font-semibold tracking-[0.18em] uppercase text-ink-subtle">
      <span>N° {indexLabel}</span>
      <span class="text-border">·</span>
      <span>{durationLabel}</span>
      <span class="text-border">·</span>
      <span>{lang === 'de' ? `${chapterCount} Kap.` : `${chapterCount} cap.`}</span>
    </div>

    <h3 class="guide-card-title font-display text-2xl font-normal leading-tight text-ink">
      {title}
    </h3>

    <p class="guide-card-subtitle text-sm text-ink-muted leading-relaxed">{subtitle}</p>

    <p class="text-[0.72rem] text-ink-subtle leading-none mt-auto italic">
      {lang === 'it' ? 'Voce sintetizzata · Testo scritto da Domenico e Luigi Loconsole' : lang === 'de' ? 'Synthetische Stimme · Text von Domenico und Luigi Loconsole' : 'Synthetic voice · Written by Domenico & Luigi Loconsole'}
    </p>

    <div class="flex items-center justify-between pt-sm">
      <span class="font-display text-lg italic text-accent">{priceLabel}</span>
      {!isSoon && (
        <span class="font-body text-xs uppercase tracking-widest font-semibold text-ink-subtle group-hover:text-ink transition-colors duration-fast">
          {lang === 'it' ? 'Ascolta →' : lang === 'de' ? 'Anhören →' : 'Listen →'}
        </span>
      )}
    </div>
  </div>
</a>

<style>
  .guide-card-link {
    text-decoration: none;
    height: 100%;
  }

  .guide-card-title,
  .guide-card-subtitle {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .guide-card-title {
    -webkit-line-clamp: 3;
    min-height: calc(1.25em * 3);
  }

  .guide-card-subtitle {
    -webkit-line-clamp: 3;
    min-height: calc(1.6em * 3);
  }
</style>
