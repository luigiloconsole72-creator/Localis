---
import { type Lang } from '../lib/i18n';
import LangPills from './LangPills.astro';
import HeroAudioSample from './HeroAudioSample.astro';

export interface Props {
  lang: Lang;
  currentPath?: string;
}

const { lang, currentPath = '/' } = Astro.props;


const heading1a = lang === 'de' ? 'Apulien, erzählt' : lang === 'it' ? 'La Puglia, raccontata' : 'Puglia, in the words';
const heading1b = lang === 'de' ? 'von Menschen, die hier leben.' : lang === 'it' ? 'da chi ci vive.' : 'of the people who live here.';

const lede1 = lang === "de"
  ? `Dokumentierte Audioerzählungen, um Bari und Apulien während des Besuchs wirklich zu verstehen. Keine App.`
  : lang === "it"
  ? `Racconti audio documentati per capire Bari e la Puglia mentre le visiti. Nessuna app.`
  : `Documented audio stories to understand Bari and Puglia as you visit. No app needed.`;

const ctaSecondary = lang === "de" ? "Erzählungen entdecken" : lang === "it" ? "Scopri le guide" : "Explore the stories";
const ctaSecondaryHref = lang === "de" ? "/de/guide" : lang === "it" ? "/guide" : "/en/guide";

const altText = lang === 'de'
  ? 'Eine junge Frau mit Kopfhörern auf Baris Lungomare bei Sonnenuntergang'
  : lang === 'it'
  ? 'Una ragazza con cuffie sul lungomare di Bari al tramonto: cattedrale e palazzi storici a destra, sole che cala sul mare a sinistra'
  : 'A young woman with headphones on Bari\'s lungomare at sunset: cathedral and historic buildings to the right, sun setting over the sea to the left';
---
<section class="hero relative" aria-label="Localis — audioguide narrative della Puglia">

  <!-- Full-bleed background image -->
  <img
    src="/images/hero/landing-puglia.jpg"
    alt={altText}
    class="hero-bg"
    width="1980"
    height="1056"
    loading="eager"
    fetchpriority="high"
    decoding="async"
  />

  <!-- Gradient scrim for text legibility on the left half -->
  <div class="hero-scrim" aria-hidden="true"></div>


  <!-- Content overlay — anchored left -->
  <div class="hero-content">
    <LangPills lang={lang} currentPath={currentPath} />
    <h1 class="hero-h1 font-display text-ink leading-[0.96] tracking-[-0.018em] m-0">
      <span class="hero-h1-a block font-light text-[clamp(2rem,5.6vw,4.4rem)]">{heading1a}</span>
      {heading1b && <span class="hero-h1-b block font-light text-[clamp(2rem,5.6vw,4.4rem)]">{heading1b}</span>}
    </h1>

    <p class="hero-lede mt-md font-display italic text-ink text-[clamp(1.05rem,1.8vw,1.35rem)] leading-snug max-w-[42ch]">
      {lede1}
    </p>

    <HeroAudioSample lang={lang} src={lang === 'en' ? '/audio/trailers/home-trailer-en.mp3' : lang === 'de' ? '/audio/trailers/home-trailer-de.mp3' : '/audio/trailers/home-trailer-it.mp3'} />

    <div class="hero-actions mt-lg flex flex-col sm:flex-row gap-sm flex-wrap">
      <a
        href={ctaSecondaryHref}
        class="inline-flex items-center justify-center gap-xs px-lg py-md rounded-md font-semibold text-sm bg-ink text-surface hover:bg-ink/90 transition-[background-color,transform] duration-fast hover:-translate-y-[1px] active:translate-y-0 no-underline min-h-[48px]"
      >
        {ctaSecondary}
      </a>
    </div>

  </div>


</section>

<style>
  .hero {
    --max-w: 1280px;
    --side-gutter: max(var(--spacing-lg), calc((100vw - var(--max-w)) / 2 + var(--spacing-lg)));

    position: relative;
    width: 100%;
    min-height: clamp(560px, 78vh, 820px);
    display: grid;
    grid-template-rows: auto 1fr auto;
    overflow: hidden;
    isolation: isolate;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center right;
    z-index: 0;
    filter: saturate(0.96) contrast(1.02);
  }

  /* Scrim — fades cream surface from left to transparent at ~65% */
  .hero-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(
        to right,
        oklch(from var(--color-surface) l c h / 0.96) 0%,
        oklch(from var(--color-surface) l c h / 0.88) 28%,
        oklch(from var(--color-surface) l c h / 0.55) 52%,
        oklch(from var(--color-surface) l c h / 0) 72%
      );
    pointer-events: none;
  }

  /* Vertical scrim on mobile so text reads over the photo */
  @media (max-width: 900px) {
    .hero-scrim {
      background:
        linear-gradient(
          to bottom,
          oklch(from var(--color-surface) l c h / 0.94) 0%,
          oklch(from var(--color-surface) l c h / 0.78) 45%,
          oklch(from var(--color-surface) l c h / 0.55) 75%,
          oklch(from var(--color-surface) l c h / 0.4) 100%
        );
    }
    .hero-bg { object-position: 70% center; }
  }

  .hero-content {
    position: relative;
    z-index: 2;
    padding-inline-start: var(--side-gutter);
    padding-inline-end: var(--spacing-lg);
    padding-block: clamp(var(--spacing-2xl), 6vw, var(--spacing-4xl));
    /* Total column width = left gutter + 620 content + small right breathing — content stays anchored left.
     * Caps at 100% on narrow viewports so it never overflows. */
    width: min(100%, calc(var(--side-gutter) + 620px + var(--spacing-lg)));
    display: flex;
    flex-direction: column;
  }
  @media (max-width: 900px) {
    .hero-content {
      padding-inline-end: var(--side-gutter);
      width: 100%;
    }
  }

  /* === Reveal animations === */
  .hero-h1 > span {
    opacity: 0;
    transform: translateY(14px);
    animation: heroIn 0.75s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }
  .hero-h1-a { animation-delay: 0.35s; }
  .hero-h1-b { animation-delay: 0.55s; }
  .hero-lede,
  :global(.hero-sample),
  .hero-actions {
    opacity: 0;
    transform: translateY(10px);
    animation: heroIn 0.6s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }
  .hero-lede     { animation-delay: 0.75s; }
  :global(.hero-sample) { animation-delay: 0.9s; }
  .hero-actions  { animation-delay: 1.05s; }

  @keyframes heroIn { to { opacity: 1; transform: translateY(0); } }

  @media (max-width: 768px) {
    /* animations */
    .hero-h1-a { animation-delay: 0.1s; animation-duration: 0.5s; }
    .hero-h1-b { animation-delay: 0.25s; animation-duration: 0.5s; }
    .hero-lede { animation-delay: 0.35s; animation-duration: 0.4s; }
    :global(.hero-sample) { animation-delay: 0.45s; animation-duration: 0.4s; }
    .hero-actions { animation-delay: 0.55s; animation-duration: 0.4s; }

    /* legibility */
    .hero-lede {
      font-size: 1.2rem;
      line-height: 1.5;
      margin-top: var(--spacing-lg);
    }
    :global(.hero-sample),
    .hero-actions {
      margin-top: var(--spacing-xl);
      gap: var(--spacing-md);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-h1 > span,
    .hero-lede,
    :global(.hero-sample),
    .hero-actions {
      animation: none;
      transform: none;
      opacity: 1;
    }
  }
</style>
