---
export const prerender = true;
import Layout from '../../components/Layout.astro';
import HeroAudioSample from '../../components/HeroAudioSample.astro';
---
<Layout
  title="Welcome, Viking Vesta Guests — Bari Audio Guide | Localis"
  description="A special welcome for Viking Vesta passengers in Bari. Two audio stories of the old town — no app, no account."
  lang="en"
  ogImage="/images/covers/porto-bari-vesta.png"
  langUrlsOverride={{ en: '/en/vesta/' }}
>

  {/* ── HERO ── */}
  <section id="hero-vesta" class="relative overflow-hidden border-b border-border">
    <img
      src="/images/covers/porto-bari-vesta.png"
      alt="Passengers disembarking at Bari port"
      class="absolute inset-0 w-full h-full object-cover object-center"
      width="1980"
      height="900"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <div class="vesta-scrim" aria-hidden="true"></div>
    <div class="max-w-wrap mx-auto px-md py-3xl lg:py-4xl relative z-10">
      <div class="flex items-center gap-sm mb-md">
        <span class="block w-7 h-px bg-accent"></span>
        <span class="text-[11px] font-semibold tracking-[0.24em] uppercase text-accent">Viking Vesta · Bari port call</span>
      </div>
      <h1 class="font-display font-light leading-[1.05] tracking-[-0.014em] text-[clamp(2.2rem,5vw,3.6rem)] max-w-[22ch]" style="color:oklch(12% 0.005 240)">
        Bari is waiting.<br />Here's how to hear it.
      </h1>
      <p class="font-body text-base sm:text-lg leading-relaxed mt-md max-w-[54ch]" style="color:oklch(22% 0.008 240 / 0.88)">
        Two audio stories of Bari — the old town and its food culture — in a compact walk from the pier. No app. No account. Just scan and listen.
      </p>

      <HeroAudioSample lang="en" src="/audio/trailers/bari/bari-vecchia-trailer-en.mp3" guideSlug="bari-vecchia" />

      <div class="flex flex-col sm:flex-row gap-sm mt-lg">
        <button
          id="vesta-checkout-btn"
          class="inline-flex items-center justify-center gap-xs px-lg py-md bg-ink text-surface rounded-md font-semibold text-sm hover:bg-ink/90 transition-[background-color,transform] duration-fast hover:-translate-y-[1px] active:translate-y-0 min-h-[48px]"
          data-product="crociera"
          data-lang="en"
        >
          Get the Bari Cruise Pack — €7.99
        </button>
      </div>
    </div>
  </section>

  <style>
    #hero-vesta {
      min-height: clamp(280px, 48vh, 520px);
      display: flex;
      align-items: center;
    }
    .vesta-scrim {
      position: absolute;
      inset: 0;
      background: linear-gradient(
        to right,
        oklch(from var(--color-surface) l c h / 0.92) 0%,
        oklch(from var(--color-surface) l c h / 0.70) 40%,
        oklch(from var(--color-surface) l c h / 0.20) 75%,
        oklch(from var(--color-surface) l c h / 0) 100%
      );
      pointer-events: none;
    }
    @media (max-width: 768px) {
      .vesta-scrim {
        background: linear-gradient(
          to bottom,
          oklch(from var(--color-surface) l c h / 0.94) 0%,
          oklch(from var(--color-surface) l c h / 0.80) 60%,
          oklch(from var(--color-surface) l c h / 0.60) 100%
        );
      }
    }
  </style>

  {/* ── WHAT YOU GET ── */}
  <section class="bg-surface py-xl lg:py-3xl border-b border-border">
    <div class="max-w-wrap mx-auto px-md">
      <h2 class="font-display font-light text-ink text-[clamp(1.5rem,3vw,2.2rem)] leading-tight tracking-[-0.01em] text-center mb-xl">
        Two chapters. One morning you'll remember.
      </h2>
      <div class="grid sm:grid-cols-2 gap-lg">
        <div class="bg-surface-elev rounded-lg overflow-hidden border border-border flex flex-col">
          <div class="aspect-[3/4] overflow-hidden">
            <img
              src="/images/covers/bari-vecchia.jpg"
              alt="Old Bari — Inside the City"
              class="w-full h-full object-cover object-top"
              width="1024"
              height="1536"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="p-md flex flex-col gap-xs flex-1">
            <span class="text-[11px] font-semibold tracking-[0.18em] uppercase text-ink-subtle">21 minutes</span>
            <h3 class="font-display font-light text-ink text-xl leading-snug">Old Bari — Inside the City</h3>
            <p class="font-body text-sm text-ink-muted leading-relaxed">
              Starts at Strada delle Crociate. The ancient quarter chapter by chapter: Basilica of San Nicola, the narrow streets, the cathedral. Real history, not the standard tourist guide.
            </p>
          </div>
        </div>
        <div class="bg-surface-elev rounded-lg overflow-hidden border border-border flex flex-col">
          <div class="aspect-[3/4] overflow-hidden">
            <img
              src="/images/covers/il-meglio-di-bari.jpg"
              alt="Bari at the Table — The Food that Holds the City Together"
              class="w-full h-full object-cover object-top"
              width="1024"
              height="1536"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="p-md flex flex-col gap-xs flex-1">
            <span class="text-[11px] font-semibold tracking-[0.18em] uppercase text-ink-subtle">28 minutes</span>
            <h3 class="font-display font-light text-ink text-xl leading-snug">Bari at the Table — The Food that Holds the City Together</h3>
            <p class="font-body text-sm text-ink-muted leading-relaxed">
              Starts at Strada Arco Basso. The seafront, the fish market, the panzerotti. The places locals never explain — because they take them for granted.
            </p>
          </div>
        </div>
      </div>
      <p class="font-body text-sm text-ink-muted text-center mt-lg">
        49 minutes of audio plus walking time. Total 3–4 hours, back on board included.
      </p>
    </div>
  </section>

  {/* ── HOW IT WORKS ── */}
  <section class="bg-surface-elev py-xl lg:py-3xl border-b border-border">
    <div class="max-w-wrap mx-auto px-md">
      <h2 class="font-display font-light text-ink text-[clamp(1.5rem,3vw,2.2rem)] leading-tight tracking-[-0.01em] text-center mb-xl">
        You're in in two minutes.
      </h2>
      <div class="grid sm:grid-cols-3 gap-lg mb-xl">
        <div class="flex flex-col gap-sm">
          <span class="font-display font-light text-accent text-4xl leading-none">01</span>
          <h3 class="font-display font-light text-ink text-lg leading-snug">Buy</h3>
          <p class="font-body text-sm text-ink-muted leading-relaxed">
            Pay by card at checkout. No registration required.
          </p>
        </div>
        <div class="flex flex-col gap-sm">
          <span class="font-display font-light text-accent text-4xl leading-none">02</span>
          <h3 class="font-display font-light text-ink text-lg leading-snug">Open the link</h3>
          <p class="font-body text-sm text-ink-muted leading-relaxed">
            Arrives by email. No app to download, no account to create. Works directly in your browser.
          </p>
        </div>
        <div class="flex flex-col gap-sm">
          <span class="font-display font-light text-accent text-4xl leading-none">03</span>
          <h3 class="font-display font-light text-ink text-lg leading-snug">Walk and listen</h3>
          <p class="font-body text-sm text-ink-muted leading-relaxed">
            Hands free for photos and coffee. The guide walks you through Bari step by step.
          </p>
        </div>
      </div>

      {/* ── REPEAT OFFER + CTA ── */}
      <div class="bg-surface rounded-lg border border-accent/40 p-lg flex flex-col sm:flex-row items-center justify-between gap-md">
        <div>
          <p class="font-body text-sm text-ink-subtle mb-xs">Bari Cruise Pack</p>
          <p class="font-body text-ink">
            Two audio stories of Bari · <strong>€7.99</strong>
          </p>
        </div>
        <button
          class="vesta-cta-btn inline-flex items-center justify-center gap-xs px-lg py-md bg-accent text-white rounded-md font-semibold text-sm hover:bg-accent/90 transition-[background-color,transform] duration-fast hover:-translate-y-[1px] active:translate-y-0 min-h-[48px] shrink-0"
          data-product="crociera"
          data-lang="en"
        >
          Get the Bari Cruise Pack
        </button>
      </div>
    </div>
  </section>

  {/* ── CLOSER ── */}
  <section class="bg-surface py-xl lg:py-3xl">
    <div class="max-w-narrow mx-auto px-md text-center">
      <blockquote class="font-display font-light text-ink text-[clamp(1.2rem,2.5vw,1.7rem)] leading-relaxed tracking-[-0.01em] italic mb-xl">
        "We're not selling you a tour. We're selling you the right words — to listen to whenever you want, on a morning that's yours."
      </blockquote>
      <button
        class="vesta-cta-btn inline-flex items-center justify-center gap-xs px-lg py-md bg-accent text-white rounded-md font-semibold text-sm hover:bg-accent/90 transition-[background-color,transform] duration-fast hover:-translate-y-[1px] active:translate-y-0 min-h-[48px] mb-md"
        data-product="crociera"
        data-lang="en"
      >
        Get the Bari Cruise Pack — €7.99
      </button>
      <p class="font-body text-xs text-ink-subtle leading-relaxed">
        No app · Offline · Yours forever · Money-back, no questions asked
      </p>
    </div>
  </section>

  {/* ── STICKY CTA MOBILE ── */}
  <div
    id="sticky-cta"
    class="fixed left-0 right-0 z-50 md:hidden bg-surface border-t border-border px-md py-sm shadow-lg translate-y-full transition-transform duration-300"
    style="bottom: var(--cookie-banner-height, 0px);"
    aria-hidden="true"
  >
    <button
      class="vesta-cta-btn w-full inline-flex items-center justify-center gap-xs px-lg py-md bg-accent text-white rounded-md font-semibold text-sm min-h-[48px]"
      data-product="crociera"
      data-lang="en"
    >
      Bari Cruise Pack — €7.99
    </button>
  </div>

</Layout>

<script>
  import { submitCheckoutRedirect } from '../../lib/checkout-client';

  document.querySelectorAll<HTMLButtonElement>('#vesta-checkout-btn, .vesta-cta-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      btn.disabled = true;
      const orig = btn.textContent;
      btn.textContent = 'Loading…';
      try {
        if (typeof window.localisTrack === 'function') {
          window.localisTrack('begin_checkout', {
            product: 'crociera',
            guide_count: 2,
            guide_slugs: 'bari-vecchia,bari-tavola',
            lang: 'en',
            value: 7.99,
            currency: 'EUR',
            cta_source: 'vesta',
          });
        }
        submitCheckoutRedirect({ product: 'crociera', lang: 'en' });
      } catch {
        btn.disabled = false;
        btn.textContent = orig;
        alert('Checkout error. Please try again in a moment.');
      }
    });
  });

  const hero = document.getElementById('hero-vesta');
  const stickyCta = document.getElementById('sticky-cta');
  if (hero && stickyCta) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) {
          stickyCta.classList.remove('translate-y-full');
          stickyCta.removeAttribute('aria-hidden');
        } else {
          stickyCta.classList.add('translate-y-full');
          stickyCta.setAttribute('aria-hidden', 'true');
        }
      },
      { threshold: 0 }
    );
    observer.observe(hero);
  }
</script>
