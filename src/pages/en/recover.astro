---
export const prerender = true;
import Layout from '../../components/Layout.astro';
---
<Layout title="Get your access back · Localis" lang="en" robots="noindex,nofollow" langUrlsOverride={{ it: '/recover/', en: '/en/recover/', de: '/de/recover/' }}>
  <div class="max-w-narrow mx-auto px-md py-3xl">
    <h1 class="font-display text-4xl text-ink mb-md">Get your story back</h1>
    <p class="text-base text-ink-muted mb-xl max-w-prose">
      Lost the email, or the link stopped working? Enter the same address you used at checkout. A new link lands in your inbox in about 30 seconds.
    </p>

    <form id="recover-form" class="flex flex-col gap-md max-w-[28rem]">
      <label for="email" class="text-sm font-semibold text-ink">Email used at checkout</label>
      <input
        type="email"
        id="email"
        name="email"
        required
        placeholder="you@example.com"
        class="px-md py-sm bg-surface border border-border rounded-md text-base focus:border-accent focus:outline-none"
      />
      <button
        type="submit"
        class="px-md py-sm bg-ink text-surface rounded-md font-semibold text-sm hover:bg-ink/90 transition-colors duration-fast"
      >
        Send me the link
      </button>
    </form>

    <div id="recover-result" class="mt-lg max-w-[28rem] hidden">
      <p class="text-base text-success">Email sent. Check your inbox — and the spam folder.</p>
    </div>
  </div>
</Layout>

<script>
  const form = document.getElementById('recover-form') as HTMLFormElement | null;
  const result = document.getElementById('recover-result');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const email = data.get('email');

    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    submit.disabled = true;
    submit.textContent = 'Sending...';

    try {
      const res = await fetch('/api/recover', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, lang: 'en' }),
      });

      if (res.status === 429) {
        alert('Too many requests. Please try again in an hour.');
        submit.disabled = false;
        submit.textContent = 'Send me the link';
        return;
      }

      // Success is always shown, whether or not the email matched (privacy).
      form.style.display = 'none';
      result?.classList.remove('hidden');
    } catch (err) {
      console.error('[recover]', err);
      alert('Network error. Please try again.');
      submit.disabled = false;
      submit.textContent = 'Send me the link';
    }
  });
</script>
