---
export const prerender = true;
import Layout from '../../components/Layout.astro';
import SectionDivider from '../../components/SectionDivider.astro';
import PriceCard from '../../components/PriceCard.astro';
import StepsBlock from '../../components/StepsBlock.astro';
import LangPills from '../../components/LangPills.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import HeroAudioSample from '../../components/HeroAudioSample.astro';
import StructuredData from '../../components/StructuredData.astro';
import { itemListLD } from '../../lib/seo';

interface GuideEntry {
  slug: string;
  title: string;
  subtitle: string;
  places: string;
  narrator: string;
  cover: string;
  alt: string;
  price?: string;
}

const guides: GuideEntry[] = [
  {
    slug: 'gargano-vieste',
    title: 'Vieste — The City on the Cliff',
    subtitle: 'Cliffs, legends and white stone: the city that looks out to sea from above.',
    places: 'Vieste · Pugnochiuso · trabucchi · sea caves',
    narrator: 'Rossella, third generation beach club',
    cover: '/images/covers/gargano-vieste-card.webp',
    alt: 'Vieste, white limestone promontory over the Gargano sea',
    price: '€4.99',
  },
  {
    slug: 'gargano-nord',
    title: 'The North Coast — Trabucchi, Villages and Sea',
    subtitle: 'Secluded villages, trabucchi and slow roads along the coast.',
    places: 'Lesina · Rodi Garganico · Peschici · trabucchi · Lake Lesina',
    narrator: 'Ferdinando, fourth generation trabucco',
    cover: '/images/covers/gargano-nord.jpg',
    alt: 'Trabucco on the Gargano coast, juniper wood structure on the rock',
    price: '€4.99',
  },
  {
    slug: 'gargano-sacro',
    title: 'The Sacred Mountain — Forest, Faith and Pilgrims',
    subtitle: 'The forest, the grotto, the convent: the pilgrims\' path on the sacred mountain.',
    places: 'Foresta Umbra · Monte Sant\'Angelo · San Giovanni Rotondo · Padre Pio',
    narrator: "Fra' Salvatore, thirty years at the Sanctuary",
    cover: '/images/covers/gargano-sacro.jpg',
    alt: 'Foresta Umbra of Gargano, ancient forest with beech and oak trees',
    price: '€4.99',
  },
  {
    slug: 'gargano-tremiti',
    title: 'The Tremiti Islands — The Forgotten Archipelago',
    subtitle: 'Islands, abbeys and deep sea: the Gargano that continues beyond the coast.',
    places: 'San Domino · San Nicola · sea caves · Benedictine abbey · marine park',
    narrator: 'Tonino, San Domino boatman',
    cover: '/images/covers/gargano-tremiti.jpg',
    alt: 'Tremiti Islands, turquoise waters and white rocks in the Adriatic',
    price: '€4.99',
  },
  {
    slug: 'gargano-paesi',
    title: 'The Gargano Inland — White Stone and Alleys',
    subtitle: 'Stone, alleys and inland villages: the Gargano far from the beaches.',
    places: 'Vico del Gargano · Ischitella · Carpino · Lake Varano',
    narrator: 'Stefano, park ranger for thirty years',
    cover: '/images/covers/gargano-paesi-card.webp',
    alt: 'Elderly Gargano woman among the white-stone alleys',
    price: '€4.99',
  },
  {
    slug: 'gargano-saline',
    title: 'The Margherita Salt Flats — Salt and Flamingos',
    subtitle: 'Salt, water and flamingos: the landscape where Gargano meets the plain.',
    places: 'Margherita di Savoia salt flats · Manfredonia · Siponto · flamingos',
    narrator: "Antonello, thirty years at the salt works",
    cover: '/images/covers/gargano-saline-card.webp',
    alt: 'Salt-works canal at Margherita di Savoia with moored fishing boats and a salt mound',
    price: '€4.99',
  },
];

const guideListLD = itemListLD(
  'Gargano audio guides',
  guides.map((guide) => `https://localis.guide/en/guide/${guide.slug}`),
);
---
<Layout
  title="Gargano — Narrative Audio Guides · Localis"
  description="Six narrative audio guides of Gargano: Vieste, North Coast, Sacred Mountain, Tremiti Islands, inland villages, salt flats. Told by locals. From €4.99."
  lang="en"
>
  <StructuredData data={guideListLD} />

  <Breadcrumb items={[{ label: 'Home', href: '/en' }, { label: 'Gargano' }]} />

  {/* PAGE HEADER — hero with image */}
  <section class="gargano-hero relative overflow-hidden border-b border-border">
    <img
      src="/images/covers/gargano-landing.jpg"
      alt="Gargano promontory over the Adriatic sea"
      class="gargano-hero-bg"
      width="1980"
      height="900"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <div class="gargano-hero-scrim" aria-hidden="true"></div>
    <div class="max-w-wrap mx-auto px-md py-3xl lg:py-4xl relative z-10">
      <LangPills lang="en" currentPath={Astro.url.pathname} />
      <div class="flex items-center gap-sm mb-md">
        <span class="block w-7 h-px bg-accent"></span>
        <span class="text-[11px] font-semibold tracking-[0.24em] uppercase text-accent">
          Destination — Gargano
        </span>
      </div>
      <h1 class="font-display font-light text-ink leading-[1.05] tracking-[-0.014em] text-[clamp(2.2rem,5vw,3.6rem)] max-w-[22ch]">
        Gargano told<br /><em class="not-italic text-ink-muted">by people born there.</em>
      </h1>
      <p class="font-body text-base sm:text-lg leading-relaxed text-ink-muted mt-md max-w-[52ch]">
        Six live guides. From Vieste to the Tremiti Islands, from the Foresta Umbra to the Margherita salt flats — every voice belongs to someone who actually lives there.
      </p>
      <HeroAudioSample lang="en" src="/audio/trailers/gargano/gargano-trailer-en.mp3" guideSlug="gargano-vieste" />
      <a href="#prezzi" class="mt-md inline-flex items-center gap-xs text-sm font-semibold text-link hover:text-link-pressed no-underline">Guides and pricing <span aria-hidden="true">↓</span></a>
    </div>
  </section>

  <style>
    .gargano-hero {
      min-height: clamp(560px, 78vh, 820px);
      display: flex;
      align-items: center;
    }
    .gargano-hero-bg {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center center;
      filter: saturate(0.92) contrast(1.04);
    }
    .gargano-hero .text-ink,
    .gargano-hero h1 {
      color: oklch(12% 0.005 240) !important;
    }
    .gargano-hero .text-ink-muted,
    .gargano-hero p {
      color: oklch(22% 0.008 240 / 0.9) !important;
    }
    .gargano-hero-scrim {
      position: absolute;
      inset: 0;
      background: linear-gradient(
        to right,
        oklch(from var(--color-surface) l c h / 0.96) 0%,
        oklch(from var(--color-surface) l c h / 0.85) 35%,
        oklch(from var(--color-surface) l c h / 0.45) 62%,
        oklch(from var(--color-surface) l c h / 0) 85%
      );
      pointer-events: none;
    }
    @media (max-width: 768px) {
      .gargano-hero-scrim {
        background: linear-gradient(
          to bottom,
          oklch(from var(--color-surface) l c h / 0.78) 0%,
          oklch(from var(--color-surface) l c h / 0.58) 60%,
          oklch(from var(--color-surface) l c h / 0.35) 100%
        );
      }
    }
  </style>

  {/* INTERLUDE */}
  <section class="bg-surface-elev border-b border-border">
    <div class="max-w-wrap mx-auto px-md py-xl flex items-center gap-lg">
      <span class="block h-px flex-1 bg-border"></span>
      <p class="font-body text-sm text-ink-muted tracking-[0.18em] uppercase shrink-0">Six stories · six places · one promontory</p>
      <span class="block h-px flex-1 bg-border"></span>
    </div>
  </section>

  {/* GUIDE GRID */}
  <section class="bg-surface">
    <div class="max-w-wrap mx-auto px-md py-3xl lg:py-4xl">
      <ol class="guide-grid list-none p-0 m-0">
        {guides.map((g, i) => (
          <li class="guide-cell" style={`--idx:${i}`}>
            <a href={`/en/guide/${g.slug}`} class="guide-card" aria-label={`${g.title}`}>
              <figure class="guide-photo m-0">
                <img src={g.cover} alt={g.alt} class="guide-img" loading="lazy" decoding="async" />
                <span class="guide-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                {g.price && <span class="guide-price" aria-hidden="true">{g.price}</span>}
                <span class="guide-scrim" aria-hidden="true">
                  <span class="guide-narrator">{g.narrator}</span>
                </span>
              </figure>
              <div class="guide-meta">
                <h3 class="guide-title font-display font-light text-ink leading-[1.2] m-0">{g.title}</h3>
                <p class="guide-places font-body text-xs text-accent tracking-[0.12em] uppercase m-0 mb-xs">{g.places}</p>
                <p class="guide-sub font-body text-sm text-ink-muted m-0">{g.subtitle}</p>
              </div>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* NARRATORS */}
  <section id="prezzi" class="bg-surface-elev border-t border-border">
    <div class="max-w-wrap mx-auto px-md py-3xl lg:py-4xl">
      <SectionDivider label="Choose how to listen to Gargano." />
      <div class="grid grid-cols-1 md:grid-cols-3 gap-lg max-w-[68rem] mx-auto">
        <PriceCard
          product="single"
          guideSlug="gargano-vieste"
          lang="en"
          features={[
            'One guide of your choice',
            'Unlimited access, forever',
            'Italian and English',
            'Money-back, no questions asked',
          ]}
        />
        <PriceCard
          product="tris"
          lang="en"
          features={[
            '3 guides of your choice',
            'Unlimited access, forever',
            'Money-back, no questions asked',
          ]}
        />
        <PriceCard
          product="gargano-completa"
          lang="en"
          primary
          titleOverride="Pack 6 Guides (Complete Area)"
          descriptionOverride="All 6 Gargano guides. Six stories, six landscapes."
          ctaOverride="Get Pack 6 Guides"
          features={[
            'All 6 Gargano guides',
            '~5h of storytelling · different voices',
            'Money-back, no questions asked',
          ]}
        />
      </div>
    </div>
  </section>

  <style>
    .narr-grid {
      display: grid;
      grid-template-columns: repeat(1, 1fr);
      gap: var(--spacing-2xl);
    }
    @media (min-width: 640px) { .narr-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (min-width: 1024px) { .narr-grid { grid-template-columns: repeat(3, 1fr); } }

    .narr-card {
      display: flex;
      flex-direction: column;
      gap: var(--spacing-md);
      text-decoration: none;
      color: inherit;
      border-top: 1px solid var(--color-border);
      padding-top: var(--spacing-md);
      transition: opacity 0.2s;
    }
    .narr-card:hover { opacity: 0.82; }
    .narr-card:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 4px; border-radius: 2px; }

    .narr-photo {
      width: 100%;
      aspect-ratio: 3 / 4;
      overflow: hidden;
      border-radius: var(--radius-md);
      background: var(--color-surface-elev);
      box-shadow: 0 1px 2px oklch(15% 0.012 240 / 0.06), 0 8px 24px -8px oklch(15% 0.012 240 / 0.14);
    }
    .narr-photo img {
      width: 100%; height: 100%; object-fit: cover; display: block;
      filter: grayscale(100%) contrast(1.05) brightness(0.97);
    }
    .narr-photo-note { margin-top: calc(var(--spacing-md) * -0.55); line-height: 1.35; }
    .narr-text { display: flex; flex-direction: column; gap: var(--spacing-xs); }
    .narr-name { font-size: clamp(1.3rem, 2.8vw, 1.6rem); line-height: 1.1; }
    .narr-bio { line-height: 1.55; }

    @media (prefers-reduced-motion: reduce) {
      .narr-card { transition: none; }
    }
  </style>

  {/* PRICING */}
  <section class="bg-surface border-t border-border">
    <div class="max-w-wrap mx-auto px-md py-3xl lg:py-4xl">
      <div class="flex items-center justify-center gap-sm mb-2xl">
        <span class="block w-7 h-px bg-accent"></span>
        <span class="text-[10px] font-semibold tracking-[0.32em] uppercase text-accent">The perspectives of Gargano</span>
        <span class="block w-7 h-px bg-accent"></span>
      </div>
      <p class="font-body text-sm text-ink-muted text-center max-w-[52ch] mx-auto mb-2xl">Narrative portraits built on research, sources and local memory.</p>
      <ul class="narr-grid list-none p-0 m-0">
        {[
          { name: 'Rossella', photo: '/images/authors/rossella-vieste-jun26.jpg', role: 'Third generation beach club, Vieste', bio: "Fifty-four. Her family has run the same beach club since her grandfather's time. She has watched this coastline change more in sixty years than in the six hundred before.", guide: 'Vieste', href: '/en/guide/gargano-vieste' },
          { name: 'Ferdinando', photo: '/images/authors/ferdinando-nord-jun26.jpg', role: 'Fourth generation trabucco fisherman', bio: 'Sixty-eight, from Peschici. On the family trabucco since he was eleven. He knows the Gargano sea by heart — every current, every hour of the day.', guide: 'North Coast', href: '/en/guide/gargano-nord' },
          { name: "Fra' Salvatore", photo: '/images/authors/fra-salvatore-sacro-jun26.jpg', role: 'Thirty years at the Sanctuary of Monte Sant\'Angelo', bio: "Seventy-three. Franciscan friar since 1978. He has guided pilgrims from the Foresta Umbra to the Archangel's grotto — on foot, as they did in the Middle Ages.", guide: 'Sacred Gargano', href: '/en/guide/gargano-sacro' },
          { name: 'Tonino', photo: '/images/authors/tonino-tremiti-jun26.jpg', role: 'Boatman of San Domino', bio: "Seventy-four. Born on the Tremiti Islands, never left. For twenty years he took Lucio Dalla around the sea caves. He knows every cove, every reef, every current of the archipelago.", guide: 'Tremiti Islands', href: '/en/guide/gargano-tremiti' },
          { name: 'Stefano', photo: '/images/authors/stefano-paesi-jun26.jpg', role: 'Park ranger for thirty years', bio: "Fifty-eight, from Vico del Gargano. Thirty years in the Gargano National Park. He knows the inland villages like few others — the roads, the stories, the names of abandoned farmsteads.", guide: 'The Villages', href: '/en/guide/gargano-paesi' },
          { name: 'Antonello', photo: '/images/authors/antonello-saline-jun26.jpg', role: 'Thirty years in salt quality control', bio: "Fifty-four, from Manfredonia. Thirty years at the Margherita di Savoia salt works. He has seen the basins at every possible hour — from the pink July dawn to the December fog.", guide: 'Salt Flats', href: '/en/guide/gargano-saline' },
        ].map((n) => (
          <li class="narr-cell">
            <a href={n.href} class="narr-card" aria-label={`Guide ${n.guide} — ${n.name}'s voice`}>
              <figure class="narr-photo m-0">
                <img
                  src={n.photo}
                  alt={`Evocative portrait of ${n.name}`}
                  title={`${n.name}: composite editorial character built from research, sources and field material. Evocative portrait.`}
                  loading="lazy"
                  decoding="async"
                />
              </figure>
              <p class="narr-photo-note font-body text-[10px] font-semibold tracking-[0.18em] uppercase text-ink-subtle m-0">
                Composite editorial voice. Evocative portrait.
              </p>
              <div class="narr-text">
                <p class="narr-guide font-body text-[10px] font-semibold tracking-[0.22em] uppercase text-accent m-0">{n.guide}</p>
                <h3 class="narr-name font-display font-light text-ink m-0">{n.name}</h3>
                <p class="narr-role font-body text-xs text-ink-subtle m-0">{n.role}</p>
                <p class="narr-bio font-body text-sm text-ink-muted m-0 mt-xs">{n.bio}</p>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* 3 STEPS */}
  <StepsBlock lang="en" ctaHref="/en/guide/gargano-vieste" />

</Layout>

<style>
  .guide-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: var(--spacing-lg);
    row-gap: var(--spacing-2xl);
  }
  @media (min-width: 640px) { .guide-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .guide-grid { grid-template-columns: repeat(3, 1fr); } }

  .guide-cell {
    opacity: 0;
    transform: translateY(14px);
    animation: guideIn 0.7s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: calc(var(--idx, 0) * 80ms + 100ms);
  }
  .guide-card {
    display: flex; flex-direction: column; gap: var(--spacing-md); height: 100%;
    text-decoration: none; color: inherit;
    border-top: 1px solid var(--color-ink); padding-top: var(--spacing-md);
  }
  .guide-photo {
    position: relative; width: 100%; height: clamp(16rem, 24vw, 21rem);
    background: var(--color-surface-elev); overflow: hidden; border-radius: var(--radius-md);
    box-shadow: 0 1px 2px oklch(15% 0.012 240 / 0.08), 0 12px 32px -12px oklch(15% 0.012 240 / 0.16);
  }
  .guide-img { width: 100%; height: 100%; object-fit: cover; display: block; filter: saturate(0.94) contrast(1.04); }
  .guide-num { position: absolute; top: var(--spacing-sm); left: var(--spacing-sm); font-family: var(--font-display); font-style: italic; font-weight: 300; font-size: clamp(2.4rem, 4.4vw, 3.2rem); line-height: 0.85; color: var(--color-surface); letter-spacing: -0.04em; text-shadow: 0 1px 8px oklch(15% 0.012 240 / 0.55); pointer-events: none; user-select: none; }
  .guide-price { position: absolute; top: var(--spacing-sm); right: var(--spacing-sm); font-family: var(--font-body); font-size: 0.8125rem; font-weight: 700; color: var(--color-ink); background: var(--color-surface); border: 1px solid var(--color-accent); padding: 4px 10px 5px; line-height: 1.2; box-shadow: 0 1px 2px oklch(15% 0.012 240 / 0.18); pointer-events: none; user-select: none; z-index: 1; }
  .guide-scrim { position: absolute; left: 0; right: 0; bottom: 0; display: flex; align-items: center; padding: var(--spacing-sm) var(--spacing-md); background: linear-gradient(to top, oklch(15% 0.012 240 / 0.78), transparent 100%); color: var(--color-surface); font-family: var(--font-body); font-size: 10px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; pointer-events: none; }
  .guide-narrator { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .guide-meta { display: flex; flex-direction: column; gap: var(--spacing-xs); }
  .guide-title { font-size: clamp(1.1rem, 2.4vw, 1.35rem); }
  .guide-places { letter-spacing: 0.12em; }
  .guide-sub { line-height: 1.5; }
  .guide-card:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 4px; border-radius: 2px; }
  @keyframes guideIn { to { opacity: 1; transform: translateY(0); } }
  @media (prefers-reduced-motion: reduce) { .guide-cell, .guide-card, .guide-img { animation: none !important; transition: none !important; opacity: 1; transform: none; } }
</style>
