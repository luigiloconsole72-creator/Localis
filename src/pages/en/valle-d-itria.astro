---
export const prerender = true;
import Layout from '../../components/Layout.astro';
import SectionDivider from '../../components/SectionDivider.astro';
import PriceCard from '../../components/PriceCard.astro';
import LangPills from '../../components/LangPills.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import HeroAudioSample from '../../components/HeroAudioSample.astro';
import StructuredData from '../../components/StructuredData.astro';
import { itemListLD } from '../../lib/seo';

interface GuideEntry {
  slug: string;
  title: string;
  subtitle: string;
  duration: string;
  area: string;
  cover: string;
  alt: string;
  price?: string;
}

const guides: GuideEntry[] = [
  {
    slug: 'alberobello',
    title: 'Alberobello — Inside the Trulli',
    subtitle: 'Not just white houses: stones, work and a shape that became the world.',
    duration: '35 min',
    area: "Valle d'Itria",
    cover: '/images/covers/alberobello.jpg',
    alt: "Trulli of Alberobello, Rione Monti district",
    price: '€4.99',
  },
  {
    slug: 'locorotondo',
    title: 'Locorotondo — The Round Village',
    subtitle: 'A circular village, white houses and vineyards that face the valley.',
    duration: '31 min',
    area: "Valle d'Itria",
    cover: '/images/covers/locorotondo.jpg',
    alt: 'Locorotondo, white houses with double-pitched roofs',
    price: '€4.99',
  },
  {
    slug: 'martina-franca',
    title: 'Martina Franca — The Free City',
    subtitle: 'Baroque, nobility and freedom: the city that learned to stand apart.',
    duration: '30 min',
    area: "Valle d'Itria",
    cover: '/images/covers/martina-franca.jpg',
    alt: 'Ducal Palace of Martina Franca, baroque courtyard',
    price: '€4.99',
  },
  {
    slug: 'cisternino',
    title: 'Cisternino — The Fornello Village',
    subtitle: 'The fornello pronto: meat chosen at the counter, embers and village life.',
    duration: '33 min',
    area: "Valle d'Itria",
    cover: '/images/covers/cisternino.jpg',
    alt: 'Cisternino, white historic centre with fornello pronto',
    price: '€4.99',
  },
  {
    slug: 'ostuni',
    title: 'Ostuni — The White City',
    subtitle: 'White alleys, light and layers: beyond the perfect image.',
    duration: '33 min',
    area: "Valle d'Itria",
    cover: '/images/covers/ostuni.jpg',
    alt: 'Ostuni, the white city seen from below',
    price: '€4.99',
  },
  {
    slug: 'fasano',
    title: "Fasano / Selva di Fasano — The Valley from Above",
    subtitle: 'From the hillside, the Valle d\'Itria changes shape and reveals itself.',
    duration: '33 min',
    area: "Valle d'Itria",
    cover: '/images/covers/fasano.jpg',
    alt: "Selva di Fasano, forest and trulli seen from above",
    price: '€4.99',
  },
];

const guideListLD = itemListLD(
  "Valle d'Itria audio guides",
  guides.map((guide) => `https://localis.guide/en/guide/${guide.slug}`),
);
---
<Layout
  title="Valle d'Itria — Narrative Audio Guides · Localis"
  description="Six narrative audio guides of Valle d'Itria: Alberobello, Locorotondo, Martina Franca, Cisternino, Ostuni, Fasano. Told by locals. From €4.99."
  lang="en"
>
  <StructuredData data={guideListLD} />

  <Breadcrumb items={[{ label: 'Home', href: '/en' }, { label: "Valle d'Itria" }]} />

  {/* PAGE HEADER — hero with image */}
  <section class="valle-hero relative overflow-hidden border-b border-border">
    <img
      src="/images/covers/valle-d-itria-landing.jpg"
      alt="Valle d'Itria, trulli and vineyards under the Puglia sun"
      class="valle-hero-bg"
      width="1980"
      height="900"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <div class="valle-hero-scrim" aria-hidden="true"></div>
    <div class="max-w-wrap mx-auto px-md py-3xl lg:py-4xl relative z-10">
      <LangPills lang="en" currentPath={Astro.url.pathname} />
      <div class="flex items-center gap-sm mb-md">
        <span class="block w-7 h-px bg-accent"></span>
        <span class="text-[11px] font-semibold tracking-[0.24em] uppercase text-accent">
          Destination — Valle d'Itria
        </span>
      </div>
      <h1 class="font-display font-light text-ink leading-[1.05] tracking-[-0.014em] text-[clamp(2.2rem,5vw,3.6rem)] max-w-[22ch]">
        Valle d'Itria, beyond the postcard.
      </h1>
      <p class="font-body text-base sm:text-lg leading-relaxed text-ink-muted mt-md max-w-[52ch]">
        Six audio stories among trulli, white villages, vineyards and hill roads. No app.
      </p>
      <HeroAudioSample lang="en" src="/audio/trailers/valle-d-itria/alberobello-trailer-en.mp3" guideSlug="alberobello" />
      <a href="#prezzi" class="mt-md inline-flex items-center gap-xs text-sm font-semibold text-link hover:text-link-pressed no-underline">Guides and pricing <span aria-hidden="true">↓</span></a>
    </div>
  </section>

  <style>
    .valle-hero {
      min-height: clamp(560px, 78vh, 820px);
      display: flex;
      align-items: center;
    }
    .valle-hero-bg {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center center;
      filter: saturate(0.92) contrast(1.04);
    }
    .valle-hero-scrim {
      position: absolute;
      inset: 0;
      background: linear-gradient(
        to right,
        oklch(from var(--color-surface) l c h / 0.88) 0%,
        oklch(from var(--color-surface) l c h / 0.65) 35%,
        oklch(from var(--color-surface) l c h / 0.18) 70%,
        oklch(from var(--color-surface) l c h / 0) 100%
      );
      pointer-events: none;
    }
    @media (max-width: 768px) {
      .valle-hero-scrim {
        background: linear-gradient(
          to bottom,
          oklch(from var(--color-surface) l c h / 0.92) 0%,
          oklch(from var(--color-surface) l c h / 0.72) 60%,
          oklch(from var(--color-surface) l c h / 0.5) 100%
        );
      }
    }
  </style>

  {/* INTERLUDE */}
  <section class="bg-surface-elev border-b border-border">
    <div class="max-w-wrap mx-auto px-md py-xl flex items-center gap-lg">
      <span class="block h-px flex-1 bg-border"></span>
      <p class="font-body text-sm text-ink-muted tracking-[0.18em] uppercase shrink-0">Six stories · six places · one valley</p>
      <span class="block h-px flex-1 bg-border"></span>
    </div>
  </section>

  {/* GUIDE GRID */}
  <section class="bg-surface">
    <div class="max-w-wrap mx-auto px-md py-3xl lg:py-4xl">
      <ol class="guide-grid list-none p-0 m-0">
        {guides.map((g, i) => (
          <li class="guide-cell" style={`--idx:${i}`}>
            <a href={`/en/guide/${g.slug}`} class="guide-card" aria-label={`${g.title} · ${g.duration}`}>
              <figure class="guide-photo m-0">
                <img src={g.cover} alt={g.alt} class="guide-img" loading="lazy" decoding="async" />
                <span class="guide-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                {g.price && <span class="guide-price" aria-hidden="true">{g.price}</span>}
                <span class="guide-scrim" aria-hidden="true">
                  <span class="guide-area">{g.area}</span>
                  <span class="guide-dur">{g.duration}</span>
                </span>
              </figure>
              <div class="guide-meta">
                <h3 class="guide-title font-display font-light text-ink leading-[1.2] m-0">{g.title}</h3>
                <p class="guide-sub font-body text-sm text-ink-muted m-0">{g.subtitle}</p>
              </div>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* NARRATORS */}
  <section id="prezzi" class="bg-surface-elev border-t border-border">
    <div class="max-w-wrap mx-auto px-md py-3xl lg:py-4xl">
      <SectionDivider label="Choose how to listen to Valle d'Itria." />
      <div class="grid grid-cols-1 md:grid-cols-3 gap-lg max-w-[68rem] mx-auto">
        <PriceCard
          product="single"
          guideSlug="alberobello"
          lang="en"
          features={[
            'One guide of your choice',
            'Unlimited access, forever',
            'Italian and English',
            'Money-back, no questions asked',
          ]}
        />
        <PriceCard
          product="tris"
          lang="en"
          features={[
            '3 guides of your choice',
            'Unlimited access, forever',
            'Money-back, no questions asked',
          ]}
        />
        <PriceCard
          product="valle-completa"
          lang="en"
          primary
          titleOverride="Pack 6 Guides (Complete Area)"
          descriptionOverride="All 6 Valle d'Itria guides. Six stories, six places."
          ctaOverride="Get Pack 6 Guides"
          features={[
            "All 6 Valle d'Itria guides",
            '~3h of storytelling · different voices',
            'Money-back, no questions asked',
          ]}
        />
      </div>
    </div>
  </section>

  <style>
    .narr-grid {
      display: grid;
      grid-template-columns: repeat(1, 1fr);
      gap: var(--spacing-2xl);
    }
    @media (min-width: 640px) { .narr-grid { grid-template-columns: repeat(3, 1fr); } }

    .narr-card {
      display: flex; flex-direction: column; gap: var(--spacing-md);
      text-decoration: none; color: inherit;
      border-top: 1px solid var(--color-border); padding-top: var(--spacing-md);
      transition: opacity 0.2s;
    }
    .narr-card:hover { opacity: 0.82; }
    .narr-card:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 4px; border-radius: 2px; }

    .narr-photo {
      width: 100%; aspect-ratio: 3 / 4; overflow: hidden;
      border-radius: var(--radius-md); background: var(--color-surface-elev);
      box-shadow: 0 1px 2px oklch(15% 0.012 240 / 0.06), 0 8px 24px -8px oklch(15% 0.012 240 / 0.14);
    }
    .narr-photo img {
      width: 100%; height: 100%; object-fit: cover; display: block;
      filter: grayscale(100%) contrast(1.05) brightness(0.97);
    }
    .narr-photo-note { margin-top: calc(var(--spacing-md) * -0.55); line-height: 1.35; }
    .narr-text { display: flex; flex-direction: column; gap: var(--spacing-xs); }
    .narr-name { font-size: clamp(1.3rem, 2.8vw, 1.6rem); line-height: 1.1; }
    .narr-bio { line-height: 1.55; }

    @media (prefers-reduced-motion: reduce) { .narr-card { transition: none; } }
  </style>

  {/* PRICING */}
  <section class="bg-surface border-t border-border">
    <div class="max-w-wrap mx-auto px-md py-3xl lg:py-4xl">
      <div class="flex items-center justify-center gap-sm mb-2xl">
        <span class="block w-7 h-px bg-accent"></span>
        <span class="text-[10px] font-semibold tracking-[0.32em] uppercase text-accent">The perspectives of the Valley</span>
        <span class="block w-7 h-px bg-accent"></span>
      </div>
      <p class="font-body text-sm text-ink-muted text-center max-w-[52ch] mx-auto mb-2xl mt-[-var(--spacing-xl)]">Narrative portraits built on research, sources and local memory.</p>
      <ul class="narr-grid list-none p-0 m-0">
        {[
          { name: 'Concetta', photo: '/images/authors/concetta-alberobello-jun26.jpg', role: 'Three generations in Rione Aia Piccola', bio: "Sixty-five, born and raised in Rione Aia Piccola. Three generations under the same stone roof. She tells the trulli the way a neighbour would — from the doorstep she's always sat on.", guide: 'Alberobello', href: '/en/guide/alberobello' },
          { name: 'Francesco', photo: '/images/authors/francesco-locorotondo-jun26.jpg', role: 'Winemaker of the round village', bio: "Fifty, winemaker of the round village. He produces DOC wine, olive oil and lavender essential oil among the Itria Valley vineyards.", guide: 'Locorotondo', href: '/en/guide/locorotondo' },
          { name: 'Anonymous', photo: '/images/authors/nobile-martina-franca-jun26.jpg', role: 'Caracciolo family descendant', bio: "A direct descendant of the Caracciolo family. Prefers not to give a name — wants to tell stories, not make statements.", guide: 'Martina Franca', href: '/en/guide/martina-franca' },
          { name: 'Michele', photo: '/images/authors/michele-cisternino-jun26.jpg', role: 'Third-generation butcher', bio: "Third-generation butcher. He runs the oldest fornello pronto in the historic centre — the fire is lit at dawn and does not go out until evening.", guide: 'Cisternino', href: '/en/guide/cisternino' },
          { name: 'Salvatore', photo: '/images/authors/salvatore-ostuni-jun26.jpg', role: 'Retired traffic warden of Ostuni', bio: "Retired traffic warden, forty years of service in Ostuni. He has watched generations of tourists pass through and knows every alley, every fine, every chaotic August and every silent winter.", guide: 'Ostuni', href: '/en/guide/ostuni' },
          { name: 'Andrea', photo: '/images/authors/andrea-fasano-jun26.jpg', role: 'Pilot over the Itria Valley', bio: "Paragliding enthusiast, he has been flying over the Valle d'Itria for twenty years. He knows the geometry of trulli and masserie from above better than any guidebook.", guide: 'Fasano / Selva di Fasano', href: '/en/guide/fasano' },
        ].map((n) => (
          <li>
            <a href={n.href} class="narr-card" aria-label={`Guide ${n.guide} — ${n.name}'s voice`}>
              <figure class="narr-photo m-0">
                <img
                  src={n.photo}
                  alt={`Evocative portrait of ${n.name}`}
                  title={`${n.name}: composite editorial character built from research, sources and field material. Evocative portrait.`}
                  loading="lazy"
                  decoding="async"
                />
              </figure>
              <p class="narr-photo-note font-body text-[10px] font-semibold tracking-[0.18em] uppercase text-ink-subtle m-0">
                Composite editorial voice. Evocative portrait.
              </p>
              <div class="narr-text">
                <p class="narr-guide font-body text-[10px] font-semibold tracking-[0.22em] uppercase text-accent m-0">{n.guide}</p>
                <h3 class="narr-name font-display font-light text-ink m-0">{n.name}</h3>
                <p class="narr-role font-body text-xs text-ink-subtle m-0">{n.role}</p>
                <p class="narr-bio font-body text-sm text-ink-muted m-0 mt-xs">{n.bio}</p>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

</Layout>

<style>
  .guide-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: var(--spacing-lg);
    row-gap: var(--spacing-2xl);
  }
  @media (min-width: 640px) { .guide-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .guide-grid { grid-template-columns: repeat(3, 1fr); } }

  .guide-cell {
    opacity: 0;
    transform: translateY(14px);
    animation: guideIn 0.7s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: calc(var(--idx, 0) * 80ms + 100ms);
  }
  .guide-card {
    display: flex; flex-direction: column; gap: var(--spacing-md); height: 100%;
    text-decoration: none; color: inherit;
    border-top: 1px solid var(--color-ink); padding-top: var(--spacing-md);
    transition: transform 240ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .guide-card:hover { transform: translateY(-2px); }
  .guide-photo {
    position: relative; width: 100%; height: clamp(16rem, 24vw, 21rem);
    background: var(--color-surface-elev); overflow: hidden; border-radius: var(--radius-md);
    box-shadow: 0 1px 2px oklch(15% 0.012 240 / 0.08), 0 12px 32px -12px oklch(15% 0.012 240 / 0.16);
  }
  .guide-img { width: 100%; height: 100%; object-fit: cover; display: block; filter: saturate(0.94) contrast(1.04); }
  .guide-num { position: absolute; top: var(--spacing-sm); left: var(--spacing-sm); font-family: var(--font-display); font-style: italic; font-weight: 300; font-size: clamp(2.4rem, 4.4vw, 3.2rem); line-height: 0.85; color: var(--color-surface); letter-spacing: -0.04em; text-shadow: 0 1px 8px oklch(15% 0.012 240 / 0.55); pointer-events: none; user-select: none; }
  .guide-price { position: absolute; top: var(--spacing-sm); right: var(--spacing-sm); font-family: var(--font-body); font-size: 0.8125rem; font-weight: 700; color: var(--color-ink); background: var(--color-surface); border: 1px solid var(--color-accent); padding: 4px 10px 5px; line-height: 1.2; box-shadow: 0 1px 2px oklch(15% 0.012 240 / 0.18); pointer-events: none; user-select: none; z-index: 1; }
  .guide-scrim { position: absolute; left: 0; right: 0; bottom: 0; display: flex; align-items: center; justify-content: space-between; padding: var(--spacing-sm) var(--spacing-md); background: linear-gradient(to top, oklch(15% 0.012 240 / 0.78), transparent 100%); color: var(--color-surface); font-family: var(--font-body); font-size: 10px; font-weight: 700; letter-spacing: 0.22em; text-transform: uppercase; pointer-events: none; }
  .guide-area { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .guide-dur { flex-shrink: 0; color: var(--color-accent-soft); }
  .guide-meta { display: flex; flex-direction: column; gap: var(--spacing-xs); }
  .guide-title { font-size: clamp(1.1rem, 2.4vw, 1.35rem); }
  .guide-sub { line-height: 1.5; }
  .guide-card:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 4px; border-radius: 2px; }
  @keyframes guideIn { to { opacity: 1; transform: translateY(0); } }
  @media (prefers-reduced-motion: reduce) { .guide-cell, .guide-card, .guide-img { animation: none !important; transition: none !important; opacity: 1; transform: none; } }
</style>
