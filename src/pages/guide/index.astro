---
export const prerender = true;
import Layout from '../../components/Layout.astro';
import AtlanteTesta from '../../components/AtlanteTesta.astro';
import GuideBuilder from '../../components/GuideBuilder.astro';
import StructuredData from '../../components/StructuredData.astro';
import { itemListLD } from '../../lib/seo';

interface GuideEntry {
  slug: string;
  title: string;
  subtitle: string;
  duration: string;
  area: string;
  cover: string;
  alt: string;
  price?: string;
  soon?: boolean;
  objectPosition?: string;
}

const bariGuides: GuideEntry[] = [
  {
    slug: 'bari-vecchia',
    title: 'Bari Vecchia — Dentro la Città',
    subtitle: 'Oggi la chiamiamo città vecchia. Per secoli era tutta Bari.',
    duration: '21 min',
    area: 'Borgo Antico',
    cover: '/images/covers/bari-vecchia-passeggiata.jpg',
    alt: 'Vicolo del Borgo Antico di Bari con colonne romane e palazzi storici',
    price: '€4,99',
  },
  {
    slug: 'san-nicola',
    title: 'San Nicola — Il Santo Rubato',
    subtitle: 'Nel 1087 Bari attraversò il mare per prendere un santo.',
    duration: '30 min',
    area: 'Borgo Antico',
    cover: '/images/covers/san-nicola-basilica.webp',
    alt: 'Facciata della Basilica di San Nicola a Bari',
    price: '€4,99',
  },
  {
    slug: 'bari-tavola',
    title: 'Bari a tavola — Il cibo che tiene insieme la città',
    subtitle: 'Dal mare ai vicoli: il cibo come modo di stare insieme.',
    duration: '28 min',
    area: 'Borgo Antico',
    cover: '/images/covers/bari-tavola-cover.webp',
    objectPosition: 'top',
    alt: 'Strada delle Orecchiette a Bari Vecchia, donne che lavorano la pasta',
    price: '€4,99',
  },
  {
    slug: 'porto-bari',
    title: 'Porto di Bari — Dove è Successo Tutto',
    subtitle: 'Il mare come porta d\'ingresso della città: commerci, partenze e ritorni.',
    duration: '33 min',
    area: 'Lungomare',
    cover: '/images/covers/porto-bari-card.jpg',
    alt: 'Bari dal alto al tramonto, lungomare e porto turistico',
    price: '€4,99',
  },
  {
    slug: 'tre-teatri',
    title: 'I Tre Teatri — Fuoco, Musica e Borghesia',
    subtitle: 'La Bari che volle diventare città moderna.',
    duration: '28 min',
    area: 'Murat',
    cover: '/images/covers/tre-teatri-card.webp',
    alt: 'Teatro Margherita di Bari, edificio liberty sul mare',
    price: '€4,99',
  },
  {
    slug: 'bari-sotterranea',
    title: 'Bari Sotterranea — Quello che sta sotto',
    subtitle: 'Sotto la città visibile: cisterne, scavi e memorie nascoste.',
    duration: '25 min',
    area: 'Borgo Antico',
    cover: '/images/covers/bari-sotterranea-card.jpg',
    alt: 'Cripta della Basilica di San Nicola, colonne romane e mosaici',
    price: '€4,99',
  },
];

const valleItria: GuideEntry[] = [
  {
    slug: 'alberobello',
    title: 'Alberobello — Dentro i Trulli',
    subtitle: 'La storia fiscale che nessuno ti ha mai raccontato.',
    duration: '35 min',
    area: 'Valle d\'Itria',
    cover: '/images/covers/alberobello.jpg',
    alt: 'Trulli di Alberobello, Rione Monti',
    price: '€4,99',
  },
  {
    slug: 'locorotondo',
    title: 'Locorotondo — Il Borgo Rotondo',
    subtitle: 'Un vino DOC, le cummerse e l\'olio essenziale di lavanda.',
    duration: '31 min',
    area: 'Valle d\'Itria',
    cover: '/images/covers/locorotondo.jpg',
    alt: 'Locorotondo, case bianche con tetti a doppio spiovente',
    price: '€4,99',
  },
  {
    slug: 'martina-franca',
    title: 'Martina Franca — La Città Franca',
    subtitle: 'Trecento anni di ducato attraverso la memoria storica della città.',
    duration: '30 min',
    area: 'Valle d\'Itria',
    cover: '/images/covers/martina-franca.jpg',
    alt: 'Palazzo Ducale di Martina Franca, cortile barocco',
    price: '€4,99',
  },
  {
    slug: 'cisternino',
    title: 'Cisternino — Il Paese del Fornello',
    subtitle: 'Il fornello pronto, la bombetta e il rito della brace nel centro storico.',
    duration: '33 min',
    area: 'Valle d\'Itria',
    cover: '/images/covers/cisternino.jpg',
    alt: 'Cisternino, centro storico bianco con fornello pronto',
    price: '€4,99',
  },
  {
    slug: 'ostuni',
    title: 'Ostuni — La Città Bianca',
    subtitle: 'Vicoli bianchi, estati affollate e inverni silenziosi.',
    duration: '33 min',
    area: 'Valle d\'Itria',
    cover: '/images/covers/ostuni.jpg',
    alt: 'Ostuni, la città bianca vista dal basso',
    price: '€4,99',
  },
  {
    slug: 'fasano',
    title: 'Fasano / Selva di Fasano — La Valle Vista dall\'Alto',
    subtitle: 'La Valle d\'Itria vista dall\'alto, tra trulli, masserie e colline.',
    duration: '33 min',
    area: 'Valle d\'Itria',
    cover: '/images/covers/fasano.jpg',
    alt: 'Selva di Fasano, bosco e trulli visti dall\'alto',
    price: '€4,99',
  },
];

const guideListLD = itemListLD(
  'Audioguide narrative Localis',
  [
    ...bariGuides.map((g) => g.slug),
    ...valleItria.map((g) => g.slug),
    'gargano-vieste',
    'gargano-nord',
    'gargano-sacro',
    'gargano-tremiti',
    'gargano-paesi',
    'gargano-saline',
    'matera',
  ].map((slug) => `https://localis.guide/guide/${slug}/`),
);
---

<Layout
  title="Guide — Audioguide narrative di Bari, Valle d'Itria e Gargano · Localis"
  description="Tutte le audioguide Localis: 18 racconti audio tra Bari, Valle d'Itria e Gargano, scritti da chi quei luoghi li vive. Da €4,99."
  lang="it"
>
  <StructuredData data={guideListLD} />
  <AtlanteTesta occhiello="Tutte le guide" titolo="La Puglia, raccontata luogo per luogo." lede="Racconti audio documentati per capire Bari, la Valle d'Itria e il Gargano." img="/images/hero/hero-bari-tramonto.jpg" alt="Bari al tramonto, dal lungomare" />
  <div class="max-w-wrap mx-auto px-md py-2xl lg:py-3xl">
    <div class="guide-intro">
      <p>Qui trovi racconti audio documentati, scritti in Puglia, per capire i luoghi mentre li visiti o prima di partire. Ogni guida nasce da ricerca, fonti consultabili e scrittura pensata per farti entrare nel significato dei luoghi.</p>
      <p class="guide-intro-pack">Puoi acquistare una guida singola, oppure creare un pack da 3 o 6 guide.</p>
    </div>

    {/* ——— BARI ——— */}
    <section class="mb-3xl lg:mb-4xl" aria-labelledby="area-bari">
      <div class="zona-testa">
        <h2 id="area-bari" class="zona-h2">
          Bari
        </h2>
        <span class="zona-conta">6 guide</span>
      </div>

      <ol class="list-none p-0 m-0 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-[var(--spacing-lg)] [row-gap:var(--spacing-2xl)] items-start">
        {bariGuides.map((g, i) => (
          <li class="guide-cell" style={`--idx:${i}`}>
            <a href={`/guide/${g.slug}`} class="guide-card" aria-label={`${g.title} · ${g.duration}`}>
              <figure class="guide-photo m-0" style="height:clamp(16rem,24vw,21rem);">
                <img src={g.cover} alt={g.alt} class="guide-img" loading="lazy" decoding="async" style={`width:100%;height:100%;object-fit:cover;display:block;${g.objectPosition ? `object-position:${g.objectPosition};` : ''}`} />
                <span class="guide-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                {g.price && <span class="guide-price" aria-hidden="true">{g.price}</span>}
                <span class="guide-scrim" aria-hidden="true">
                  <span class="guide-area">{g.area}</span>
                  <span class="guide-dur">{g.duration}</span>
                </span>
              </figure>
              <div class="guide-meta">
                <h3 class="guide-title font-display font-light text-ink leading-[1.2] m-0">{g.title}</h3>
                <p class="guide-sub font-body text-sm text-ink-muted m-0">{g.subtitle}</p>
              </div>
            </a>
          </li>
        ))}
      </ol>

    </section>

    {/* ——— VALLE D'ITRIA ——— */}
    <section aria-labelledby="area-valle">
      <div class="zona-testa">
        <h2 id="area-valle" class="zona-h2">
          Valle d'Itria
        </h2>
        <span class="zona-conta">6 guide</span>
      </div>

      <ol class="list-none p-0 m-0 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-[var(--spacing-lg)] [row-gap:var(--spacing-2xl)] items-start">
        {valleItria.map((g, i) => (
          <li class="guide-cell" style={`--idx:${i}`}>
            <a href={`/guide/${g.slug}`} class="guide-card" aria-label={`${g.title} · ${g.duration}`}>
              <figure class="guide-photo m-0" style="height:clamp(16rem,24vw,21rem);">
                <img src={g.cover} alt={g.alt} class="guide-img" loading="lazy" decoding="async" style={`width:100%;height:100%;object-fit:cover;display:block;${g.objectPosition ? `object-position:${g.objectPosition};` : ''}`} />
                <span class="guide-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                {g.price && <span class="guide-price" aria-hidden="true">{g.price}</span>}
                <span class="guide-scrim" aria-hidden="true">
                  <span class="guide-area">{g.area}</span>
                  <span class="guide-dur">{g.duration}</span>
                </span>
              </figure>
              <div class="guide-meta">
                <h3 class="guide-title font-display font-light text-ink leading-[1.2] m-0">{g.title}</h3>
                <p class="guide-sub font-body text-sm text-ink-muted m-0">{g.subtitle}</p>
              </div>
            </a>
          </li>
        ))}
      </ol>
    </section>

    {/* ——— GARGANO ——— */}
    <section class="mt-3xl lg:mt-4xl" aria-labelledby="area-gargano">
      <div class="zona-testa">
        <h2 id="area-gargano" class="zona-h2">
          Gargano
        </h2>
        <span class="zona-conta">6 guide</span>
      </div>

      <ol class="list-none p-0 m-0 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-[var(--spacing-lg)] [row-gap:var(--spacing-2xl)] items-start">
        {[
          { slug: 'gargano-vieste', title: 'Vieste — La Città sul Promontorio', subtitle: 'Pizzomunno, le falesie bianche, Pugnochiuso.', duration: '33 min', area: 'Gargano', cover: '/images/covers/gargano-vieste-card.webp', alt: 'Vieste, promontorio di roccia bianca sul mare del Gargano', price: '€4,99' },
          { slug: 'gargano-nord', title: 'La Costa Nord — Trabucchi, Borghi e Mare', subtitle: 'Trabucchi, costa e borghi del Gargano settentrionale.', duration: '33 min', area: 'Gargano', cover: '/images/covers/gargano-nord.jpg', alt: 'Trabucco sul mare del Gargano settentrionale', price: '€4,99' },
          { slug: 'gargano-sacro', title: 'Il Sacro Monte — Foresta, Fede e Pellegrini', subtitle: 'Foresta Umbra, Monte Sant\'Angelo, San Giovanni Rotondo.', duration: '33 min', area: 'Gargano', cover: '/images/covers/gargano-sacro.jpg', alt: 'Monte Sant\'Angelo, santuario di San Michele Arcangelo', price: '€4,99' },
          { slug: 'gargano-tremiti', title: 'Le Tremiti — L\'Arcipelago Dimenticato', subtitle: 'San Domino, San Nicola, le grotte marine.', duration: '33 min', area: 'Gargano', cover: '/images/covers/gargano-tremiti.jpg', alt: 'Isole Tremiti, acque cristalline e scogliere', price: '€4,99' },
          { slug: 'gargano-paesi', title: "L'Entroterra del Gargano — Pietra Bianca e Vicoli", subtitle: 'Il Gargano che non si raggiunge col navigatore sul mare.', duration: '33 min', area: 'Gargano', cover: '/images/covers/gargano-paesi-card.webp', alt: 'Anziana donna del Gargano tra i vicoli di pietra bianca', price: '€4,99' },
          { slug: 'gargano-saline', title: 'Le Saline di Margherita — Sale e Fenicotteri', subtitle: 'Il sale più grande d\'Italia e la città abbandonata.', duration: '33 min', area: 'Gargano', cover: '/images/covers/gargano-saline-card.webp', alt: 'Canale delle saline di Margherita di Savoia con barche da pesca ormeggiate', price: '€4,99' },
        ].map((g: GuideEntry, i) => (
          <li class="guide-cell" style={`--idx:${i}`}>
            <a href={`/guide/${g.slug}`} class="guide-card" aria-label={`${g.title} · ${g.duration}`}>
              <figure class="guide-photo m-0" style="height:clamp(16rem,24vw,21rem);">
                <img src={g.cover} alt={g.alt} class="guide-img" loading="lazy" decoding="async" style={`width:100%;height:100%;object-fit:cover;display:block;${g.objectPosition ? `object-position:${g.objectPosition};` : ''}`} />
                <span class="guide-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                {g.price && <span class="guide-price" aria-hidden="true">{g.price}</span>}
                <span class="guide-scrim" aria-hidden="true">
                  <span class="guide-area">{g.area}</span>
                  <span class="guide-dur">{g.duration}</span>
                </span>
              </figure>
              <div class="guide-meta">
                <h3 class="guide-title font-display font-light text-ink leading-[1.2] m-0">{g.title}</h3>
                <p class="guide-sub font-body text-sm text-ink-muted m-0">{g.subtitle}</p>
              </div>
            </a>
          </li>
        ))}
      </ol>
    </section>

    {/* ——— MATERA ——— */}
    <section class="mt-3xl lg:mt-4xl" aria-labelledby="area-matera">
      <div class="zona-testa">
        <h2 id="area-matera" class="zona-h2">
          Matera
        </h2>
        <span class="zona-conta">1 guida</span>
      </div>

      <ol class="list-none p-0 m-0 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-[var(--spacing-lg)] [row-gap:var(--spacing-2xl)] items-start">
        {[
          { slug: 'matera', title: 'Matera — I Sassi', subtitle: 'Rosa, 78 anni, nata nel Sasso Caveoso.', duration: '24 min', area: 'Basilicata', cover: '/images/covers/matera-hero-jun26.webp', alt: 'Matera, i Sassi visti dall\'alto con la Gravina', price: '€4,99' },
        ].map((g: GuideEntry, i) => (
          <li class="guide-cell" style={`--idx:${i}`}>
            <a href={`/guide/${g.slug}`} class="guide-card" aria-label={`${g.title} · ${g.duration}`}>
              <figure class="guide-photo m-0" style="height:clamp(16rem,24vw,21rem);">
                <img src={g.cover} alt={g.alt} class="guide-img" loading="lazy" decoding="async" style={`width:100%;height:100%;object-fit:cover;display:block;${g.objectPosition ? `object-position:${g.objectPosition};` : ''}`} />
                <span class="guide-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                {g.price && <span class="guide-price" aria-hidden="true">{g.price}</span>}
                <span class="guide-scrim" aria-hidden="true">
                  <span class="guide-area">{g.area}</span>
                  <span class="guide-dur">{g.duration}</span>
                </span>
              </figure>
              <div class="guide-meta">
                <h3 class="guide-title font-display font-light text-ink leading-[1.2] m-0">{g.title}</h3>
                <p class="guide-sub font-body text-sm text-ink-muted m-0">{g.subtitle}</p>
              </div>
            </a>
          </li>
        ))}
      </ol>
    </section>

  </div>

  <GuideBuilder lang="it" />

</Layout>

<style>
.guide-cell {
    opacity: 0;
    transform: translateY(14px);
    animation: guideIn 0.7s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: calc(var(--idx, 0) * 80ms + 100ms);
  }

  .guide-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    color: inherit;
    border-top: 3px solid transparent;
    border-image: linear-gradient(90deg, var(--color-accent), transparent) 1;
    padding-top: var(--spacing-md);
    transition: transform 240ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .guide-card:hover { transform: translateY(-2px); }
  .guide-card.is-soon {
    border-top-style: dashed;
    border-top-color: var(--color-border);
    cursor: default;
  }

  .guide-photo {
    display: block;
    position: relative;
    width: 100%;
    height: clamp(16rem, 24vw, 21rem);
    background: var(--color-surface-elev);
    overflow: hidden;
    border-radius: var(--radius-md);
    box-shadow: 0 1px 2px oklch(15% 0.012 240 / 0.08), 0 12px 32px -12px oklch(15% 0.012 240 / 0.16);
    transition: transform 500ms cubic-bezier(0.22, 1, 0.36, 1), box-shadow 500ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .guide-img {
    position: absolute;
    inset: 0;
    width: 100%; height: 100%; object-fit: cover; display: block;
    filter: sepia(0.45) saturate(0.88) contrast(1.04) brightness(0.97);
    transition: transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .guide-card:hover .guide-img { transform: scale(1.03); }

  .guide-soon-placeholder {
    width: 100%; height: 100%;
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: var(--spacing-sm);
    background: radial-gradient(ellipse at 50% 40%, oklch(78% 0.012 75) 0%, oklch(78% 0.012 75) 28%, transparent 48%), var(--color-surface-elev);
  }
  .guide-soon-num {
    font-family: var(--font-display); font-style: italic; font-weight: 300;
    font-size: clamp(4rem, 9vw, 6rem); line-height: 1; color: var(--color-accent);
    letter-spacing: -0.04em; user-select: none; opacity: 0.55;
  }
  .guide-soon-label {
    font-family: var(--font-body); font-size: 10px; font-weight: 700;
    letter-spacing: 0.32em; text-transform: uppercase; color: var(--color-ink-subtle);
  }

  .guide-num {
    position: absolute; top: var(--spacing-sm); left: var(--spacing-sm);
    font-family: var(--font-display); font-style: italic; font-weight: 300;
    font-size: clamp(2.4rem, 4.4vw, 3.2rem); line-height: 0.85;
    color: var(--color-surface); letter-spacing: -0.04em;
    text-shadow: 0 1px 8px oklch(15% 0.012 240 / 0.55);
    pointer-events: none; user-select: none;
  }
  .guide-price {
    position: absolute; top: var(--spacing-sm); right: var(--spacing-sm);
    font-family: var(--font-body); font-size: 0.8125rem; font-weight: 700;
    color: var(--color-ink); background: var(--color-surface);
    border: 1px solid var(--color-accent); padding: 4px 10px 5px; line-height: 1.2;
    box-shadow: 0 1px 2px oklch(15% 0.012 240 / 0.18);
    pointer-events: none; user-select: none; z-index: 1;
  }
  .guide-scrim {
    position: absolute; left: 0; right: 0; bottom: 0;
    display: flex; align-items: center; justify-content: space-between;
    padding: var(--spacing-sm) var(--spacing-md);
    background: linear-gradient(to top, oklch(15% 0.012 240 / 0.78), transparent 100%);
    color: var(--color-surface); font-family: var(--font-body);
    font-size: 10px; font-weight: 700; letter-spacing: 0.22em; text-transform: uppercase;
    pointer-events: none;
  }
  .guide-area { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .guide-dur { flex-shrink: 0; color: var(--color-accent-soft); }

  .guide-meta { display: flex; flex-direction: column; gap: var(--spacing-xs); margin-top: var(--spacing-md); }
  .guide-title { font-size: clamp(1.1rem, 2.4vw, 1.35rem); }
  .guide-sub { line-height: 1.5; }

  .guide-card:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 4px; border-radius: 2px; }

  @keyframes guideIn { to { opacity: 1; transform: translateY(0); } }

  @media (prefers-reduced-motion: reduce) {
    .guide-cell, .guide-card, .guide-img { animation: none !important; transition: none !important; opacity: 1; transform: none; }
  }

  .guide-intro { max-width: 48rem; margin: 0 0 3.5rem; padding: 1.4rem 1.6rem; border-left: 3px solid var(--color-accent); background: var(--color-surface-elev); border-radius: 0 12px 12px 0; }
  .guide-intro p { color: var(--color-ink-muted); line-height: 1.7; }
  .guide-intro-pack { margin-top: 0.6rem; font-size: 0.9rem; }
  .zona-testa { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin-bottom: 2rem; padding-bottom: 0.9rem; border-bottom: 1px solid var(--color-border-2); }
  .zona-h2 { font-family: var(--font-display); font-weight: 400; font-size: clamp(2rem, 4.5vw, 3rem); line-height: 1; letter-spacing: -0.015em; color: var(--color-ink); }
  .zona-conta { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: var(--color-accent); }
  .guide-price { border-radius: 999px; }
  .guide-photo { border-radius: 14px; }
</style>
