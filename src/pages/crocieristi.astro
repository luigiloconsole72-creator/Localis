---
export const prerender = true;
import Layout from '../components/Layout.astro';
import StartMap from '../components/StartMap.astro';
---
<Layout
  title="Cosa vedere a Bari dal porto crociere in poche ore | Localis"
  description="Due racconti audio per scoprire Bari a piedi durante lo scalo: anteprima gratuita, nessuna app e salvataggio offline prima del percorso."
  lang="it"
  ogImage="/images/covers/nave-crociera.jpg"
>

  {/* ── HERO ── */}
  <section id="hero-crociera" class="relative overflow-hidden border-b border-border">
    <img
      src="/images/covers/nave-crociera.jpg"
      alt="Nave da crociera al porto di Bari"
      class="absolute inset-0 w-full h-full object-cover object-center"
      width="1980"
      height="900"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <div class="cruise-scrim" aria-hidden="true"></div>
    <div class="max-w-wrap mx-auto px-md py-3xl lg:py-4xl relative z-10">
      <div class="flex items-center gap-sm mb-md">
        <span class="block w-7 h-px bg-accent"></span>
        <span class="text-[11px] font-semibold tracking-[0.24em] uppercase text-accent">Scali · Bari</span>
      </div>
      <h1 class="font-display font-light text-ink leading-[1.05] tracking-[-0.014em] text-[clamp(2.2rem,5vw,3.6rem)] max-w-[22ch]" style="color:oklch(12% 0.005 240)">
        Poche ore a Bari.<br />Non attraversarla distrattamente.
      </h1>
      <p class="font-body text-base sm:text-lg leading-relaxed mt-md max-w-[54ch]" style="color:oklch(22% 0.008 240 / 0.88)">
        Due racconti audio selezionati per chi arriva dal porto: Bari Vecchia e il cibo della città, in un percorso compatto da fare a piedi con i propri tempi.
      </p>
      <div class="flex flex-col sm:flex-row gap-sm mt-lg">
        <button
          class="checkout-btn-crociera inline-flex items-center justify-center gap-xs px-lg py-md bg-ink text-surface rounded-md font-semibold text-sm hover:bg-ink/90 transition-[background-color,transform] duration-fast hover:-translate-y-[1px] active:translate-y-0 min-h-[48px]"
          data-product="crociera"
          data-lang="it"
        >
          Pacchetto Crociera — €7,99
        </button>
        <button
          id="play-trailer-btn"
          class="inline-flex items-center justify-center gap-xs px-lg py-md border border-border text-ink rounded-md font-semibold text-sm hover:bg-surface-elev transition-[background-color,transform] duration-fast hover:-translate-y-[1px] active:translate-y-0 min-h-[48px]"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <polygon points="5,3 19,12 5,21"></polygon>
          </svg>
          Ascolta 60 secondi di assaggio
        </button>
      </div>
      <audio id="trailer-audio" src="/audio/trailers/bari/bari-vecchia-trailer-it.mp3" class="hidden" preload="none"></audio>
    </div>
  </section>

  {/* ── BULLET STRIP ── */}
  <div class="bg-surface-elev border-b border-border">
    <ul class="max-w-wrap mx-auto px-md py-md flex flex-col sm:flex-row sm:gap-xl gap-xs text-sm text-ink-muted list-none p-0 m-0 sm:py-md py-sm">
      <li class="flex items-center gap-xs"><span class="text-accent">✦</span> 2 racconti brevi, scelti per una sosta di 4 o 5 ore.</li>
      <li class="flex items-center gap-xs"><span class="text-accent">✦</span> Partenza semplice: terminal, centro storico, ritorno al molo a piedi.</li>
      <li class="flex items-center gap-xs"><span class="text-accent">✦</span> Durata ottimizzata: ascolti, cammini, rientri con margine.</li>
    </ul>
  </div>

  <style>
    #hero-crociera {
      min-height: clamp(280px, 42vh, 480px);
      display: flex;
      align-items: center;
    }
    .cruise-scrim {
      position: absolute;
      inset: 0;
      background: linear-gradient(
        to right,
        oklch(from var(--color-surface) l c h / 0.90) 0%,
        oklch(from var(--color-surface) l c h / 0.65) 40%,
        oklch(from var(--color-surface) l c h / 0.15) 75%,
        oklch(from var(--color-surface) l c h / 0) 100%
      );
      pointer-events: none;
    }
    @media (max-width: 768px) {
      .cruise-scrim {
        background: linear-gradient(
          to bottom,
          oklch(from var(--color-surface) l c h / 0.92) 0%,
          oklch(from var(--color-surface) l c h / 0.75) 60%,
          oklch(from var(--color-surface) l c h / 0.55) 100%
        );
      }
    }
  </style>

  {/* ── COSA ASCOLTI ── */}
  <section class="bg-surface py-xl lg:py-3xl border-b border-border">
    <div class="max-w-wrap mx-auto px-md">
      <h2 class="font-display font-light text-ink text-[clamp(1.6rem,3.5vw,2.4rem)] leading-tight tracking-[-0.01em] mb-xl text-center">
        Due capitoli. Una mattina che ricorderai.
      </h2>
      <div class="grid sm:grid-cols-2 gap-lg">
        {/* Card 1 */}
        <div class="bg-surface-elev rounded-lg overflow-hidden border border-border flex flex-col">
          <div class="aspect-[3/4] overflow-hidden">
            <img
              src="/images/covers/bari-vecchia.jpg"
              alt="Bari Vecchia — Dentro la Città"
              class="w-full h-full object-cover object-top"
              width="1024"
              height="1536"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="p-md flex flex-col gap-xs flex-1">
            <span class="text-[11px] font-semibold tracking-[0.18em] uppercase text-ink-subtle">21 minuti</span>
            <h3 class="font-display font-light text-ink text-xl leading-snug">
              Bari Vecchia — Dentro la Città
            </h3>
            <p class="font-body text-sm text-ink-muted leading-relaxed">
              Parte da Strada delle Crociate. Il Borgo Antico capitolo per capitolo: la Basilica di San Nicola, le strette, la Cattedrale, i rioni. Storia vera, non la guida turistica standard.
            </p>
          </div>
        </div>
        {/* Card 2 */}
        <div class="bg-surface-elev rounded-lg overflow-hidden border border-border flex flex-col">
          <div class="aspect-[3/4] overflow-hidden">
            <img
              src="/images/covers/il-meglio-di-bari.jpg"
              alt="Bari a Tavola — Il Cibo che Tiene Insieme la Città"
              class="w-full h-full object-cover object-top"
              width="1024"
              height="1536"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="p-md flex flex-col gap-xs flex-1">
            <span class="text-[11px] font-semibold tracking-[0.18em] uppercase text-ink-subtle">28 minuti</span>
            <h3 class="font-display font-light text-ink text-xl leading-snug">
              Bari a Tavola — Il Cibo che Tiene Insieme la Città
            </h3>
            <p class="font-body text-sm text-ink-muted leading-relaxed">
              Parte da Strada Arco Basso. Il lungomare, il mercato del pesce, i panzerotti. I posti che i baresi non spiegano perché li danno per scontati.
            </p>
          </div>
        </div>
      </div>
      <p class="font-body text-sm text-ink-muted text-center mt-lg">
        49 minuti di racconto più il tempo del cammino. Totale 3–4 ore, ritorno in nave compreso.
      </p>
    </div>
  </section>

  {/* ── IL PERCORSO ── */}
  <section id="percorso" class="bg-surface-elev py-xl lg:py-3xl border-b border-border">
    <div class="max-w-wrap mx-auto px-md">
      <div class="flex items-center gap-sm justify-center mb-sm">
        <span class="block w-7 h-px bg-accent"></span>
        <span class="text-[11px] font-semibold tracking-[0.24em] uppercase text-ink-subtle">— Mappa —</span>
        <span class="block w-7 h-px bg-accent"></span>
      </div>
      <h2 class="font-display font-light text-ink text-[clamp(1.5rem,3vw,2.2rem)] leading-tight tracking-[-0.01em] text-center mb-xl">
        Dal molo a Bari Vecchia. 600 metri.
      </h2>
      <div class="mb-lg">
        <StartMap
          lat={41.1268}
          lng={16.8716}
          lang="it"
          startsAt="Molo Pizzoli — 8 minuti a piedi"
          delta={0.008}
        />
      </div>
      <div class="flex flex-wrap items-center justify-center gap-xs text-sm font-body text-ink-muted">
        <span class="text-ink font-semibold">Molo Pizzoli</span>
        <span class="text-ink-subtle">→ 8 minuti a piedi →</span>
        <span class="text-ink font-semibold">Cattedrale di San Sabino</span>
        <span class="text-ink-subtle">→</span>
        <span class="text-ink font-semibold">Basilica di San Nicola</span>
        <span class="text-ink-subtle">→</span>
        <span class="text-ink font-semibold">Strada delle Orecchiette</span>
        <span class="text-ink-subtle">→</span>
        <span class="text-ink font-semibold">Ritorno al molo</span>
      </div>
      <p class="font-body text-sm text-ink-subtle text-center mt-md">
        La guida parte dove serve. Tu cammini al tuo ritmo.
      </p>
    </div>
  </section>

  {/* ── COME FUNZIONA ── */}
  <section class="bg-surface py-xl lg:py-3xl border-b border-border">
    <div class="max-w-wrap mx-auto px-md">
      <h2 class="font-display font-light text-ink text-[clamp(1.5rem,3vw,2.2rem)] leading-tight tracking-[-0.01em] text-center mb-xl">
        In due minuti sei dentro.
      </h2>
      <div class="grid sm:grid-cols-3 gap-lg mb-xl">
        <div class="flex flex-col gap-sm">
          <span class="font-display font-light text-accent text-4xl leading-none">01</span>
          <h3 class="font-display font-light text-ink text-lg leading-snug">Acquisti</h3>
          <p class="font-body text-sm text-ink-muted leading-relaxed">
            Dal wifi della nave, del terminal o di un bar. Carta di credito, niente registrazione.
          </p>
        </div>
        <div class="flex flex-col gap-sm">
          <span class="font-display font-light text-accent text-4xl leading-none">02</span>
          <h3 class="font-display font-light text-ink text-lg leading-snug">Apri il link</h3>
          <p class="font-body text-sm text-ink-muted leading-relaxed">
            Arriva via email. Scarica la guida prima di iniziare il percorso e ascoltala anche senza connessione.
          </p>
        </div>
        <div class="flex flex-col gap-sm">
          <span class="font-display font-light text-accent text-4xl leading-none">03</span>
          <h3 class="font-display font-light text-ink text-lg leading-snug">Cammini e ascolti</h3>
          <p class="font-body text-sm text-ink-muted leading-relaxed">
            Le mani libere per le foto e il caffè. La guida ti accompagna passo dopo passo.
          </p>
        </div>
      </div>
      <div class="text-center">
        <button
          class="checkout-btn-crociera inline-flex items-center justify-center gap-xs px-lg py-md bg-accent text-white rounded-md font-semibold text-sm hover:bg-accent/90 transition-[background-color,transform] duration-fast hover:-translate-y-[1px] active:translate-y-0 min-h-[48px]"
          data-product="crociera"
          data-lang="it"
        >
          Inizia ora — €7,99
        </button>
      </div>
    </div>
  </section>

  {/* ── TORNI IN TEMPO ── */}
  <section class="bg-surface-elev py-xl lg:py-3xl border-b border-border">
    <div class="max-w-narrow mx-auto px-md">
      <div class="flex items-center gap-sm justify-center mb-sm">
        <span class="block w-7 h-px bg-accent"></span>
        <span class="text-[11px] font-semibold tracking-[0.24em] uppercase text-ink-subtle">— Timing —</span>
        <span class="block w-7 h-px bg-accent"></span>
      </div>
      <h2 class="font-display font-light text-ink text-[clamp(1.5rem,3vw,2.2rem)] leading-tight tracking-[-0.01em] text-center mb-xl">
        Un percorso pensato per lasciarti margine per il ritorno al porto.
      </h2>
      <ul class="flex flex-col gap-md">
        {[
          'Le guide durano poco apposta — 50 minuti totali',
          'Aggiungi un\'ora e mezza–due di camminata con calma',
          'Tieni 30 minuti di margine per il ritorno al molo',
          'Se sbarchi alle 9 e riparti alle 17, hai tutto il tempo',
        ].map((item) => (
          <li class="flex items-start gap-md">
            <svg class="w-5 h-5 text-accent flex-shrink-0 mt-[2px]" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414L8.414 15l-4.121-4.121a1 1 0 011.414-1.414L8.414 12.172l7.879-7.879a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            <span class="font-body text-sm text-ink-muted leading-relaxed">{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* ── FAQ ── */}
  <section class="bg-surface py-xl lg:py-3xl border-b border-border">
    <div class="max-w-narrow mx-auto px-md">
      <h2 class="font-display font-light text-ink text-[clamp(1.5rem,3vw,2.2rem)] leading-tight tracking-[-0.01em] text-center mb-xl">
        Domande frequenti
      </h2>
      <dl class="flex flex-col gap-lg">
        {[
          {
            q: 'Mi serve internet mentre cammino?',
            a: 'Sì per lo streaming; no se la salvi prima. Dalla pagina guida premi "Salva per ascoltare offline" mentre sei connesso al wifi del terminal o della nave. Quando compare "✓ Disponibile offline" puoi camminare senza copertura.',
          },
          {
            q: 'Quanto dista Bari Vecchia dal molo?',
            a: '600 metri, 8–10 minuti a piedi sul lungomare. Tutto pianeggiante.',
          },
          {
            q: 'E se non torno in tempo per la nave?',
            a: 'Il percorso è progettato per una visita breve e compatta. Verifica sempre l\'orario limite di rientro comunicato dalla compagnia e interrompi la visita con il margine necessario per tornare a bordo.',
          },
          {
            q: 'Posso ascoltarla anche dopo, a casa?',
            a: 'Sì, la guida è tua per sempre. Molti la riascoltano dopo il viaggio.',
          },
          {
            q: 'Le voci sono reali o AI?',
            a: 'Sono voci sintetizzate, lo dichiariamo. I testi sono scritti da noi, con fonti verificabili su /fonti.',
          },
        ].map(({ q, a }) => (
          <div class="border-b border-border pb-lg last:border-b-0 last:pb-0">
            <dt class="font-body font-semibold text-ink text-sm mb-xs">{q}</dt>
            <dd class="font-body text-sm text-ink-muted leading-relaxed">{a}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  {/* ── CLOSER ── */}
  <section class="bg-surface-elev py-xl lg:py-3xl">
    <div class="max-w-narrow mx-auto px-md text-center">
      <blockquote class="font-display font-light text-ink text-[clamp(1.2rem,2.5vw,1.7rem)] leading-relaxed tracking-[-0.01em] italic mb-xl">
        "Non ti vendiamo un tour. Ti vendiamo le parole giuste, da ascoltare quando vuoi, durante una mattina che è tua."
      </blockquote>
      <button
        class="checkout-btn-crociera inline-flex items-center justify-center gap-xs px-lg py-md bg-accent text-white rounded-md font-semibold text-sm hover:bg-accent/90 transition-[background-color,transform] duration-fast hover:-translate-y-[1px] active:translate-y-0 min-h-[48px] mb-md"
        data-product="crociera"
        data-lang="it"
      >
        Acquista Pacchetto Crociera — €7,99
      </button>
      <p class="font-body text-xs text-ink-subtle leading-relaxed">
        Accesso immediato via email · Offline · Tuo per sempre · Soddisfatti o rimborsati
      </p>
    </div>
  </section>

  {/* ── STICKY CTA MOBILE ── */}
  <div
    id="sticky-cta"
    class="fixed left-0 right-0 z-50 md:hidden bg-surface border-t border-border px-md py-sm shadow-lg translate-y-full transition-transform duration-300"
    style="bottom: var(--cookie-banner-height, 0px);"
    aria-hidden="true"
  >
    <button
      class="checkout-btn-crociera w-full inline-flex items-center justify-center gap-xs px-lg py-md bg-accent text-white rounded-md font-semibold text-sm min-h-[48px]"
      data-product="crociera"
      data-lang="it"
    >
      Pacchetto Crociera — €7,99
    </button>
  </div>

</Layout>

<script>
  import { createAudioAnalyticsTracker } from '../lib/audio-analytics';
  import { submitCheckoutRedirect } from '../lib/checkout-client';
  const lang = 'it';
  // ── Trailer audio toggle ──
  const playBtn = document.getElementById('play-trailer-btn') as HTMLButtonElement | null;
  const audio = document.getElementById('trailer-audio') as HTMLAudioElement | null;
  if (playBtn && audio) {
    const tracker = createAudioAnalyticsTracker({
      audio,
      guideSlug: 'bari-vecchia',
      audioAssetId: 'bari-vecchia-cruise-sample-it',
      language: lang,
      audioContext: 'cruise',
      audioType: 'cruise_sample',
      product: 'crociera',
    });
    audio.addEventListener('timeupdate', () => {
      tracker.onTimeUpdate();
    });
    playBtn.addEventListener('click', () => {
      if (audio.paused) {
        audio.play().then(() => {
          tracker.onPlay();
          playBtn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg> Pausa assaggio';
        }).catch(() => {});
      } else {
        audio.pause();
        tracker.onPause();
        playBtn.innerHTML = `<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><polygon points="5,3 19,12 5,21"></polygon></svg> Ascolta 60 secondi di assaggio`;
      }
    });
    audio.addEventListener('ended', () => {
      tracker.onEnded();
      playBtn.innerHTML = `<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><polygon points="5,3 19,12 5,21"></polygon></svg> Ascolta 60 secondi di assaggio`;
    });
  }

  // ── Sticky CTA via IntersectionObserver ──
  const hero = document.getElementById('hero-crociera');
  const stickyCta = document.getElementById('sticky-cta');
  if (hero && stickyCta) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) {
          stickyCta.classList.remove('translate-y-full');
          stickyCta.removeAttribute('aria-hidden');
        } else {
          stickyCta.classList.add('translate-y-full');
          stickyCta.setAttribute('aria-hidden', 'true');
        }
      },
      { threshold: 0 }
    );
    observer.observe(hero);
  }

  // ── Checkout buttons ──
  document.querySelectorAll<HTMLButtonElement>('.checkout-btn-crociera').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const product = btn.dataset.product ?? 'crociera';
      btn.disabled = true;
      const orig = btn.textContent;
      btn.textContent = 'Caricamento…';
      try {
        if (typeof window.localisTrack === 'function') {
          const params = {
            product,
            guide_count: 2,
            guide_slugs: 'bari-vecchia,bari-tavola',
            lang,
            value: 7.99,
            currency: 'EUR',
            cta_source: 'cruise',
          };
          window.localisTrack('begin_checkout', params);
        }
        submitCheckoutRedirect({ product: 'crociera', lang });
      } catch {
        btn.disabled = false;
        btn.textContent = orig;
        alert('Errore nel checkout. Riprova tra qualche secondo.');
      }
    });
  });
</script>
