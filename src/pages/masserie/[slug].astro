---
export const prerender = true;
import { getCollection, render } from 'astro:content';
import Layout from '../../components/Layout.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import HeroAudioSample from '../../components/HeroAudioSample.astro';
import StructuredData from '../../components/StructuredData.astro';
import MasseriaCard from '../../components/MasseriaCard.astro';
import { comuneDi, inOrdine } from '../../lib/masserie';

export async function getStaticPaths() {
  const masserie = await getCollection('masserie', (m) => m.data.status === 'published');
  return masserie.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const comune = comuneDi(d.place);

// Le altre masserie: prima quelle dello stesso paese, poi le altre, tre in tutto.
// Il numero è lo stesso dell'atlante (inOrdine), così «07» resta «07».
const tutte = inOrdine(await getCollection('masserie', (m) => m.data.status === 'published'));
const numeroDi = (slug: string) => tutte.findIndex((m) => m.data.slug === slug) + 1;
const altreMasserie = tutte
  .filter((m) => m.data.slug !== d.slug)
  .sort((a, b) => Number(comuneDi(b.data.place)?.slug === comune?.slug) - Number(comuneDi(a.data.place)?.slug === comune?.slug))
  .slice(0, 3);
const { Content } = await render(entry);
const path = `/masserie/${d.slug}/`;
const SITE = 'https://localis.guide';
const minuti = (s: number) => Math.max(1, Math.round(s / 60));
const minutes = minuti(d.duration_seconds);
const lungo = d.format === 'lungo';

// Altre lingue solo se esiste il file audio: mai promettere una lingua che poi parla italiano.
const altre = [
  d.audio_en && d.duration_en_seconds ? { lang: 'en' as const, src: d.audio_en, label: `Listen in English · ${minuti(d.duration_en_seconds)} min` } : null,
  d.audio_de && d.duration_de_seconds ? { lang: 'de' as const, src: d.audio_de, label: `Auf Deutsch hören · ${minuti(d.duration_de_seconds)} Min` } : null,
].filter((x): x is NonNullable<typeof x> => x !== null);

// L'assaggio della guida di zona (per ora una zona sola: Valle d'Itria → Alberobello).
const assaggioZona = d.zone_href === '/valle-d-itria/'
  ? { src: '/audio/trailers/valle-d-itria/alberobello-trailer-it.mp3', guideSlug: 'alberobello' }
  : null;

const iso = (s: number) => `PT${Math.floor(s / 60)}M${s % 60}S`;
const ld = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: `${d.name} · ${d.title_it}`,
    description: d.description,
    inLanguage: 'it',
    datePublished: d.published_at.toISOString().slice(0, 10),
    author: { '@type': 'Organization', name: 'Localis', url: SITE },
    publisher: { '@type': 'Organization', name: 'Localis', url: SITE },
    mainEntityOfPage: `${SITE}${path}`,
    about: {
      '@type': 'LodgingBusiness',
      name: d.name,
      address: { '@type': 'PostalAddress', addressLocality: d.place, addressRegion: 'Puglia', addressCountry: 'IT' },
      ...(d.website_url ? { url: d.website_url } : {}),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'AudioObject',
    name: `${d.name} · ${d.title_it}`,
    description: d.description,
    contentUrl: `${SITE}${d.audio_it}`,
    encodingFormat: 'audio/mpeg',
    duration: iso(d.duration_seconds),
    inLanguage: 'it',
    isAccessibleForFree: true,
    publisher: { '@type': 'Organization', name: 'Localis', url: SITE },
  },
];
---
<Layout
  title={`${d.name} · ${d.title_it} · Localis`}
  description={d.description}
  lang="it"
  langUrlsOverride={{ it: path }}
  ogType="article"
>
  <StructuredData data={ld} />

  <nav aria-label="Breadcrumb" class="max-w-narrow mx-auto px-md pt-lg">
    <ol class="flex items-center gap-xs text-sm text-ink-subtle flex-wrap">
      <li><a href="/" class="hover:text-ink transition-colors">Home</a></li>
      <li aria-hidden="true" class="text-ink-subtle/50">›</li>
      <li><a href="/masserie/" class="hover:text-ink transition-colors">Masserie</a></li>
      <li aria-hidden="true" class="text-ink-subtle/50">›</li>
      <li aria-current="page" class="text-ink-muted">{d.name}</li>
    </ol>
  </nav>

  <header class="scheda-apertura max-w-6xl mx-auto px-md pt-md">
    <div class="scheda-foto">
      {comune?.img && <img src={comune.img} alt={comune.imgAlt ?? ''} fetchpriority="high" />}
      <div class="scheda-testo">
        <p class="scheda-occhiello">Masserie di Puglia · {d.place}</p>
        <h1>{d.name}</h1>
        <p class="scheda-titolo">{d.title_it}</p>
      </div>
      {comune && <p class="scheda-didascalia">Foto: {comune.label}, il territorio. Non è la masseria.</p>}
    </div>
  </header>

  <article class="max-w-narrow mx-auto px-md py-xl">

    <HeroAudioSample
      lang="it"
      src={d.audio_it}
      guideSlug={`masseria-${d.slug}`}
      context="masseria"
      label={lungo ? `Ascolta · ${minutes} min · racconto lungo` : `Ascolta · ${minutes} min · gratis`}
    />
    {altre.map((a) => (
      <HeroAudioSample lang={a.lang} src={a.src} guideSlug={`masseria-${d.slug}`} context="masseria" label={a.label} />
    ))}

    <p class="text-sm text-ink-subtle mt-md">
      Scritto da Localis su fonti pubbliche, letto da una voce sintetica ({d.voice}).
      Non è una pagina della masseria.
      {d.website_url && <> <a href={d.website_url} rel="noopener" class="text-link underline underline-offset-2">Il sito della masseria →</a></>}
    </p>

    <h2 class="font-display text-2xl text-ink mt-2xl mb-md">Il testo</h2>
    <div class="prose prose-ink max-w-prose">
      <Content />
    </div>

    <h2 class="font-display text-2xl text-ink mt-2xl mb-md">Le fonti</h2>
    <ul class="text-sm text-ink-muted space-y-xs">
      {d.sources.map((s) => (
        <li>{s.author && <>{s.author}, </>}{s.url ? <a href={s.url} class="text-link underline underline-offset-2" rel="noopener">{s.title}</a> : <em>{s.title}</em>}{s.publisher && <>, {s.publisher}</>}{s.year && <> ({s.year})</>}</li>
      ))}
    </ul>

    <div class="mt-2xl rounded-lg border border-border bg-surface-elev p-lg">
      <p class="text-ink">
        Gestite questa masseria e c'è qualcosa da correggere, o da togliere?
        Scriveteci a <a href="mailto:hello@localis.guide" class="text-link underline underline-offset-2">hello@localis.guide</a>:
        lo sistemiamo.
      </p>
    </div>
  </article>

  <section class="max-w-6xl mx-auto px-md pb-xl">
    <div class="altre-testa">
      <h2 class="font-display text-3xl text-ink">Le altre masserie</h2>
      <a href="/masserie/" class="text-link underline underline-offset-2">Tutto l'atlante →</a>
    </div>
    <div class="altre">
      {altreMasserie.map((m) => <MasseriaCard entry={m} numero={numeroDi(m.data.slug)} foto={false} />)}
    </div>
  </section>

  <article class="max-w-narrow mx-auto px-md pb-2xl">

    <section class="mt-3xl border-t border-border pt-2xl">
      <Eyebrow class="mb-md">La valle intorno</Eyebrow>
      <h2 class="font-display text-2xl text-ink mb-sm">I paesi della {d.zone_label}, con lo stesso sguardo.</h2>
      <p class="text-ink-muted leading-relaxed">
        Le masserie si ascoltano gratis. I racconti dei paesi intorno — perché Alberobello è fatta di coni,
        cosa si vede da Locorotondo, chi ha costruito Ostuni bianca — sono il nostro catalogo.
      </p>
      {assaggioZona && (
        <HeroAudioSample lang="it" src={assaggioZona.src} guideSlug={assaggioZona.guideSlug} context="masseria-zona" />
      )}
      <p class="mt-lg">
        <a href={`${d.zone_href}#prezzi`} class="text-link underline underline-offset-2">I racconti della {d.zone_label} si comprano da 4,99 € →</a>
      </p>
    </section>
  </article>
</Layout>

<style>
  .scheda-foto {
    position: relative;
    min-height: clamp(18rem, 46vh, 30rem);
    border-radius: 18px;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    background: var(--color-surface-elev);
    isolation: isolate;
  }
  .scheda-foto img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: sepia(0.5) saturate(0.85) contrast(1.04) brightness(0.95);
    z-index: -2;
  }
  .scheda-foto::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(0deg, rgba(28, 24, 19, 0.78) 0%, rgba(28, 24, 19, 0.25) 55%, rgba(28, 24, 19, 0.05) 100%);
  }
  .scheda-testo { padding: 2rem 1.5rem 2.6rem; color: #fbfaf6; animation: scheda-su 0.8s cubic-bezier(.2,.7,.2,1) both; }
  .scheda-occhiello { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: #e8d3a3; margin-bottom: 0.6rem; }
  .scheda-testo h1 { color: #fbfaf6; font-family: var(--font-display); font-size: var(--text-4xl); line-height: 1.05; font-weight: 400; letter-spacing: -0.015em; }
  .scheda-titolo { font-family: var(--font-display); font-style: italic; font-size: 1.35rem; margin-top: 0.4rem; color: rgba(251, 250, 246, 0.9); }
  .scheda-didascalia {
    position: absolute;
    right: 0.9rem;
    bottom: 0.6rem;
    font-size: 0.68rem;
    color: rgba(251, 250, 246, 0.72);
  }
  @media (min-width: 768px) { .scheda-testo { padding: 2.5rem 2.75rem 3rem; } }

  .altre-testa { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; flex-wrap: wrap; margin-bottom: 1.25rem; border-top: 1px solid var(--color-border-2); padding-top: 2rem; }
  .altre { display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr)); }

  @keyframes scheda-su { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .scheda-testo { animation: none; } }
</style>
