---
export const prerender = true;
import { getCollection, render } from 'astro:content';
import Layout from '../../components/Layout.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import HeroAudioSample from '../../components/HeroAudioSample.astro';
import StructuredData from '../../components/StructuredData.astro';

export async function getStaticPaths() {
  const masserie = await getCollection('masserie', (m) => m.data.status === 'published');
  return masserie.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const path = `/masserie/${d.slug}/`;
const SITE = 'https://localis.guide';
const minuti = (s: number) => Math.max(1, Math.round(s / 60));
const minutes = minuti(d.duration_seconds);
const lungo = d.format === 'lungo';

// Altre lingue solo se esiste il file audio: mai promettere una lingua che poi parla italiano.
const altre = [
  d.audio_en && d.duration_en_seconds ? { lang: 'en' as const, src: d.audio_en, label: `Listen in English · ${minuti(d.duration_en_seconds)} min` } : null,
  d.audio_de && d.duration_de_seconds ? { lang: 'de' as const, src: d.audio_de, label: `Auf Deutsch hören · ${minuti(d.duration_de_seconds)} Min` } : null,
].filter((x): x is NonNullable<typeof x> => x !== null);

// L'assaggio della guida di zona (per ora una zona sola: Valle d'Itria → Alberobello).
const assaggioZona = d.zone_href === '/valle-d-itria/'
  ? { src: '/audio/trailers/valle-d-itria/alberobello-trailer-it.mp3', guideSlug: 'alberobello' }
  : null;

const iso = (s: number) => `PT${Math.floor(s / 60)}M${s % 60}S`;
const ld = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: `${d.name} · ${d.title_it}`,
    description: d.description,
    inLanguage: 'it',
    datePublished: d.published_at.toISOString().slice(0, 10),
    author: { '@type': 'Organization', name: 'Localis', url: SITE },
    publisher: { '@type': 'Organization', name: 'Localis', url: SITE },
    mainEntityOfPage: `${SITE}${path}`,
    about: {
      '@type': 'LodgingBusiness',
      name: d.name,
      address: { '@type': 'PostalAddress', addressLocality: d.place, addressRegion: 'Puglia', addressCountry: 'IT' },
      ...(d.website_url ? { url: d.website_url } : {}),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'AudioObject',
    name: `${d.name} · ${d.title_it}`,
    description: d.description,
    contentUrl: `${SITE}${d.audio_it}`,
    encodingFormat: 'audio/mpeg',
    duration: iso(d.duration_seconds),
    inLanguage: 'it',
    isAccessibleForFree: true,
    publisher: { '@type': 'Organization', name: 'Localis', url: SITE },
  },
];
---
<Layout
  title={`${d.name} · ${d.title_it} · Localis`}
  description={d.description}
  lang="it"
  langUrlsOverride={{ it: path }}
  ogType="article"
>
  <StructuredData data={ld} />

  <nav aria-label="Breadcrumb" class="max-w-narrow mx-auto px-md pt-lg">
    <ol class="flex items-center gap-xs text-sm text-ink-subtle flex-wrap">
      <li><a href="/" class="hover:text-ink transition-colors">Home</a></li>
      <li aria-hidden="true" class="text-ink-subtle/50">›</li>
      <li><a href="/masserie/" class="hover:text-ink transition-colors">Masserie</a></li>
      <li aria-hidden="true" class="text-ink-subtle/50">›</li>
      <li aria-current="page" class="text-ink-muted">{d.name}</li>
    </ol>
  </nav>

  <article class="max-w-narrow mx-auto px-md py-xl">
    <Eyebrow class="mb-md">Masserie di Puglia · {d.place}</Eyebrow>
    <h1 class="font-display text-4xl text-ink leading-tight mb-sm">{d.name}</h1>
    <p class="font-display italic text-xl text-ink-muted mb-lg">{d.title_it}</p>

    <HeroAudioSample
      lang="it"
      src={d.audio_it}
      guideSlug={`masseria-${d.slug}`}
      context="masseria"
      label={lungo ? `Ascolta · ${minutes} min · racconto lungo` : `Ascolta · ${minutes} min · gratis`}
    />
    {altre.map((a) => (
      <HeroAudioSample lang={a.lang} src={a.src} guideSlug={`masseria-${d.slug}`} context="masseria" label={a.label} />
    ))}

    <p class="text-sm text-ink-subtle mt-md">
      Scritto da Localis su fonti pubbliche, letto da una voce sintetica ({d.voice}).
      Non è una pagina della masseria.
      {d.website_url && <> <a href={d.website_url} rel="noopener" class="text-link underline underline-offset-2">Il sito della masseria →</a></>}
    </p>

    <h2 class="font-display text-2xl text-ink mt-2xl mb-md">Il testo</h2>
    <div class="prose prose-ink max-w-prose">
      <Content />
    </div>

    <h2 class="font-display text-2xl text-ink mt-2xl mb-md">Le fonti</h2>
    <ul class="text-sm text-ink-muted space-y-xs">
      {d.sources.map((s) => (
        <li>{s.author && <>{s.author}, </>}{s.url ? <a href={s.url} class="text-link underline underline-offset-2" rel="noopener">{s.title}</a> : <em>{s.title}</em>}{s.publisher && <>, {s.publisher}</>}{s.year && <> ({s.year})</>}</li>
      ))}
    </ul>

    <div class="mt-2xl rounded-lg border border-border bg-surface-elev p-lg">
      <p class="text-ink">
        Gestite questa masseria e c'è qualcosa da correggere, o da togliere?
        Scriveteci a <a href="mailto:hello@localis.guide" class="text-link underline underline-offset-2">hello@localis.guide</a>:
        lo sistemiamo.
      </p>
    </div>

    <section class="mt-3xl border-t border-border pt-2xl">
      <Eyebrow class="mb-md">La valle intorno</Eyebrow>
      <h2 class="font-display text-2xl text-ink mb-sm">I paesi della {d.zone_label}, con lo stesso sguardo.</h2>
      <p class="text-ink-muted leading-relaxed">
        Le masserie si ascoltano gratis. I racconti dei paesi intorno — perché Alberobello è fatta di coni,
        cosa si vede da Locorotondo, chi ha costruito Ostuni bianca — sono il nostro catalogo.
      </p>
      {assaggioZona && (
        <HeroAudioSample lang="it" src={assaggioZona.src} guideSlug={assaggioZona.guideSlug} context="masseria-zona" />
      )}
      <p class="mt-lg">
        <a href={`${d.zone_href}#prezzi`} class="text-link underline underline-offset-2">I racconti della {d.zone_label} si comprano da 4,99 € →</a>
      </p>
    </section>
  </article>
</Layout>
