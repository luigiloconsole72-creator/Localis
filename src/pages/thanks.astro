---
import { getCollection } from 'astro:content';
import Layout from '../components/Layout.astro';
import AudioPlayer from '../components/AudioPlayer.astro';
import { buildThanksPageModel } from '../lib/thanks-page';
import { generateAccessToken } from '../lib/jwt';
import { canonicalGuideSlugs } from '../lib/legacy-slugs';
import { localizedHref, type Lang } from '../lib/i18n';
import { getStripe } from '../lib/stripe';

function normalizeLang(value: string | null | undefined): Lang {
  if (value === 'en' || value === 'de') return value;
  return 'it';
}

const UI_COPY = {
  it: {
    eyebrow: 'Localis',
    purchasedGuidesLabel: 'Guide acquistate',
    recoverCta: 'Recupera accesso',
    homeCta: 'Torna in homepage',
    backupLabel: 'Link di backup via email',
    backupMessage: 'Ti serve di nuovo il link? Puoi recuperarlo in qualsiasi momento.',
    unconfirmedHeading: 'Stiamo preparando il tuo accesso.',
    unconfirmedMessage: (buyerEmail: string | null) =>
      buyerEmail
        ? `Stiamo verificando l'acquisto associato a ${buyerEmail}. Se il pagamento verrà confermato, useremo questa email per inviarti il link di accesso.`
        : 'Mostriamo le guide acquistate solo dopo la conferma del pagamento. Se hai già completato l’acquisto, controlla la tua email o usa il recupero accesso.',
    confirmedEmptyHeading: 'Stiamo finalizzando le tue guide.',
  },
  en: {
    eyebrow: 'Localis',
    purchasedGuidesLabel: 'Purchased guides',
    recoverCta: 'Recover access',
    homeCta: 'Back to homepage',
    backupLabel: 'Backup link by email',
    backupMessage: 'Need the link again? You can recover it anytime.',
    unconfirmedHeading: 'We are preparing your access.',
    unconfirmedMessage: (buyerEmail: string | null) =>
      buyerEmail
        ? `We are verifying the purchase linked to ${buyerEmail}. If payment is confirmed, we will use this email to send your access link.`
        : 'We only show purchased guides after payment is confirmed. If you already completed checkout, check your email or use access recovery.',
    confirmedEmptyHeading: 'We are finalizing your guides.',
  },
  de: {
    eyebrow: 'Localis',
    purchasedGuidesLabel: 'Gekaufte Guides',
    recoverCta: 'Zugang wiederherstellen',
    homeCta: 'Zur Startseite',
    backupLabel: 'Backup-Link per E-Mail',
    backupMessage: 'Du brauchst den Link erneut? Du kannst ihn jederzeit wiederherstellen.',
    unconfirmedHeading: 'Wir bereiten deinen Zugang vor.',
    unconfirmedMessage: (buyerEmail: string | null) =>
      buyerEmail
        ? `Wir prüfen gerade den Kauf für ${buyerEmail}. Wenn die Zahlung bestätigt wird, senden wir den Zugangslink an diese E-Mail-Adresse.`
        : 'Wir zeigen gekaufte Guides erst nach bestätigter Zahlung. Wenn du den Checkout schon abgeschlossen hast, prüfe bitte deine E-Mail oder stelle den Zugang wieder her.',
    confirmedEmptyHeading: 'Wir finalisieren deine Guides.',
  },
} satisfies Record<
  Lang,
  {
    eyebrow: string;
    purchasedGuidesLabel: string;
    recoverCta: string;
    homeCta: string;
    backupLabel: string;
    backupMessage: string;
    unconfirmedHeading: string;
    unconfirmedMessage: (buyerEmail: string | null) => string;
    confirmedEmptyHeading: string;
  }
>;

const sessionId = Astro.url.searchParams.get('session_id');
const allGuides = await getCollection('guides');

let lang = normalizeLang(Astro.url.searchParams.get('lang'));
let hasConfirmedPayment = false;
let fallbackBuyerEmail: string | null = null;
let purchaseParams: Record<string, unknown> = {};
// Player inline: dopo il pagamento si ascolta QUI, senza passare dall'email.
let accessToken: string | null = null;
let purchasedGuides: typeof allGuides = [];

let model = buildThanksPageModel({
  lang,
  token: null,
  buyerEmail: null,
  guideSlugs: [],
  matchedGuides: [],
});

if (sessionId) {
  try {
    const stripe = getStripe();
    const session = await stripe.checkout.sessions.retrieve(sessionId);
    const email = session.customer_email || session.customer_details?.email || null;
    fallbackBuyerEmail = email;
    const meta = session.metadata || {};
    const guideSlugs = canonicalGuideSlugs(
      (meta.guide_slugs || '')
        .split(',')
        .map((slug) => slug.trim())
        .filter(Boolean),
    );

    lang = normalizeLang(meta.lang ?? Astro.url.searchParams.get('lang'));
    hasConfirmedPayment = session.payment_status === 'paid';
    purchaseParams = {
      session: session.id,
      // Stessa chiave del purchase server-side (webhook): GA4 deduplica i
      // purchase con lo stesso transaction_id → nessun doppio conteggio.
      transaction_id: session.id,
      product: meta.product || '',
      guide_slugs: guideSlugs.join(','),
      guide_count: guideSlugs.length,
      partner_id: meta.partner_id || '(direct)',
      lang,
      value: (session.amount_total || 0) / 100,
      currency: (session.currency || 'eur').toUpperCase(),
      cta_source: 'stripe_success',
      items: guideSlugs.map((slug) => ({ item_id: slug, item_name: slug, quantity: 1 })),
    };

    const matchedGuides = guideSlugs
      .map((slug) => allGuides.find((guide) => guide.data.slug === slug))
      .filter((guide): guide is (typeof allGuides)[number] => Boolean(guide));

    if (email && guideSlugs.length > 0 && hasConfirmedPayment) {
      const token = generateAccessToken({
        email,
        guide_slugs: guideSlugs,
        stripe_session_id: session.id,
        partner_id: meta.partner_id || null,
      });

      accessToken = token;
      purchasedGuides = matchedGuides;

      model = buildThanksPageModel({
        lang,
        token,
        buyerEmail: email,
        guideSlugs,
        matchedGuides,
      });
    } else {
      model = buildThanksPageModel({
        lang,
        token: null,
        buyerEmail: email,
        guideSlugs,
        matchedGuides,
      });
    }
  } catch (err) {
    console.error('[thanks] session lookup error', err);
  }
}

const ui = UI_COPY[lang];
const recoverHref = localizedHref('/recover', lang);
const homeHref = localizedHref('/', lang);
const success = model.state === 'ready';
const fallbackHeading = hasConfirmedPayment ? ui.confirmedEmptyHeading : ui.unconfirmedHeading;
const fallbackMessage = hasConfirmedPayment ? model.primaryMessage : ui.unconfirmedMessage(fallbackBuyerEmail);
const footerMessage = success || hasConfirmedPayment ? model.emailMessage : ui.backupMessage;
const pageTitle = success ? model.pageTitle : fallbackHeading;
---
<Layout title={`${pageTitle} · Localis`} lang={lang} robots="noindex,nofollow">
  <main class="max-w-wrap mx-auto px-md py-3xl">
    <header class="max-w-prose mb-2xl">
      <p class="font-display italic text-2xl text-accent mb-md">{ui.eyebrow}</p>
      <h1 class="font-display text-4xl text-ink mb-md">{pageTitle}</h1>
      <p class="text-base text-ink-muted">
        {success ? model.primaryMessage : fallbackMessage}
      </p>
      {success ? (
        <div class="mt-lg rounded-xl border border-accent/20 bg-accent/5 p-md">
          <p class="text-xs uppercase tracking-[0.18em] text-accent mb-xs">{ui.backupLabel}</p>
          <p class="text-sm text-ink-muted">{model.emailMessage}</p>
        </div>
      ) : null}
    </header>

    {success ? (
      <section class="flex flex-col gap-xl max-w-[720px]" aria-label={ui.purchasedGuidesLabel}>
        {model.cards.map((card, i) => (
          <article class="overflow-hidden rounded-xl border border-border bg-surface-elev">
            <div class="flex flex-col p-md gap-sm">
              <h2 class="font-display text-2xl text-ink m-0">{card.title}</h2>
              <p class="text-sm text-ink-muted leading-relaxed m-0">{card.subtitle}</p>
              <p class="text-xs uppercase tracking-[0.18em] text-ink-subtle m-0">{card.duration}</p>
              {accessToken && purchasedGuides[i] ? (
                <AudioPlayer guide={purchasedGuides[i].data} token={accessToken} lang={lang} />
              ) : (
                <a
                  href={card.ctaHref}
                  class="inline-flex items-center justify-center rounded-md bg-ink px-lg py-md text-sm font-semibold text-surface transition-colors duration-fast no-underline hover:bg-ink/90"
                >
                  {model.cardCta}
                </a>
              )}
              <a href={card.ctaHref} class="text-sm text-link hover:text-link-pressed">
                {lang === 'it' ? 'La tua pagina d\'ascolto permanente →' : lang === 'de' ? 'Deine dauerhafte Hörseite →' : 'Your permanent listening page →'}
              </a>
            </div>
          </article>
        ))}
      </section>
    ) : (
      <section class="max-w-prose rounded-xl border border-border bg-surface-elev p-lg">
        <div class="flex flex-wrap items-center gap-md">
          <a
            href={recoverHref}
            class="inline-flex items-center gap-xs rounded-md bg-ink px-md py-sm text-sm font-semibold text-surface transition-colors duration-fast no-underline hover:bg-ink/90"
          >
            {ui.recoverCta}
          </a>
          <a
            href={homeHref}
            class="inline-flex items-center gap-xs rounded-md border border-border px-md py-sm text-sm font-semibold text-ink transition-colors duration-fast no-underline hover:border-ink"
          >
            {ui.homeCta}
          </a>
        </div>
      </section>
    )}

    <footer class="mt-2xl max-w-prose border-t border-border pt-lg text-sm text-ink-subtle">
      {success ? (
        <p>
          {ui.backupMessage}{' '}
          <a href={recoverHref} class="text-link hover:text-link-pressed">
            {ui.recoverCta}
          </a>
          .
        </p>
      ) : (
        <p>{footerMessage}</p>
      )}
    </footer>
  </main>

  <script is:inline define:vars={{ sessionId, success, purchaseParams }}>
    if (success) {
      const params = purchaseParams || { session: sessionId || 'unknown' };
      if (typeof window.localisTrack === 'function') {
        window.localisTrack('purchase', params);
      } else if (typeof window.plausible === 'function') {
        window.plausible('Checkout Completed', { props: params });
      }
    }
  </script>
</Layout>
