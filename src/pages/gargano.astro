---
export const prerender = true;
import Layout from '../components/Layout.astro';
import SectionDivider from '../components/SectionDivider.astro';
import PriceCard from '../components/PriceCard.astro';
import StepsBlock from '../components/StepsBlock.astro';
import LangPills from '../components/LangPills.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import HeroAudioSample from '../components/HeroAudioSample.astro';
import StructuredData from '../components/StructuredData.astro';
import { itemListLD } from '../lib/seo';

interface GuideEntry {
  slug: string;
  title: string;
  subtitle: string;
  places: string;
  narrator: string;
  cover: string;
  alt: string;
  price?: string;
}

const guides: GuideEntry[] = [
  {
    slug: 'gargano-vieste',
    title: 'Vieste — La Città sul Promontorio',
    subtitle: 'Falesie, leggende e pietra bianca: la città che guarda il mare dall\'alto.',
    places: 'Vieste · Pugnochiuso · trabucchi · grotte marine',
    narrator: 'Rossella, voce narrativa della costa di Vieste',
    cover: '/images/covers/gargano-vieste-card.webp',
    alt: 'Vieste, promontorio di roccia bianca sul mare del Gargano',
    price: '€4,99',
  },
  {
    slug: 'gargano-nord',
    title: 'La Costa Nord — Trabucchi, Borghi e Mare',
    subtitle: 'Borghi appartati, trabucchi e strade lente lungo la costa.',
    places: 'Lesina · Rodi Garganico · Peschici · trabucchi · lago di Lesina',
    narrator: 'Ferdinando, voce narrativa dei trabucchi',
    cover: '/images/covers/gargano-nord.jpg',
    alt: 'Trabucco sul Gargano, struttura di legno di ginepro sulla roccia',
    price: '€4,99',
  },
  {
    slug: 'gargano-sacro',
    title: 'Il Sacro Monte — Foresta, Fede e Pellegrini',
    subtitle: 'La foresta, la grotta, il convento: il cammino dei pellegrini sul monte sacro.',
    places: 'Foresta Umbra · Monte Sant\'Angelo · San Giovanni Rotondo · Padre Pio',
    narrator: "Fra' Salvatore, trent'anni al Santuario",
    cover: '/images/covers/gargano-sacro.jpg',
    alt: "Foresta Umbra del Gargano, bosco primario con faggi e cerri",
    price: '€4,99',
  },
  {
    slug: 'gargano-tremiti',
    title: "Le Tremiti — L'Arcipelago Dimenticato",
    subtitle: 'Isole, abbazie e mare profondo: il Gargano che continua oltre la costa.',
    places: 'San Domino · San Nicola · grotte marine · abbazia benedettina · parco marino',
    narrator: 'Tonino, barcaiolo di San Domino',
    cover: '/images/covers/gargano-tremiti.jpg',
    alt: 'Isole Tremiti, acque turchesi e rocce bianche nel mezzo dell\'Adriatico',
    price: '€4,99',
  },
  {
    slug: 'gargano-paesi',
    title: "L'Entroterra del Gargano — Pietra Bianca e Vicoli",
    subtitle: 'Pietra, vicoli e paesi interni: il Gargano lontano dalle spiagge.',
    places: 'Vico del Gargano · Ischitella · Carpino · lago di Varano',
    narrator: 'Stefano, guardiaparco da trent\'anni',
    cover: '/images/covers/gargano-paesi-card.webp',
    alt: 'Anziana donna del Gargano tra i vicoli di pietra bianca',
    price: '€4,99',
  },
  {
    slug: 'gargano-saline',
    title: 'Le Saline di Margherita — Sale e Fenicotteri',
    subtitle: 'Sale, acqua e fenicotteri: il paesaggio dove il Gargano incontra la pianura.',
    places: 'Saline di Margherita di Savoia · Manfredonia · Siponto · fenicotteri',
    narrator: "Antonello, trent'anni alle saline",
    cover: '/images/covers/gargano-saline-card.webp',
    alt: 'Canale delle saline di Margherita di Savoia con barche da pesca ormeggiate e cumulo di sale',
    price: '€4,99',
  },
];

const guideListLD = itemListLD(
  'Audioguide del Gargano',
  guides.map((guide) => `https://localis.guide/guide/${guide.slug}`),
);
---
<Layout
  title="Gargano — Audioguide narrative tra Vieste, Tremiti e Foresta Umbra · Localis"
  description="Sei audioguide narrative del Gargano tra Vieste, Tremiti, Foresta Umbra, borghi interni e saline. Senza app. Da €4,99."
  lang="it"
>
  <StructuredData data={guideListLD} />

  <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Gargano' }]} />

  {/* PAGE HEADER — hero con immagine */}
  <section class="gargano-hero relative overflow-hidden border-b border-border">
    <img
      src="/images/covers/gargano-landing.jpg"
      alt="Gargano, promontorio sul mare Adriatico"
      class="gargano-hero-bg"
      width="1980"
      height="900"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <div class="gargano-hero-scrim" aria-hidden="true"></div>
    <div class="max-w-wrap mx-auto px-md py-3xl lg:py-4xl relative z-10">
      <LangPills lang="it" currentPath={Astro.url.pathname} />
      <div class="flex items-center gap-sm mb-md">
        <span class="block w-7 h-px bg-accent"></span>
        <span class="text-[11px] font-semibold tracking-[0.24em] uppercase text-accent">
          Destinazione — Gargano
        </span>
      </div>
      <h1 class="font-display font-light text-ink leading-[1.05] tracking-[-0.014em] text-[clamp(2.2rem,5vw,3.6rem)] max-w-[22ch]">
        Il Gargano, dal mare alla foresta.
      </h1>
      <p class="font-body text-base sm:text-lg leading-relaxed text-ink-muted mt-md max-w-[52ch]">
        Sei racconti audio tra mare, foresta, paesi interni e isole. Nessuna app.
      </p>
      <HeroAudioSample lang="it" src="/audio/trailers/gargano/gargano-trailer-it.mp3" guideSlug="gargano-vieste" />
      <a href="#prezzi" class="mt-md inline-flex items-center gap-xs text-sm font-semibold text-link hover:text-link-pressed no-underline">Guide e prezzi <span aria-hidden="true">↓</span></a>
    </div>
  </section>

  <style>
    .gargano-hero {
      min-height: clamp(560px, 78vh, 820px);
      display: flex;
      align-items: center;
    }
    .gargano-hero-bg {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center center;
      filter: saturate(0.92) contrast(1.04);
    }
    .gargano-hero .text-ink,
    .gargano-hero h1 {
      color: oklch(12% 0.005 240) !important;
    }
    .gargano-hero .text-ink-muted,
    .gargano-hero p {
      color: oklch(22% 0.008 240 / 0.9) !important;
    }
    .gargano-hero-scrim {
      position: absolute;
      inset: 0;
      background: linear-gradient(
        to right,
        oklch(from var(--color-surface) l c h / 0.96) 0%,
        oklch(from var(--color-surface) l c h / 0.85) 35%,
        oklch(from var(--color-surface) l c h / 0.45) 62%,
        oklch(from var(--color-surface) l c h / 0) 85%
      );
      pointer-events: none;
    }
    @media (max-width: 768px) {
      .gargano-hero-scrim {
        background: linear-gradient(
          to bottom,
          oklch(from var(--color-surface) l c h / 0.78) 0%,
          oklch(from var(--color-surface) l c h / 0.58) 60%,
          oklch(from var(--color-surface) l c h / 0.35) 100%
        );
      }
    }
  </style>

  {/* INTERLUDE */}
  <section class="bg-surface-elev border-b border-border">
    <div class="max-w-wrap mx-auto px-md py-xl flex items-center gap-lg">
      <span class="block h-px flex-1 bg-border"></span>
      <p class="font-body text-sm text-ink-muted tracking-[0.18em] uppercase shrink-0">Sei racconti · sei luoghi · un promontorio</p>
      <span class="block h-px flex-1 bg-border"></span>
    </div>
  </section>

  {/* GUIDE GRID */}
  <section class="bg-surface">
    <div class="max-w-wrap mx-auto px-md py-3xl lg:py-4xl">
      <ol class="guide-grid list-none p-0 m-0">
        {guides.map((g, i) => (
          <li class="guide-cell" style={`--idx:${i}`}>
            <a href={`/guide/${g.slug}`} class="guide-card" aria-label={`${g.title}`}>
              <figure class="guide-photo m-0">
                <img src={g.cover} alt={g.alt} class="guide-img" loading="lazy" decoding="async" />
                <span class="guide-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                {g.price && <span class="guide-price" aria-hidden="true">{g.price}</span>}
                <span class="guide-scrim" aria-hidden="true">
                  <span class="guide-narrator">{g.narrator}</span>
                </span>
              </figure>
              <div class="guide-meta">
                <h3 class="guide-title font-display font-light text-ink leading-[1.2] m-0">{g.title}</h3>
                <p class="guide-places font-body text-xs text-accent tracking-[0.12em] uppercase m-0 mb-xs">{g.places}</p>
                <p class="guide-sub font-body text-sm text-ink-muted m-0">{g.subtitle}</p>
              </div>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* NARRATORI */}
  <section id="prezzi" class="bg-surface-elev border-t border-border">
    <div class="max-w-wrap mx-auto px-md py-3xl lg:py-4xl">
      <SectionDivider label="Scegli come ascoltare il Gargano." />
      <div class="grid grid-cols-1 md:grid-cols-3 gap-lg max-w-[68rem] mx-auto">
        <PriceCard
          product="single"
          guideSlug="gargano-vieste"
          lang="it"
          features={[
            'Una guida a tua scelta',
            'Accesso illimitato, per sempre',
            'Italiano e inglese',
            'Soddisfatti o rimborsati',
          ]}
        />
        <PriceCard
          product="tris"
          lang="it"
          features={[
            '3 guide a scelta tra tutte le zone',
            'Accesso illimitato, per sempre',
            'Soddisfatti o rimborsati',
          ]}
        />
        <PriceCard
          product="gargano-completa"
          lang="it"
          primary
          titleOverride="Pack 6 Guide (Intera Zona)"
          descriptionOverride="Tutte le 6 guide del Gargano. Sei racconti, sei luoghi."
          ctaOverride="Acquista Pack 6 Guide"
          features={[
            'Tutte le 6 guide del Gargano',
            '~5h di racconto · voci diverse',
            'Soddisfatti o rimborsati',
          ]}
        />
      </div>
    </div>
  </section>

  <style>
    .narr-grid {
      display: grid;
      grid-template-columns: repeat(1, 1fr);
      gap: var(--spacing-2xl);
    }
    @media (min-width: 640px) { .narr-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (min-width: 1024px) { .narr-grid { grid-template-columns: repeat(3, 1fr); } }

    .narr-card {
      display: flex;
      flex-direction: column;
      gap: var(--spacing-md);
      text-decoration: none;
      color: inherit;
      border-top: 1px solid var(--color-border);
      padding-top: var(--spacing-md);
      transition: opacity 0.2s;
    }
    .narr-card:hover { opacity: 0.82; }
    .narr-card:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 4px; border-radius: 2px; }

    .narr-photo {
      width: 100%;
      aspect-ratio: 3 / 4;
      overflow: hidden;
      border-radius: var(--radius-md);
      background: var(--color-surface-elev);
      box-shadow: 0 1px 2px oklch(15% 0.012 240 / 0.06), 0 8px 24px -8px oklch(15% 0.012 240 / 0.14);
    }
    .narr-photo img {
      width: 100%; height: 100%; object-fit: cover; display: block;
      filter: grayscale(100%) contrast(1.05) brightness(0.97);
    }
    .narr-photo-note { margin-top: calc(var(--spacing-md) * -0.55); line-height: 1.35; }
    .narr-text { display: flex; flex-direction: column; gap: var(--spacing-xs); }
    .narr-name { font-size: clamp(1.3rem, 2.8vw, 1.6rem); line-height: 1.1; }
    .narr-bio { line-height: 1.55; }

    @media (prefers-reduced-motion: reduce) {
      .narr-card { transition: none; }
    }
  </style>

  {/* PRICING */}
  <section class="bg-surface border-t border-border">
    <div class="max-w-wrap mx-auto px-md py-3xl lg:py-4xl">
      <div class="flex items-center justify-center gap-sm mb-2xl">
        <span class="block w-7 h-px bg-accent"></span>
        <span class="text-[10px] font-semibold tracking-[0.32em] uppercase text-accent">Le prospettive del Gargano</span>
        <span class="block w-7 h-px bg-accent"></span>
      </div>
      <p class="font-body text-sm text-ink-muted text-center max-w-[52ch] mx-auto mb-2xl">Ritratti narrativi costruiti su ricerca, fonti e memoria dei luoghi.</p>
      <ul class="narr-grid list-none p-0 m-0">
        {[
          { name: 'Rossella', photo: '/images/authors/rossella-vieste-jun26.jpg', role: 'Voce narrativa della costa di Vieste', bio: 'Cinquantaquattro anni. La famiglia gestisce lo stesso lido dai tempi di suo nonno. Ha visto questa costa cambiare più in sessant\'anni che nei seicento precedenti.', guide: 'Vieste', href: '/guide/gargano-vieste' },
          { name: 'Ferdinando', photo: '/images/authors/ferdinando-nord-jun26.jpg', role: 'Voce narrativa dei trabucchi', bio: 'Sessantotto anni, di Peschici. Sul trabucco di famiglia da quando aveva undici anni. Il mare del Gargano lo conosce a memoria, ogni corrente, ogni ora del giorno.', guide: 'Costa Nord', href: '/guide/gargano-nord' },
          { name: "Fra' Salvatore", photo: '/images/authors/fra-salvatore-sacro-jun26.jpg', role: 'Trent\'anni al Santuario di Monte Sant\'Angelo', bio: "Settantatré anni. Frate francescano dal 1978. Ha accompagnato pellegrini dalla Foresta Umbra fino alla grotta dell'Arcangelo — a piedi, come si faceva nel Medioevo.", guide: 'Il Gargano Sacro', href: '/guide/gargano-sacro' },
          { name: 'Tonino', photo: '/images/authors/tonino-tremiti-jun26.jpg', role: 'Barcaiolo di San Domino', bio: "Settantaquattro anni. Nato alle Tremiti, non le ha mai lasciate. Conosce ogni cala, ogni secca, ogni corrente dell'arcipelago.", guide: 'Isole Tremiti', href: '/guide/gargano-tremiti' },
          { name: 'Stefano', photo: '/images/authors/stefano-paesi-jun26.jpg', role: 'Guardiaparco da trent\'anni', bio: "Cinquantotto anni, di Vico del Gargano. Trent'anni nel Parco Nazionale del Gargano. Conosce i borghi dell'entroterra come pochi — le strade, le storie, i nomi dei casali abbandonati.", guide: 'I Borghi', href: '/guide/gargano-paesi' },
          { name: 'Antonello', photo: '/images/authors/antonello-saline-jun26.jpg', role: 'Trent\'anni al controllo qualità del sale', bio: "Cinquantaquattro anni, di Manfredonia. Trent'anni alle saline di Margherita di Savoia. Ha visto le vasche in tutte le ore possibili — dall'alba rosa di luglio alla nebbia di dicembre.", guide: 'Saline', href: '/guide/gargano-saline' },
        ].map((n) => (
          <li class="narr-cell">
            <a href={n.href} class="narr-card" aria-label={`Guida ${n.guide} — voce di ${n.name}`}>
              <figure class="narr-photo m-0">
                <img
                  src={n.photo}
                  alt={`Ritratto narrativo di ${n.name}`}
                  title={`${n.name}: ritratto narrativo costruito su ricerca e fonti Localis.`}
                  loading="lazy"
                  decoding="async"
                />
              </figure>
              <p class="narr-photo-note font-body text-[10px] font-semibold tracking-[0.18em] uppercase text-ink-subtle m-0">
                Ritratto narrativo. Costruito su ricerca e fonti Localis.
              </p>
              <div class="narr-text">
                <p class="narr-guide font-body text-[10px] font-semibold tracking-[0.22em] uppercase text-accent m-0">{n.guide}</p>
                <h3 class="narr-name font-display font-light text-ink m-0">{n.name}</h3>
                <p class="narr-role font-body text-xs text-ink-subtle m-0">{n.role}</p>
                <p class="narr-bio font-body text-sm text-ink-muted m-0 mt-xs">{n.bio}</p>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* 3 PASSI */}
  <StepsBlock lang="it" ctaHref="/guide/gargano-vieste" />

</Layout>

<style>
  .guide-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: var(--spacing-lg);
    row-gap: var(--spacing-2xl);
  }
  @media (min-width: 640px) { .guide-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .guide-grid { grid-template-columns: repeat(3, 1fr); } }

  .guide-cell {
    opacity: 0;
    transform: translateY(14px);
    animation: guideIn 0.7s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: calc(var(--idx, 0) * 80ms + 100ms);
  }
  .guide-card {
    display: flex; flex-direction: column; gap: var(--spacing-md); height: 100%;
    text-decoration: none; color: inherit;
    border-top: 1px solid var(--color-ink); padding-top: var(--spacing-md);
  }
  .guide-photo {
    position: relative; width: 100%; height: clamp(16rem, 24vw, 21rem);
    background: var(--color-surface-elev); overflow: hidden; border-radius: var(--radius-md);
    box-shadow: 0 1px 2px oklch(15% 0.012 240 / 0.08), 0 12px 32px -12px oklch(15% 0.012 240 / 0.16);
  }
  .guide-img { width: 100%; height: 100%; object-fit: cover; display: block; filter: saturate(0.94) contrast(1.04); }
  .guide-num { position: absolute; top: var(--spacing-sm); left: var(--spacing-sm); font-family: var(--font-display); font-style: italic; font-weight: 300; font-size: clamp(2.4rem, 4.4vw, 3.2rem); line-height: 0.85; color: var(--color-surface); letter-spacing: -0.04em; text-shadow: 0 1px 8px oklch(15% 0.012 240 / 0.55); pointer-events: none; user-select: none; }
  .guide-price { position: absolute; top: var(--spacing-sm); right: var(--spacing-sm); font-family: var(--font-body); font-size: 0.8125rem; font-weight: 700; color: var(--color-ink); background: var(--color-surface); border: 1px solid var(--color-accent); padding: 4px 10px 5px; line-height: 1.2; box-shadow: 0 1px 2px oklch(15% 0.012 240 / 0.18); pointer-events: none; user-select: none; z-index: 1; }
  .guide-scrim { position: absolute; left: 0; right: 0; bottom: 0; display: flex; align-items: center; padding: var(--spacing-sm) var(--spacing-md); background: linear-gradient(to top, oklch(15% 0.012 240 / 0.78), transparent 100%); color: var(--color-surface); font-family: var(--font-body); font-size: 10px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; pointer-events: none; }
  .guide-narrator { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .guide-meta { display: flex; flex-direction: column; gap: var(--spacing-xs); }
  .guide-title { font-size: clamp(1.1rem, 2.4vw, 1.35rem); }
  .guide-places { letter-spacing: 0.12em; }
  .guide-sub { line-height: 1.5; }
  .guide-card:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 4px; border-radius: 2px; }
  @keyframes guideIn { to { opacity: 1; transform: translateY(0); } }
  @media (prefers-reduced-motion: reduce) { .guide-cell, .guide-card, .guide-img { animation: none !important; transition: none !important; opacity: 1; transform: none; } }
</style>
