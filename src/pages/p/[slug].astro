---
// SSR e non prerender: le scansioni QR vanno contate lato server, e il
// middleware non gira sulle pagine statiche servite dalla CDN. A questi
// volumi il costo di rendere a ogni richiesta e' nullo.
export const prerender = false;
import Layout from '../../components/Layout.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import GuideCard from '../../components/GuideCard.astro';
import HeroAudioSample from '../../components/HeroAudioSample.astro';
import PriceCard from '../../components/PriceCard.astro';
import SectionDivider from '../../components/SectionDivider.astro';
import FollowCta from '../../components/FollowCta.astro';
import { getCollection } from 'astro:content';
import { getActivePartner } from '../../lib/partners';


type AreaKey = 'bari' | 'valle' | 'gargano';

const AREA_CITY_MAP: Record<AreaKey, Set<string>> = {
  bari: new Set(['bari']),
  // Polignano sta in Valle d'Itria per scelta commerciale (2026-06-13):
  // a un ospite di Polignano si propongono trulli e borghi, non San Nicola.
  valle: new Set(['polignano', 'alberobello', 'locorotondo', 'martina-franca', 'cisternino', 'ostuni', 'fasano', 'noci']),
  gargano: new Set(['gargano', 'vieste', 'rodi-garganico', 'peschici', 'vico-del-gargano', 'manfredonia', 'isole-tremiti', 'carpino', 'cagnano-varano']),
};

function resolveArea(city: string): AreaKey {
  for (const [area, cities] of Object.entries(AREA_CITY_MAP) as [AreaKey, Set<string>][]) {
    if (cities.has(city)) return area;
  }
  return 'bari';
}

const partner = await getActivePartner(Astro.params.slug ?? '');
if (!partner) return Astro.rewrite('/404');
const area = resolveArea(partner.data.city);

// Chi scansiona il QR non ha mai sentito Localis: senza un assaggio qui,
// gli si chiede di pagare 4,99 EUR al buio. Trailer della zona in cui si
// trova, non della zona che vende di piu'.
const AREA_TRAILER: Record<AreaKey, { src: string; slug: string }> = {
  bari: { src: '/audio/trailers/bari/bari-vecchia-trailer-it.mp3', slug: 'bari-vecchia' },
  valle: { src: '/audio/trailers/valle-d-itria/alberobello-trailer-it.mp3', slug: 'alberobello' },
  gargano: { src: '/audio/trailers/gargano/gargano-trailer-it.mp3', slug: 'gargano-vieste' },
};
const trailer = AREA_TRAILER[area];

const guides = (await getCollection('guides'))
  .filter((g) => AREA_CITY_MAP[area].has(g.data.city) && g.data.status === 'live')
  .sort((a, b) => a.data.published_at.getTime() - b.data.published_at.getTime());

const primaryGuideSlug = guides[0]?.data.slug ?? 'bari-vecchia';
const bundleProduct =
  area === 'gargano' ? 'gargano-completa'
  : area === 'valle' ? 'valle-completa'
  : 'bari-completa';

const bundleFeatures =
  area === 'gargano'
    ? [
        'Tutte le 6 guide del Gargano',
        '~3h 20min di racconto · 6 paesaggi diversi',
        'Risparmi EUR 9,95 vs guide singole',
        'Accesso illimitato · Senza app',
      ]
    : area === 'valle'
      ? [
          "Tutte le 6 guide della Valle d'Itria",
          '~3h 20min di racconto · 6 luoghi diversi',
          'Risparmi EUR 9,95 vs guide singole',
          'Accesso illimitato · Senza app',
        ]
      : [
          'Tutte le 6 guide di Bari',
          '~2h 20min di racconto · 6 voci diverse',
          'Risparmi EUR 9,95 vs guide singole',
          'Accesso illimitato · Senza app',
        ];

const welcomeIt =
  partner.data.custom_landing_copy_it ||
  `Benvenuto. Dalla tua stanza al ${partner.data.display_name}, ascolta la Puglia come la racconterebbe chi ci vive — così esci sapendo dove sei.`;
---
<Layout
  title={`Localis · benvenuto da ${partner.data.display_name}`}
  description={`Audioguide narrative della Puglia. Goditi un'esperienza speciale grazie al ${partner.data.display_name}.`}
  lang="it"
>
  <section class="bg-surface-elev border-b border-border">
    <div class="max-w-wrap mx-auto px-md py-md sm:py-2xl text-center">
      <Eyebrow class="justify-center mb-sm sm:mb-md">In collaborazione con {partner.data.display_name}</Eyebrow>
      <h1 class="font-display text-3xl sm:text-4xl text-ink leading-tight mb-sm sm:mb-md max-w-prose mx-auto">
        Ascolta la Puglia come una storia. <em class="text-accent">Per capire dove sei.</em>
      </h1>
      <p class="text-base sm:text-lg text-ink-muted max-w-prose mx-auto">{welcomeIt}</p>

      <div class="mt-md sm:mt-lg flex flex-col items-center">
        <HeroAudioSample lang="it" src={trailer.src} guideSlug={trailer.slug} context="partner" />
        <p class="font-body text-xs text-ink-subtle mt-sm">Anteprima gratuita · nessuna app · offline dopo l&rsquo;acquisto</p>
      </div>
    </div>
  </section>

  <section class="max-w-wrap mx-auto px-md py-2xl">
    <SectionDivider label="Le guide disponibili" />
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-md">
      {guides.map((g, i) => (
        <GuideCard guide={g} lang="it" index={i} />
      ))}
    </div>
  </section>

  <section class="max-w-wrap mx-auto px-md py-2xl">
    <SectionDivider label="Scegli il tuo piano" />
    <div class="grid grid-cols-1 md:grid-cols-2 gap-md max-w-[44rem] mx-auto">
      <PriceCard
        product="single"
        guideSlug={primaryGuideSlug}
        lang="it"
        features={[
          '1 guida a scelta',
          'Accesso illimitato',
          'Senza app, si apre con un link',
          'Italiano e inglese',
        ]}
      />
      <PriceCard
        product={bundleProduct}
        lang="it"
        primary
        features={bundleFeatures}
      />
    </div>
  </section>

  <FollowCta lang="it" class="max-w-wrap mx-auto px-md mt-md mb-2xl" />
</Layout>
