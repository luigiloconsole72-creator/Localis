---
export const prerender = true;
import DestinationsBlock from '../../components/DestinationsBlock.astro';
import FeatureBlock from '../../components/FeatureBlock.astro';
import Hero from '../../components/Hero.astro';
import Layout from '../../components/Layout.astro';
import StatsBlock from '../../components/StatsBlock.astro';
import StepsBlock from '../../components/StepsBlock.astro';
---
<Layout
  title="Localis | Narrative Audioguides für Bari und Apulien"
  description="Dokumentierte Audioerzählungen über Bari, das Itria-Tal und den Gargano. Höre 1 Minute kostenlos und speichere deine Guide offline für den Besuch."
  lang="de"
>
  <Hero lang="de" currentPath={Astro.url.pathname} />

  <section class="bg-surface border-b border-border">
    <div class="max-w-wrap mx-auto px-md py-lg grid grid-cols-1 md:grid-cols-[1.2fr_1fr] gap-lg items-start">
      <div>
        <p class="text-xs font-semibold tracking-[0.24em] uppercase text-accent mb-xs">
          Audioerzählungen über Orte
        </p>
        <p class="font-display text-2xl text-ink leading-tight m-0">
          Sie sagen dir nicht, wohin du gehen sollst. Sie helfen dir zu verstehen, wo du bist.
        </p>
      </div>
      <p class="text-base text-ink-muted leading-relaxed m-0">
        Localis ist eine Audio-Erzählung über den Ort: Geschichte, Kontext und ein erklärter Blickwinkel, damit du verstehst, wie dieser Ort zu dem wurde, was er heute ist. Keine App: Du bekommst einen Link, drückst Play und hörst, wann du willst — vor Ort, von zu Hause vor der Reise oder danach.
      </p>
    </div>
  </section>

  <StatsBlock lang="de" />


  <section class="manifesto-section bg-surface-elev border-y border-border">
    <div class="max-w-narrow mx-auto px-md py-xl lg:py-2xl">

      <blockquote class="manifesto-quote font-display italic text-ink leading-[1.2] text-[clamp(1.3rem,3vw,1.9rem)] m-0 max-w-[32ch] mx-auto text-center">
        Orte verbraucht man nicht.<br />
        Man versteht sie.
      </blockquote>
    </div>
  </section>

  {/* PRIMA / DOPO — die Bedeutungsverschiebung, gezeigt statt erklärt */}
  <section class="bg-surface">
    <div class="max-w-narrow mx-auto px-md py-2xl lg:py-3xl">
      <p class="text-xs font-semibold tracking-[0.24em] uppercase text-accent text-center mb-md">Was sich wirklich ändert</p>
      <h2 class="font-display text-ink text-center leading-[1.15] text-[clamp(1.5rem,3.4vw,2.2rem)] mb-xl max-w-[28ch] mx-auto">
        Wir fügen keine Informationen hinzu.<br />
        <em class="not-italic text-accent">Wir verändern, was du siehst.</em>
      </h2>
      <ul class="flex flex-col gap-lg list-none p-0 m-0 max-w-[42rem] mx-auto">
        <li class="grid grid-cols-1 sm:grid-cols-[1fr_auto_1fr] items-center gap-xs sm:gap-md text-center sm:text-left">
          <span class="text-ink-subtle sm:text-right">Eine Frau, die Orecchiette macht.</span>
          <span class="text-accent select-none" aria-hidden="true">→</span>
          <span class="font-display text-ink text-lg leading-snug">Jemand, der eine über Generationen weitergegebene Geste fortführt.</span>
        </li>
        <li class="grid grid-cols-1 sm:grid-cols-[1fr_auto_1fr] items-center gap-xs sm:gap-md text-center sm:text-left">
          <span class="text-ink-subtle sm:text-right">Eine weiß gekalkte Mauer.</span>
          <span class="text-accent select-none" aria-hidden="true">→</span>
          <span class="font-display text-ink text-lg leading-snug">Jahrhundertelanger Schutz vor Sonne und Seuchen.</span>
        </li>
        <li class="grid grid-cols-1 sm:grid-cols-[1fr_auto_1fr] items-center gap-xs sm:gap-md text-center sm:text-left">
          <span class="text-ink-subtle sm:text-right">Ein Heiliger, in Prozession getragen.</span>
          <span class="text-accent select-none" aria-hidden="true">→</span>
          <span class="font-display text-ink text-lg leading-snug">Eine Stadt, die sich bis heute in ihm wiedererkennt.</span>
        </li>
      </ul>
    </div>
  </section>

  <DestinationsBlock lang="de" />

  <section class="bg-surface" id="preise">
    <div class="max-w-wrap mx-auto px-md py-2xl">
      <div class="flex flex-col items-center gap-sm text-center">
      <p class="font-display font-light text-[clamp(1.2rem,2.5vw,1.7rem)] text-ink mb-xs">
        Eine Erzählung, ein Pack oder ganz Apulien.
      </p>
      <div class="flex flex-col items-center gap-sm">
        <a
          href="/de/guide#builder"
          class="inline-flex items-center justify-center gap-xs px-xl py-md bg-accent text-surface rounded-md font-semibold text-base hover:bg-accent/90 transition-[background-color,transform] duration-fast hover:-translate-y-[1px] active:translate-y-0 no-underline min-h-[52px]"
        >
          Paket zusammenstellen
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
        <p class="text-sm text-ink-muted">Einzelner Guide 4,99 € · Pack 3 11,99 € · Pack 6 19,99 € · je ~30 Min.</p>
        <p class="text-xs text-ink-subtle text-center">Pack 6 funktioniert auch mit Guides aus verschiedenen Gebieten.</p>
      </div>
      </div>
    </div>
  </section>

  <FeatureBlock
    eyebrow="Nur wenige Stunden?"
    heading="Nur wenige Stunden in Bari?"
    italicEnding="Hör zwei ausgewählte Erzählungen und versteh die Stadt — ohne Zeit zu verlieren."
    body="Du kaufst mit E-Mail und Karte. Danach bekommst du einen dauerhaften Link: öffnen, Play drücken, hören. Auf der Straße beim Gehen, auf dem Sofa vor der Reise oder im Zug zurück. Das sind Erzählungen, keine Museums-Audios, die nur beschreiben, was vor dir steht — sie bringen dich nach Bari hinein, auch wenn du noch nicht dort bist."
    bullets={[
      'Freies Hören · vor Ort, vorher, danach, überall',
      'Magic Link per E-Mail · kein Passwort, kein Konto',
      'Dauerhafter Link · die Guide gehört dir, immer wieder hörbar',
    ]}
    imageSrc="/images/covers/nave-crociera.jpg"
    imageAlt="Kreuzfahrtgäste gehen in Bari vor der MSC Splendida von Bord; im Hintergrund Hafenpromenade und helles Sonnenlicht"
    caption="Bari, Kreuzfahrthafen. Auch mit wenigen Stunden an Land kann die Erzählung beginnen, bevor man die Stadt wirklich durchquert."
    ctaLabel="Route für Kreuzfahrtgäste entdecken"
    ctaHref="/de/kreuzfahrt"
    imageSide="right"
    tiltDeg={1.5}
    mobileAspect="3 / 2"
    framedImage
  />

  <FeatureBlock
    eyebrow="Woher die Geschichten kommen"
    heading="In Apulien geschrieben."
    italicEnding="Mit überprüfbaren Quellen."
    body="Jede Guide entsteht aus redaktioneller Recherche: historische Quellen, institutionelle Quellen und, wenn vorhanden, lokale Erinnerung, die vor Ort gesammelt wurde. Auf der Seite Quellen veröffentlichen wir die Referenzen, aus denen die Erzählungen gebaut sind."
    bullets={[
      'Von Menschen geschrieben, die hier leben · Recherche und lokale Erinnerung',
      "Veröffentlichte Guides · Bari, Valle d'Itria, Gargano",
      'Italienisch, Englisch und Deutsch · Texte sprachgenau ausgearbeitet',
      'Nachprüfbar · jede belegte Aussage auf /de/fonti, Kapitel für Kapitel',
    ]}
    imageSrc="/images/covers/fonti-ricerca.jpg"
    imageAlt="Recherche-Schreibtisch: Bücher zur Geschichte Baris, offenes Notizbuch, historische Postkarten, Karte und Zeitungsausschnitt über die Reliquien des heiligen Nikolaus"
    caption="Der Schreibtisch vor der Stimme. Bücher, Notizen, Postkarten, Ausschnitte — jedes Kapitel beginnt hier."
    ctaLabel="Unsere Methode"
    ctaHref="/de/methode"
    imageSide="left"
    tiltDeg={-1.5}
  />

  <StepsBlock lang="de" ctaHref="/de/guide/bari-vecchia" />
</Layout>

<style>
  .manifesto-quote {
    opacity: 0;
    transform: translateY(10px);
    animation: manifestoIn 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.1s forwards;
  }

  @keyframes manifestoIn {
    to { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .manifesto-quote {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>
