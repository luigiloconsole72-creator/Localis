---
export const prerender = true;
import Layout from '../../components/Layout.astro';
import BariMap from '../../components/BariMap.astro';
import PriceCard from '../../components/PriceCard.astro';
import SectionDivider from '../../components/SectionDivider.astro';
import AuthorsBlock from '../../components/AuthorsBlock.astro';
import StepsBlock from '../../components/StepsBlock.astro';
import LangPills from '../../components/LangPills.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import HeroAudioSample from '../../components/HeroAudioSample.astro';
import StructuredData from '../../components/StructuredData.astro';
import { itemListLD } from '../../lib/seo';

const guideListLD = itemListLD('Bari Audioguides', [
  'https://localis.guide/de/guide/bari-vecchia',
  'https://localis.guide/de/guide/san-nicola',
  'https://localis.guide/de/guide/porto-bari',
  'https://localis.guide/de/guide/bari-tavola',
  'https://localis.guide/de/guide/tre-teatri',
  'https://localis.guide/de/guide/bari-sotterranea',
]);
---
<Layout
  title="Bari Sehenswürdigkeiten: Altstadt, San Nicola & Hafen | Localis"
  description="Sechs Audioerzählungen, um Bari beim Spaziergang zu verstehen: Altstadt, San Nicola, Hafen, Essen, Theater und Untergrund. Hörprobe gratis."
  lang="de"
>
  <StructuredData data={guideListLD} />

  <Breadcrumb items={[{ label: 'Start', href: '/de' }, { label: 'Bari' }]} />

  {/* PAGE HEADER — hero with image */}
  <section class="bari-hero relative overflow-hidden border-b border-border">
    <img
      src="/images/hero/hero-bari-tramonto.jpg"
      alt="Bari, Blick auf die Altstadt und die Strandpromenade"
      class="bari-hero-bg"
      width="1980"
      height="900"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <div class="bari-hero-scrim" aria-hidden="true"></div>
    <div class="max-w-wrap mx-auto px-md py-3xl lg:py-4xl relative z-10">
      <LangPills lang="de" currentPath={Astro.url.pathname} />
      <div class="flex items-center gap-sm mb-md">
        <span class="block w-7 h-px bg-accent"></span>
        <span class="text-[11px] font-semibold tracking-[0.24em] uppercase text-accent">
          Reiseziel — Bari
        </span>
      </div>
      <h1 class="font-display font-light text-ink leading-[1.05] tracking-[-0.014em] text-[clamp(2.2rem,5vw,3.6rem)] max-w-[18ch]">
        Bari, so wie es dir ein Freund von hier erzählen würde.
      </h1>
      <p class="font-body text-base sm:text-lg leading-relaxed text-ink mt-md max-w-[52ch]">
        Jemand, der hier aufgewachsen ist, erzählt dir die Gassen, die Heiligen, das Warum der Dinge — genau dann, wenn du davorstehst. Sechs Erzählungen, keine App.
      </p>
      <HeroAudioSample lang="de" src="/audio/trailers/bari/san-nicola-trailer-de.mp3" guideSlug="san-nicola" />
      <a href="#preise" class="mt-md inline-flex items-center gap-xs text-sm font-semibold text-link hover:text-link-pressed no-underline">Guides und Preise <span aria-hidden="true">↓</span></a>
    </div>
  </section>

  <style>
    .bari-hero {
      min-height: clamp(560px, 78vh, 820px);
      display: flex;
      align-items: center;
    }
    .bari-hero-bg {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center center;
      filter: saturate(0.92) contrast(1.04);
    }
    .bari-hero-scrim {
      position: absolute;
      inset: 0;
      background: linear-gradient(
        to right,
        oklch(from var(--color-surface) l c h / 0.88) 0%,
        oklch(from var(--color-surface) l c h / 0.65) 35%,
        oklch(from var(--color-surface) l c h / 0.18) 70%,
        oklch(from var(--color-surface) l c h / 0) 100%
      );
      pointer-events: none;
    }
    @media (max-width: 768px) {
      .bari-hero-scrim {
        background: linear-gradient(
          to bottom,
          oklch(from var(--color-surface) l c h / 0.92) 0%,
          oklch(from var(--color-surface) l c h / 0.72) 60%,
          oklch(from var(--color-surface) l c h / 0.5) 100%
        );
      }
    }
  </style>

  {/* THE 6 GUIDES */}
  <BariMap lang="de" />

  {/* PRICING */}
  <section id="preise" class="bg-surface">
    <div class="max-w-wrap mx-auto px-md py-3xl lg:py-4xl">
      <SectionDivider label="Wähle, wie du Bari hören möchtest." />
      <div class="grid grid-cols-1 md:grid-cols-3 gap-lg max-w-[68rem] mx-auto">
        <PriceCard
          product="single"
          guideSlug="bari-vecchia"
          lang="de"
          features={[
            'Eine Audioerzählung nach Wahl',
            'Dauerhafter Zugriff',
            'Italienisch, Englisch und Deutsch',
            'Geld-zurück-Garantie, ohne Rückfragen',
          ]}
        />
        <PriceCard
          product="tris"
          lang="de"
          features={[
            '3 Audioerzählungen nach Wahl',
            'Dauerhafter Zugriff',
            'Geld-zurück-Garantie, ohne Rückfragen',
          ]}
        />
        <PriceCard
          product="bari-completa"
          lang="de"
          primary
          features={[
            'Alle 6 Audioerzählungen aus Bari',
            '~2h 20min · 6 verschiedene Stimmen',
            'Spart 9,95 € gegenüber Einzelkauf',
            'Geld-zurück-Garantie, ohne Rückfragen',
          ]}
        />
      </div>
    </div>
  </section>

  {/* AUTHORS */}
  <AuthorsBlock lang="de" />

  {/* 3 STEPS */}
  <StepsBlock lang="de" ctaHref="/de/guide/bari-vecchia" />

</Layout>
