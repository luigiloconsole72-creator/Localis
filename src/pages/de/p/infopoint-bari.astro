---
export const prerender = true;
import Layout from '../../../components/Layout.astro';
import HeroAudioSample from '../../../components/HeroAudioSample.astro';
import PriceCard from '../../../components/PriceCard.astro';
import BariMap from '../../../components/BariMap.astro';
---

<Layout
  title="6 Audioerzählungen über Bari | Localis — InfoPoint"
  description="Altstadt, San Nicola, Hafen, Essen, Theater und die unterirdische Stadt: sechs Audioerzählungen für deinen Spaziergang durch Bari. Keine App erforderlich. Ab 4,99 €."
  lang="de"
  robots="noindex,nofollow"
  langUrlsOverride={{ it: '/p/infopoint-bari/', en: '/en/p/infopoint-bari/', de: '/de/p/infopoint-bari/' }}
>

  {/* ── HERO ── */}
  <section class="infopoint-hero relative overflow-hidden bg-surface">
    <img
      src="/images/hero/hero-bari-tramonto.jpg"
      alt="Bari, Blick auf Altstadt und Lungomare"
      class="absolute inset-0 w-full h-full object-cover object-center saturate-90"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-surface/90 via-surface/65 to-surface/10 pointer-events-none" aria-hidden="true"></div>

    <div class="relative z-10 max-w-wrap mx-auto px-md py-3xl lg:py-4xl">
      <div class="flex items-center gap-sm mb-md">
        <span class="block w-7 h-px bg-accent"></span>
        <span class="text-[11px] font-semibold tracking-[0.24em] uppercase text-accent">
          6 AUDIOERZÄHLUNGEN ÜBER BARI
        </span>
      </div>

      <h1 class="font-display font-light text-ink leading-[1.05] tracking-[-0.014em] text-[clamp(2.2rem,5vw,3.6rem)] max-w-[22ch]">
        Erlebe Bari wie ein Einheimischer,<br />
        <em class="font-light not-italic text-accent">nicht wie ein Tourist.</em>
      </h1>

      <p class="font-body text-base sm:text-lg leading-relaxed text-ink-muted mt-md max-w-[52ch]">
        Dieselben Gassen wie alle — aber mit den Geschichten, die nur die Baresi kennen. Sechs Audioerzählungen zum Hören beim Spazieren. Keine App erforderlich.
      </p>

      <div class="mt-lg">
        <HeroAudioSample
          lang="de"
          src="/audio/trailers/bari/bari-vecchia-trailer-de.mp3"
          guideSlug="bari-vecchia"
        />
        <p class="font-body text-xs text-ink-subtle mt-sm max-w-[46ch]">
          Sprachen bei jeder Erzählung angegeben · Direkt streamen oder nach dem Kauf offline speichern
        </p>
      </div>

      <div class="hero-actions mt-lg">
        <a href="#pack" class="hero-action hero-action-primary">
          Bari-Pack kaufen
        </a>
        <a href="#guide" class="hero-action hero-action-secondary">
          Die 6 Erzählungen ansehen
        </a>
      </div>
    </div>
  </section>

  {/* ── 6 GUIDE CARD ── */}
  <BariMap lang="de" />

  {/* ── PACK ── */}
  <section id="pack" class="bg-surface-elev border-t border-border py-3xl scroll-mt-20" aria-label="Bari-Erzählungen kaufen">
    <div class="max-w-wrap mx-auto px-md">
      <h2 class="font-display font-light text-ink text-[clamp(1.6rem,3.5vw,2.4rem)] leading-tight tracking-[-0.01em] mb-xl text-center">
        Wähle, wie viele Erzählungen du möchtest
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-lg max-w-[52rem] mx-auto">
        <PriceCard
          product="tris"
          lang="de"
          features={[
            '3 Guides nach Wahl aus allen Destinationen',
            'Spart 2,98 EUR gegenüber Einzelkauf',
            'Dauerhafter Zugriff',
          ]}
        />
        <PriceCard
          product="bari-completa"
          lang="de"
          primary={true}
          features={[
            'Alle 6 Bari-Erzählungen',
            'Altstadt, San Nicola, Hafen, Essen, Theater, Untergrund',
            'Dauerhafter Zugriff',
            'Italienisch und Englisch (Deutsch auf Bari Altstadt)',
          ]}
        />
      </div>
    </div>
  </section>

  {/* ── TRUST ── */}
  <section class="bg-surface border-t border-border py-2xl">
    <div class="max-w-narrow mx-auto px-md flex flex-col sm:flex-row gap-xl items-start sm:items-center justify-between">
      <p class="font-body text-sm text-ink-muted leading-relaxed max-w-[42ch]">
        Erzählungen auf der Grundlage von Recherchen und Quellen von Localis.<br />
        Reale Autoren und narrative Porträts sind in jeder Erzählung angegeben.
      </p>
      <div class="flex gap-md flex-shrink-0">
        <a href="/de/methode/" class="font-body text-sm font-semibold text-ink underline underline-offset-4 hover:text-accent transition-colors">
          Unsere Methode
        </a>
        <a href="/de/fonti/" class="font-body text-sm font-semibold text-ink underline underline-offset-4 hover:text-accent transition-colors">
          Quellen
        </a>
      </div>
    </div>
  </section>

  {/* ── TRACKING ── */}
  <script is:inline>
    (function () {
      try {
        var lang = 'de';
        var path = window.location.pathname;
        var utm = {};
        try {
          var params = new URLSearchParams(window.location.search);
          utm = window.localisUtm || JSON.parse(sessionStorage.getItem('localis_utm') || '{}');
          if (params.get('utm_source') || params.get('utm_medium')) {
            utm = {
              utm_source: params.get('utm_source') || undefined,
              utm_medium: params.get('utm_medium') || undefined,
              utm_campaign: params.get('utm_campaign') || undefined,
              utm_content: params.get('utm_content') || undefined,
            };
          }
        } catch (e) {}

        function track(name, params) {
          if (typeof window.localisTrack === 'function') {
            window.localisTrack(name, params);
          } else {
            try { window.plausible && window.plausible(name, { props: params }); } catch (e) {}
          }
        }

        track('landing_view', { page: path, language: lang, source: utm.utm_source || '(direct)', campaign: utm.utm_campaign || '' });
        if (utm.utm_medium === 'qr') {
          track('qr_landing_view', { partner_id: utm.utm_source || '(direct)', placement: utm.utm_content || '', campaign: utm.utm_campaign || '', language: lang });
        }
      } catch (e) {}
    })();
  </script>

</Layout>

<style>
  .infopoint-hero {
    min-height: clamp(480px, 72vh, 760px);
    display: flex;
    align-items: center;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-sm);
  }

  .hero-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.72rem 1rem;
    border-radius: 4px;
    font-family: var(--font-body);
    font-size: 0.92rem;
    font-weight: 700;
    text-decoration: none;
    transition: background-color var(--duration-fast), color var(--duration-fast), border-color var(--duration-fast);
  }

  .hero-action-primary {
    background: var(--color-ink);
    color: var(--color-surface);
    border: 1px solid var(--color-ink);
  }

  .hero-action-primary:hover {
    background: color-mix(in oklab, var(--color-ink) 90%, white 10%);
  }

  .hero-action-secondary {
    background: oklch(from var(--color-surface) l c h / 0.82);
    color: var(--color-ink);
    border: 1px solid var(--color-border);
  }

  .hero-action-secondary:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  @media (max-width: 640px) {
    .hero-actions {
      flex-direction: column;
    }

    .hero-action {
      width: 100%;
    }
  }
</style>
