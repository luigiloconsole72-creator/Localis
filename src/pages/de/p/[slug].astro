---
// SSR e non prerender: le scansioni QR vanno contate lato server, e il
// middleware non gira sulle pagine statiche servite dalla CDN. A questi
// volumi il costo di rendere a ogni richiesta e' nullo.
export const prerender = false;
import Layout from '../../../components/Layout.astro';
import Eyebrow from '../../../components/Eyebrow.astro';
import GuideCard from '../../../components/GuideCard.astro';
import HeroAudioSample from '../../../components/HeroAudioSample.astro';
import PriceCard from '../../../components/PriceCard.astro';
import SectionDivider from '../../../components/SectionDivider.astro';
import FollowCta from '../../../components/FollowCta.astro';
import { getCollection } from 'astro:content';
import { getActivePartner } from '../../../lib/partners';


type AreaKey = 'bari' | 'valle' | 'gargano';

const AREA_CITY_MAP: Record<AreaKey, Set<string>> = {
  bari: new Set(['bari']),
  valle: new Set(['polignano', 'alberobello', 'locorotondo', 'martina-franca', 'cisternino', 'ostuni', 'fasano', 'noci']),
  gargano: new Set(['gargano', 'vieste', 'rodi-garganico', 'peschici', 'vico-del-gargano', 'manfredonia', 'isole-tremiti', 'carpino', 'cagnano-varano']),
};

function resolveArea(city: string): AreaKey {
  for (const [area, cities] of Object.entries(AREA_CITY_MAP) as [AreaKey, Set<string>][]) {
    if (cities.has(city)) return area;
  }
  return 'bari';
}

const partner = await getActivePartner(Astro.params.slug ?? '');
if (!partner) return Astro.rewrite('/404');
const slug = partner.data.slug;
const area = resolveArea(partner.data.city);

// Chi scansiona il QR non ha mai sentito Localis: senza un assaggio qui,
// gli si chiede di pagare 4,99 EUR al buio. Trailer della zona in cui si
// trova, non della zona che vende di piu'.
const AREA_TRAILER: Record<AreaKey, { src: string; slug: string }> = {
  bari: { src: '/audio/trailers/bari/bari-vecchia-trailer-de.mp3', slug: 'bari-vecchia' },
  valle: { src: '/audio/trailers/valle-d-itria/alberobello-trailer-de.mp3', slug: 'alberobello' },
  gargano: { src: '/audio/trailers/gargano/gargano-trailer-de.mp3', slug: 'gargano-vieste' },
};
const trailer = AREA_TRAILER[area];

const guides = (await getCollection('guides'))
  .filter((g) => AREA_CITY_MAP[area].has(g.data.city) && g.data.status === 'live')
  .sort((a, b) => a.data.published_at.getTime() - b.data.published_at.getTime());

const primaryGuideSlug = guides[0]?.data.slug ?? 'bari-vecchia';
const bundleProduct =
  area === 'gargano' ? 'gargano-completa'
  : area === 'valle' ? 'valle-completa'
  : 'bari-completa';

const bundleFeatures =
  area === 'gargano'
    ? [
        'Alle 6 Gargano-Geschichten',
        '~3h 20min Erzählung · 6 verschiedene Landschaften',
        'Spare EUR 9,95 ggü. Einzelführern',
        'Unbegrenzter Zugang · Keine App',
      ]
    : area === 'valle'
      ? [
          "Alle 6 Geschichten des Valle d'Itria",
          '~3h 20min Erzählung · 6 verschiedene Orte',
          'Spare EUR 9,95 ggü. Einzelführern',
          'Unbegrenzter Zugang · Keine App',
        ]
      : [
          'Alle 6 Bari-Geschichten',
          '~2h 20min Erzählung · 6 verschiedene Stimmen',
          'Spare EUR 9,95 ggü. Einzelführern',
          'Unbegrenzter Zugang · Keine App',
        ];

// La scheda partner non ha un campo copy DE: si usa un benvenuto generato.
const welcomeDe =
  `Willkommen. Von deinem Zimmer im ${partner.data.display_name} aus, erlebe Apulien so, wie es jemand erzählen würde, der hier lebt — damit du weißt, wo du bist.`;
---
<Layout
  title={`Localis · willkommen bei ${partner.data.display_name}`}
  description={`Narrative Audioguides für Apulien. Genießen Sie ein besonderes Erlebnis dank ${partner.data.display_name}.`}
  lang="de"
  langUrlsOverride={{ it: `/p/${slug}/`, en: `/en/p/${slug}/`, de: `/de/p/${slug}/` }}
>
  <section class="bg-surface-elev border-b border-border">
    <div class="max-w-wrap mx-auto px-md py-md sm:py-2xl text-center">
      <Eyebrow class="justify-center mb-sm sm:mb-md">In Zusammenarbeit mit {partner.data.display_name}</Eyebrow>
      <h1 class="font-display text-3xl sm:text-4xl text-ink leading-tight mb-sm sm:mb-md max-w-prose mx-auto">
        Erlebe Apulien als Geschichte. <em class="text-accent">Um zu verstehen, wo du bist.</em>
      </h1>
      <p class="text-base sm:text-lg text-ink-muted max-w-prose mx-auto">{welcomeDe}</p>

      <div class="mt-md sm:mt-lg flex flex-col items-center">
        <HeroAudioSample lang="de" src={trailer.src} guideSlug={trailer.slug} context="partner" />
        <p class="font-body text-xs text-ink-subtle mt-sm">Kostenlose H&ouml;rprobe · keine App · offline nach dem Kauf</p>
      </div>
    </div>
  </section>

  <section class="max-w-wrap mx-auto px-md py-2xl">
    <SectionDivider label="Verfügbare Geschichten" />
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-md">
      {guides.map((g, i) => (
        <GuideCard guide={g} lang="de" index={i} />
      ))}
    </div>
  </section>

  <section class="max-w-wrap mx-auto px-md py-2xl">
    <SectionDivider label="Wähle deinen Plan" />
    <div class="grid grid-cols-1 md:grid-cols-2 gap-md max-w-[44rem] mx-auto">
      <PriceCard
        product="single"
        guideSlug={primaryGuideSlug}
        lang="de"
        features={[
          '1 Geschichte nach Wahl',
          'Unbegrenzter Zugang',
          'Keine App — öffnet mit einem Link',
          'Italienisch und Englisch',
        ]}
      />
      <PriceCard
        product={bundleProduct}
        lang="de"
        primary
        features={bundleFeatures}
      />
    </div>
  </section>

  <FollowCta lang="de" class="max-w-wrap mx-auto px-md mt-md mb-2xl" />
</Layout>
