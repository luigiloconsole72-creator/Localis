---
export const prerender = true;
import Layout from '../../../components/Layout.astro';
import Eyebrow from '../../../components/Eyebrow.astro';
import GuidePurchaseCards from '../../../components/GuidePurchaseCards.astro';
import ChapterList from '../../../components/ChapterList.astro';
import StartMap from '../../../components/StartMap.astro';
import NarratorCard from '../../../components/NarratorCard.astro';
import StructuredData from '../../../components/StructuredData.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import HeroAudioSample from '../../../components/HeroAudioSample.astro';
import GuideUseCase from '../../../components/GuideUseCase.astro';
import GuideFactsCard from '../../../components/GuideFactsCard.astro';
import GuideSeoEditorial from '../../../components/GuideSeoEditorial.astro';
import { getCollection } from 'astro:content';
import { formatDuration } from '../../../lib/format';
import { audioObjectLD, breadcrumbListLD, productLD, touristAttractionLD } from '../../../lib/seo';
import { guideAccessibility, guideDescription, guideDurationSeconds, guideNeeds, guideRouteMode, guideStopsCount, guideSubtitle, guideTitle, narratorBio } from '../../../lib/guide-localization';

const CITY_DEST: Record<string, { href: string; label: string }> = {
  bari: { href: '/de/bari', label: 'Bari' },
  polignano: { href: '/de/bari', label: 'Bari' },
  alberobello: { href: '/de/valle-d-itria', label: "Valle d'Itria" },
  locorotondo: { href: '/de/valle-d-itria', label: "Valle d'Itria" },
  'martina-franca': { href: '/de/valle-d-itria', label: "Valle d'Itria" },
  cisternino: { href: '/de/valle-d-itria', label: "Valle d'Itria" },
  ostuni: { href: '/de/valle-d-itria', label: "Valle d'Itria" },
  fasano: { href: '/de/valle-d-itria', label: "Valle d'Itria" },
  vieste: { href: '/de/gargano', label: 'Gargano' },
  gargano: { href: '/de/gargano', label: 'Gargano' },
  matera: { href: '/de/matera', label: 'Matera' },
};

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides
    .filter((g) => g.data.status === 'live')
    .map((guide) => ({
      params: { slug: guide.data.slug },
      props: { guide },
    }));
}

const { guide } = Astro.props;
const data = guide.data;
const previewSrc = data.preview_audio_base ? `${data.preview_audio_base}-de.mp3` : null;
const destination = CITY_DEST[data.city];
const lang = 'de';
const durationSeconds = guideDurationSeconds(data, lang);
const durationLabel = formatDuration(durationSeconds);
const title = guideTitle(data, lang);
const subtitle = guideSubtitle(data, lang);
const description = guideDescription(data, lang);
const stopsCount = guideStopsCount(data);
const routeMode = guideRouteMode(data, lang) ?? 'Flexible Stadt-Route zu Fuß';
const accessibility = guideAccessibility(data, lang) ?? 'Historisches Zentrum mit gemischtem Bodenbelag, für die meisten Besucher geeignet.';
const needs = guideNeeds(data, lang) ?? 'Kopfhörer und geladenes Smartphone.';

const zoneBundle =
  data.city === 'bari' || data.city === 'polignano'
    ? {
        product: 'bari-completa' as const,
        features: [
          'Alle 6 Audioerzählungen aus Bari',
          'Spare 9,95 € gegenüber Einzelguides',
          'Kostenlose Updates bei neuen Inhalten aus Bari',
        ],
      }
    : data.city === 'vieste' || data.city === 'gargano'
      ? {
          product: 'gargano-completa' as const,
          features: [
            'Alle 6 Audioerzählungen aus dem Gargano',
            'Spare 9,95 € gegenüber Einzelguides',
            'Kostenlose Updates bei neuen Inhalten aus dem Gargano',
          ],
        }
      : data.city === 'matera'
        ? null
        : {
            product: 'valle-completa' as const,
            features: [
              "Alle 6 Audioerzählungen aus dem Valle d'Itria",
              'Spare 9,95 € gegenüber Einzelguides',
              "Kostenlose Updates bei neuen Inhalten aus dem Valle d'Itria",
            ],
          };
const singleFeatures = [
  `${data.chapters.length} Kapitel`,
  `${durationLabel} Laufzeit`,
  'Audioerzählung zum freien Hören',
  'Italienisch, Englisch und Deutsch, wo verfügbar',
  'Dauerhafter Link, immer wieder nutzbar',
  'Offline nach dem ersten Abspielen',
];
const trisFeatures = [
  '3 Guides frei wählbar',
  'Spare 2,98 € gegenüber Einzelguides',
  'Unbegrenzter Zugang, dauerhaft',
];

const ld: object[] = [
  audioObjectLD({
    slug: data.slug,
    title,
    description,
    durationSeconds,
    language: lang,
    priceCents: data.price_cents,
    coords: data.coords_start,
    cityName: data.city,
  }),
];

if (data.coords_start) {
  ld.push(touristAttractionLD(title, data.coords_start, data.city.charAt(0).toUpperCase() + data.city.slice(1)));
}

ld.push(productLD({
  slug: data.slug,
  title,
  description,
  cover: data.cover,
  priceCents: data.price_cents,
  language: lang,
}));

ld.push(breadcrumbListLD([
  { name: 'Start', url: 'https://localis.guide/de/' },
  ...(destination ? [{ name: destination.label, url: `https://localis.guide${destination.href}` }] : []),
  { name: title, url: `https://localis.guide/de/guide/${data.slug}/` },
]));
---
<Layout title={`${title} - Localis`} description={description} lang="de" ogImage={`/og/og-${data.slug}.jpg`}>
  <StructuredData data={ld} />
  {destination
    ? <Breadcrumb items={[{ label: 'Start', href: '/de' }, { label: destination.label, href: destination.href }, { label: title }]} />
    : <Breadcrumb items={[{ label: 'Start', href: '/de' }, { label: title }]} />}

  <article class="max-w-wrap mx-auto px-md py-2xl grid grid-cols-1 lg:grid-cols-[1fr_360px] gap-2xl items-start">
    <header class="order-1 lg:order-none lg:col-span-2 mb-2xl">
      <Eyebrow class="mb-md">{`Apulien · ${durationLabel} · IT/EN/DE`}</Eyebrow>
      <h1 class="font-display text-4xl text-ink leading-tight mb-sm">{title}</h1>
      <p class="font-display italic text-2xl text-ink-muted">{subtitle}</p>
    </header>

    <div class="order-2 lg:order-none flex flex-col gap-lg">
      <img src={data.cover} alt="" class="w-full aspect-[4/3] object-cover rounded-lg" loading="eager" />

      {previewSrc && (
        <HeroAudioSample lang="de" src={previewSrc} guideSlug={data.slug} context="product" />
      )}

      <GuidePurchaseCards
        class="lg:hidden flex flex-col gap-md"
        guideSlug={data.slug}
        lang="de"
        singleFeatures={singleFeatures}
        trisFeatures={trisFeatures}
        zoneBundleProduct={zoneBundle?.product}
        zoneBundleFeatures={zoneBundle?.features}
      />

      <GuideUseCase guide={data} lang={lang} />
      <GuideFactsCard
        lang={lang}
        distanceKm={data.distance_km}
        stopsCount={stopsCount}
        routeMode={routeMode}
        accessibility={accessibility}
        needs={needs}
      />

      {data.narrator && (
        <NarratorCard
          name={data.narrator.name}
          photo={data.narrator.photo}
          bio={narratorBio(data, lang) ?? ''}
          lang={lang}
        />
      )}

      <section>
        <h2 class="font-display text-3xl text-ink mb-md">Kapitel</h2>
        <ChapterList chapters={data.chapters} lang={lang} />
      </section>

      <GuideSeoEditorial slug={data.slug} lang={lang} />

      {data.coords_start && (
        <StartMap lat={data.coords_start.lat} lng={data.coords_start.lng} lang={lang} />
      )}
    </div>

    <GuidePurchaseCards
      class="hidden lg:sticky lg:top-24 lg:flex flex-col gap-md"
      guideSlug={data.slug}
      lang="de"
      singleFeatures={singleFeatures}
      trisFeatures={trisFeatures}
      zoneBundleProduct={zoneBundle?.product}
      zoneBundleFeatures={zoneBundle?.features}
    />
  </article>
</Layout>
