---
export const prerender = true;
import Layout from '../../components/Layout.astro';
import AtlanteTesta from '../../components/AtlanteTesta.astro';
import '../../styles/atlante-pagine.css';
import { getCollection } from 'astro:content';

const sources = (await getCollection('sources')).sort((a, b) =>
  (a.data.guide_title_de ?? a.data.guide_title_en).localeCompare(b.data.guide_title_de ?? b.data.guide_title_en),
);

type SourceRef = {
  author?: string;
  title: string;
  publisher?: string;
  year?: number;
  url?: string;
};

type ChapterWithSources = {
  facts: Array<{ sources: SourceRef[] }>;
};

function formatDate(d: Date): string {
  return d.toLocaleDateString('de-DE', { day: 'numeric', month: 'long', year: 'numeric' });
}

function formatSource(s: SourceRef): string {
  const parts: string[] = [];
  if (s.author) parts.push(s.author);
  parts.push(s.title);
  const tail: string[] = [];
  if (s.publisher) tail.push(s.publisher);
  if (s.year) tail.push(String(s.year));
  if (tail.length) parts.push(tail.join(', '));
  return parts.join(' · ');
}

function sourceKey(s: SourceRef): string {
  return [s.author ?? '', s.title, s.publisher ?? '', s.year ?? '', s.url ?? ''].join('|');
}

function uniqueChapterSources(chapter: ChapterWithSources): SourceRef[] {
  const byKey = new Map<string, SourceRef>();

  for (const fact of chapter.facts) {
    for (const source of fact.sources) {
      byKey.set(sourceKey(source), source);
    }
  }

  return [...byKey.values()];
}
---
<Layout
  title="Quellen der Guides · Localis"
  description="Archiv- und Fachquellen hinter den Localis Guides, Kapitel für Kapitel."
  lang="de"
>
  <AtlanteTesta occhiello="Prüfe die Geschichten" titolo="Unsere Quellen." lede="Keine kalte Literaturliste: Hier siehst du den Rechercheweg hinter jeder Guide." img="/images/covers/fonti-ricerca.jpg" alt="Der Recherche-Schreibtisch: Bücher, Notizen, Postkarten und eine Karte" />

  <article class="ab-corpo">

    <section class="fo-intro">
      <p class="text-base text-ink-muted leading-relaxed max-w-prose">
        Jede Guide basiert auf prüfbaren Quellen, Vor-Ort-Kontrollen und lokaler Erinnerung. Nicht belegbare Details markieren wir als narrative Rekonstruktion.
      </p>
    </section>

    <nav class="fo-indice" aria-label="Inhalt">
      <p class="fo-indice-titolo">Inhalt</p>
      <ol>
        {sources.map((entry, i) => (
          <li><a href={`#fonte-${entry.data.slug}`}><span>{String(i + 1).padStart(2, '0')}</span> {(entry.data.guide_title_de ?? entry.data.guide_title_it)}</a></li>
        ))}
      </ol>
    </nav>

    {sources.map((entry, i) => (
      <section class="fo-guida" id={`fonte-${entry.data.slug}`}>
        <header class="fo-guida-testa">
          <span class="fo-num">{String(i + 1).padStart(2, '0')}</span>
          <h2 class="font-display text-3xl text-ink leading-tight mb-xs">{entry.data.guide_title_de ?? entry.data.guide_title_en}</h2>
          <p class="text-xs font-semibold tracking-[0.22em] uppercase text-ink-subtle">
            Letzte Prüfung: {formatDate(entry.data.last_review)}
          </p>
        </header>

        <p class="text-base text-ink-muted leading-relaxed max-w-prose mb-lg">
          {entry.data.research_note_de ?? entry.data.research_note_en ?? 'Für diese Guide wurden historische Texte, Archive und Ortsbegehungen gegengeprüft, um vereinfachte Touristenerzählungen zu vermeiden.'}
        </p>

        {entry.data.chapters.map((chapter) => {
          const translatedFacts = chapter.facts.filter((fact) => fact.claim_de ?? fact.claim_en);
          const chapterSources = uniqueChapterSources(chapter);

          return (
            <details class="fo-capitolo">
              <summary><h3 class="font-display text-xl text-ink mb-xs">{chapter.title_de ?? chapter.title_en ?? 'Kapitel'}</h3></summary>
              <p class="text-sm text-ink mb-sm">{chapter.framing_de ?? chapter.framing_en ?? 'Was dieses Kapitel belegt:'}</p>

              {translatedFacts.length > 0 ? (
                translatedFacts.map((fact) => (
                  <div class="mb-md">
                    <p class="text-sm italic text-ink-muted mb-xs">{fact.claim_de ?? fact.claim_en}</p>
                    <ul class="list-disc pl-lg space-y-2xs">
                      {fact.sources.map((source) => (
                        <li class="text-sm text-ink-muted leading-snug">
                          {source.url
                            ? <a href={source.url} target="_blank" rel="noopener noreferrer">{formatSource(source)}</a>
                            : formatSource(source)}
                        </li>
                      ))}
                    </ul>
                  </div>
                ))
              ) : (
                <>
                  <p class="text-sm text-ink-muted mb-md">
                    Die detaillierten Aussagen dieses Kapitels werden noch ins Deutsche übertragen. Die verwendeten Quellen sind bereits vollständig aufgeführt.
                  </p>
                  <h4 class="text-xs font-semibold tracking-[0.18em] uppercase text-ink-subtle mb-xs">Quellen dieses Kapitels</h4>
                  <ul class="list-disc pl-lg space-y-2xs">
                    {chapterSources.map((source) => (
                      <li class="text-sm text-ink-muted leading-snug">
                        {source.url
                          ? <a href={source.url} target="_blank" rel="noopener noreferrer">{formatSource(source)}</a>
                          : formatSource(source)}
                      </li>
                    ))}
                  </ul>
                </>
              )}
            </details>
          );
        })}
      </section>
    ))}
  </article>
</Layout>
