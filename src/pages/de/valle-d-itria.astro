---
export const prerender = true;
import Layout from '../../components/Layout.astro';
import SectionDivider from '../../components/SectionDivider.astro';
import PriceCard from '../../components/PriceCard.astro';
import LangPills from '../../components/LangPills.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import HeroAudioSample from '../../components/HeroAudioSample.astro';
import StructuredData from '../../components/StructuredData.astro';
import { itemListLD } from '../../lib/seo';

interface GuideEntry {
  slug: string;
  title: string;
  subtitle: string;
  duration: string;
  area: string;
  cover: string;
  alt: string;
  price?: string;
}

const guides: GuideEntry[] = [
  {
    slug: 'alberobello',
    title: 'Alberobello — Im Inneren der Trulli',
    subtitle: 'Nicht nur weiße Häuser: Steine, Arbeit und eine Form, die die Welt eroberte.',
    duration: '35 min',
    area: "Valle d'Itria",
    cover: '/images/covers/alberobello.jpg',
    alt: "Trulli von Alberobello, Rione Monti",
    price: '€4,99',
  },
  {
    slug: 'locorotondo',
    title: 'Locorotondo — Das runde Dorf',
    subtitle: 'Ein rundes Dorf, weiße Häuser und Weinberge mit Blick ins Tal.',
    duration: '31 min',
    area: "Valle d'Itria",
    cover: '/images/covers/locorotondo.jpg',
    alt: 'Locorotondo, weiße Häuser mit Satteldächern',
    price: '€4,99',
  },
  {
    slug: 'martina-franca',
    title: 'Martina Franca — Die freie Stadt',
    subtitle: 'Barock, Adel und Freiheit: die Stadt, die gelernt hat, sich abzuheben.',
    duration: '30 min',
    area: "Valle d'Itria",
    cover: '/images/covers/martina-franca.jpg',
    alt: 'Herzogspalast von Martina Franca, Barockinnenhof',
    price: '€4,99',
  },
  {
    slug: 'cisternino',
    title: 'Cisternino — Das Fornello-Dorf',
    subtitle: 'Das Fornello pronto: Fleisch nach Wahl an der Theke, Glut und Dorfleben.',
    duration: '33 min',
    area: "Valle d'Itria",
    cover: '/images/covers/cisternino.jpg',
    alt: 'Cisternino, weißes historisches Zentrum mit Fornello pronto',
    price: '€4,99',
  },
  {
    slug: 'ostuni',
    title: 'Ostuni — Die weiße Stadt',
    subtitle: 'Weiße Gassen, Licht und Schichten: jenseits des perfekten Bildes.',
    duration: '33 min',
    area: "Valle d'Itria",
    cover: '/images/covers/ostuni.jpg',
    alt: 'Ostuni, die weiße Stadt von unten gesehen',
    price: '€4,99',
  },
  {
    slug: 'fasano',
    title: "Fasano / Selva di Fasano — Das Tal von oben",
    subtitle: "Vom Hügel aus verändert das Valle d'Itria seine Form und lässt sich lesen.",
    duration: '33 min',
    area: "Valle d'Itria",
    cover: '/images/covers/fasano.jpg',
    alt: "Selva di Fasano, Wald und Trulli von oben gesehen",
    price: '€4,99',
  },
];

const guideListLD = itemListLD(
  "Valle d'Itria Audioguides",
  guides.map((guide) => `https://localis.guide/de/guide/${guide.slug}`),
);
---
<Layout
  title="Valle d'Itria — Narrative Audioguides · Localis"
  description="Sechs narrative Audioguides aus dem Valle d'Itria: Alberobello, Locorotondo, Martina Franca, Cisternino, Ostuni und Fasano. Erzählt von Einheimischen. Ab 4,99 €."
  lang="de"
>
  <StructuredData data={guideListLD} />

  <Breadcrumb items={[{ label: 'Start', href: '/de' }, { label: "Valle d'Itria" }]} />

  {/* PAGE HEADER — hero with image */}
  <section class="valle-hero relative overflow-hidden border-b border-border">
    <img
      src="/images/covers/valle-d-itria-landing.jpg"
      alt="Valle d'Itria, Trulli und Weinberge unter der apulischen Sonne"
      class="valle-hero-bg"
      width="1980"
      height="900"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <div class="valle-hero-scrim" aria-hidden="true"></div>
    <div class="max-w-wrap mx-auto px-md py-3xl lg:py-4xl relative z-10">
      <LangPills lang="de" currentPath={Astro.url.pathname} />
      <div class="flex items-center gap-sm mb-md">
        <span class="block w-7 h-px bg-accent"></span>
        <span class="text-[11px] font-semibold tracking-[0.24em] uppercase text-accent">
          Reiseziel — Valle d'Itria
        </span>
      </div>
      <h1 class="font-display font-light text-ink leading-[1.05] tracking-[-0.014em] text-[clamp(2.2rem,5vw,3.6rem)] max-w-[22ch]">
        Das Valle d'Itria, jenseits der Postkarte.
      </h1>
      <p class="font-body text-base sm:text-lg leading-relaxed text-ink-muted mt-md max-w-[52ch]">
        Sechs Audioerzählungen zwischen Trulli, weißen Dörfern, Weinbergen und Hügelstraßen. Keine App.
      </p>
      <HeroAudioSample lang="de" src="/audio/trailers/valle-d-itria/alberobello-trailer-de.mp3" guideSlug="alberobello" />
      <a href="#preise" class="mt-md inline-flex items-center gap-xs text-sm font-semibold text-link hover:text-link-pressed no-underline">Guides und Preise <span aria-hidden="true">↓</span></a>
    </div>
  </section>

  <style>
    .valle-hero {
      min-height: clamp(560px, 78vh, 820px);
      display: flex;
      align-items: center;
    }
    .valle-hero-bg {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center center;
      filter: saturate(0.92) contrast(1.04);
    }
    .valle-hero-scrim {
      position: absolute;
      inset: 0;
      background: linear-gradient(
        to right,
        oklch(from var(--color-surface) l c h / 0.88) 0%,
        oklch(from var(--color-surface) l c h / 0.65) 35%,
        oklch(from var(--color-surface) l c h / 0.18) 70%,
        oklch(from var(--color-surface) l c h / 0) 100%
      );
      pointer-events: none;
    }
    @media (max-width: 768px) {
      .valle-hero-scrim {
        background: linear-gradient(
          to bottom,
          oklch(from var(--color-surface) l c h / 0.92) 0%,
          oklch(from var(--color-surface) l c h / 0.72) 60%,
          oklch(from var(--color-surface) l c h / 0.5) 100%
        );
      }
    }
  </style>

  {/* INTERLUDE */}
  <section class="bg-surface-elev border-b border-border">
    <div class="max-w-wrap mx-auto px-md py-xl flex items-center gap-lg">
      <span class="block h-px flex-1 bg-border"></span>
      <p class="font-body text-sm text-ink-muted tracking-[0.18em] uppercase shrink-0">Sechs Erzählungen · sechs Orte · ein Tal</p>
      <span class="block h-px flex-1 bg-border"></span>
    </div>
  </section>

  {/* GUIDE GRID */}
  <section class="bg-surface">
    <div class="max-w-wrap mx-auto px-md py-3xl lg:py-4xl">
      <ol class="guide-grid list-none p-0 m-0">
        {guides.map((g, i) => (
          <li class="guide-cell" style={`--idx:${i}`}>
            <a href={`/de/guide/${g.slug}`} class="guide-card" aria-label={`${g.title} · ${g.duration}`}>
              <figure class="guide-photo m-0">
                <img src={g.cover} alt={g.alt} class="guide-img" loading="lazy" decoding="async" />
                <span class="guide-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                {g.price && <span class="guide-price" aria-hidden="true">{g.price}</span>}
                <span class="guide-scrim" aria-hidden="true">
                  <span class="guide-area">{g.area}</span>
                  <span class="guide-dur">{g.duration}</span>
                </span>
              </figure>
              <div class="guide-meta">
                <h3 class="guide-title font-display font-light text-ink leading-[1.2] m-0">{g.title}</h3>
                <p class="guide-sub font-body text-sm text-ink-muted m-0">{g.subtitle}</p>
              </div>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* NARRATORS */}
  <section id="preise" class="bg-surface-elev border-t border-border">
    <div class="max-w-wrap mx-auto px-md py-3xl lg:py-4xl">
      <SectionDivider label="Wähle, wie du das Valle d'Itria erleben möchtest." />
      <div class="grid grid-cols-1 md:grid-cols-3 gap-lg max-w-[68rem] mx-auto">
        <PriceCard
          product="single"
          guideSlug="alberobello"
          lang="de"
          features={[
            'Eine Audioerzählung nach Wahl',
            'Dauerhafter Zugriff',
            'Italienisch, Englisch und Deutsch',
            'Geld-zurück-Garantie, ohne Rückfragen',
          ]}
        />
        <PriceCard
          product="tris"
          lang="de"
          features={[
            '3 Audioerzählungen nach Wahl',
            'Dauerhafter Zugriff',
            'Geld-zurück-Garantie, ohne Rückfragen',
          ]}
        />
        <PriceCard
          product="valle-completa"
          lang="de"
          primary
          titleOverride="Pack 6 (Komplette Zone)"
          descriptionOverride="Alle 6 Guides der Valle d'Itria. Sechs Erzählungen, sechs Orte."
          ctaOverride="Pack 6 kaufen"
          features={[
            "Alle 6 Guides der Valle d'Itria",
            '~3h Storytelling · verschiedene Stimmen',
            'Geld-zurück-Garantie, ohne Rückfragen',
          ]}
        />
      </div>
    </div>
  </section>

  <style>
    .narr-grid {
      display: grid;
      grid-template-columns: repeat(1, 1fr);
      gap: var(--spacing-2xl);
    }
    @media (min-width: 640px) { .narr-grid { grid-template-columns: repeat(3, 1fr); } }

    .narr-card {
      display: flex; flex-direction: column; gap: var(--spacing-md);
      text-decoration: none; color: inherit;
      border-top: 1px solid var(--color-border); padding-top: var(--spacing-md);
      transition: opacity 0.2s;
    }
    .narr-card:hover { opacity: 0.82; }
    .narr-card:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 4px; border-radius: 2px; }

    .narr-photo {
      width: 100%; aspect-ratio: 3 / 4; overflow: hidden;
      border-radius: var(--radius-md); background: var(--color-surface-elev);
      box-shadow: 0 1px 2px oklch(15% 0.012 240 / 0.06), 0 8px 24px -8px oklch(15% 0.012 240 / 0.14);
    }
    .narr-photo img {
      width: 100%; height: 100%; object-fit: cover; display: block;
      filter: grayscale(100%) contrast(1.05) brightness(0.97);
    }
    .narr-photo-note { margin-top: calc(var(--spacing-md) * -0.55); line-height: 1.35; }
    .narr-text { display: flex; flex-direction: column; gap: var(--spacing-xs); }
    .narr-name { font-size: clamp(1.3rem, 2.8vw, 1.6rem); line-height: 1.1; }
    .narr-bio { line-height: 1.55; }

    @media (prefers-reduced-motion: reduce) { .narr-card { transition: none; } }
  </style>

  {/* PRICING */}
  <section class="bg-surface border-t border-border">
    <div class="max-w-wrap mx-auto px-md py-3xl lg:py-4xl">
      <div class="flex items-center justify-center gap-sm mb-2xl">
        <span class="block w-7 h-px bg-accent"></span>
        <span class="text-[10px] font-semibold tracking-[0.32em] uppercase text-accent">Die Perspektiven des Tals</span>
        <span class="block w-7 h-px bg-accent"></span>
      </div>
      <p class="font-body text-sm text-ink-muted text-center max-w-[52ch] mx-auto mb-2xl mt-[-var(--spacing-xl)]">Narrative Porträts, aufgebaut auf Recherche, Quellen und Ortsgedächtnis.</p>
      <ul class="narr-grid list-none p-0 m-0">
        {[
          { name: 'Concetta', photo: '/images/authors/concetta-alberobello-jun26.jpg', role: 'Drei Generationen im Rione Aia Piccola', bio: "Fünfundsechzig Jahre alt, geboren und aufgewachsen im Rione Aia Piccola. Drei Generationen unter demselben Steindach. Sie erzählt die Trulli so, wie es eine Nachbarin tut — von der Türschwelle, auf der sie immer gesessen hat.", guide: 'Alberobello', href: '/de/guide/alberobello' },
          { name: 'Francesco', photo: '/images/authors/francesco-locorotondo-jun26.jpg', role: 'Winzer des runden Dorfes', bio: "Fünfzig Jahre alt, Winzer des runden Dorfes. Er produziert DOC-Wein, Olivenöl und Lavendelöl zwischen den Weinbergen des Valle d'Itria.", guide: 'Locorotondo', href: '/de/guide/locorotondo' },
          { name: 'Anonym', photo: '/images/authors/nobile-martina-franca-jun26.jpg', role: 'Nachkomme der Familie Caracciolo', bio: "Ein direkter Nachkomme der Familie Caracciolo. Möchte keinen Namen nennen — er will Geschichten erzählen, keine Aussagen machen.", guide: 'Martina Franca', href: '/de/guide/martina-franca' },
          { name: 'Michele', photo: '/images/authors/michele-cisternino-jun26.jpg', role: 'Metzger in dritter Generation', bio: "Metzger, dritte Generation. Er betreibt das älteste Fornello pronto in der Altstadt — das Feuer wird bei Tagesanbruch angezündet und erlischt erst am Abend.", guide: 'Cisternino', href: '/de/guide/cisternino' },
          { name: 'Salvatore', photo: '/images/authors/salvatore-ostuni-jun26.jpg', role: 'Pensionierter Stadtpolizist aus Ostuni', bio: "Pensionierter Stadtpolizist, vierzig Jahre Dienst in Ostuni. Er hat Generationen von Touristen kommen und gehen sehen und kennt jede Gasse, jedes Bußgeld, jeden chaotischen August und jeden stillen Winter.", guide: 'Ostuni', href: '/de/guide/ostuni' },
          { name: 'Andrea', photo: '/images/authors/andrea-fasano-jun26.jpg', role: 'Pilot über dem Valle d\'Itria', bio: "Gleitschirmflieger, fliegt seit zwanzig Jahren über die Valle d'Itria. Er kennt die Geometrie der Trulli und Masserie von oben besser als jeder Reiseführer.", guide: 'Fasano / Selva di Fasano', href: '/de/guide/fasano' },
        ].map((n) => (
          <li>
            <a href={n.href} class="narr-card" aria-label={`Guide ${n.guide} — Stimme von ${n.name}`}>
              <figure class="narr-photo m-0">
                <img
                  src={n.photo}
                  alt={`Sinnbildliches Porträt von ${n.name}`}
                  title={`${n.name}: zusammengesetzte redaktionelle Figur aus Recherche, Quellen und Material vor Ort. Sinnbildliches Porträt.`}
                  loading="lazy"
                  decoding="async"
                />
              </figure>
              <p class="narr-photo-note font-body text-[10px] font-semibold tracking-[0.18em] uppercase text-ink-subtle m-0">
                Zusammengesetzte redaktionelle Stimme. Sinnbildliches Porträt.
              </p>
              <div class="narr-text">
                <p class="narr-guide font-body text-[10px] font-semibold tracking-[0.22em] uppercase text-accent m-0">{n.guide}</p>
                <h3 class="narr-name font-display font-light text-ink m-0">{n.name}</h3>
                <p class="narr-role font-body text-xs text-ink-subtle m-0">{n.role}</p>
                <p class="narr-bio font-body text-sm text-ink-muted m-0 mt-xs">{n.bio}</p>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

</Layout>

<style>
  .guide-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: var(--spacing-lg);
    row-gap: var(--spacing-2xl);
  }
  @media (min-width: 640px) { .guide-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .guide-grid { grid-template-columns: repeat(3, 1fr); } }

  .guide-cell {
    opacity: 0;
    transform: translateY(14px);
    animation: guideIn 0.7s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: calc(var(--idx, 0) * 80ms + 100ms);
  }
  .guide-card {
    display: flex; flex-direction: column; gap: var(--spacing-md); height: 100%;
    text-decoration: none; color: inherit;
    border-top: 1px solid var(--color-ink); padding-top: var(--spacing-md);
    transition: transform 240ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .guide-card:hover { transform: translateY(-2px); }
  .guide-photo {
    position: relative; width: 100%; height: clamp(16rem, 24vw, 21rem);
    background: var(--color-surface-elev); overflow: hidden; border-radius: var(--radius-md);
    box-shadow: 0 1px 2px oklch(15% 0.012 240 / 0.08), 0 12px 32px -12px oklch(15% 0.012 240 / 0.16);
  }
  .guide-img { width: 100%; height: 100%; object-fit: cover; display: block; filter: saturate(0.94) contrast(1.04); }
  .guide-num { position: absolute; top: var(--spacing-sm); left: var(--spacing-sm); font-family: var(--font-display); font-style: italic; font-weight: 300; font-size: clamp(2.4rem, 4.4vw, 3.2rem); line-height: 0.85; color: var(--color-surface); letter-spacing: -0.04em; text-shadow: 0 1px 8px oklch(15% 0.012 240 / 0.55); pointer-events: none; user-select: none; }
  .guide-price { position: absolute; top: var(--spacing-sm); right: var(--spacing-sm); font-family: var(--font-body); font-size: 0.8125rem; font-weight: 700; color: var(--color-ink); background: var(--color-surface); border: 1px solid var(--color-accent); padding: 4px 10px 5px; line-height: 1.2; box-shadow: 0 1px 2px oklch(15% 0.012 240 / 0.18); pointer-events: none; user-select: none; z-index: 1; }
  .guide-scrim { position: absolute; left: 0; right: 0; bottom: 0; display: flex; align-items: center; justify-content: space-between; padding: var(--spacing-sm) var(--spacing-md); background: linear-gradient(to top, oklch(15% 0.012 240 / 0.78), transparent 100%); color: var(--color-surface); font-family: var(--font-body); font-size: 10px; font-weight: 700; letter-spacing: 0.22em; text-transform: uppercase; pointer-events: none; }
  .guide-area { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .guide-dur { flex-shrink: 0; color: var(--color-accent-soft); }
  .guide-meta { display: flex; flex-direction: column; gap: var(--spacing-xs); }
  .guide-title { font-size: clamp(1.1rem, 2.4vw, 1.35rem); }
  .guide-sub { line-height: 1.5; }
  .guide-card:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 4px; border-radius: 2px; }
  @keyframes guideIn { to { opacity: 1; transform: translateY(0); } }
  @media (prefers-reduced-motion: reduce) { .guide-cell, .guide-card, .guide-img { animation: none !important; transition: none !important; opacity: 1; transform: none; } }
</style>
