---
export const prerender = true;
import Layout from '../../components/Layout.astro';
import StartMap from '../../components/StartMap.astro';
---
<Layout
  title="Bari bei Kreuzfahrt-Stopp: Hafen & Sehenswürdigkeiten | Localis"
  description="Nur wenige Stunden beim Landgang in Bari? Zwei Hörgeschichten führen Kreuzfahrtgäste zu Fuß durch Altstadt, Hafen und Sehenswürdigkeiten. Gratis Hörprobe."
  lang="de"
  ogImage="/images/covers/nave-crociera.jpg"
>

  {/* ── HERO ── */}
  <section id="hero-crociera" class="relative overflow-hidden border-b border-border">
    <img
      src="/images/covers/nave-crociera.jpg"
      alt="Kreuzfahrtschiff im Hafen von Bari"
      class="absolute inset-0 w-full h-full object-cover object-center"
      width="1980"
      height="900"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <div class="cruise-scrim" aria-hidden="true"></div>
    <div class="max-w-wrap mx-auto px-md py-3xl lg:py-4xl relative z-10">
      <div class="flex items-center gap-sm mb-md">
        <span class="block w-7 h-px bg-accent"></span>
        <span class="text-[11px] font-semibold tracking-[0.24em] uppercase text-accent">Hafenstopp · Bari</span>
      </div>
      <h1 class="font-display font-light text-ink leading-[1.05] tracking-[-0.014em] text-[clamp(2.2rem,5vw,3.6rem)] max-w-[22ch]" style="color:oklch(12% 0.005 240)">
        Nur wenige Stunden in Bari.<br />Geh nicht einfach nur hindurch.
      </h1>
      <p class="font-body text-base sm:text-lg leading-relaxed mt-md max-w-[54ch]" style="color:oklch(22% 0.008 240 / 0.88)">
        Zwei Audioerzählungen für Kreuzfahrtgäste: Bari Vecchia und die Esskultur der Stadt, auf einem kompakten Spaziergang in deinem eigenen Tempo.
      </p>
      <p class="font-body text-sm sm:text-base leading-relaxed mt-sm max-w-[54ch]" style="color:oklch(22% 0.008 240 / 0.82)">
        Speziell für 4 bis 5 Stunden an Land: Start zu Fuß am Kreuzfahrtterminal, Altstadt ohne Umwege und genug Puffer für den Rückweg zum Schiff.
      </p>
      <div class="flex flex-col sm:flex-row gap-sm mt-lg">
        <button
          class="checkout-btn-crociera inline-flex items-center justify-center gap-xs px-lg py-md bg-ink text-surface rounded-md font-semibold text-sm hover:bg-ink/90 transition-[background-color,transform] duration-fast hover:-translate-y-[1px] active:translate-y-0 min-h-[48px]"
          data-product="crociera"
          data-lang="de"
        >
          Kreuzfahrt-Paket — 7,99 €
        </button>
        <button
          id="play-trailer-btn"
          class="inline-flex items-center justify-center gap-xs px-lg py-md border border-border text-ink rounded-md font-semibold text-sm hover:bg-surface-elev transition-[background-color,transform] duration-fast hover:-translate-y-[1px] active:translate-y-0 min-h-[48px]"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <polygon points="5,3 19,12 5,21"></polygon>
          </svg>
          60 Sekunden anhören
        </button>
      </div>
      <ul class="mt-md flex flex-col gap-xs text-sm text-ink max-w-[48ch] list-none p-0 m-0">
        <li>2 kurze Audio-Erzählungen, zugeschnitten auf 4 bis 5 Stunden an Land.</li>
        <li>Einfache Strecke: Kreuzfahrtterminal, Altstadt und zu Fuß zurück zum Kai.</li>
        <li>Optimiertes Timing: hören, gehen und mit Reserve wieder an Bord.</li>
      </ul>
        <audio id="trailer-audio" src="/audio/trailers/bari/bari-vecchia-trailer-de.mp3" class="hidden" preload="none"></audio>
    </div>
  </section>

  <style>
    #hero-crociera {
      min-height: clamp(280px, 42vh, 480px);
      display: flex;
      align-items: center;
    }
    .cruise-scrim {
      position: absolute;
      inset: 0;
      background: linear-gradient(
        to right,
        oklch(from var(--color-surface) l c h / 0.90) 0%,
        oklch(from var(--color-surface) l c h / 0.65) 40%,
        oklch(from var(--color-surface) l c h / 0.15) 75%,
        oklch(from var(--color-surface) l c h / 0) 100%
      );
      pointer-events: none;
    }
    @media (max-width: 768px) {
      .cruise-scrim {
        background: linear-gradient(
          to bottom,
          oklch(from var(--color-surface) l c h / 0.92) 0%,
          oklch(from var(--color-surface) l c h / 0.75) 60%,
          oklch(from var(--color-surface) l c h / 0.55) 100%
        );
      }
    }
  </style>

  {/* ── WAS SIE HÖREN ── */}
  <section class="bg-surface py-xl lg:py-3xl border-b border-border">
    <div class="max-w-wrap mx-auto px-md">
      <h2 class="font-display font-light text-ink text-[clamp(1.6rem,3.5vw,2.4rem)] leading-tight tracking-[-0.01em] mb-xl text-center">
        Zwei Audioerzählungen für einen Morgen an Land.
      </h2>
      <div class="grid sm:grid-cols-2 gap-lg">
        {/* Card 1 */}
        <div class="bg-surface-elev rounded-lg overflow-hidden border border-border flex flex-col">
          <div class="aspect-[3/4] overflow-hidden">
            <img
              src="/images/covers/bari-vecchia.jpg"
              alt="Altstadt Bari — In der Stadt"
              class="w-full h-full object-cover object-top"
              width="1024"
              height="1536"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="p-md flex flex-col gap-xs flex-1">
            <span class="text-[11px] font-semibold tracking-[0.18em] uppercase text-ink-subtle">21 Minuten</span>
            <h3 class="font-display font-light text-ink text-xl leading-snug">
              Altstadt Bari — In der Stadt
            </h3>
            <p class="font-body text-sm text-ink-muted leading-relaxed">
              Eine Erzählung über Bari Vecchia: die Basilika San Nicola, enge Gassen, die Kathedrale und die Schichten der Altstadt. Echte Geschichte, kein Touristenskript.
            </p>
          </div>
        </div>
        {/* Card 2 */}
        <div class="bg-surface-elev rounded-lg overflow-hidden border border-border flex flex-col">
          <div class="aspect-[3/4] overflow-hidden">
            <img
              src="/images/covers/il-meglio-di-bari.jpg"
              alt="Bari bei Tisch — Das Essen, das die Stadt zusammenhält"
              class="w-full h-full object-cover object-top"
              width="1024"
              height="1536"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="p-md flex flex-col gap-xs flex-1">
            <span class="text-[11px] font-semibold tracking-[0.18em] uppercase text-ink-subtle">28 Minuten</span>
            <h3 class="font-display font-light text-ink text-xl leading-snug">
              Bari bei Tisch — Das Essen, das die Stadt zusammenhält
            </h3>
            <p class="font-body text-sm text-ink-muted leading-relaxed">
              Eine Erzählung über das Bari am Meer: Uferpromenade, Fischmarkt, Panzerotti und Orte, die Einheimische selten erklären — weil sie für sie selbstverständlich sind.
            </p>
          </div>
        </div>
      </div>
      <p class="font-body text-sm text-ink-muted text-center mt-lg">
        49 Minuten Audio plus Gehzeit. Insgesamt 3 bis 4 Stunden, Rückweg zum Schiff inklusive.
      </p>
    </div>
  </section>

  {/* ── DIE ROUTE ── */}
  <section id="route" class="bg-surface-elev py-xl lg:py-3xl border-b border-border">
    <div class="max-w-wrap mx-auto px-md">
      <div class="flex items-center gap-sm justify-center mb-sm">
        <span class="block w-7 h-px bg-accent"></span>
        <span class="text-[11px] font-semibold tracking-[0.24em] uppercase text-ink-subtle">— Karte —</span>
        <span class="block w-7 h-px bg-accent"></span>
      </div>
      <h2 class="font-display font-light text-ink text-[clamp(1.5rem,3vw,2.2rem)] leading-tight tracking-[-0.01em] text-center mb-xl">
        Vom Kai zur Altstadt. 600 Meter.
      </h2>
      <div class="mb-lg">
        <StartMap
          lat={41.1268}
          lng={16.8716}
          lang="de"
          startsAt="Molo Pizzoli — 8 Minuten zu Fuß"
          delta={0.008}
        />
      </div>
      <div class="flex flex-wrap items-center justify-center gap-xs text-sm font-body text-ink-muted">
        <span class="text-ink font-semibold">Molo Pizzoli</span>
        <span class="text-ink-subtle">→ 8 Min. zu Fuß →</span>
        <span class="text-ink font-semibold">Kathedrale San Sabino</span>
        <span class="text-ink-subtle">→</span>
        <span class="text-ink font-semibold">Basilika San Nicola</span>
        <span class="text-ink-subtle">→</span>
        <span class="text-ink font-semibold">Orecchiette-Gasse</span>
        <span class="text-ink-subtle">→</span>
        <span class="text-ink font-semibold">Zurück zum Kai</span>
      </div>
      <p class="font-body text-sm text-ink-subtle text-center mt-md">
        Sie können am Kai beginnen und dann hören, wann es für Sie passt. Die Aufnahmen erklären den Ort, nicht jede einzelne Abbiegung.
      </p>
    </div>
  </section>

  {/* ── SO FUNKTIONIERT ES ── */}
  <section class="bg-surface py-xl lg:py-3xl border-b border-border">
    <div class="max-w-wrap mx-auto px-md">
      <h2 class="font-display font-light text-ink text-[clamp(1.5rem,3vw,2.2rem)] leading-tight tracking-[-0.01em] text-center mb-xl">
        In zwei Minuten sind Sie dabei.
      </h2>
      <div class="grid sm:grid-cols-3 gap-lg mb-xl">
        <div class="flex flex-col gap-sm">
          <span class="font-display font-light text-accent text-4xl leading-none">01</span>
          <h3 class="font-display font-light text-ink text-lg leading-snug">Kaufen</h3>
          <p class="font-body text-sm text-ink-muted leading-relaxed">
            Über das WLAN des Schiffes, des Terminals oder eines Cafés. Kreditkarte, keine Registrierung.
          </p>
        </div>
        <div class="flex flex-col gap-sm">
          <span class="font-display font-light text-accent text-4xl leading-none">02</span>
          <h3 class="font-display font-light text-ink text-lg leading-snug">Link öffnen</h3>
          <p class="font-body text-sm text-ink-muted leading-relaxed">
            Kommt per E-Mail. Lade den Guide vor dem Start der Tour herunter und höre ihn auch ohne Verbindung — keine App, kein Konto.
          </p>
        </div>
        <div class="flex flex-col gap-sm">
          <span class="font-display font-light text-accent text-4xl leading-none">03</span>
          <h3 class="font-display font-light text-ink text-lg leading-snug">Hören, wann es passt</h3>
          <p class="font-body text-sm text-ink-muted leading-relaxed">
            Beim Gehen, auf einer Bank oder später auf dem Schiff. Localis erklärt den Ort, ohne Sie Schritt für Schritt zu führen.
          </p>
        </div>
      </div>
      <div class="text-center">
        <button
          class="checkout-btn-crociera inline-flex items-center justify-center gap-xs px-lg py-md bg-accent text-white rounded-md font-semibold text-sm hover:bg-accent/90 transition-[background-color,transform] duration-fast hover:-translate-y-[1px] active:translate-y-0 min-h-[48px]"
          data-product="crociera"
          data-lang="de"
        >
          Jetzt starten — 7,99 €
        </button>
      </div>
    </div>
  </section>

  {/* ── PÜNKTLICH ZURÜCK ── */}
  <section class="bg-surface-elev py-xl lg:py-3xl border-b border-border">
    <div class="max-w-narrow mx-auto px-md">
      <div class="flex items-center gap-sm justify-center mb-sm">
        <span class="block w-7 h-px bg-accent"></span>
        <span class="text-[11px] font-semibold tracking-[0.24em] uppercase text-ink-subtle">— Timing —</span>
        <span class="block w-7 h-px bg-accent"></span>
      </div>
      <h2 class="font-display font-light text-ink text-[clamp(1.5rem,3vw,2.2rem)] leading-tight tracking-[-0.01em] text-center mb-xl">
        Mit genug Puffer zurück an Bord.
      </h2>
      <ul class="flex flex-col gap-md">
        {[
          'Die beiden Audioerzählungen sind bewusst kurz — zusammen 49 Minuten',
          'Rechnen Sie mit anderthalb bis zwei Stunden für gemütliches Gehen und Pausen',
          'Planen Sie 30 Minuten Puffer für den Rückweg zum Kai ein',
          'Planen Sie immer ausreichend Zeit für den Rückweg zum Schiff ein und prüfen Sie die von Ihrer Reederei angegebene späteste Rückkehrzeit.',
        ].map((item) => (
          <li class="flex items-start gap-md">
            <svg class="w-5 h-5 text-accent flex-shrink-0 mt-[2px]" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414L8.414 15l-4.121-4.121a1 1 0 011.414-1.414L8.414 12.172l7.879-7.879a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            <span class="font-body text-sm text-ink-muted leading-relaxed">{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* ── FAQ ── */}
  <section class="bg-surface py-xl lg:py-3xl border-b border-border">
    <div class="max-w-narrow mx-auto px-md">
      <h2 class="font-display font-light text-ink text-[clamp(1.5rem,3vw,2.2rem)] leading-tight tracking-[-0.01em] text-center mb-xl">
        Häufige Fragen
      </h2>
      <dl class="flex flex-col gap-lg">
        {[
          {
            q: 'Brauche ich Internet beim Gehen?',
            a: 'Ja für das Streaming; nein, wenn du ihn vorher speicherst. Auf der Guide-Seite tippst du auf "Für offline speichern", solange du mit dem WLAN des Terminals oder Schiffes verbunden bist. Sobald "✓ Offline verfügbar" erscheint, kannst du ohne Empfang losgehen.',
          },
          {
            q: 'Wie weit ist die Altstadt vom Kai entfernt?',
            a: '600 Meter, 8 bis 10 Minuten zu Fuß entlang der Uferpromenade. Alles eben.',
          },
          {
            q: 'Was ist, wenn ich das Schiff verpasse?',
            a: 'Diese Route ist für einen kurzen und kompakten Besuch gedacht. Prüfen Sie immer die von Ihrer Reederei angegebene späteste Rückkehrzeit und planen Sie ausreichend Zeit für den Weg zurück zum Schiff ein.',
          },
          {
            q: 'Kann ich ihn auch zu Hause nochmal hören?',
            a: 'Ja, der Guide gehört Ihnen dauerhaft. Viele hören ihn nach der Reise noch einmal.',
          },
          {
            q: 'Sind die Stimmen echt oder KI?',
            a: 'Synthetische Stimmen — das sagen wir offen. Die Texte sind von uns geschrieben, mit nachprüfbaren Quellen.',
          },
        ].map(({ q, a }) => (
          <div class="border-b border-border pb-lg last:border-b-0 last:pb-0">
            <dt class="font-body font-semibold text-ink text-sm mb-xs">{q}</dt>
            <dd class="font-body text-sm text-ink-muted leading-relaxed">{a}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  {/* ── CLOSER ── */}
  <section class="bg-surface-elev py-xl lg:py-3xl">
    <div class="max-w-narrow mx-auto px-md text-center">
      <blockquote class="font-display font-light text-ink text-[clamp(1.2rem,2.5vw,1.7rem)] leading-relaxed tracking-[-0.01em] italic mb-xl">
        "Wir verkaufen Ihnen keine Führung. Wir geben Ihnen Worte und Geschichten für einen Ort, den Sie auf eigene Weise erleben."
      </blockquote>
      <button
        class="checkout-btn-crociera inline-flex items-center justify-center gap-xs px-lg py-md bg-accent text-white rounded-md font-semibold text-sm hover:bg-accent/90 transition-[background-color,transform] duration-fast hover:-translate-y-[1px] active:translate-y-0 min-h-[48px] mb-md"
        data-product="crociera"
        data-lang="de"
      >
        Kreuzfahrt-Paket kaufen — 7,99 €
      </button>
      <p class="font-body text-xs text-ink-subtle leading-relaxed">
        Sofortiger Zugang per E-Mail · Offline hörbar · Dauerhafter Zugriff · Geld-zurück-Garantie, ohne Rückfragen
      </p>
    </div>
  </section>

  {/* ── STICKY CTA MOBILE ── */}
  <div
    id="sticky-cta"
    class="fixed left-0 right-0 z-50 md:hidden bg-surface border-t border-border px-md py-sm shadow-lg translate-y-full transition-transform duration-300"
    style="bottom: var(--cookie-banner-height, 0px);"
    aria-hidden="true"
  >
    <button
      class="checkout-btn-crociera w-full inline-flex items-center justify-center gap-xs px-lg py-md bg-accent text-white rounded-md font-semibold text-sm min-h-[48px]"
      data-product="crociera"
      data-lang="de"
    >
      Kreuzfahrt-Paket — 7,99 €
    </button>
  </div>

</Layout>

<script>
  import { createAudioAnalyticsTracker } from '../../lib/audio-analytics';
  import { submitCheckoutRedirect } from '../../lib/checkout-client';
  const lang = 'de';
  const playBtn = document.getElementById('play-trailer-btn') as HTMLButtonElement | null;
  const audio = document.getElementById('trailer-audio') as HTMLAudioElement | null;
  if (playBtn && audio) {
    const tracker = createAudioAnalyticsTracker({
      audio,
      guideSlug: 'bari-vecchia',
      audioAssetId: 'bari-vecchia-cruise-sample-de',
      language: lang,
      audioContext: 'cruise',
      audioType: 'cruise_sample',
      product: 'crociera',
    });
    audio.addEventListener('timeupdate', () => {
      tracker.onTimeUpdate();
    });
    playBtn.addEventListener('click', () => {
      if (audio.paused) {
        audio.play().then(() => {
          tracker.onPlay();
        }).catch(() => {});
        playBtn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg> Pause';
      } else {
        audio.pause();
        tracker.onPause();
        playBtn.innerHTML = `<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><polygon points="5,3 19,12 5,21"></polygon></svg> 60 Sekunden anhören`;
      }
    });
    audio.addEventListener('ended', () => {
      tracker.onEnded();
      playBtn.innerHTML = `<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><polygon points="5,3 19,12 5,21"></polygon></svg> 60 Sekunden anhören`;
    });
  }

  const hero = document.getElementById('hero-crociera');
  const stickyCta = document.getElementById('sticky-cta');
  if (hero && stickyCta) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) {
          stickyCta.classList.remove('translate-y-full');
          stickyCta.removeAttribute('aria-hidden');
        } else {
          stickyCta.classList.add('translate-y-full');
          stickyCta.setAttribute('aria-hidden', 'true');
        }
      },
      { threshold: 0 }
    );
    observer.observe(hero);
  }

  document.querySelectorAll<HTMLButtonElement>('.checkout-btn-crociera').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const product = btn.dataset.product ?? 'crociera';
      btn.disabled = true;
      const orig = btn.textContent;
      btn.textContent = 'Lädt…';
      try {
        if (typeof window.localisTrack === 'function') {
          const params = {
            product,
            guide_count: 2,
            guide_slugs: 'bari-vecchia,bari-tavola',
            lang,
            value: 7.99,
            currency: 'EUR',
            cta_source: 'cruise',
          };
          window.localisTrack('begin_checkout', params);
        }
        submitCheckoutRedirect({ product: 'crociera', lang });
      } catch {
        btn.disabled = false;
        btn.textContent = orig;
        alert('Checkout-Fehler. Bitte versuchen Sie es in einem Moment erneut.');
      }
    });
  });
</script>
