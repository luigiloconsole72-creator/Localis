---
export const prerender = true;
import Layout from '../../components/Layout.astro';
import SectionDivider from '../../components/SectionDivider.astro';
import PriceCard from '../../components/PriceCard.astro';
import StepsBlock from '../../components/StepsBlock.astro';
import LangPills from '../../components/LangPills.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import HeroAudioSample from '../../components/HeroAudioSample.astro';
import StructuredData from '../../components/StructuredData.astro';
import { itemListLD } from '../../lib/seo';

const guideListLD = itemListLD(
  'Matera Audioguide',
  ['https://localis.guide/de/guide/matera'],
);
---
<Layout
  title="Matera Audioguide | Die Sassi erklärt von Localis"
  description="Matera Audioguide: die Sassi, Höhlenhäuser, die Gravina und Felsenkirchen. Rosa erzählt die Stadt von innen. 26 Minuten · 4,99 €. Keine App erforderlich."
  lang="de"
  ogImage="/images/covers/og-matera.jpg"
>
  <StructuredData data={guideListLD} />
  <Breadcrumb items={[{ label: 'Startseite', href: '/de' }, { label: 'Matera' }]} />

  {/* HERO */}
  <section class="matera-hero relative overflow-hidden border-b border-border">
    <img
      src="/images/covers/matera-golden-hour-jun26.webp"
      alt="Matera, die Sassi von oben mit der Gravina-Schlucht im Hintergrund"
      class="matera-hero-bg"
      width="1980"
      height="900"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <div class="matera-hero-scrim" aria-hidden="true"></div>
    <div class="max-w-wrap mx-auto px-md py-3xl lg:py-4xl relative z-10">
      <LangPills lang="de" currentPath={Astro.url.pathname} />
      <div class="flex items-center gap-sm mb-md">
        <span class="block w-7 h-px bg-accent"></span>
        <span class="text-[11px] font-semibold tracking-[0.24em] uppercase text-accent">
          Audioerzählung · Matera
        </span>
      </div>
      <h1 class="font-display font-light text-ink leading-[1.05] tracking-[-0.014em] text-[clamp(2.2rem,5vw,3.6rem)] max-w-[22ch]">
        Matera besucht man nicht einfach.<br />
        <em class="not-italic">Man begreift es.</em>
      </h1>
      <p class="font-body text-base sm:text-lg leading-relaxed text-ink-muted mt-md max-w-[52ch]">
        Die Geschichte der Sassi, der Höhlenhäuser, der Gravina und einer in Stein gemeißelten Stadt: bitterarm, verlassen, dann wiedergeboren vor den Augen der Welt.
      </p>
      <HeroAudioSample lang="de" src="/audio/trailers/matera/matera-trailer-de.mp3" guideSlug="matera" />
      <a href="#preise" class="mt-md inline-flex items-center gap-xs text-sm font-semibold text-link hover:text-link-pressed no-underline">Guides und Preise <span aria-hidden="true">↓</span></a>
    </div>
  </section>

  <style>
    .matera-hero {
      min-height: clamp(560px, 78vh, 820px);
      display: flex;
      align-items: center;
    }
    .matera-hero-bg {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center center;
      filter: saturate(0.88) contrast(1.06);
    }
    .matera-hero .text-ink,
    .matera-hero h1 {
      color: oklch(12% 0.005 240) !important;
    }
    .matera-hero .text-ink-muted,
    .matera-hero p {
      color: oklch(22% 0.008 240 / 0.9) !important;
    }
    .matera-hero-scrim {
      position: absolute;
      inset: 0;
      background: linear-gradient(
        to right,
        oklch(from var(--color-surface) l c h / 0.96) 0%,
        oklch(from var(--color-surface) l c h / 0.85) 35%,
        oklch(from var(--color-surface) l c h / 0.45) 62%,
        oklch(from var(--color-surface) l c h / 0) 85%
      );
      pointer-events: none;
    }
    @media (max-width: 768px) {
      .matera-hero-scrim {
        background: linear-gradient(
          to bottom,
          oklch(from var(--color-surface) l c h / 0.78) 0%,
          oklch(from var(--color-surface) l c h / 0.58) 60%,
          oklch(from var(--color-surface) l c h / 0.35) 100%
        );
      }
    }
  </style>

  {/* INTERLUDE */}
  <section class="bg-surface-elev border-b border-border">
    <div class="max-w-wrap mx-auto px-md py-xl flex items-center gap-lg">
      <span class="block h-px flex-1 bg-border"></span>
      <p class="font-body text-sm text-ink-muted tracking-[0.18em] uppercase shrink-0">Eine Geschichte · eine Stadt · Jahrtausende in Stein</p>
      <span class="block h-px flex-1 bg-border"></span>
    </div>
  </section>

  {/* GUIDE CARD */}
  <section class="bg-surface">
    <div class="max-w-wrap mx-auto px-md py-3xl lg:py-4xl">
      <ol class="guide-grid list-none p-0 m-0">
        {[
          {
            slug: 'matera',
            title: 'Matera — Die Sassi',
            subtitle: 'Die Sassi, Höhlenhäuser, die Gravina und die Felsenkirchen. Eine Geschichte um die Stadt von innen zu verstehen.',
            places: 'Sasso Caveoso · Sasso Barisano · Gravina · Felsenkirchen · Murgia Timone',
            narrator: 'Rosa, narrative Stimme der Sassi',
            cover: '/images/covers/matera-hero-jun26.webp',
            alt: 'Matera, die Sassi von oben mit den Höhlenhäusern',
            price: '€4,99',
            soon: false,
          },
          {
            slug: 'murgia',
            title: 'Die Murgia zwischen Matera, Gravina und Altamura',
            subtitle: 'Eine Reise durch Stein, Brot und Schluchten.',
            places: 'Matera · Gravina in Puglia · Altamura · Alta Murgia',
            narrator: '',
            cover: '/images/covers/matera-gravina-jun26.webp',
            alt: 'Die Gravina di Matera vom Canyonrand aus gesehen mit typischer Vegetation',
            price: '',
            soon: true,
          },
        ].map((g, i) => (
          <li class="guide-cell" style={`--idx:${i}`}>
            {g.soon ? (
              <div class="guide-card guide-card--soon" aria-label={g.title}>
                <figure class="guide-photo m-0">
                  <img src={g.cover} alt={g.alt} class="guide-img" loading="lazy" decoding="async" />
                  <span class="guide-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                  <span class="guide-ribbon" aria-hidden="true">demnächst</span>
                </figure>
                <div class="guide-meta">
                  <h3 class="guide-title font-display font-light text-ink-muted leading-[1.2] m-0">{g.title}</h3>
                  <p class="guide-places font-body text-xs text-ink-subtle tracking-[0.12em] uppercase m-0 mb-xs">{g.places}</p>
                  <p class="guide-sub font-body text-sm text-ink-subtle m-0">{g.subtitle}</p>
                </div>
              </div>
            ) : (
              <a href={`/de/guide/${g.slug}`} class="guide-card" aria-label={g.title}>
                <figure class="guide-photo m-0">
                  <img src={g.cover} alt={g.alt} class="guide-img" loading="lazy" decoding="async" />
                  <span class="guide-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                  {g.price && <span class="guide-price" aria-hidden="true">{g.price}</span>}
                  <span class="guide-scrim" aria-hidden="true">
                    <span class="guide-narrator">{g.narrator}</span>
                  </span>
                </figure>
                <div class="guide-meta">
                  <h3 class="guide-title font-display font-light text-ink leading-[1.2] m-0">{g.title}</h3>
                  <p class="guide-places font-body text-xs text-accent tracking-[0.12em] uppercase m-0 mb-xs">{g.places}</p>
                  <p class="guide-sub font-body text-sm text-ink-muted m-0">{g.subtitle}</p>
                </div>
              </a>
            )}
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* ERZÄHLERIN — ROSA */}
  <section class="bg-surface border-t border-border">
    <div class="max-w-wrap mx-auto px-md py-3xl lg:py-4xl">
      <div class="flex items-center justify-center gap-sm mb-2xl">
        <span class="block w-7 h-px bg-accent"></span>
        <span class="text-[10px] font-semibold tracking-[0.32em] uppercase text-accent">Die Stimme von Matera</span>
        <span class="block w-7 h-px bg-accent"></span>
      </div>
      <p class="font-body text-sm text-ink-muted text-center max-w-[52ch] mx-auto mb-2xl">Narratives Porträt auf Basis von Recherche, Quellen und Gedächtnis des Ortes.</p>
      <ul class="narr-grid list-none p-0 m-0">
        {[
          {
            name: 'Rosa',
            photo: '/images/authors/rosa-matera-jun26.png',
            role: 'Narrative Stimme der Sassi',
            bio: 'Achtundsiebzig Jahre alt. 1948 im Sasso Caveoso geboren, 1957 zwangsevakuiert, 1996 aus eigenem Willen zurückgekehrt. Sie hat erlebt, wie Matera sich von Italiens Schande zur europäischen Kulturhauptstadt gewandelt hat. Sie erzählt die Stadt als jemand, der sie von innen trägt, nicht als jemand, der sie von außen erklärt.',
            guide: 'Die Sassi',
            href: '/de/guide/matera',
          },
        ].map((n) => (
          <li class="narr-cell">
            <a href={n.href} class="narr-card" aria-label={`Guide ${n.guide} — Stimme von ${n.name}`}>
              <figure class="narr-photo m-0">
                <img
                  src={n.photo}
                  alt={`Narratives Porträt von ${n.name}`}
                  title={`${n.name}: Narratives Porträt auf Basis von Recherche und Localis-Quellen.`}
                  loading="lazy"
                  decoding="async"
                />
              </figure>
              <p class="narr-photo-note font-body text-[10px] font-semibold tracking-[0.18em] uppercase text-ink-subtle m-0">
                Narratives Porträt. Auf Basis von Recherche und Localis-Quellen.
              </p>
              <div class="narr-text">
                <p class="narr-guide font-body text-[10px] font-semibold tracking-[0.22em] uppercase text-accent m-0">{n.guide}</p>
                <h3 class="narr-name font-display font-light text-ink m-0">{n.name}</h3>
                <p class="narr-role font-body text-xs text-ink-subtle m-0">{n.role}</p>
                <p class="narr-bio font-body text-sm text-ink-muted m-0 mt-xs">{n.bio}</p>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <style>
    .narr-grid {
      display: grid;
      grid-template-columns: repeat(1, 1fr);
      gap: var(--spacing-2xl);
      max-width: 22rem;
    }
    @media (min-width: 640px)  { .narr-grid { grid-template-columns: repeat(2, 1fr); max-width: none; } }
    @media (min-width: 1024px) { .narr-grid { grid-template-columns: repeat(3, 1fr); } }

    .narr-card {
      display: flex; flex-direction: column; gap: var(--spacing-md);
      text-decoration: none; color: inherit;
      border-top: 1px solid var(--color-border);
      padding-top: var(--spacing-md);
      transition: opacity 0.2s;
    }
    .narr-card:hover { opacity: 0.82; }
    .narr-card:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 4px; border-radius: 2px; }
    .narr-photo {
      width: 100%; aspect-ratio: 3 / 4; overflow: hidden;
      border-radius: var(--radius-md); background: var(--color-surface-elev);
      box-shadow: 0 1px 2px oklch(15% 0.012 240 / 0.06), 0 8px 24px -8px oklch(15% 0.012 240 / 0.14);
    }
    .narr-photo img { width: 100%; height: 100%; object-fit: cover; display: block; filter: grayscale(100%) contrast(1.05) brightness(0.97); }
    .narr-photo-note { margin-top: calc(var(--spacing-md) * -0.55); line-height: 1.35; }
    .narr-text { display: flex; flex-direction: column; gap: var(--spacing-xs); }
    .narr-name { font-size: clamp(1.3rem, 2.8vw, 1.6rem); line-height: 1.1; }
    .narr-bio { line-height: 1.55; }
    @media (prefers-reduced-motion: reduce) { .narr-card { transition: none; } }
  </style>

  {/* PRICING */}
  <section id="preise" class="bg-surface-elev border-t border-border">
    <div class="max-w-wrap mx-auto px-md py-3xl lg:py-4xl">
      <SectionDivider label="Wähle, wie du Matera hören möchtest."  as="h2" />
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-lg max-w-[66rem] mx-auto">
        <PriceCard
          product="single"
          guideSlug="matera"
          lang="de"
          primary
          titleOverride="Die Erzählung über Matera"
          descriptionOverride="Die Sassi, die Gravina, die Felsenkirchen. Eine vollständige Geschichte."
          ctaOverride="Matera-Erzählung kaufen"
          features={[
            'Unbegrenzter Zugang, für immer',
            'Italienisch, Englisch und Deutsch',
            'Geld-zurück-Garantie, ohne Rückfragen',
          ]}
        />
        <PriceCard
          product="tris"
          lang="de"
          features={[
            '3 Guides deiner Wahl aus allen Zonen',
            'Unbegrenzter Zugang, für immer',
            'Geld-zurück-Garantie, ohne Rückfragen',
          ]}
        />
        <PriceCard
          product="sestina"
          lang="de"
          features={[
            '6 Guides deiner Wahl aus Bari, Valle d’Itria, Gargano und Matera',
            'Spare 9,95 € gegenüber Einzelguides',
            'Unbegrenzter Zugang, für immer',
          ]}
        />
      </div>
    </div>
  </section>

  {/* 3 SCHRITTE */}
  <StepsBlock lang="de" ctaHref="/de/guide/matera" />

</Layout>

<style>
  .guide-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: var(--spacing-lg);
    row-gap: var(--spacing-2xl);
  }
  @media (min-width: 640px)  { .guide-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .guide-grid { grid-template-columns: repeat(3, 1fr); } }

  .guide-cell {
    opacity: 0; transform: translateY(14px);
    animation: guideIn 0.7s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: calc(var(--idx, 0) * 80ms + 100ms);
  }
  .guide-card {
    display: flex; flex-direction: column; gap: var(--spacing-md); height: 100%;
    text-decoration: none; color: inherit;
    border-top: 1px solid var(--color-ink); padding-top: var(--spacing-md);
  }
  .guide-photo {
    position: relative; width: 100%; height: clamp(16rem, 24vw, 21rem);
    background: var(--color-surface-elev); overflow: hidden; border-radius: var(--radius-md);
    box-shadow: 0 1px 2px oklch(15% 0.012 240 / 0.08), 0 12px 32px -12px oklch(15% 0.012 240 / 0.16);
  }
  .guide-img { width: 100%; height: 100%; object-fit: cover; display: block; filter: saturate(0.94) contrast(1.04); }
  .guide-num { position: absolute; top: var(--spacing-sm); left: var(--spacing-sm); font-family: var(--font-display); font-style: italic; font-weight: 300; font-size: clamp(2.4rem, 4.4vw, 3.2rem); line-height: 0.85; color: var(--color-surface); letter-spacing: -0.04em; text-shadow: 0 1px 8px oklch(15% 0.012 240 / 0.55); pointer-events: none; user-select: none; }
  .guide-price { position: absolute; top: var(--spacing-sm); right: var(--spacing-sm); font-family: var(--font-body); font-size: 0.8125rem; font-weight: 700; color: var(--color-ink); background: var(--color-surface); border: 1px solid var(--color-accent); padding: 4px 10px 5px; line-height: 1.2; box-shadow: 0 1px 2px oklch(15% 0.012 240 / 0.18); pointer-events: none; user-select: none; z-index: 1; }
  .guide-scrim { position: absolute; left: 0; right: 0; bottom: 0; display: flex; align-items: center; padding: var(--spacing-sm) var(--spacing-md); background: linear-gradient(to top, oklch(15% 0.012 240 / 0.78), transparent 100%); color: var(--color-surface); font-family: var(--font-body); font-size: 10px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; pointer-events: none; }
  .guide-narrator { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .guide-meta { display: flex; flex-direction: column; gap: var(--spacing-xs); }
  .guide-title { font-size: clamp(1.1rem, 2.4vw, 1.35rem); }
  .guide-places { letter-spacing: 0.12em; }
  .guide-sub { line-height: 1.5; }
  .guide-card:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 4px; border-radius: 2px; }

  .guide-card--soon { cursor: default; border-top-style: dashed; border-top-color: var(--color-border); }
  .guide-card--soon .guide-img { filter: saturate(0.4) contrast(1.02) brightness(0.92); }

  .guide-ribbon {
    position: absolute;
    top: 20px;
    right: -28px;
    width: 130px;
    background: var(--color-accent);
    color: var(--color-surface);
    font-family: var(--font-body);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    text-align: center;
    padding: 6px 0;
    transform: rotate(45deg);
    transform-origin: center;
    pointer-events: none;
    z-index: 3;
    box-shadow: 0 2px 6px oklch(15% 0.012 240 / 0.28);
  }

  @keyframes guideIn { to { opacity: 1; transform: translateY(0); } }
  @media (prefers-reduced-motion: reduce) { .guide-cell, .guide-card, .guide-img { animation: none !important; transition: none !important; opacity: 1; transform: none; } }
</style>
