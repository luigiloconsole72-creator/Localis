---
import Layout from '../../components/Layout.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import AudioPlayer from '../../components/AudioPlayer.astro';
import FollowCta from '../../components/FollowCta.astro';
import { verifyAccessToken } from '../../lib/jwt';
import { canonicalGuideSlugs } from '../../lib/legacy-slugs';
import { getCollection } from 'astro:content';
import type { Lang } from '../../lib/i18n';
import { guideSubtitle, guideTitle } from '../../lib/guide-localization';

const { token } = Astro.params;

// La lingua si legge PRIMA dei redirect: i link di accesso la portano nel
// querystring (il webhook li costruisce come /access/{token}?lang=de) e chi
// finisce sulla pagina di link non valido deve trovarla nella propria lingua.
// Altrimenti legge una spiegazione che non capisce e se ne va, invece di
// chiedere un link nuovo.
const requestedLang = Astro.url.searchParams.get('lang');
const lang: Lang = requestedLang === 'en' || requestedLang === 'de' ? requestedLang : 'it';
const invalidPath = lang === 'it' ? '/access-invalid' : '/' + lang + '/access-invalid';

if (!token) {
  return Astro.redirect(invalidPath);
}

const decoded = await verifyAccessToken(token);

if (!decoded) {
  return Astro.redirect(invalidPath);
}

const allGuides = await getCollection('guides');
const userGuides = canonicalGuideSlugs(decoded.guide_slugs)
  .map((slug) => allGuides.find((g) => g.data.slug === slug))
  .filter((g): g is NonNullable<typeof g> => Boolean(g));

Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
Astro.response.headers.set('Cache-Control', 'private, no-store');

const labels = lang === 'it'
  ? {
      title: 'Le tue guide',
      eyebrow: 'Accesso permanente',
      intro: 'Salva questa pagina nei preferiti. Resta solo tua, vale per sempre. Ascolta in streaming oppure salva la guida per ascoltarla offline durante la visita.',
      phone: 'Cambiato telefono? Riapri questo link.',
      recover: 'Smarrita email?',
      recoverLink: 'Recupera l\'accesso',
    }
  : lang === 'de'
    ? {
        title: 'Deine Guides',
        eyebrow: 'Dauerhafter Zugang',
        intro: 'Speichere diese Seite in deinen Lesezeichen. Sie gehört dir und bleibt gültig. Höre per Stream oder speichere den Guide für die Offline-Nutzung während deines Besuchs.',
        phone: 'Neues Smartphone? Öffne diesen Link erneut.',
        recover: 'E-Mail verloren?',
        recoverLink: 'Zugang wiederherstellen',
      }
    : {
        title: 'Your guides',
        eyebrow: 'Permanent access',
        intro: 'Bookmark this page. It is yours and stays valid. Stream it anytime or save the guide to listen offline during your visit.',
        phone: 'Changed phone? Open this link again.',
        recover: 'Lost the email?',
        recoverLink: 'Recover access',
      };

// Token coniati da Cortése (concierge in hotel): la "email" è un marker tecnico
// (cortese:free:<hotel> / cortese:room:<n>). Mostriamo un'etichetta elegante al
// posto della stringa tecnica e nascondiamo il recupero via email — l'ospite non
// ha un acquisto: riapre la guida dalla sua app Cortése in camera.
const isCortese = typeof decoded.email === 'string' && decoded.email.startsWith('cortese:');
const corteseGift = typeof decoded.email === 'string' && decoded.email.startsWith('cortese:free:');
const corteseSuffix = !isCortese
  ? decoded.email
  : lang === 'de'
    ? (corteseGift ? 'Ein Geschenk Ihrer Unterkunft' : 'Während Ihres Aufenthalts freigeschaltet')
    : lang === 'en'
      ? (corteseGift ? 'Compliments of your host' : 'Unlocked during your stay')
      : (corteseGift ? 'Omaggio della struttura' : 'Sbloccata durante il soggiorno');
---
<Layout title={`${labels.title} - Localis`} description="" lang={lang} embedded={isCortese}>
  <main class="max-w-wrap mx-auto px-md py-2xl">
    <header class="mb-2xl">
      <Eyebrow class="mb-md">{labels.eyebrow} - {corteseSuffix}</Eyebrow>
      <h1 class="font-display text-4xl text-ink mb-md">{labels.title}</h1>
      <p class="text-base text-ink-muted max-w-prose">
        {labels.intro}
      </p>
    </header>

    <div class="flex flex-col gap-2xl">
      {userGuides.map((guide) => (
        <section id={guide.data.slug} class="scroll-mt-lg">
          <h2 class="font-display text-2xl text-ink mb-xs">{guideTitle(guide.data, lang)}</h2>
          <p class="text-sm text-ink-muted mb-md">{guideSubtitle(guide.data, lang)}</p>
          <AudioPlayer guide={guide.data} token={token} lang={lang} />
        </section>
      ))}
    </div>

    <FollowCta lang={lang} class="mt-3xl" />

    <footer class="mt-3xl pt-lg border-t border-border text-center">
      <p class="text-sm text-ink-muted mb-xs">
        {labels.phone}
      </p>
      {!isCortese && (
        <p class="text-sm text-ink-muted">
          {labels.recover} <a href="/recover" class="text-link hover:text-link-pressed">{labels.recoverLink}</a>.
        </p>
      )}
    </footer>
  </main>

  <script is:inline>
    if ('serviceWorker' in navigator) {
      navigator.serviceWorker.register('/sw.js').catch(console.error);
    }
  </script>
</Layout>
